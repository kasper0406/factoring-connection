    25	def reduce_mod_g(c: List[int], g: Sequence[int], m: int | None = None) -> List[int]:
    26	    """Reduce a coefficient list (any length) modulo the monic g (degree d); optional coefficient modulus m."""
    27	    d = len(g) - 1
    28	    c = list(c)
