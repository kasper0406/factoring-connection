    17	
    18	from fractions import Fraction
    19	from math import sqrt
    20	from typing import Dict
    21	
    22	from src.pcest.params import theta as theta_pp  # design (a''_k), for comparison
    23	
    24	
    25	def h_floor_mu(d: int, k: int, mu: Fraction) -> Fraction:
    26	    """Height floor with M = N^mu, w ~ N^(mu + nu) (codex ldbound_2 variant):
    27	    Kern 2nu; FM level mu - (d-2)nu; window |a_0| ~ N w / M^d << M H:  1 - d mu + nu."""
    28	    nu = Fraction(1, 4 * k)
    29	    return max(2 * nu, mu - (d - 2) * nu, 1 - d * mu + nu)
    30	
    31	
    32	def theta_mu(d: int, k: int, mu: Fraction) -> Fraction:
    33	    nu = Fraction(1, 4 * k)
    34	    return 2 * mu + h_floor_mu(d, k, mu) + (d - 1) * nu
    35	
    36	
    37	def best_mu(d: int, k: int):
    38	    """Minimise theta_mu over mu > nu (piecewise linear in mu: check the breakpoints)."""
    39	    nu = Fraction(1, 4 * k)
    40	    cands = {Fraction(1, d + 1), (1 + (d - 1) * nu) / (d + 1), (1 - nu) / d, d * nu}
    41	    cands = [m for m in cands if m > nu]
    42	    m = min(cands, key=lambda m: (theta_mu(d, k, m), m))
    43	    return m, theta_mu(d, k, m)
    44	
    45	
    46	def theta3opt(d: int, k: int) -> Fraction:
    47	    return best_mu(d, k)[1]
    48	
    49	
    50	def h_floor(d: int, k: int) -> Fraction:
    51	    s = Fraction(1, d + 1)
    52	    return max(s + Fraction(1, 4 * k), s - Fraction(d - 2, 4 * k), Fraction(1, 2 * k))
    53	
    54	
    55	def theta3(d: int, k: int) -> Fraction:
    56	    s = Fraction(1, d + 1)
    57	    return 2 * s + h_floor(d, k) + Fraction(d - 1, 4 * k)
    58	
    59	
    60	def c_const(th) -> float:
    61	    return (1 + float(th)) / sqrt(2)
    62	
    63	
    64	def c_ps(th) -> float:
    65	    """Theorem A' (Pollard-Strassen smoothness tests), closed form valid for theta <= 1/2."""
    66	    th = float(th)
    67	    assert th <= 0.5
    68	    return 1 / sqrt(2) + (sqrt(2) - sqrt(2 - 4 * th)) / 2
    69	
    70	
    71	def min_k(d: int, target: float = 1.0, design: str = "a3", kmax: int = 10 ** 5) -> int:
    72	    for k in range(1, kmax):
