    86	    mu = Fraction(1, d + 1) if mu is None else mu
    87	    h = h_floor_mu(d, k, mu)
    88	    return {
    89	        "FM_k": mu - nu,                              # FM: q = mu + nu > 2 nu; fibres M/V >> 1
    90	        "FM_level": (mu + h + d * nu) / 2 - (mu + nu) + Fraction(1, 10 ** 9),  # >= 0 at floor
    91	        "Kern": h - 2 * nu + Fraction(1, 10 ** 9),    # >= 0 at floor (eta0 added)
    92	        "window": h - (1 - d * mu + nu) + Fraction(1, 10 ** 9),  # |a_0| V^d << M H V^d
    93	        "diag": h + (d - 1) * nu - 2 * nu,            # T >> l q
    94	        "C_R2": h + (d - 1) * nu - 4 * nu,            # class (C): Y^2 q^2 << T rho rho
    95	        "C_X": 2 * nu,                                # class (C): pi_J >> 1/rho_F
    96	        "B_R2": 2 * nu + h + (d - 1) * nu,            # class (B): X/X' = l T
    97	        "theta_le_1": 1 - theta_mu(d, k, mu) + Fraction(1, 10 ** 9),
    98	    }
    99	
