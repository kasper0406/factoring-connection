    for f in out["nondivisible"][:50]:
        chk = R.check_res_floor(list(f) if f[-1] != 0 else list(f), f0, m, N) if f[-1] != 0 else None
        if chk is not None:
            assert chk["divisible"] and chk["abs_ge_N"]


def test_rational_side_rigidity():
