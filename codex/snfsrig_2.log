"""Exact size-model bookkeeping for special-form polynomials (notes/snfsrig_results.md section 1).

Conventions (as in notes/recurse_results.md section 3.3 and notes/lv5unif_results.md):
  t = log N, D = t / log t, Lambda_alpha = t^alpha (log t)^(1-alpha), B = exp(a Lambda_alpha),
  d ~ D^x (degree), k ~ D^y (split: k primes of size N^(1/(2k)), nu = 1/(4k)).
A one-level design has norm-product exponent
  theta = theta_coeff + theta_box,   theta_box = (d - 1) nu  (box radius V ~ sqrt(l) S),
and the coefficient term theta_coeff = (log||f|| + log||g||)/log N.  For every pair with a LINEAR side g and
deg f = d, Res(f, g) is a nonzero multiple of N, so (d + 1)||f|| ||g||^d >= N and theta_coeff >= 1/d - o(1)
(Lemma RES in the notes; this module only does the exponent arithmetic).

Everything is exact (fractions.Fraction); no floating point is used for any decision.
"""
from __future__ import annotations

from fractions import Fraction as Fr
from typing import Dict, List, Tuple

# ---------------------------------------------------------------------------------------------------------
# 1. One-level floor as a function of the coefficient exponent p (theta_coeff ~ d^{-p})
# ---------------------------------------------------------------------------------------------------------


def one_level_floor(p) -> Fr:
    """Least alpha for which some (x, y) satisfies
         (R1) y <= alpha,  (R2/R3) p*x >= 1 - 2 alpha  and  y >= x + 1 - 2 alpha,  x >= 0.
    Closed form: (1 + p)/(3p + 2) for p > 0 (p = 1 gives 2/5; p -> infinity gives 1/3); p = 0 gives 1/2."""
    p = Fr(p)
    if p < 0:
        raise ValueError("p >= 0")
    if p == 0:
        return Fr(1, 2)
    return (1 + p) / (3 * p + 2)


def one_level_feasible(alpha, p, x, y) -> bool:
    """Check the three exponent constraints exactly at a given (alpha, x, y)."""
    alpha, p, x, y = Fr(alpha), Fr(p), Fr(x), Fr(y)
    return (x >= 0 and y <= alpha and p * x >= 1 - 2 * alpha and y >= x + 1 - 2 * alpha)


def one_level_optimum(p) -> Tuple[Fr, Fr, Fr]:
    """(alpha, x, y) at the floor: x = (1 - 2 alpha)/p, y = alpha."""
    al = one_level_floor(p)
    if Fr(p) == 0:
        return al, Fr(0), al
    return al, (1 - 2 * al) / Fr(p), al


# ---------------------------------------------------------------------------------------------------------
# 2. Constants at alpha = 2/5: theta * D^{1/5} -> theta0(d0, kappa), d = d0 D^{1/5}, k = kappa D^{2/5}
# ---------------------------------------------------------------------------------------------------------

DESIGNS = ("U", "GNFS_heur", "SNFS")


def theta0(design: str, d0, kappa) -> Fr:
    """Leading constant of theta D^{1/5}.
    U          : Theorem U's rigorous design (random field; floors h >= max(2nu, mu-(d-2)nu, 1-d mu+nu)):
                 3/d0 if kappa >= d0^2/4, else 2/d0 + d0/(4 kappa)   [lv5unif params.theta0]
    GNFS_heur  : base-m pair, ||f|| ~ ||g|| ~ N^{1/(d+1)}, no randomisation floors: 2/d0 + d0/(4 kappa)
    SNFS       : ||f|| = N^{o(1)}, ||g|| ~ N^{1/d}: 1/d0 + d0/(4 kappa)  (the RES minimum 1/d is attained)."""
    d0, kappa = Fr(d0), Fr(kappa)
    if design == "U":
        if kappa >= d0 * d0 / 4:
            return Fr(3) / d0
        return Fr(2) / d0 + d0 / (4 * kappa)
    if design == "GNFS_heur":
        return Fr(2) / d0 + d0 / (4 * kappa)
    if design == "SNFS":
        return Fr(1) / d0 + d0 / (4 * kappa)
    raise ValueError(design)


def theta0_min_squared(design: str, kappa) -> Fr:
    """(min over d0 of theta0)^2, exact.  U and GNFS_heur: 2/kappa (at d0 = sqrt(8 kappa), Kern regime, which
    is admissible for U since kappa < d0^2/4 = 2 kappa); SNFS: 1/kappa (at d0 = 2 sqrt(kappa))."""
    kappa = Fr(kappa)
    if design in ("U", "GNFS_heur"):
        return Fr(2) / kappa
    if design == "SNFS":
        return Fr(1) / kappa
    raise ValueError(design)


def two_pow_2_5_bracket(den: int = 10 ** 6) -> Tuple[Fr, Fr]:
    lo_n = 1319507 * den // 10 ** 6
    while Fr(lo_n + 1, den) ** 5 < 4:
        lo_n += 1
    while Fr(lo_n, den) ** 5 > 4:
        lo_n -= 1
    return Fr(lo_n, den), Fr(lo_n + 1, den)


def cost_constant(design: str, a, d0, kappa, C_gamma) -> Fr:
    """Upper bracket of Theorem U's cost formula with theta0 of the given design:
         c = max(2a, a + s + max(a, sigma), (a + s)/(1 - 2^{-2/5})),  s = 2 kappa (1 + C_gamma), sigma = 2 theta0/(5a).
    For SNFS and GNFS_heur this is HYPOTHETICAL: it assumes a relation supply gamma >= (log N)^{-C_gamma} that is
    proved only for design U (and, for SNFS, is exactly what is missing; notes section 2)."""
    a, kappa, C_gamma = Fr(a), Fr(kappa), Fr(C_gamma)
    sg = 2 * theta0(design, d0, kappa) / (5 * a)
    s = 2 * kappa * (1 + C_gamma)
    lo_t, _hi_t = two_pow_2_5_bracket()
    fhi = lo_t / (lo_t - 1)              # upper bracket of 1/(1 - 2^{-2/5})
    return max(2 * a, a + s + max(a, sg), (a + s) * fhi)


def optimise(design: str, C_gamma, grid_a=None, grid_kappa=None, grid_d0=None) -> Dict:
    grid_a = grid_a or [Fr(i, 20) for i in range(1, 81)]
    grid_kappa = grid_kappa or [Fr(i, 400) for i in range(1, 81)]
    best = None
    for kappa in grid_kappa:
        d0s = grid_d0 or [Fr(i, 20) for i in range(1, 300) if kappa <= Fr(i, 20) ** 2 <= 32 * kappa]
        for d0 in d0s:
            for a in grid_a:
                c = cost_constant(design, a, d0, kappa, C_gamma)
                if best is None or c < best["c"]:
                    best = {"design": design, "a": a, "kappa": kappa, "d0": d0, "c": c,
                            "theta0": theta0(design, d0, kappa)}
    return best


# ---------------------------------------------------------------------------------------------------------
# 3. Multi-level descent in one field (recurse section 3.4): exponent count of levels
# ---------------------------------------------------------------------------------------------------------


def multilevel_levels(alpha) -> int:
    """Levels needed from beta_1 = 1 - alpha down to alpha with decrement 3 alpha - 1 (alpha > 1/3).
    Identical for GNFS and SNFS heights: the coefficient term enters as (log N)^{1 - delta} either way."""
    alpha = Fr(alpha)
    if alpha <= Fr(1, 3):
        raise ValueError("bounded number of levels needs alpha > 1/3 (alpha = 1/3: O(log log N) levels)")
    num, den = 1 - 2 * alpha, 3 * alpha - 1
    q = num / den
    return int(q) if q.denominator == 1 else int(q) + 1


# ---------------------------------------------------------------------------------------------------------
# 4. Prop R2 (no algebraic children) recomputed: GNFS premise (M1) vs SNFS premise (M1-S)
# ---------------------------------------------------------------------------------------------------------


def r2_window_nonempty_exponent(alpha) -> bool:
    """GNFS (M1): nested Prop R2's window (A, W) is non-empty iff Lambda^2 U^3 = o(t^2), Lambda ~ U ~ t^alpha up to
    log factors, i.e. iff 5 alpha < 2.  Non-empty window => no finite cost-L[alpha] tree without algebraic children."""
    return 5 * Fr(alpha) < 2


def r2s_contraction_exponent(alpha) -> Fr:
    """SNFS (M1-S): at a node with rational target e^z choose d = c' Xi/(z/2 + log S), Xi = Lambda U (algebraic value
    B-smooth within budget).  Rational cofactor ~ t/d ~ t z/(2 c' Xi); children y = cofactor/U, so
        y/z  ~  t/(2 c' Lambda U^2)  =  t^{1 - 3 alpha} (log t)^{3 alpha - 1} / const.
    Returns the t-exponent 1 - 3 alpha of the contraction ratio (< 0: polynomial contraction; = 0: constant)."""
    return 1 - 3 * Fr(alpha)


def r2s_floor() -> Fr:
    """Least alpha with a non-expanding rational-only descent in the SNFS model: 1/3 (attained with constant
    contraction, see r2s_alpha_third)."""
    return Fr(1, 3)


def r2s_alpha_third(b, s, phiF, phiR, b1) -> Dict:
    """alpha = 1/3, E = t^{1/3}(log t)^{2/3}, Q = t^{2/3}(log t)^{1/3}, D' = Q/E, t = D'Q.
    B = e^{bE}; box radius e^{sE} sqrt(q); algebraic smoothness u_F = phiF D' (cost e^{phiF E/3});
    rational-cofactor smoothness u_R = phiR D' (cost e^{phiR E/3}); split targets z_1 = b1 Q.
    Node with target z >= bE: d(z) = phiF b Q/(z/2 + sE) (so the algebraic value e^{d(z/2+sE)} = e^{phiF b Q} is
    B-smooth with u = phiF D'); rational cofactor t/d = D'(z/2 + sE)/(phiF b); children y = (z/2 + sE)/(phiF phiR b).
    Returns the exact contraction bound lam (y <= lam z for all z >= bE), the top degree d1 = 2 phiF b/b1, the
    heuristic per-target good-point exponent 2s - (phiF + phiR)/3 (must be > 0 for an all-target supply under the
    random-integer model), and the top-level rational-value exponent tau = 1/d1 (values N^{tau})."""
    b, s, phiF, phiR, b1 = map(Fr, (b, s, phiF, phiR, b1))
    lam = (Fr(1, 2) + s / b) / (phiF * phiR * b)
    d1 = 2 * phiF * b / b1
    margin = 2 * s - (phiF + phiR) / 3
    return {"lam": lam, "contracts": lam < 1, "d1": d1, "d1_ge_1": d1 >= 1,
            "good_point_margin": margin, "heuristic_ok": margin > 0,
            "tau_top": (1 / d1) if d1 >= 1 else None,
            "max_degree_over_Dprime": 2 * phiF}


# ---------------------------------------------------------------------------------------------------------
# 5. The size-model table (data; derivations in the notes)
# ---------------------------------------------------------------------------------------------------------

TABLE: List[Tuple[str, str, str, str]] = [
    # (design, one-level alpha, multi-level one-field alpha (algebraic children), rational-only alpha)
    ("GNFS-type (M1 holds; random fields available)", "2/5", "1/3 (endogenous algebraic children)", "2/5 (nested Prop R2)"),
    ("SNFS (||f|| = N^{o(1)}, ||g|| = N^{1/d}; fixed fields)", "2/5 (theta0 smaller by sqrt 2 vs heuristic GNFS)",
     "1/3", "1/3 (Prop R2-S, per-node degree)"),
]
"""Diagnostic checkers for the rigidity statements of notes/snfsrig_results.md section 2.

  Lemma RES  (resultant floor):  f, g in Z[x] with a common root m mod N and Res(f, g) != 0  =>  N | Res(f, g),
                                 hence |Res| >= N and (Hadamard) ||f||_2^{deg g} ||g||_2^{deg f} >= N.
  Lemma HR   (height rigidity):  f0 irreducible, f0(m) = 0 mod N, f(m) = 0 mod N, f0 does not divide f
                                 =>  ||f||_2 >= (N / ||f0||_2^{deg f})^{1/deg f0}.
  Lemma RS   (rational-side rigidity): (g0, g1) with g0 = m g1 (mod N), max(|g0|, |g1|) < N/(2m + 2)
                                 => (g0, g1) = g1 (m, 1).
  Prop DI    (device invariance): the devices N*w, kN, root twists, f(x + t), u^d f(x/u), Moebius transforms map the
                                 value pair (F, G)(P) to (c1 F0(T P), c2 G0(T P)) with T in GL_2(Q).

These are checks of proved lemmas on small instances (exact integer arithmetic; sympy only for polynomial algebra
and resultants of explicit small polynomials -- never to factor N).  Not operational code.
"""
from __future__ import annotations

import itertools
import math
from fractions import Fraction as Fr
from typing import Iterable, List, Sequence, Tuple

import sympy as sp

X, A, Bv = sp.symbols("x a b")


def poly_eval_mod(coeffs_low_to_high: Sequence[int], m: int, N: int) -> int:
    v = 0
    for c in reversed(coeffs_low_to_high):
        v = (v * m + c) % N
    return v


def l2(coeffs: Sequence[int]) -> float:  # only for reporting, never for decisions
    return math.sqrt(sum(c * c for c in coeffs))


def l2sq(coeffs: Sequence[int]) -> int:
    return sum(c * c for c in coeffs)


def resultant(f: Sequence[int], g: Sequence[int]) -> int:
    F = sp.Poly(list(reversed(list(f))), X)
    G = sp.Poly(list(reversed(list(g))), X)
    return int(sp.resultant(F, G))


def check_res_floor(f: Sequence[int], g: Sequence[int], m: int, N: int) -> dict:
    """Lemma RES on one instance: f(m) = g(m) = 0 mod N.  Returns the facts checked exactly."""
    assert poly_eval_mod(f, m, N) == 0 and poly_eval_mod(g, m, N) == 0
    R = resultant(f, g)
    df, dg = len(f) - 1, len(g) - 1
    had_sq = l2sq(f) ** dg * l2sq(g) ** df          # Hadamard: R^2 <= ||f||^{2 dg} ||g||^{2 df}
    return {"res": R, "divisible": R % N == 0, "nonzero": R != 0,
            "hadamard_ok": R * R <= had_sq, "abs_ge_N": (R == 0) or abs(R) >= N}


def snfs_pair(r: int, e: int, s: int, d: int) -> Tuple[List[int], int, int, int]:
    """N = r^e - s.  With q = ceil(e/d), m = r^q and j = d q - e:  r^j N = m^d - s r^j, so
    f0(x) = x^d - s r^j has f0(m) = r^j N = 0 (mod N) (when gcd(r, N) = 1 this is the root used).
    Returns (f0 low->high, m, N, j)."""
    N = r ** e - s
    q = -(-e // d)
    j = d * q - e
    m = r ** q
    f0 = [-s * r ** j] + [0] * (d - 1) + [1]
    assert poly_eval_mod(f0, m, N) == 0
    return f0, m, N, j


def is_irreducible(f: Sequence[int]) -> bool:
    return sp.Poly(list(reversed(list(f))), X).is_irreducible


def divides_over_Q(f0: Sequence[int], f: Sequence[int]) -> bool:
    F0 = sp.Poly(list(reversed(list(f0))), X, domain="QQ")
    F = sp.Poly(list(reversed(list(f))), X, domain="QQ")
    if F.is_zero:
        return True
    return F.rem(F0).is_zero


def hr_bound_sq_pow(f0: Sequence[int], deg_f: int, N: int) -> Tuple[int, int]:
    """Lemma HR in squared integer form: ||f||_2^{2 d0} >= N^2 / ||f0||_2^{2 deg_f}.  Returns (lhs_needed_num, den)
    so that the claim reads  l2sq(f)^{d0} * den >= num  with num = N^2, den = l2sq(f0)^{deg_f}."""
    return N * N, l2sq(f0) ** deg_f


def exhaustive_small_height(f0: Sequence[int], m: int, N: int, deg: int, H: int) -> dict:
    """Enumerate every f of degree <= deg with coefficients in [-H, H] and f(m) = 0 mod N; report those not
    divisible by f0 (over Q).  Lemma HR predicts none when l2sq(f)^{d0} * l2sq(f0)^{deg} < N^2 for all such f,
    i.e. in particular when ((deg+1) H^2)^{d0} * l2sq(f0)^{deg} < N^2."""
    d0 = len(f0) - 1
    found, nondiv = 0, []
    for cs in itertools.product(range(-H, H + 1), repeat=deg + 1):
        if all(c == 0 for c in cs):
            continue
        if poly_eval_mod(cs, m, N) != 0:
            continue
        found += 1
        if not divides_over_Q(f0, cs):
            nondiv.append(cs)
    guaranteed = ((deg + 1) * H * H) ** d0 * l2sq(f0) ** deg < N * N
    # every non-multiple must violate the guarantee region (consistency with Lemma HR)
    consistent = all(l2sq(c) ** d0 * l2sq(f0) ** deg >= N * N for c in nondiv)
    return {"found": found, "nondivisible": nondiv, "hr_guarantees_none": guaranteed, "consistent_with_HR": consistent}


def rational_side_vectors(m: int, N: int, Hg: int) -> List[Tuple[int, int]]:
    """All (g0, g1) with |g0|, |g1| <= Hg, (g0, g1) != 0, g0 = m g1 (mod N).  Enumerates g1 and the few g0."""
    out = []
    for g1 in range(-Hg, Hg + 1):
        base = (m * g1) % N
        for g0 in (base - N * t for t in range(-2, 3)):
            if abs(g0) <= Hg and (g0, g1) != (0, 0):
                out.append((g0, g1))
    return sorted(set(out))


def check_rs(m: int, N: int, Hg: int) -> dict:
    """Lemma RS: if Hg < N/(2m + 2) (and 0 <= m < N) every vector is g1 (m, 1)."""
    vecs = rational_side_vectors(m, N, Hg)
    bad = [(g0, g1) for (g0, g1) in vecs if g0 != m * g1]
    return {"n": len(vecs), "non_multiples": bad, "hypothesis": Hg * (2 * m + 2) < N}


# ---------------------------------------------------------------------------------------------------------
# Prop DI: device invariance (symbolic identities)
# ---------------------------------------------------------------------------------------------------------


def hom(f_low_high: Sequence[int], a, b):
    d = len(f_low_high) - 1
    return sum(sp.Integer(c) * a ** i * b ** (d - i) for i, c in enumerate(f_low_high))


def device_identities(f0: Sequence[int], m: int) -> dict:
    """For the devices of Prop DI, return sympy expressions that must simplify to 0.
    F0(a, b) = b^d f0(a/b), G0(a, b) = a - m b.  T acts on column vectors P = (a, b)."""
    d = len(f0) - 1
    F0 = hom(f0, A, Bv)
    G0 = A - m * Bv
    u, t, w, lam = sp.Integer(3), sp.Integer(5), sp.Integer(7), sp.Integer(2)
    al, be, ga, de = sp.Integer(2), sp.Integer(1), sp.Integer(1), sp.Integer(1)   # Moebius x -> (al x + be)/(ga x + de)
    fx = sp.Poly(list(reversed(list(f0))), X).as_expr()
    out = {}
    # (b) multiplier w: f = w f0, g = g0
    out["w_multiplier"] = sp.expand(hom([w * c for c in f0], A, Bv) - w * F0)
    # (a') root twist by lambda: root lambda m, f_l(x) = lambda^d f0(x/lambda), g = x - lambda m
    f_l = sp.Poly(sp.expand(lam ** d * fx.subs(X, X / lam)), X)
    F_l = hom(list(reversed(f_l.all_coeffs())), A, Bv)
    out["root_twist_F"] = sp.expand(F_l - F0.subs(Bv, lam * Bv))
    out["root_twist_G"] = sp.expand((A - lam * m * Bv) - G0.subs(Bv, lam * Bv))
    # (c) shift f(x + t): root m - t, F_t(a, b) = F0(a + t b, b)
    f_t = sp.Poly(sp.expand(fx.subs(X, X + t)), X)
    F_t = hom(list(reversed(f_t.all_coeffs())), A, Bv)
    out["shift_F"] = sp.expand(F_t - F0.subs(A, A + t * Bv))
    out["shift_G"] = sp.expand((A - (m - t) * Bv) - G0.subs(A, A + t * Bv))
    # (c') scaling u^d f(x/u): root u m, F(a, b) = F0(a, u b)
    f_u = sp.Poly(sp.expand(u ** d * fx.subs(X, X / u)), X)
    F_u = hom(list(reversed(f_u.all_coeffs())), A, Bv)
    out["scale_F"] = sp.expand(F_u - F0.subs(Bv, u * Bv))
    # (c'') Moebius: f_M(x) = (ga x + de)^d f0((al x + be)/(ga x + de)); F_M(a, b) = F0(al a + be b, ga a + de b)
    f_M = sp.Poly(sp.expand(sp.cancel((ga * X + de) ** d * fx.subs(X, (al * X + be) / (ga * X + de)))), X)
    F_M = hom(list(reversed(f_M.all_coeffs())), A, Bv)
    out["moebius_F"] = sp.expand(F_M - F0.subs({A: al * A + be * Bv, Bv: ga * A + de * Bv}, simultaneous=True))
    return out


# ---------------------------------------------------------------------------------------------------------
# Prop RB: size of the total value set of a fixed-family one-level design
# ---------------------------------------------------------------------------------------------------------


def value_set_bound(n_devices: int, n_targets: int, box_points: int) -> int:
    """|V| <= 2 * (#fields/devices) * (#special-q targets) * (#box points): every query is G(P)/l or F(P) for one
    of the listed (device, target, point) triples."""
    return 2 * n_devices * n_targets * box_points

