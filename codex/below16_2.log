    75	def class_var_range(n: int, side: str) -> Tuple[int, int, int]:
    76	    """(xmin, xmax, partner_len_max): integer range of the class variable over
    77	    S_n and an upper bound for the length of the partner's range."""
    78	    lo, hi = 1 << (n - 1), 1 << n
    79	    if side == "p":
    80	        xmin = math.isqrt((lo - 1) // 2) + 1          # 2p^2 >= lo
    81	        xmax = math.isqrt(hi - 1)                       # p^2 < hi
    82	        return xmin, xmax, xmax                        # q in (p, 2p]: length <= p
    83	    xmin = math.isqrt(lo - 1) + 1                       # q^2 > pq >= lo
    84	    xmax = math.isqrt(2 * (hi - 1))                     # q^2 <= 2pq < 2hi
    85	    return xmin, xmax, xmax // 2 + 1                   # p in [q/2, q)
