   121	def count_T1(g: GenT1, p: np.ndarray, q: np.ndarray) -> int:
   122	    x, y = (p, q) if g.side == "p" else (q, p)
   123	    kap = (p * q) % g.K
   124	    cls = x % g.M
   125	    val = (g.B * x + g.A * y) // g.D
   126	    keys = np.array(sorted(set(g.R) & set(g.S)), dtype=np.int64)
   127	    if len(keys) == 0:
   128	        return 0
   129	    # R membership via table
   130	    rt = np.zeros((g.K, g.M), dtype=bool)
   131	    for k, rs in g.R.items():
   132	        for r in rs:
   133	            rt[k, r % g.M] = True
   134	    ok = rt[kap, cls]
   135	    # S membership via combined codes
   136	    vmin = int(val.min()) - 1
   137	    span = int(val.max()) - vmin + 2
   138	    codes = []
   139	    for k, ss in g.S.items():
   140	        for s in ss:
   141	            if vmin <= s < vmin + span:
   142	                codes.append(k * span + (s - vmin))
   143	    codes = np.array(sorted(codes), dtype=np.int64)
   144	    c = kap * span + (val - vmin)
   145	    ok &= np.isin(c, codes, assume_unique=False)
   146	    return int(ok.sum())
