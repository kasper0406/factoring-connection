   190	
   191	def bound_T1_closed(g: GenT1, n: int) -> float:
   192	    """Closed form CF1 = 2 c_side (P/M) sqrt(2P(D/|A|+K)) E_N[|R| sqrt|S|]
   193	    (A != 0) or 4 c_side (P/M) sqrt(P(D/|B|+M)) E_N[|R| sqrt|S|] (A == 0).
   194	    Float only as the final comparison value (sqrt)."""
   195	    P = 2.0 ** (n / 2)
   196	    c_side = 1.0 if g.side == "p" else 1.25
   197	    f = {k: len(g.R[k]) * math.sqrt(len(g.S[k])) for k in set(g.R) & set(g.S)}
   198	    E = float(expect_over_N(n, g.K, f))
   199	    if g.A != 0:
   200	        return 2 * c_side * (P / g.M) * math.sqrt(2 * P * (g.D / abs(g.A) + g.K)) * E
   201	    return 4 * c_side * (P / g.M) * math.sqrt(P * (g.D / abs(g.B) + g.M)) * E
   202	
   203	
   204	def t1_conditions(g: GenT1, n: int) -> bool:
   205	    P = 2.0 ** (n / 2)
   206	    return g.M <= P / 2 and g.K <= P / 2 and g.K <= 2 ** (n - 2)
   207	
   208	
   209	# --------------------------------------------------------------------------
   210	# T2
   211	# --------------------------------------------------------------------------
   212	
   213	@dataclass
   214	class GenT2:
   215	    A: int
   216	    B: int
   217	    M: int
   218	    K: int
   219	    D: int
   220	    Delta: int
   221	    R: Dict[Tuple[int, int], FrozenSet[int]] = field(default_factory=dict)
   222	    UW: Dict[Tuple[int, int], Tuple[int, int]] = field(default_factory=dict)
   223	
   224	
   225	def t2_delta(n: int, K: int) -> int:
   226	    """Smallest power of two >= P*K (P = 2^{n/2}); it divides 2^{n-1}."""
   227	    j = math.ceil(n / 2 + math.log2(K) - 1e-12)
   228	    while (1 << j) < math.isqrt(1 << n) * K:
   229	        j += 1
   230	    return 1 << j
   231	
   232	
   233	def keys_T2(g: GenT2, n: int, p: np.ndarray, q: np.ndarray):
   234	    N = p * q
   235	    return N % g.K, (N - (1 << (n - 1))) // g.Delta
   236	
   237	
   238	def count_T2(g: GenT2, n: int, p: np.ndarray, q: np.ndarray) -> int:
   239	    kap, b = keys_T2(g, n, p, q)
   240	    val = (g.B * p + g.A * q) // g.D
   241	    tot = 0
   242	    # group by key present in design
   243	    want = set(g.R) & set(g.UW)
   244	    if not want:
   245	        return 0
   246	    code = kap * (int(b.max()) + 1) + b
   247	    nb = int(b.max()) + 1
   248	    for (k, bb) in want:
   249	        m = code == k * nb + bb
   250	        if not m.any():
   251	            continue
   252	        U, W = g.UW[(k, bb)]
   253	        rs = np.array(sorted(g.R[(k, bb)]), dtype=np.int64)
   254	        sel = m & np.isin(p % g.M, rs) & (val >= U) & (val < U + W)
   255	        tot += int(sel.sum())
   256	    return tot
   257	
   258	
   259	def cplus_T2(g: GenT2, n: int, key: Tuple[int, int]) -> int:
   260	    """|C^+(key)|: integers p (class var) in the p-range with p mod M in R and
   261	    some integer q == kappa/p (mod K) in the box with floor((Bp+Aq)/D) in window."""
   262	    k, bb = key
   263	    lo_n = (1 << (n - 1)) + bb * g.Delta
   264	    hi_n = min(lo_n + g.Delta, 1 << n)
   265	    U, W = g.UW[key]
   266	    xmin, xmax, _ = class_var_range(n, "p")
   267	    cnt = 0
   268	    for r in g.R[key]:
   269	        start = xmin + ((r - xmin) % g.M)
   270	        for x in range(start, xmax + 1, g.M):
   271	            if math.gcd(x, g.K) != 1:
   272	                continue
   273	            a = (k * pow(x, -1, g.K)) % g.K
   274	            # q range: q in (x, 2x], lo_n <= xq < hi_n, D*U <= Bx + Aq < D*(U+W)
   275	            qlo = max(x + 1, -(-lo_n // x), -(-(g.D * U - g.B * x) // g.A))
   276	            qhi = min(2 * x, (hi_n - 1) // x, (g.D * (U + W) - g.B * x - 1) // g.A)
   277	            if qhi < qlo:
   278	                continue
   279	            if count_in_class(qlo, qhi, a, g.K) > 0:
   280	                cnt += 1
   281	    return cnt
   282	
   283	
   284	def bound_T2_core(g: GenT2, n: int) -> int:
   285	    """B2 = sum_keys |C^+(key)| * (floor((Delta/xmin)/K) + 2)."""
   286	    xmin, _, _ = class_var_range(n, "p")
   287	    per = (g.Delta // xmin + 1) // g.K + 1
   288	    return sum(cplus_T2(g, n, key) * per for key in set(g.R) & set(g.UW))
   289	
   290	
   291	def cplus_closed(g: GenT2, n: int, key) -> float:
   292	    P = 2.0 ** (n / 2)
   293	    U, W = g.UW[key]
   294	    I = g.D * W + 2 * g.A * g.Delta / P
   295	    return len(g.R[key]) * (2 * math.sqrt(2 * I * P / g.A) / g.M + 2)
   296	
   297	
   298	def bound_T2_closed(g: GenT2, n: int) -> float:
   299	    """CF2 = (3 * 2^n / P) * E_N[ |R| (2 sqrt(2 I P / A)/M + 2) ]."""
   300	    P = 2.0 ** (n / 2)
   301	    lo, hi = 1 << (n - 1), 1 << n
   302	    tot = 0.0
   303	    for key in set(g.R) & set(g.UW):
   304	        k, bb = key
   305	        a = lo + bb * g.Delta
   306	        bnd = min(a + g.Delta, hi)
   307	        w = n_count_in_class(a, bnd, k, g.K) / (hi - lo)
   308	        tot += w * cplus_closed(g, n, key)
   309	    return 3 * (2 ** n) / P * tot
   310	
   311	
   312	# --------------------------------------------------------------------------
   313	# designs
   314	# --------------------------------------------------------------------------
   315	
   316	def sqrt_mod_prime(a: int, l: int) -> Optional[int]:
   317	    a %= l
   318	    if a == 0:
   319	        return 0
   320	    if pow(a, (l - 1) // 2, l) != 1:
   321	        return None
   322	    # Tonelli-Shanks
   323	    qq, s = l - 1, 0
   324	    while qq % 2 == 0:
   325	        qq //= 2
   326	        s += 1
   327	    z = 2
   328	    while pow(z, (l - 1) // 2, l) != l - 1:
   329	        z += 1
   330	    m, c, t, r = s, pow(z, qq, l), pow(a, qq, l), pow(a, (qq + 1) // 2, l)
   331	    while t != 1:
   332	        i, t2 = 0, t
   333	        while t2 != 1:
   334	            t2 = t2 * t2 % l
   335	            i += 1
   336	        b = pow(c, 1 << (m - i - 1), l)
   337	        m, c, t, r = i, b * b % l, t * b * b % l, r * b % l
   338	    return r
   339	
   340	
   341	def dcl_generators(n: int, H: int, Y: int, K_sq: bool = False) -> List[GenT1]:
   342	    """DCL as T1 generators: (A,B) coprime <= H, A != B, primes l in (Y, 2Y],
   343	    R(kappa) = roots of B r^2 == A kappa (mod l), n-only whole-range window
   344	    (a superset of DCL-det's window).  K = l (or l^2 if K_sq)."""
   345	    lo, hi = 1 << (n - 1), 1 << n
   346	    xmin, xmax, _ = class_var_range(n, "p")
   347	    gens = []
   348	    for l in primes_upto(2 * Y):
   349	        l = int(l)
   350	        if l <= Y or l <= 2:
   351	            continue
   352	        for A in range(1, H + 1):
   353	            for B in range(1, H + 1):
   354	                if A == B or math.gcd(A, B) != 1 or l <= max(A, B):
   355	                    continue
   356	                K = l * l if K_sq else l
   357	                D = l * l
   358	                # n-only window: values floor((Bp+Aq)/l^2) over p in [xmin,xmax], q in (p,2p]
   359	                Fmin = 2 * math.isqrt(A * B * lo)        # AM-GM lower bound (floor)
   360	                Fmax = max(B * xmin + A * (2 * xmin + 2), B * xmax + A * (hi // xmax + 1),
   361	                           B * xmin + A * (hi // xmin + 1), B * xmax + A * (2 * xmax))
   362	                S = frozenset(range(Fmin // D - 1, Fmax // D + 2))
   363	                R, SS = {}, {}
   364	                for kap in range(K):
   365	                    if math.gcd(kap, K) != 1:
   366	                        continue
   367	                    r = sqrt_mod_prime(A * kap * pow(B, -1, l), l)
   368	                    if r is None or r == 0:
   369	                        continue
   370	                    R[kap] = frozenset({r, (l - r) % l})
   371	                    SS[kap] = S
   372	                gens.append(GenT1(A, B, l, K, D, "p", R, SS))
   373	    return gens

