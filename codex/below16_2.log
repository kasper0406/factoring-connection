    87	
    88	def count_in_class(lo: int, hi: int, r: int, m: int) -> int:
    89	    """#{x in [lo, hi] : x == r (mod m)}."""
    90	    if hi < lo:
    91	        return 0
    92	    return (hi - r) // m - (lo - 1 - r) // m
