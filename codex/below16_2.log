   104	@dataclass
   105	class GenT1:
   106	    A: int
   107	    B: int
   108	    M: int
   109	    K: int
   110	    D: int
   111	    side: str = "p"
   112	    R: Dict[int, FrozenSet[int]] = field(default_factory=dict)
   113	    S: Dict[int, FrozenSet[int]] = field(default_factory=dict)
