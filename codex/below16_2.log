+from src.below16 import avgbound as ab
+
+rng = random.Random(18102026)
+summary = {}
+total = 0
+worst = (0, None)
+for n in (12, 13, 14, 16):
+    p, q = ab.population(n)
+    P = 2 ** (n / 2)
+    for it in range(400):
+        M = rng.randrange(1, max(2, int(math.sqrt(P / 2))))
+        K = M * rng.randrange(1, M + 1)
+        D = rng.randrange(1, M*M + 1)
+        A, B = rng.choice([(0, -1), (0, 1), (1, 0), (-1, 0),
+                               (-3, 2), (2, -3), (1, 1), (3, 2)])
+        side = rng.choice(['p', 'q'])
+        x, y = (p, q) if side == 'p' else (q, p)
+        values = (B*x + A*y) // D
+        R, S = {}, {}
+        for k in range(K):
+            ids = ((p*q) % K == k).nonzero()[0].tolist()
+            if not ids or rng.random() < 0.5:
+                continue
+            selected = rng.sample(ids, min(len(ids), rng.choice([1, 2, 4, 8])))
+            R[k] = frozenset(int(x[j]) % M for j in selected)
+            S[k] = frozenset(int(values[j]) for j in selected)
+        g = ab.GenT1(A, B, M, K, D, side, R, S)
+        actual = ab.count_T1(g, p, q)
+        core = ab.bound_T1_core(g, n)
+        closed = ab.bound_T1_closed(g, n)
+        assert actual <= core <= closed + 1e-6, (n, g, actual, core, closed)
+        f = {k: len(R[k])*math.sqrt(len(S[k])) for k in R}
+        common = 5 * P**1.5 * float(ab.expect_over_N(n, K, f))
+        assert actual <= common + 1e-6
+        ratio = actual/common if common else 0
+        if ratio > worst[0]:
+            worst = (ratio, dict(n=n, A=A, B=B, M=M, K=K, D=D, side=side))
+        total += 1
