    43	def primes_upto(m: int) -> np.ndarray:
    44	    s = np.ones(m + 1, dtype=bool)
    45	    s[:2] = False
    46	    for i in range(2, math.isqrt(m) + 1):
    47	        if s[i]:
    48	            s[i * i::i] = False
    49	    return np.nonzero(s)[0].astype(np.int64)
