    52	def population(n: int) -> Tuple[np.ndarray, np.ndarray]:
    53	    """All (p, q) in S_n as int64 arrays (exhaustive; n <= 36 sensible)."""
    54	    lo, hi = 1 << (n - 1), 1 << n
    55	    pr = primes_upto(1 << ((n + 3) // 2))
    56	    ps, qs = [], []
    57	    for i, p in enumerate(pr):
    58	        p = int(p)
    59	        if p * p >= hi:
    60	            break
    61	        if 2 * p * p < lo:
    62	            continue
    63	        qlo = max(p + 1, -(-lo // p))
    64	        qhi = min(2 * p, (hi - 1) // p)
    65	        if qlo > qhi:
    66	            continue
    67	        a = np.searchsorted(pr, qlo, side="left")
    68	        b = np.searchsorted(pr, qhi, side="right")
    69	        qq = pr[a:b]
    70	        ps.append(np.full(len(qq), p, dtype=np.int64))
    71	        qs.append(qq)
    72	    return np.concatenate(ps), np.concatenate(qs)
