diff --git a/codex/scratch/below16_2/referee_checks.py b/codex/scratch/below16_2/referee_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..e84eb5e909b1ff0f151e07af5ed898111f56812a
--- /dev/null
+++ b/codex/scratch/below16_2/referee_checks.py
@@ -0,0 +1,79 @@
+import sys
+import math
+import random
+import json
+
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+from src.below16 import avgbound as ab
+
+rng = random.Random(18102026)
+summary = {}
+total = 0
+worst = (0, None)
+for n in (12, 13, 14, 16):
+    p, q = ab.population(n)
+    P = 2 ** (n / 2)
+    for it in range(400):
+        M = rng.randrange(1, max(2, int(math.sqrt(P / 2))))
+        K = M * rng.randrange(1, M + 1)
+        D = rng.randrange(1, M*M + 1)
+        A, B = rng.choice([(0, -1), (0, 1), (1, 0), (-1, 0),
+                               (-3, 2), (2, -3), (1, 1), (3, 2)])
+        side = rng.choice(['p', 'q'])
+        x, y = (p, q) if side == 'p' else (q, p)
+        values = (B*x + A*y) // D
+        R, S = {}, {}
+        for k in range(K):
+            ids = ((p*q) % K == k).nonzero()[0].tolist()
+            if not ids or rng.random() < 0.5:
+                continue
+            selected = rng.sample(ids, min(len(ids), rng.choice([1, 2, 4, 8])))
+            R[k] = frozenset(int(x[j]) % M for j in selected)
+            S[k] = frozenset(int(values[j]) for j in selected)
+        g = ab.GenT1(A, B, M, K, D, side, R, S)
+        actual = ab.count_T1(g, p, q)
+        core = ab.bound_T1_core(g, n)
+        closed = ab.bound_T1_closed(g, n)
+        assert actual <= core <= closed + 1e-6, (n, g, actual, core, closed)
+        f = {k: len(R[k])*math.sqrt(len(S[k])) for k in R}
+        common = 5 * P**1.5 * float(ab.expect_over_N(n, K, f))
+        assert actual <= common + 1e-6
+        ratio = actual/common if common else 0
+        if ratio > worst[0]:
+            worst = (ratio, dict(n=n, A=A, B=B, M=M, K=K, D=D, side=side))
+        total += 1
+summary['T1_adversarial_finite_checks'] = dict(cases=total, max_actual_over_common_bound=worst)
+
+n = 20
+p, q = ab.population(n)
+P = 2**(n/2)
+p0 = min(set(p.tolist()), key=lambda a: abs(a - 0.75*P))
+hits = int((p*p == p0*p0).sum())
+summary['CorF_missing_boundary'] = dict(n=n, p0=p0, integer_window=[p0*p0],
+                                        true_pair_hits=hits, P=P,
+                                        claimed_pair_scale_without_boundary=1,
+                                        correct_boundary_scale=P)
+
+P = 2**20
+N = P*P - 1
+A, B = 1, 2
+l = 101
+c = 0
+Lo = math.isqrt(4*A*B*N)
+a0 = math.isqrt(N//2)
+while 2*a0*a0 < N:
+    a0 += 1
+b0 = math.isqrt(N)
+Hi = max(-(-(B*x*x + A*N)//x) for x in (a0, b0))
+old_width = (Hi-c)//(l*l) - (-(-(Lo-c)//(l*l))) + 1
+global_lo = math.isqrt(4*A*B*(P*P//2))
+global_hi = 3*P
+new_width = global_hi//(l*l)+1 - (global_lo//(l*l)-1) + 1
+summary['DCL_window_enlargement'] = dict(A=A, B=B, ell=l, N=N,
+                                        original_width=old_width,
+                                        enlarged_width=new_width,
+                                        ratio=new_width/old_width)
+
+summary['A0_q_side_step5'] = dict(n=20, P=1024, M=360, K=360, r=7,
+    xs=[727,1087,1447], claimed_whole_class_bound=1024/360)
+print(json.dumps(summary, indent=2))

