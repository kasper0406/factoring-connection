     6	from __future__ import annotations
     7	
     8	import json
     9	import random
    10	import sys
    11	import time
    12	from math import gcd
    13	from multiprocessing import Pool
    14	from typing import Dict, List
    15	
    16	from ..nfsfruit.instances import composite
    17	from . import gf2
    18	from . import sampler as smp
    19	from .toynfs import ToyField, gen_functionals
    20	
    21	
    22	def peel_core(rows: List[int], ideal_mask: int) -> List[int]:
    23	    """Indices of rows surviving iterated removal of rows that contain an ideal column
    24	    (bit in ideal_mask) occurring (oddly) in exactly one remaining row (algebraic 2-core)."""
    25	    alive = set(range(len(rows)))
    26	    while True:
    27	        cnt: Dict[int, int] = {}
    28	        who: Dict[int, int] = {}
    29	        for i in alive:
    30	            v = rows[i] & ideal_mask
    31	            while v:
    32	                lb = v & -v
    33	                c = lb.bit_length() - 1
    34	                cnt[c] = cnt.get(c, 0) + 1
    35	                who[c] = i
    36	                v ^= lb
    37	        kill = {who[c] for c, k in cnt.items() if k == 1}
    38	        if not kill:
    39	            return sorted(alive)
    40	        alive -= kill
    41	
    42	
    43	def level_record(T: ToyField, rows: List[int], gen: List[int], vallee, structured, rng) -> Dict:
    44	    D = T.D_rat
    45	    E = gf2.Echelon(rows)
    46	    Wb = E.basis_below(D)
    47	    high = ((1 << T.ncols) - 1) ^ ((1 << D) - 1)
    48	    rankA = gf2.rank(r & high for r in rows)
    49	    dimW = len(Wb)
    50	    assert dimW == E.rank - rankA
    51	    gen_ok = gf2.all_annihilate(gen, Wb)
    52	    sign_ok = all(b & 1 == 0 for b in Wb)
    53	    forced = gen + [1]
    54	    forced_rank = gf2.rank(forced)
    55	    in_perp_forced = gf2.annihilated_dim(forced, Wb) if gf2.rank(forced) == len(forced) else None
    56	    dim_perp = D - dimW
    57	    resid = dim_perp - in_perp_forced if in_perp_forced is not None else None
    58	    occ = {p: 0 for p in T.ps}
    59	    for r in rows:
    60	        v = r & ((1 << D) - 2)
    61	        while v:
    62	            lb = v & -v
    63	            c = lb.bit_length() - 1
    64	            occ[T.ps[c - 1]] += 1
    65	            v ^= lb
    66	    n_occ = {k: sum(1 for p in T.ps if occ[p] == k) for k in range(4)}
    67	    ck = {}
    68	    for k in (1, 2, 3, 5):
    69	        Pk = [T.col[("r", p)] for p in T.ps if occ[p] >= k]
    70	        mask = gf2.mask_of(Pk)
    71	        lam = len(Pk) - gf2.restrict_rank(gen, mask)
    72	        ck[k] = lam - gf2.dim_in_coords(Wb, mask)
    73	    # peeling predictor: rational primes occurring in no row of the algebraic 2-core
    74	    ideal_mask = 0
    75	    for key, c in T.col.items():
    76	        if key[0] == "a":
    77	            ideal_mask |= 1 << c
    78	    core = peel_core(rows, ideal_mask)
    79	    core_rat = 0
    80	    for i in core:
    81	        core_rat |= rows[i]
    82	    n_peel = sum(1 for p in T.ps if not (core_rat >> T.col[("r", p)]) & 1)
    83	    const_real = []
    84	    for j in range(len(T.real)):
    85	        c = T.col[("rs", j)]
    86	        vals = {(r >> c) & 1 for r in rows}
    87	        const_real.append(vals.pop() if len(vals) == 1 else None)
    88	    rec = dict(const_real=const_real, M=len(rows), rankR=E.rank, rankA=rankA, dimW=dimW, dim_perp=dim_perp,
    89	               forced_rank=forced_rank, gen_in_perp=gen_ok, sign_in_perp=sign_ok,
    90	               resid=resid, n_occ=n_occ, ck=ck, n_peel=n_peel, core_rows=len(core))
    91	    if vallee is not None:
    92	        P3 = {T.col[("r", p)] for p in T.ps if occ[p] >= 3}
    93	        vres = []
    94	        WE = gf2.Echelon(Wb)
    95	        for (z, v) in vallee:
    96	            supp = {c for c in range(1, D) if (v >> c) & 1}
    97	            vres.append(dict(neg=z < 0, inP3=supp <= P3, inW=WE.contains(v)))
    98	        rec["vallee"] = vres
    99	    if structured:
   100	        def delta(phi):
   101	            return sum(gf2.dot(r, phi) for r in rows) / len(rows)
   102	        rat_primes = ((1 << D) - 2)
   103	        liou = rat_primes | ideal_mask
   104	        dense = [rng.getrandbits(T.ncols) for _ in range(10)]
   105	        sparse = [1 << T.col[("r", p)] for p in rng.sample(T.ps, 10)]
   106	        rec["delta"] = dict(liouville_joint=delta(liou), liouville_rat=delta(rat_primes),
   107	                            liouville_alg=delta(ideal_mask),
   108	                            dense=[delta(x) for x in dense], sparse=[delta(x) for x in sparse])
   109	    return rec
   110	
   111	
   112	def job(args) -> Dict:
   113	    cls, bits, seed, cfg = args
   114	    t0 = time.time()
   115	    N, fs = composite(cls, bits, seed)
   116	    p = cfg["params"][str(bits)]
   117	    T = ToyField(N, p["B"], cfg["nchar"], seed, cfg["H"])
   118	    target = int(max(cfg["levels"]) * T.ncols) + 1
   119	    rows, pairs, blast = T.sieve(p["A"], p["bmax"], target)
   120	    rng = random.Random(f"rkrank-e1|{cls}|{bits}|{seed}")
   121	    order = list(range(len(rows)))
   122	    rng.shuffle(order)
   123	    rows = [rows[i] for i in order]
   124	    gen = gen_functionals(T, fs)
   125	    # small squares (linearised cells), keep B-smooth ones; harness records gcd accidents
   126	    h = smp.h_two_thirds(N)
   127	    vallee, accidental = [], 0
   128	    for (x, z) in smp.small_squares(N, p["cells"], seed, h):
   129	        if gcd(x, N) != 1 or gcd(z, N) != 1:
   130	            accidental += 1
   131	            continue
   132	        v = T.rational_vector(z)
   133	        if v is not None:
   134	            vallee.append((z, v))
   135	    levels = []
   136	    for L in cfg["levels"]:
   137	        M = int(L * T.ncols)
   138	        if M > len(rows):
   139	            break
   140	        top = L == max(cfg["levels"])
   141	        levels.append(dict(level=L, **level_record(T, rows[:M], gen, vallee,
   142	                                                   structured=top, rng=rng)))
   143	    return dict(exp="rkrank_e1", cls=cls, bits=bits, seed=seed, N=N, omega=len(fs),
   144	                ncols=T.ncols, D_rat=T.D_rat, D_alg=T.D_alg, n_real=len(T.real),
   145	                nchar=len(T.chars), m=T.m, r=[T.r0, T.r1], nrel=len(rows), b_last=blast,
   146	                n_vallee=len(vallee), accidental_gcd=accidental, levels=levels,
   147	                secs=time.time() - t0)
   148	
   149	
   150	def main():
   151	    cfgp, outp = sys.argv[1], sys.argv[2]
   152	    workers = int(sys.argv[3]) if len(sys.argv) > 3 else 4
   153	    cfg = json.load(open(cfgp))
   154	    jobs = [(c, b, s, cfg) for c in cfg["classes"] for b in cfg["bits"] for s in cfg["seeds"]]
   155	    with Pool(workers) as pool, open(outp, "w") as out:
   156	        for rec in pool.imap_unordered(job, jobs):
   157	            out.write(json.dumps(rec) + "\n")
   158	            out.flush()
