   223	    def rational_vector(self, z: int) -> Optional[int]:
   224	        """Rational-block vector of a B-smooth integer z (sign included), else None."""
   225	        fz = self.fb.factor(z)
   226	        if fz is None:
   227	            return None
   228	        v = 1 if z < 0 else 0
   229	        for p, e in fz.items():
   230	            if e & 1:
   231	                v ^= 1 << self.col[("r", p)]
