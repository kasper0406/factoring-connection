    87	def below_root(a: int, b: int, f: List[int], iv: Tuple[Fraction, Fraction]) -> bool:
    88	    """Exact: is a/b < rho for the unique root rho of f in the isolating interval iv (b > 0)?"""
    89	    lo, hi = iv
    90	    q = Fraction(a, b)
    91	    if q <= lo:
    92	        return True
    93	    if q >= hi:
    94	        return False
    95	    fq = peval(f, q)
    96	    if fq == 0:
    97	        raise ValueError("rational root")
    98	    # f changes sign exactly once in (lo, hi): q > rho iff sign f(q) == sign f(hi)
    99	    return sign(fq) != sign(peval(f, hi))
