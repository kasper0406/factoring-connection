    22	def peel_core(rows: List[int], ideal_mask: int) -> List[int]:
    23	    """Indices of rows surviving iterated removal of rows that contain an ideal column
    24	    (bit in ideal_mask) occurring (oddly) in exactly one remaining row (algebraic 2-core)."""
    25	    alive = set(range(len(rows)))
    26	    while True:
    27	        cnt: Dict[int, int] = {}
    28	        who: Dict[int, int] = {}
    29	        for i in alive:
    30	            v = rows[i] & ideal_mask
    31	            while v:
    32	                lb = v & -v
    33	                c = lb.bit_length() - 1
    34	                cnt[c] = cnt.get(c, 0) + 1
    35	                who[c] = i
    36	                v ^= lb
    37	        kill = {who[c] for c, k in cnt.items() if k == 1}
    38	        if not kill:
    39	            return sorted(alive)
    40	        alive -= kill
    41	
    42	
    43	def level_record(T: ToyField, rows: List[int], gen: List[int], vallee, structured, rng) -> Dict:
    44	    D = T.D_rat
    45	    E = gf2.Echelon(rows)
    46	    Wb = E.basis_below(D)
    47	    high = ((1 << T.ncols) - 1) ^ ((1 << D) - 1)
    48	    rankA = gf2.rank(r & high for r in rows)
    49	    dimW = len(Wb)
    50	    assert dimW == E.rank - rankA
    51	    gen_ok = gf2.all_annihilate(gen, Wb)
    52	    sign_ok = all(b & 1 == 0 for b in Wb)
    53	    forced = gen + [1]
    54	    forced_rank = gf2.rank(forced)
    55	    in_perp_forced = gf2.annihilated_dim(forced, Wb) if gf2.rank(forced) == len(forced) else None
    56	    dim_perp = D - dimW
    57	    resid = dim_perp - in_perp_forced if in_perp_forced is not None else None
    58	    occ = {p: 0 for p in T.ps}
    59	    for r in rows:
    60	        v = r & ((1 << D) - 2)
    61	        while v:
    62	            lb = v & -v
    63	            c = lb.bit_length() - 1
    64	            occ[T.ps[c - 1]] += 1
    65	            v ^= lb
    66	    n_occ = {k: sum(1 for p in T.ps if occ[p] == k) for k in range(4)}
    67	    ck = {}
    68	    for k in (1, 2, 3, 5):
    69	        Pk = [T.col[("r", p)] for p in T.ps if occ[p] >= k]
    70	        mask = gf2.mask_of(Pk)
    71	        lam = len(Pk) - gf2.restrict_rank(gen, mask)
    72	        ck[k] = lam - gf2.dim_in_coords(Wb, mask)
