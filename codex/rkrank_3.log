   234	
   235	def gen_functionals(T: ToyField, factors: List[int]) -> List[int]:
   236	    """HARNESS ONLY (uses the factors): the omega quadratic-character functionals on the
   237	    rational block, w_i(p) = [(p/p_i) = -1], w_i(sign) = [(-1/p_i) = -1]."""
   238	    out = []
   239	    for pi in factors:
   240	        w = 1 if gmpy2.legendre(pi - 1, pi) == -1 else 0
   241	        for p in T.ps:
   242	            if gmpy2.legendre(p, pi) == -1:
   243	                w |= 1 << T.col[("r", p)]
   244	        out.append(w)
