   112	def job(args) -> Dict:
   113	    cls, bits, seed, cfg = args
   114	    t0 = time.time()
   115	    N, fs = composite(cls, bits, seed)
   116	    p = cfg["params"][str(bits)]
   117	    T = ToyField(N, p["B"], cfg["nchar"], seed, cfg["H"])
   118	    target = int(max(cfg["levels"]) * T.ncols) + 1
   119	    rows, pairs, blast = T.sieve(p["A"], p["bmax"], target)
   120	    rng = random.Random(f"rkrank-e1|{cls}|{bits}|{seed}")
   121	    order = list(range(len(rows)))
   122	    rng.shuffle(order)
   123	    rows = [rows[i] for i in order]
   124	    gen = gen_functionals(T, fs)
   125	    # small squares (linearised cells), keep B-smooth ones; harness records gcd accidents
   126	    h = smp.h_two_thirds(N)
   127	    vallee, accidental = [], 0
   128	    for (x, z) in smp.small_squares(N, p["cells"], seed, h):
   129	        if gcd(x, N) != 1 or gcd(z, N) != 1:
   130	            accidental += 1
   131	            continue
   132	        v = T.rational_vector(z)
   133	        if v is not None:
   134	            vallee.append((z, v))
   135	    levels = []
   136	    for L in cfg["levels"]:
   137	        M = int(L * T.ncols)
   138	        if M > len(rows):
   139	            break
   140	        top = L == max(cfg["levels"])
   141	        levels.append(dict(level=L, **level_record(T, rows[:M], gen, vallee,
   142	                                                   structured=top, rng=rng)))
   143	    return dict(exp="rkrank_e1", cls=cls, bits=bits, seed=seed, N=N, omega=len(fs),
   144	                ncols=T.ncols, D_rat=T.D_rat, D_alg=T.D_alg, n_real=len(T.real),
   145	                nchar=len(T.chars), m=T.m, r=[T.r0, T.r1], nrel=len(rows), b_last=blast,
   146	                n_vallee=len(vallee), accidental_gcd=accidental, levels=levels,
   147	                secs=time.time() - t0)
   148	
