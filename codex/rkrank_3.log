    51	def real_root_intervals(f: List[int]) -> List[Tuple[Fraction, Fraction]]:
    52	    """Isolating intervals (lo, hi), f(lo) f(hi) < 0, one simple real root each (f squarefree,
    53	    degree 3).  Exact: Cauchy bound, then bisection on the critical-point partition."""
    54	    lead = f[-1]
    55	    Cb = 1 + max(abs(Fraction(c, lead)) for c in f[:-1])
    56	    # critical points of a cubic: roots of f' (quadratic); isolate them by bisection on sign
    57	    # of f' between -Cb and Cb, then split [-Cb, Cb] at points where f is monotone.
    58	    df = deriv(f)
    59	    pts = [-Cb, Cb]
    60	    # f' quadratic: real roots exist iff disc >= 0
    61	    A2, B2, C2 = df[2], df[1], df[0]
    62	    disc = B2 * B2 - 4 * A2 * C2
    63	    if disc > 0:
    64	        # bracket each critical point to width <= 2^-60 * Cb using exact bisection on f'
    65	        vertex = Fraction(-B2, 2 * A2)
    66	        for lo, hi in ((-Cb, vertex), (vertex, Cb)):
    67	            if sign(peval(df, lo)) * sign(peval(df, hi)) < 0:
    68	                for _ in range(200):
    69	                    mid = (lo + hi) / 2
    70	                    if sign(peval(df, mid)) == sign(peval(df, lo)):
    71	                        lo = mid
    72	                    else:
    73	                        hi = mid
    74	                pts.append(lo)
    75	                pts.append(hi)
    76	    pts = sorted(set(pts))
    77	    out = []
    78	    for lo, hi in zip(pts, pts[1:]):
    79	        flo, fhi = peval(f, lo), peval(f, hi)
    80	        if flo == 0 or fhi == 0:
    81	            raise ValueError("rational root at a breakpoint")
    82	        if sign(flo) * sign(fhi) < 0:
    83	            out.append((lo, hi))
    84	    return out
