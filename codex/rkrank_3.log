   150	def main():
   151	    cfgp, outp = sys.argv[1], sys.argv[2]
   152	    workers = int(sys.argv[3]) if len(sys.argv) > 3 else 4
   153	    cfg = json.load(open(cfgp))
   154	    jobs = [(c, b, s, cfg) for c in cfg["classes"] for b in cfg["bits"] for s in cfg["seeds"]]
