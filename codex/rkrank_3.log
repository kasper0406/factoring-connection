   207	
   208	    def sieve(self, A: int, bmax: int, target: int):
   209	        """Sweep b = 1.. bmax, |a| <= A; stop once `target` relations are found."""
   210	        rows, pairs = [], []
   211	        for b in range(1, bmax + 1):
   212	            for a in range(-A, A + 1):
   213	                if gcd(a, b) != 1:
   214	                    continue
   215	                r = self.row_of(a, b)
   216	                if r is not None:
   217	                    rows.append(r)
