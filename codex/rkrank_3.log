     1	"""OPERATIONAL linearised-cell small-square generator (Vallée-type; NOT Vallée's full algorithm).
     2	
     3	A cell is x1 + t, |t| <= T.  Since (x1 + t)^2 = x1^2 + 2 x1 t + t^2, the points with
     4	s := (x1^2 + 2 x1 t) mod N (centred) in [-h/2, h/2] and t^2 <= h/4 have |(x1+t)^2 mod N| <= 3h/4.
     5	They are the points of an affine lattice of determinant N in a T x h box, found exactly by
     6	Gauss reduction and enumeration.  No Farey treatment of skewed cells, no quasi-uniformity claim:
     7	this only produces small squares (|z| <= h, h ~ 4 N^{2/3}) for the RK membership tests.
     8	"""
     9	from __future__ import annotations
    10	
    11	import random
    12	from math import isqrt
    13	from typing import List, Tuple
    14	
    15	import gmpy2
    16	
    17	
    18	def _gauss(u, v, K):
    19	    """Lagrange-Gauss reduction for the norm (K t)^2 + s^2 on integer vectors (t, s)."""
    20	    def n2(w):
    21	        return (K * w[0]) ** 2 + w[1] ** 2
    22	
    23	    def ip(w, z):
    24	        return K * K * w[0] * z[0] + w[1] * z[1]
    25	    if n2(u) > n2(v):
    26	        u, v = v, u
    27	    while True:
    28	        nu = n2(u)
    29	        mu = (2 * ip(u, v) + nu) // (2 * nu)          # round(ip/nu)
    30	        v = (v[0] - mu * u[0], v[1] - mu * u[1])
    31	        if n2(v) >= nu:
    32	            return u, v
    33	        u, v = v, u
    34	
    35	
    36	def cell_points(N: int, x1: int, T: int, H: int) -> List[int]:
    37	    """All t, |t| <= T, with s = (x1^2 + 2 x1 t) mod N centred and |s| <= H (exact)."""
    38	    c0 = x1 * x1 % N
    39	    K = max(1, H // max(T, 1))
    40	    e1, e2 = _gauss((1, 2 * x1 % N), (0, N), K)
    41	    D = e1[0] * e2[1] - e1[1] * e2[0]                # +-N
    42	    # affine target: points (t, s) = (0, c0) + i e1 + j e2 + k (0, N) collapse into the lattice;
    43	    # move the shift close to the origin by Babai rounding (exact).
    44	    p0 = (0, c0)
    45	    # coordinates of -p0: solve i e1 + j e2 = -p0
    46	    ni = (-p0[0] * e2[1] + p0[1] * e2[0])
    47	    nj = (-e1[0] * p0[1] + e1[1] * p0[0])
    48	    i0 = (2 * ni + D) // (2 * D) if D > 0 else -((2 * ni - D) // (2 * D))
    49	    j0 = (2 * nj + D) // (2 * D) if D > 0 else -((2 * nj - D) // (2 * D))
    50	    q = (p0[0] + i0 * e1[0] + j0 * e2[0], p0[1] + i0 * e1[1] + j0 * e2[1])
    51	    # enumerate: points q + i e1 + j e2 with |t| <= T, |s| <= H.  Brute bound on i, j via
    52	    # |coordinate| <= (box radius + |q|) * |other vector| / |D| in the K-weighted norm.
    53	    Rt, Rs = T + abs(q[0]), H + abs(q[1])
    54	    def bound(w):
    55	        return (Rt * abs(w[1]) + Rs * abs(w[0])) // abs(D) + 2
    56	    Ji, Jj = bound(e2), bound(e1)
    57	    if (2 * Ji + 1) * (2 * Jj + 1) > 200000:
    58	        return []                                  # skewed cell: skipped (disclosed)
    59	    out = []
    60	    for j in range(-Jj, Jj + 1):
    61	        bt, bs = q[0] + j * e2[0], q[1] + j * e2[1]
    62	        lo, hi = -Ji, Ji
    63	        for i in range(lo, hi + 1):
    64	            t, s = bt + i * e1[0], bs + i * e1[1]
    65	            if abs(t) <= T and abs(s) <= H:
    66	                out.append(t)
    67	    return out
    68	
    69	
    70	def small_squares(N: int, n_cells: int, seed, h: int) -> List[Tuple[int, int]]:
    71	    """Return (x, z) with z = x^2 mod N centred, |z| <= h, one random point per productive cell."""
    72	    rng = random.Random(f"rkrank-sampler|{N}|{seed}")
    73	    T = isqrt(h) // 2
    74	    H = h // 2
    75	    out = []
    76	    for _ in range(n_cells):
    77	        x1 = rng.randrange(1, N)
    78	        ts = cell_points(N, x1, T, H)
    79	        if not ts:
    80	            continue
    81	        t = rng.choice(ts)
    82	        x = (x1 + t) % N
    83	        z = x * x % N
    84	        if z > N // 2:
    85	            z -= N
    86	        assert abs(z) <= h
    87	        out.append((x, z))
    88	    return out
    89	
    90	
    91	def h_two_thirds(N: int) -> int:
    92	    return 4 * int(gmpy2.iroot(gmpy2.mpz(N) ** 2, 3)[0])
import random
from fractions import Fraction
from itertools import product
from math import gcd, isqrt

from src.rkrank import gf2, sampler as smp
from src.rkrank.harness import peel_core
from src.rkrank.toynfs import ToyField, gen_functionals, real_root_intervals, below_root, peval
from src.nfsfruit.instances import composite


def _span(vecs):
    s = {0}
    for v in vecs:
        s |= {x ^ v for x in s}
    return s


def test_echelon_basis_below_bruteforce():
    rng = random.Random(1)
    for _ in range(40):
        n, k, t = 9, rng.randrange(1, 8), rng.randrange(1, 9)
        vecs = [rng.getrandbits(n) for _ in range(k)]
        E = gf2.Echelon(vecs)
        S = _span(vecs)
        assert E.rank == len(S).bit_length() - 1
        low = {x for x in S if x < (1 << t)}
        assert _span(E.basis_below(t)) == low


def test_dim_in_coords_and_annihilated_dim():
    rng = random.Random(2)
    for _ in range(40):
        n = 8
        vecs = [rng.getrandbits(n) for _ in range(rng.randrange(1, 7))]
        B = gf2.Echelon(vecs).basis()
        mask = rng.getrandbits(n)
        S = _span(B)
        assert 2 ** gf2.dim_in_coords(B, mask) == sum(1 for x in S if x & ~mask == 0)
        funcs = gf2.Echelon([rng.getrandbits(n) for _ in range(4)]).basis()
        ann = [x for x in _span(funcs) if all(gf2.dot(x, b) == 0 for b in B)]
        assert 2 ** gf2.annihilated_dim(funcs, B) == len(ann)


def test_real_root_isolation_and_sign():
    rng = random.Random(3)
    f = [-7, 3, -2, 1]          # x^3 - 2x^2 + 3x - 7
    ivs = real_root_intervals(f)
    for lo, hi in ivs:
        assert peval(f, lo) * peval(f, hi) < 0
    for _ in range(200):
        a, b = rng.randrange(-60, 61), rng.randrange(1, 30)
        for lo, hi in ivs:
            # exact reference: bisect to width < 1/(10^6 b)
            L, H = lo, hi
            while H - L > Fraction(1, 10 ** 6 * b):
                M = (L + H) / 2
                if (peval(f, M) > 0) == (peval(f, H) > 0):
                    H = M
                else:
                    L = M
            q = Fraction(a, b)
            if q < L or q > H:
                assert below_root(a, b, f, (lo, hi)) == (q < L)


def _small_field():
    N, fs = composite("blum", 44, 5)
    return N, fs, ToyField(N, 1500, 12, 0)


def test_rows_parities_and_W_in_lambda_half():
    N, fs, T = _small_field()
    rows, pairs, _ = T.sieve(3000, 600, int(2.0 * T.ncols))
    assert len(rows) > T.ncols
    for r, (a, b) in zip(rows[:50], pairs[:50]):
        t = a - b * T.m
        ft = T.fb.factor(t)
        for p in T.ps:
            assert (r >> T.col[("r", p)]) & 1 == ft.get(p, 0) & 1
        assert r & 1 == (t < 0)
    E = gf2.Echelon(rows)
    Wb = E.basis_below(T.D_rat)
    gen = gen_functionals(T, fs)
    assert gf2.all_annihilate(gen, Wb)            # W ⊆ Λ/2 (harness check)
    high = ((1 << T.ncols) - 1) ^ ((1 << T.D_rat) - 1)
    assert len(Wb) == E.rank - gf2.rank(r & high for r in rows)


def test_peel_core_rows_not_in_any_dependency():
    rng = random.Random(4)
    for _ in range(30):
        n, k = 7, 9
        rows = [rng.getrandbits(n) for _ in range(k)]
        core = set(peel_core(rows, (1 << n) - 1))
        for S in product([0, 1], repeat=k):
            if any(S):
                acc = 0
                for i, s in enumerate(S):
                    if s:
                        acc ^= rows[i]
                if acc == 0:
                    assert {i for i, s in enumerate(S) if s} <= core


def test_cell_points_complete_and_sampler_valid():
    N = 10007 * 10009
    rng = random.Random(5)
    h = smp.h_two_thirds(N)
    T, H = isqrt(h) // 2, h // 2
    for _ in range(20):
        x1 = rng.randrange(1, N)
        got = sorted(smp.cell_points(N, x1, T, H))
        ref = []
        for t in range(-T, T + 1):
            s = (x1 * x1 + 2 * x1 * t) % N
            if s > N // 2:
                s -= N
            if abs(s) <= H:
                ref.append(t)
        if got:                                   # skewed cells may be skipped (returns [])
            assert got == ref
    for x, z in smp.small_squares(N, 200, 1, h):
        assert (x * x - z) % N == 0 and abs(z) <= h
