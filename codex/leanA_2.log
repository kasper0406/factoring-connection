/-- If `X ≥ 2^k` then `j ≥ 1`, `(2Y)^k ≤ X < (4Y)^k`. -/
lemma Yj_spec (P : Params) (hk : 1 ≤ P.k) (N : ℕ) (hX : 2 ^ P.k ≤ Params.Xsp N) :
    1 ≤ P.jJ N ∧ (2 * P.Yj N) ^ P.k ≤ Params.Xsp N ∧ Params.Xsp N < (4 * P.Yj N) ^ P.k := by
