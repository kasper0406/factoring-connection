+#check FactoringA.ev_Xr
+#check FactoringA.ev_XF
+#check FactoringA.ev_Yj
+#check FactoringA.ev_Bsm
+#check Nat.exists_prime_and_dvd
+#check Nat.exists_prime_lt_and_le_two_mul
+
+set_option pp.all true in
+#print FactoringA.CEP
+set_option pp.all true in
+#print FactoringA.BrunTitchmarsh
+set_option pp.all true in
+#print FactoringA.RosserSchoenfeld
