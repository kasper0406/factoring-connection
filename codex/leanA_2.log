@@ -0,0 +1,86 @@
+import LeanA
+
+set_option autoImplicit false
+noncomputable section
+open Classical Real Finset Filter FactoringA
+namespace SecondRoundRangeAudit
+
+lemma loglog16_pos : 0 < Real.log (Real.log 16) := by
+  apply Real.log_pos
+  apply (Real.lt_log_iff_exp_lt (by norm_num : (0 : ℝ) < 16)).2
+  exact Real.exp_one_lt_three.trans (by norm_num)
+
+/-- Large u in the repaired CEP range forces x beyond any prescribed large-x threshold.
+This is the uniformity point needed to import the published asymptotic corollary. -/
+theorem repaired_range_forces_x_large (ε X x u : ℝ) (hε : 0 < ε) (hX : 16 ≤ X)
+    (hx : 16 ≤ x) (hU : Real.log X / Real.log (Real.log 16) + 1 ≤ u)
+    (hrange : u ≤ (1 - ε) * Real.log x / Real.log (Real.log x)) : X < x := by
+  have hx0 : 0 < x := by linarith
+  have hX0 : 0 < X := by linarith
+  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
+  have hlX : 0 ≤ Real.log X := Real.log_nonneg (by linarith)
+  have hc := loglog16_pos
+  have hllx : Real.log (Real.log 16) ≤ Real.log (Real.log x) := by
+    apply Real.log_le_log (Real.log_pos (by norm_num : (1 : ℝ) < 16))
+    exact Real.log_le_log (by norm_num) hx
+  have hllx0 : 0 < Real.log (Real.log x) := hc.trans_le hllx
+  have hU0 : 0 < u := by
+    have : 0 ≤ Real.log X / Real.log (Real.log 16) := div_nonneg hlX hc.le
+    linarith
+  by_contra hn
+  have hxX : x ≤ X := le_of_not_gt hn
+  have hlxX : Real.log x ≤ Real.log X := Real.log_le_log hx0 hxX
+  have hr := (le_div_iff₀ hllx0).mp hrange
+  have hu : u * Real.log (Real.log 16) ≤ Real.log X := by
+    nlinarith [mul_nonneg hU0.le (sub_nonneg.mpr hllx)]
+  have hU' : Real.log X + Real.log (Real.log 16) ≤ u * Real.log (Real.log 16) := by
+    have h := (mul_le_mul_of_nonneg_right hU hc.le)
+    rw [add_mul, div_mul_cancel₀ _ hc.ne'] at h
+    simpa using h
+  linarith
+
+theorem repaired_range_excludes_nonpositive_u (ε x u : ℝ) (hε : 1 ≤ ε) (hx : 16 ≤ x)
+    (hu : 3 ≤ u) : ¬ u ≤ (1 - ε) * Real.log x / Real.log (Real.log x) := by
+  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
+  have hllx : 0 < Real.log (Real.log x) := loglog16_pos.trans_le
+    (Real.log_le_log (Real.log_pos (by norm_num : (1 : ℝ) < 16))
+      (Real.log_le_log (by norm_num) hx))
+  have hnonpos : (1 - ε) * Real.log x / Real.log (Real.log x) ≤ 0 :=
+    div_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg (by linarith) hlx.le) hllx.le
+  linarith
+
+/-- The former first-round counterexample has x<1 and cannot meet the repaired guard. -/
+theorem old_CEP_family_excluded (u : ℝ) :
+    ¬ 16 ≤ Real.exp (-Real.exp (-(1 / (4 * u)))) := by
+  have hx : Real.exp (-Real.exp (-(1 / (4 * u)))) < 1 :=
+    Real.exp_lt_one_iff.mpr (neg_neg_of_pos (Real.exp_pos _))
+  linarith
+
+/-- BT's complete denominator is strictly positive on every permitted input. -/
+theorem BT_denominator_pos (y : ℝ) (q : ℕ) (hq : 1 ≤ q) (hyq : (q : ℝ) < y) :
+    0 < (Nat.totient q : ℝ) * Real.log (y / q) := by
+  have hq0 : (0 : ℝ) < q := by exact_mod_cast (by omega : 0 < q)
+  have ht : (0 : ℝ) < Nat.totient q := by exact_mod_cast Nat.totient_pos.mpr (by omega : 0 < q)
+  exact mul_pos ht (Real.log_pos ((one_lt_div hq0).mpr hyq))
+
+-- Checks specifically for hidden natural divisions/subtractions in the new material.
+example (z y : ℝ) (q a : ℕ) : Eerr z y q a =
+    (PsiAP z y q a : ℝ) - (PsiCop z y q : ℝ) / (q.totient : ℝ) := rfl
+example (z y : ℝ) (ℓ s t r : ℕ) :
+    Eerr z y t r - Eerr z y s r / ((ℓ : ℝ) - 1) =
+      Eerr z y t r - Eerr z y s r / ((ℓ : ℝ) - 1) := rfl
+example (m : ℕ) : 2 ∣ (m + 1) * (m + 2) := Nat.two_dvd_mul_add_one (m + 1)
+
+#print axioms repaired_range_forces_x_large
+#print axioms repaired_range_excludes_nonpositive_u
+#print axioms old_CEP_family_excluded
+#print axioms BT_denominator_pos
+#print axioms FactoringA.orthogonality_E1
+#print axioms FactoringA.abs_Eerr_le_DeltaAll
+#print axioms FactoringA.lift_averaging_E2_eq
+#print axioms FactoringA.lift_averaging_E2
+#print axioms FactoringA.restart_series
+#print axioms FactoringA.muOpt_mem
+#print axioms FactoringA.d9_k_ge_13
+#print axioms FactoringA.cRA_vs_cA
+end SecondRoundRangeAudit
