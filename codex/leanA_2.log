+import LeanA
+
+set_option autoImplicit false
+noncomputable section
+open Classical Real Finset Filter FactoringA
+namespace SecondRoundCostAudit
+
+def oneModelA (P : Params) : CostModelA P where
+  factorCost := fun _ => 1
+  splitCost := fun _ => 1
+  pTrial := fun _ => 1
+  rej := fun _ => ∅
+  Ctrial := fun _ => 1
+  Tpost := fun _ => 1
+  Mrows := fun _ => 1
+  Tshape := fun _ => 1
+  Tsq := fun _ => 1
+  TLP := fun _ => 1
+
+def oneModelRA (P : Params) : CostModelRA P where
+  Fsup := fun _ => 1
+  tau := fun _ => 1
+  nonO := fun _ => 1
+  pTrial := fun _ => 1
+  rej := fun _ => ∅
+  Mrows := fun _ => 1
+  Tsq := fun _ => 1
+  Tpost := fun _ => 1
+
+lemma log_ge_one {x : ℝ} (hx : Real.exp 1 ≤ x) : 1 ≤ Real.log x := by
+  exact (Real.le_log_iff_exp_le ((Real.exp_pos 1).trans_le hx)).2 hx
+
+lemma avg_descent_le_one (P : Params) (a : ℝ) (N : ℕ) :
+    FactoringA.expect (P.fields N) (fun A => if A ∈ (∅ : Finset P.Field) then 0 else P.descentProb a N A) ≤ 1 := by
+  simp only [Finset.mem_empty, ↓reduceIte]
+  unfold FactoringA.expect
+  apply div_le_one_of_le₀ _ (by positivity)
+  calc
+    ∑ A ∈ P.fields N, P.descentProb a N A ≤ ∑ _A ∈ P.fields N, (1 : ℝ) := by
+      exact Finset.sum_le_sum (fun A _ => prob_le_one' _ _)
+    _ = (P.fields N).card := by simp
+
+lemma sq_search_bound (P : Params) (a : ℝ) (N : ℕ) (hlog : 1 ≤ Real.log N) :
+    1 ≤ (Real.log N) ^ (4 : ℝ) *
+      ((Params.Bsm a N : ℝ) + (P.Ssz a N : ℝ) ^ 2 * Real.log N) := by
+  have hS : 1 ≤ P.Ssz a N := by
+    unfold Params.Ssz Params.Lv LN
+    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.exp_pos _) _)
+  have hSr : (1 : ℝ) ≤ P.Ssz a N := by exact_mod_cast hS
+  have hS2 : (1 : ℝ) ≤ (P.Ssz a N : ℝ) ^ 2 := by nlinarith
+  have hpow : 1 ≤ (Real.log N) ^ (4 : ℝ) := Real.one_le_rpow hlog (by norm_num)
+  have hB : (0 : ℝ) ≤ Params.Bsm a N := Nat.cast_nonneg _
+  have hprod : 1 ≤ (P.Ssz a N : ℝ) ^ 2 * Real.log N := one_le_mul_of_one_le_of_one_le hS2 hlog
+  exact one_le_mul_of_one_le_of_one_le hpow (by linarith)
+
+lemma rejection_rhs_nonneg (P : Params) (N : ℕ) :
+    0 ≤ Real.exp (-(Real.log (P.Hb N) / (13 * P.d * Real.log (Real.log (P.Hb N))))) +
+      2 / (2 * (P.Hb N : ℝ) + 1) + 1 / (P.Wb N : ℝ) := by positivity
+
+theorem oneModelA_interface (P : Params) (a : ℝ) : CostInterfaceA P a (oneModelA P) := by
+  refine ⟨⟨4, Real.exp 1, by norm_num, ?_, ?_, ?_⟩⟩
+  · intro N hN _hsplit
+    have hl := log_ge_one hN
+    have hp : 1 ≤ (Real.log N) ^ (4 : ℝ) := Real.one_le_rpow hl (by norm_num)
+    have hk : (0 : ℝ) ≤ P.k := Nat.cast_nonneg _
+    have hpi : (0 : ℝ) ≤ Nat.primeCounting (Params.Bsm a N) := Nat.cast_nonneg _
+    have hd : (0 : ℝ) ≤ (P.d : ℝ) + 1 := by positivity
+    dsimp [oneModelA]
+    refine ⟨avg_descent_le_one P a N, by simp, ?_, by norm_num, by norm_num, ?_, by norm_num, ?_, ?_, sq_search_bound P a N hl, by norm_num⟩
+    · simpa [prob] using rejection_rhs_nonneg P N
+    · nlinarith [mul_nonneg hd hpi]
+    · nlinarith
+    · nlinarith
+  · intro ε _hε
+    refine ⟨Real.exp 1, ?_⟩
+    intro N hN _hsplit
+    have hp : 1 ≤ (Real.log N) ^ (4 : ℝ) := Real.one_le_rpow (log_ge_one hN) (by norm_num)
+    have hb : 0 ≤ (Params.Bsm a N : ℝ) ^ (1 + ε) := Real.rpow_nonneg (Nat.cast_nonneg _) _
+    dsimp [oneModelA]
+    nlinarith
+  · intro N hN
+    have hs : 0 ≤ supSplit (fun _ => (1 : ℝ)) a (Real.exp 1) N :=
+      mt_supSplit_nonneg _ _ _ _ (by intros; norm_num)
+    have hl : 0 ≤ Real.logb 2 (N : ℝ) := by
+      unfold Real.logb
+      exact div_nonneg (Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ N))) (Real.log_pos (by norm_num)).le
+    have hn : 0 ≤ 4 * (Params.Bsm a N : ℝ) * (Real.log N) ^ (4 : ℝ) := by positivity
+    dsimp [oneModelA]
+    nlinarith [mul_nonneg (by linarith : 0 ≤ Real.logb 2 (N : ℝ) + 1) (by linarith :
+      0 ≤ 4 * (Params.Bsm a N : ℝ) * (Real.log N) ^ (4 : ℝ) + 2 * supSplit (fun _ => (1 : ℝ)) a (Real.exp 1) N)]
+
+theorem oneModelA_LP (P : Params) : LenstraPomerance (oneModelA P).TLP := by
+  intro ε hε
+  exact Filter.Eventually.of_forall (fun N => by
+    dsimp [oneModelA, LN]
+    exact Real.one_le_exp (mul_nonneg (by linarith) (Lam_half_nonneg _)))
+
+theorem oneModelRA_interface (P : Params) (a : ℝ) : CostInterfaceRA P a (oneModelRA P) := by
+  refine ⟨⟨4, Real.exp 1, by norm_num, ?_, ?_, ?_, ?_, ?_⟩⟩
+  · intro N hN _hsplit
+    have hl := log_ge_one hN
+    have hp : 1 ≤ (Real.log N) ^ (4 : ℝ) := Real.one_le_rpow hl (by norm_num)
+    have hk : (0 : ℝ) ≤ P.k := Nat.cast_nonneg _
+    have hpi : (0 : ℝ) ≤ Nat.primeCounting (Params.Bsm a N) := Nat.cast_nonneg _
+    have hd : (0 : ℝ) ≤ (P.d : ℝ) + 1 := by positivity
+    dsimp [oneModelRA]
+    refine ⟨avg_descent_le_one P a N, by simp, ?_, by norm_num, ?_, sq_search_bound P a N hl, by norm_num, by norm_num, by norm_num, by norm_num, ?_⟩
+    · simpa [prob] using rejection_rhs_nonneg P N
+    · nlinarith [mul_nonneg hd hpi]
+    · nlinarith
+  · intro ε _hε
+    refine ⟨Real.exp 1, ?_⟩
+    intro N hN _hsplit
+    have hp : 1 ≤ (Real.log N) ^ (4 : ℝ) := Real.one_le_rpow (log_ge_one hN) (by norm_num)
+    have hb : 0 ≤ (Params.Bsm a N : ℝ) ^ (1 + ε) := Real.rpow_nonneg (Nat.cast_nonneg _) _
+    dsimp [oneModelRA]
+    nlinarith
+  · intros; norm_num [oneModelRA]
+  · intro x hx y hy hxy
+    exact le_rfl
+  · intro x hx
+    have hlog := log_ge_one hx
+    have hl2 : Real.log 2 ≤ 1 := by
+      have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
+      linarith
+    have hl : 1 ≤ Real.logb 2 x := by
+      unfold Real.logb
+      apply (le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).2
+      linarith
+    have hs : 0 ≤ supSplit (fun _ => (1 : ℝ)) a (Real.exp 1) x :=
+      mt_supSplit_nonneg _ _ _ _ (by intros; norm_num)
+    have hn : 0 ≤ 4 * (Params.Bsm a ⌊x⌋₊ : ℝ) * (Real.log x) ^ (4 : ℝ) := by positivity
+    dsimp [oneModelRA]
+    nlinarith [mul_nonneg (by linarith : 0 ≤ Real.logb 2 x - 1)
+      (by linarith : 0 ≤ 4 + 4 * (Params.Bsm a ⌊x⌋₊ : ℝ) * (Real.log x) ^ (4 : ℝ) +
+        2 * supSplit (fun _ => (1 : ℝ)) a (Real.exp 1) x +
+        2 * (2 * supSplit (fun _ => (1 : ℝ)) a (Real.exp 1) x) * 1)]
+
+#print axioms oneModelA_interface
+#print axioms oneModelA_LP
+#print axioms oneModelRA_interface
+end SecondRoundCostAudit
