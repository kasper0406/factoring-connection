+set_option pp.all true in
+#check @FactoringA.CostInterfaceRA.bounds
+set_option pp.all true in
+#check @FactoringA.theoremDL_assembly
+set_option pp.all true in
+#check @FactoringA.restart_series
+set_option pp.all true in
