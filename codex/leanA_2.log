index 0000000000000000000000000000000000000000..6edc7663254a8ba38659c01349afe221d05abf4a
--- /dev/null
+++ b/codex/scratch/leanA_2/analytic_scan.py
@@ -0,0 +1,46 @@
+"""Finite counterexample search; numerical evidence only, not a proof."""
+from math import gcd, log, nextafter, inf
+
+limit = 2_000_002
+sieve = bytearray(b"\x01") * (limit + 1)
+sieve[0:2] = b"\x00\x00"
+for p in range(2, int(limit**0.5) + 1):
+    if sieve[p]:
+        sieve[p*p::p] = b"\x00" * ((limit-p*p)//p + 1)
+pi = [0] * (limit + 1)
+for n in range(1, limit + 1):
+    pi[n] = pi[n-1] + sieve[n]
+
+rs_upper_cases = 0
+rs_lower_cases = 0
+for n in range(2, 1_000_001):
+    assert pi[n] < 1.25506*n/log(n), ("RS-upper", n)
+    rs_upper_cases += 1
+for j in range(41, 2_000_001):
+    # Check both sides of every possible jump of pi(2z)-pi(z).
+    for z in (j/2, nextafter((j+1)/2, -inf)):
+        assert 3*z/(5*log(z)) < pi[int(2*z)]-pi[int(z)], ("RS-lower", z)
+        rs_lower_cases += 1
+
+bt_cases = 0
+primes = [n for n in range(2, 601) if sieve[n]]
+for q in range(1, 31):
+    residues = [a for a in range(q) if gcd(a, q) == 1]
+    phi = len(residues)
+    tables = {}
+    for a in residues:
+        acc = [0] * 601
+        for n in range(1, 601):
+            acc[n] = acc[n-1] + (sieve[n] and n % q == a)
+        tables[a] = acc
+    for x2 in range(1, 601):
+        x = x2/2
+        for y2 in range(2*q+1, 401):
+            y = y2/2
+            count = max(tables[a][int(x+y)] - tables[a][int(x)] for a in residues)
+            assert count < 2*y/(phi*log(y/q)), ("BT", x, y, q, count)
+            bt_cases += 1
+
+print(f"RS upper: {rs_upper_cases:,} real-endpoint intervals checked; no counterexample.")
+print(f"RS lower: {rs_lower_cases:,} jump-endpoint checks; no counterexample.")
+print(f"BT: {bt_cases:,} (x,y,q) checks, maximizing over reduced residues; no counterexample.")

