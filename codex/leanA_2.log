diff --git a/codex/scratch/leanA_2/SplitInputAudit.lean b/codex/scratch/leanA_2/SplitInputAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..a525a6211891c25cf019cab068bdee0f76810606
--- /dev/null
+++ b/codex/scratch/leanA_2/SplitInputAudit.lean
@@ -0,0 +1,59 @@
+import LeanA
+
+set_option autoImplicit false
+noncomputable section
+open Classical Real Finset Filter FactoringA
+namespace SecondRoundSplitInputAudit
+
+/-- The guarded moment/interface input domain is unbounded, for every fixed a>0.
+The witnesses are products of two distinct primes in one Bertrand interval. -/
+theorem split_inputs_unbounded (a : ℝ) (ha : 0 < a) (K : ℕ) :
+    ∃ N : ℕ, K ≤ N ∧ Params.SplitInput a N := by
+  have hev : ∀ᶠ N : ℕ in atTop,
+      2 ≤ Params.Bsm a N ∧ 3 * Real.log (Params.Bsm a N) ≤ Real.log N := by
+    filter_upwards [ev_Bsm ha, ev_Lam_le (1 / (3 * a)) (by positivity)] with N hB hL
+    refine ⟨hB.1, ?_⟩
+    have hmul := mul_le_mul_of_nonneg_left hL (by positivity : 0 ≤ 3 * a)
+    have heq : (3 * a) * (1 / (3 * a) * Real.log (N : ℝ)) = Real.log N := by field_simp
+    rw [heq] at hmul
+    nlinarith [hB.2.2]
+  obtain ⟨N₀, hN₀⟩ := Filter.eventually_atTop.mp hev
+  obtain ⟨p, hpbig, hp⟩ := Nat.exists_infinite_primes (max (max N₀ K) 3)
+  have hp3 : 3 ≤ p := (le_max_right _ _).trans hpbig
+  obtain ⟨q, hq, hpq, hq2p⟩ := Nat.exists_prime_lt_and_le_two_mul p (by omega)
+  have hpN : p ≤ p * q := by nlinarith [hq.two_le]
+  have hNK : K ≤ p * q := (le_max_right N₀ K).trans ((le_max_left _ _).trans hpbig) |>.trans hpN
+  have hNN₀ : N₀ ≤ p * q := (le_max_left N₀ K).trans ((le_max_left _ _).trans hpbig) |>.trans hpN
+  obtain ⟨hB2, hB⟩ := hN₀ (p * q) hNN₀
+  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
+  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq.pos
+  have hBp : Params.Bsm a (p * q) < p := by
+    have hq2p' : (q : ℝ) ≤ 2 * p := by exact_mod_cast hq2p
+    have hp2 : (2 : ℝ) < p := by exact_mod_cast (by omega : 2 < p)
+    have hlogqp : Real.log (q : ℝ) < 2 * Real.log p := by
+      have hlogq : Real.log (q : ℝ) ≤ Real.log ((2 : ℝ) * p) := Real.log_le_log hq0 hq2p'
+      rw [Real.log_mul (by norm_num) hp0.ne'] at hlogq
+      have hlog2p : Real.log 2 < Real.log (p : ℝ) := Real.log_lt_log (by norm_num) hp2
+      linarith
+    have hlogN : Real.log (p * q : ℕ) < 3 * Real.log p := by
+      rw [Nat.cast_mul, Real.log_mul hp0.ne' hq0.ne']
+      linarith
+    have hlogBp : Real.log (Params.Bsm a (p * q)) < Real.log p := by linarith
+    have hB0 : (0 : ℝ) < Params.Bsm a (p * q) := by exact_mod_cast (by omega : 0 < Params.Bsm a (p * q))
+    exact_mod_cast (Real.log_lt_log_iff hB0 hp0).mp hlogBp
+  refine ⟨p * q, hNK, ?_, (hp.odd_of_ne_two (by omega)).mul (hq.odd_of_ne_two (by omega)), ?_, ?_⟩
+  · nlinarith [hp.two_le, hq.two_le]
+  · intro r hr hrdvd
+    rcases hr.dvd_mul.mp hrdvd with hrp | hrq
+    · have : r = p := (Nat.prime_dvd_prime_iff_eq hr hp).mp hrp
+      simpa [this] using hBp
+    · have : r = q := (Nat.prime_dvd_prime_iff_eq hr hq).mp hrq
+      simpa [this] using hBp.trans hpq
+  · intro hpp
+    obtain ⟨r, hr, huniq⟩ := isPrimePow_iff_unique_prime_dvd.mp hpp
+    have hpr : p = r := huniq p ⟨hp, dvd_mul_right p q⟩
+    have hqr : q = r := huniq q ⟨hq, dvd_mul_left q p⟩
+    omega
+
+#print axioms split_inputs_unbounded
+end SecondRoundSplitInputAudit

