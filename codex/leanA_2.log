/- Read-only statement audit: the two definitions below are copied from Challenge.lean. -/
noncomputable section
open Classical Real Finset
namespace StatementAudit

def Psi (x y : ℝ) : ℕ :=
  ((Icc 1 ⌊x⌋₊).filter (fun n => ∀ p : ℕ, p.Prime → p ∣ n → (p : ℝ) ≤ y)).card

def CEP : Prop :=
  ∀ ε > 0, ∀ δ > 0, ∃ U₀ : ℝ, ∀ x u : ℝ, U₀ ≤ u → u ≤ (1 - ε) * Real.log x / Real.log (Real.log x) →
    x * u ^ (-(u * (1 + δ))) ≤ (Psi x (x ^ (1 / u)) : ℝ) ∧
      (Psi x (x ^ (1 / u)) : ℝ) ≤ x * u ^ (-(u * (1 - δ)))

/-- The transcribed hypothesis is false even with ε=δ=1/2 and positive x. -/
theorem not_CEP : ¬ CEP := by
  intro h
  obtain ⟨U, hU⟩ := h (1/2) (by norm_num) (1/2) (by norm_num)
  let u : ℝ := max U 1
  have huU : U ≤ u := le_max_left _ _
  have hu1 : 1 ≤ u := le_max_right _ _
  have hu : 0 < u := by linarith
  let t : ℝ := 1 / (4 * u)
  have ht : 0 < t := by dsimp [t]; positivity
  have htu : t * (4 * u) = 1 := by dsimp [t]; field_simp
  have ht1 : t ≤ 1/4 := by nlinarith
  have hexp : (1/2 : ℝ) ≤ exp (-t) := by
    have := Real.add_one_le_exp (-t)
    linarith
  let x : ℝ := exp (-exp (-t))
  have hx : 0 < x := Real.exp_pos _
  have hx1 : x < 1 := by
    dsimp [x]
    exact Real.exp_lt_one_iff.mpr (neg_neg_of_pos (Real.exp_pos _))
  have hlog : Real.log x = -exp (-t) := Real.log_exp _
  have hloglog : Real.log (Real.log x) = -t := by
    rw [hlog, Real.log_neg_eq_log, Real.log_exp]
  have hrange : u ≤ (1 - (1/2 : ℝ)) * Real.log x / Real.log (Real.log x) := by
    rw [hloglog, hlog]
    have heq : (1 - (1/2 : ℝ)) * -exp (-t) / -t = exp (-t) / (2 * t) := by ring
    rw [heq]
    apply (le_div_iff₀ (by positivity : 0 < 2*t)).mpr
    nlinarith
  have hzero : Psi x (x ^ (1/u)) = 0 := by
    have hf : ⌊x⌋₊ = 0 := Nat.floor_eq_zero.mpr hx1
    simp [Psi, hf]
  have hlower := (hU x u huU hrange).1
  rw [hzero, Nat.cast_zero] at hlower
  have hpositive : 0 < x * u ^ (-(u * (1 + (1/2 : ℝ)))) := by positivity
  linarith

#print axioms not_CEP
end StatementAudit

