index 0000000000000000000000000000000000000000..1bd9223d4f163dc27207f94b26c3cdd0edf918a2
--- /dev/null
+++ b/codex/scratch/leanA_2/NonvacuityAudit.lean
@@ -0,0 +1,109 @@
+import LeanA
+
+set_option autoImplicit false
+noncomputable section
+open Classical Real Finset Filter FactoringA
+namespace SecondRoundAudit
+
+theorem psi_pos {x : ℝ} (y : ℝ) (hx : 1 ≤ x) : 0 < Psi x y := by
+  apply Finset.card_pos.mpr
+  refine ⟨1, Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨le_rfl, Nat.le_floor (by simpa using hx)⟩, ?_⟩⟩
+  intro p hp hd
+  exact False.elim (hp.ne_one (Nat.dvd_one.mp hd))
+
+theorem rho_pos {x : ℝ} (y : ℝ) (hx : 1 ≤ x) : 0 < rho x y := by
+  unfold rho
+  exact div_pos (by exact_mod_cast psi_pos y hx) (by linarith)
+
+theorem primesIoc_nonempty (W : ℕ) (hW : 1 ≤ W) : (primesIoc W (2 * W)).Nonempty := by
+  obtain ⟨p, hp, hpW, hp2W⟩ := Nat.exists_prime_lt_and_le_two_mul W (by omega)
+  exact ⟨p, by simp [primesIoc, hp, hpW, hp2W]⟩
+
+theorem cube_nonempty (d H : ℕ) : (cube d H).Nonempty := by
+  refine ⟨fun _ => 0, ?_⟩
+  simp [cube]
+
+theorem gSet_nonempty (P : Params) (N : ℕ) (hm : 1 ≤ P.Mb N) : (P.gSet N).Nonempty := by
+  by_cases h1 : P.Mb N = 1
+  · refine ⟨(1, 1), ?_⟩
+    simp [Params.gSet, h1]
+  · have hm2 : (2 : ℤ) ≤ P.Mb N := by exact_mod_cast (by omega : 2 ≤ P.Mb N)
+    refine ⟨((P.Mb N : ℤ), (P.Mb N : ℤ) - 1), ?_⟩
+    have hcop : IsCoprime (P.Mb N : ℤ) ((P.Mb N : ℤ) - 1) := by
+      refine ⟨1, -1, ?_⟩
+      ring
+    have hgcd : Int.gcd (P.Mb N : ℤ) ((P.Mb N : ℤ) - 1) = 1 :=
+      Int.isCoprime_iff_gcd_eq_one.mp hcop
+    simp only [Params.gSet, Finset.mem_filter, Finset.mem_product, Finset.mem_Icc]
+    exact ⟨⟨⟨by omega, by omega⟩, ⟨by omega, by omega⟩⟩, hgcd⟩
+
+theorem fields_nonempty (P : Params) (hP : P.Admissible) (N : ℕ) (hN : 1 ≤ N) :
+    (P.fields N).Nonempty := by
+  obtain ⟨hν, -, -, hμ, -, -, -, -⟩ := Params.adm_real hP
+  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
+  have hm : 1 ≤ P.Mb N := Nat.le_floor (by simpa using Real.one_le_rpow hN' hμ.le)
+  have hw : 1 ≤ P.Wb N := by
+    unfold Params.Wb
+    have he : (0 : ℝ) < ((P.μ + P.ν + P.η₀ / 2 : ℚ) : ℝ) := by
+      push_cast
+      have hη : (0 : ℝ) < P.η₀ := by exact_mod_cast hP.2.2.2.1
+      positivity
+    exact_mod_cast (Real.one_le_rpow hN' he.le).trans (Nat.le_ceil _)
+  exact (gSet_nonempty P N hm).product ((primesIoc_nonempty _ hw).product (cube_nonempty _ _))
+
+theorem Jset_nonempty (P : Params) (N : ℕ) : (P.Jset N).Nonempty := by
+  exact primesIoc_nonempty _ Nat.one_le_two_pow
+
+theorem firstMoment_positive_rhs (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a) :
+    ∀ᶠ N : ℕ in atTop, ∀ C : ℝ,
+      0 < (P.Ssz a N : ℝ) ^ 2 * P.rhoR a N * P.rhoF a N / (Real.log N) ^ C := by
+  obtain ⟨hν, -, hμν, hμ, hh, hθ, -, hd⟩ := Params.adm_real hP
+  filter_upwards [ev_Xr hP ha, ev_XF hP ha, ev_log_ge 1] with N hr hF hlog C
+  have hln : 0 < Real.log (N : ℝ) := by linarith
+  have hr1 : 1 ≤ P.Xr a N := by
+    have hl : 0 ≤ Real.log (P.Xr a N) := le_trans (by positivity) hr.2.1
+    exact (Real.log_nonneg_iff hr.1).mp hl
+  have hF1 : 1 ≤ P.XF a N := by
+    have hl : 0 ≤ Real.log (P.XF a N) := le_trans (by positivity) hF.2.1
+    exact (Real.log_nonneg_iff hF.1).mp hl
+  have hS := (Ssz_bounds P ha hθ.le N).1
+  have hrhoR : 0 < P.rhoR a N := rho_pos _ hr1
+  have hrhoF : 0 < P.rhoF a N := rho_pos _ hF1
+  exact div_pos (mul_pos (mul_pos (by nlinarith) hrhoR) hrhoF) (Real.rpow_pos_of_pos hln C)
+
+/-- FM cannot hold with identically zero counts on all sufficiently large split inputs. -/
+theorem FM_forces_positive_expectation (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a)
+    (hFM : FirstMoment P a) :
+    ∀ᶠ N : ℕ in atTop, Params.SplitInput a N →
+      0 < FactoringA.expect (P.fields N ×ˢ P.Jset N) (fun x => (P.countN a N x.1 x.2 : ℝ)) := by
+  obtain ⟨C, N₀, h⟩ := hFM
+  filter_upwards [firstMoment_positive_rhs P hP a ha, ev_nat_ge N₀] with N hp hN hsplit
+  exact (hp C).trans_le (h N hN hsplit)
+
+theorem FM_forces_some_relation (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a)
+    (hFM : FirstMoment P a) :
+    ∀ᶠ N : ℕ in atTop, Params.SplitInput a N →
+      ∃ A ∈ P.fields N, ∃ ℓ ∈ P.Jset N, 0 < P.countN a N A ℓ := by
+  filter_upwards [FM_forces_positive_expectation P hP a ha hFM] with N h hsplit
+  have hp := h hsplit
+  by_contra hn
+  push Not at hn
+  have he : FactoringA.expect (P.fields N ×ˢ P.Jset N)
+      (fun x => (P.countN a N x.1 x.2 : ℝ)) = 0 := by
+    unfold FactoringA.expect
+    have hs : ∑ x ∈ P.fields N ×ˢ P.Jset N, (P.countN a N x.1 x.2 : ℝ) = 0 := by
+      apply Finset.sum_eq_zero
+      intro x hx
+      have hx' := Finset.mem_product.mp hx
+      have hz := hn x.1 hx'.1 x.2 hx'.2
+      simp only [Nat.cast_eq_zero]
+      omega
+    rw [hs, zero_div]
+  linarith
+
+#print axioms fields_nonempty
+#print axioms Jset_nonempty
+#print axioms firstMoment_positive_rhs
+#print axioms FM_forces_positive_expectation
+#print axioms FM_forces_some_relation
+end SecondRoundAudit
