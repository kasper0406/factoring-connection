+example : Nat.primeCounting 2 = 1 := by decide
+example : Nat.primeCounting 3 = 2 := by decide
+example : Nat.log 1 100 = 0 := by decide
+example : Nat.log 4 15 = 1 := by decide
+example (x : ℝ) : Real.log (-x) = Real.log x := Real.log_neg_eq_log x
