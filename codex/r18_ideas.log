index 0000000000000000000000000000000000000000..1659b2fd3a18453b510c5c28e6e42a6521ec1db4
--- /dev/null
+++ b/codex/scratch/r18_ideas/norm_box_check.py
@@ -0,0 +1,110 @@
+"""Exact diagnostic for the norm-box proposal; no asymptotic timing claim.
+
+Frozen design before first run: enumerate a=32..160 and b=1..3; keep prime
+a*a+b*b with b <= p**.12. Pair with the next prime q>p, and separately seek
+two such norm primes in one real-coordinate baby block. Operational search
+gets only N,A,B. Check every promised input and exercise gcd=N recovery.
+"""
+from math import gcd, isqrt
+from sympy import isprime, nextprime
+import json
+
+
+def cmul(z, w, n):
+    return ((z[0]*w[0]-z[1]*w[1]) % n,
+            (z[0]*w[1]+z[1]*w[0]) % n)
+
+
+def norm(z, n):
+    return (z[0]*z[0]+z[1]*z[1]) % n
+
+
+def poly(k, n):
+    f = [1]
+    for j in range(k):
+        h = [0]*(len(f)+1)
+        for i, c in enumerate(f):
+            h[i] = (h[i]+j*c) % n
+            h[i+1] = (h[i+1]+c) % n
+        f = h
+    return f
+
+
+def evaluate(f, z, n):
+    r = (0, 0)
+    for c in reversed(f):
+        r = cmul(r, z, n)
+        r = ((r[0]+c) % n, r[1])
+    return r
+
+
+def search(n, amax, bmax):
+    """Slow exact realization of the fast multipoint-search specification."""
+    k = min(amax+1, isqrt((amax+1)*bmax)+1)
+    f = poly(k, n)
+    full = 0
+    for b in range(1, bmax+1):
+        for v in range((amax+k)//k):
+            z = (k*v, b)
+            value = evaluate(f, z, n)
+            direct = (1, 0)
+            for j in range(k):
+                direct = cmul(direct, (k*v+j, b), n)
+            assert value == direct
+            d = gcd(norm(value, n), n)
+            if d == n:
+                full += 1
+                # A product-tree descent gives the same leaf with O(k) total
+                # work. This simple diagnostic scans the k leaves instead.
+                for j in range(k):
+                    leaf = (k*v+j)**2+b*b
+                    assert 0 < leaf < n
+                    d = gcd(leaf, n)
+                    if 1 < d < n:
+                        return d, full
+                raise AssertionError("full gcd without a proper leaf")
+            if 1 < d < n:
+                return d, full
+    return None, full
+
+
+def main():
+    cases = []
+    for a in range(32, 161):
+        for b in range(1, 4):
+            p = a*a+b*b
+            if isprime(p) and b <= p**.12:
+                q = int(nextprime(p))
+                cases.append((p*q, a, b))
+    full_count = 0
+    for n, a, b in cases:
+        amax = isqrt(isqrt(n))+2
+        bmax = max(b, 2)  # public promised box, not a supplied representation
+        d, full = search(n, amax, bmax)
+        assert d and n % d == 0 and 1 < d < n
+        full_count += full
+    special = 0
+    for a in range(32, 161):
+        p = a*a+1
+        if not isprime(p):
+            continue
+        for a2 in range(a+1, min(a+12, 162)):
+            q = a2*a2+1
+            if not isprime(q):
+                continue
+            n = p*q
+            amax = isqrt(isqrt(n))+2
+            k = min(amax+1, isqrt(2*(amax+1))+1)
+            if a//k == a2//k and a2 <= amax:
+                d, full = search(n, amax, 2)
+                assert d and n % d == 0
+                full_count += full
+                special += 1
+    print(json.dumps({"norm_cases": len(cases),
+                      "forced_same_block_cases": special,
+                      "full_gcd_recoveries": full_count,
+                      "failures": 0}))
+
+
+if __name__ == "__main__":
+    main()

