+from math import ceil, gcd, isqrt
+from sympy import isprime, nextprime
+import json
+
+
+def cmul(z, w, n):
+    return ((z[0]*w[0]-z[1]*w[1]) % n,
+            (z[0]*w[1]+z[1]*w[0]) % n)
+
+
+def norm(z, n):
+    return (z[0]*z[0]+z[1]*z[1]) % n
+
+
+def poly(k, n):
+    f = [1]
+    for j in range(k):
+        h = [0]*(len(f)+1)
+        for i, c in enumerate(f):
+            h[i] = (h[i]+j*c) % n
+            h[i+1] = (h[i+1]+c) % n
+        f = h
+    return f
+
+
+def evaluate(f, z, n):
+    r = (0, 0)
+    for c in reversed(f):
+        r = cmul(r, z, n)
+        r = ((r[0]+c) % n, r[1])
+    return r
+
+
+def search(n, amax, bmax):
+    """Slow exact realization of the fast multipoint-search specification."""
+    k = min(amax+1, isqrt((amax+1)*bmax)+1)
+    f = poly(k, n)
+    full = 0
+    for b in range(1, bmax+1):
+        for v in range((amax+k)//k):
+            z = (k*v, b)
+            value = evaluate(f, z, n)
+            direct = (1, 0)
+            for j in range(k):
+                direct = cmul(direct, (k*v+j, b), n)
+            assert value == direct
+            d = gcd(norm(value, n), n)
+            if d == n:
+                full += 1
+                # A product-tree descent gives the same leaf with O(k) total
+                # work. This simple diagnostic scans the k leaves instead.
+                for j in range(k):
+                    leaf = (k*v+j)**2+b*b
+                    assert 0 < leaf < n
+                    d = gcd(leaf, n)
+                    if 1 < d < n:
+                        return d, full
+                raise AssertionError("full gcd without a proper leaf")
+            if 1 < d < n:
+                return d, full
+    return None, full
+
+
