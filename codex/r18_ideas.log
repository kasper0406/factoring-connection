+        bmax = ceil(n**.06)  # public promised box derived only from N
+        d, full = search(n, amax, bmax)
+        assert d and n % d == 0 and 1 < d < n
+        full_count += full
+    special = 0
+    for a in range(32, 161):
+        p = a*a+1
+        if not isprime(p):
+            continue
+        for a2 in range(a+1, min(a+12, 162)):
+            q = a2*a2+1
+            if not isprime(q):
+                continue
+            n = p*q
+            amax = isqrt(isqrt(n))+2
+            k = min(amax+1, isqrt(2*(amax+1))+1)
+            if a//k == a2//k and a2 <= amax:
+                d, full = search(n, amax, 2)
+                assert d and n % d == 0
+                full_count += full
+                special += 1
+    print(json.dumps({"norm_cases": len(cases),
+                      "forced_same_block_cases": special,
+                      "full_gcd_recoveries": full_count,
