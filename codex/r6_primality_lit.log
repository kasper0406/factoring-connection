from math import gcd
from fractions import Fraction as F
P=[n for n in range(3,100,2) if all(n%d for d in range(2,int(n**.5)+1))]
def val(n):
 t=0
 while n%2==0: t+=1;n//=2
 return t
pairs=0
for z,p in enumerate(P):
 for q in P[z+1:]:
  N=p*q; t=val(N-1);d=(N-1)>>t;u=val(p-1);v=val(q-1); k=min(t,u,v)
  cp=F(gcd(d,p-1),(p-1)>>u);cq=F(gcd(d,q-1),(q-1)>>v)
  sp=F(gcd(N-1,p-1),p-1);sq=F(gcd(N-1,q-1),q-1)
  L=cp*cq*F(4**k+2,3*2**(u+v))
  counts=[0,0,0,0]
  for a in range(1,N):
   if gcd(a,N)>1:continue
   xs=[pow(a,(1<<i)*d,N) for i in range(t+1)]
   passed=xs[0]==1 or N-1 in xs[:-1]
   split=any(1<gcd(x+sgn,N)<N for x in xs[:-1] for sgn in [-1,1]) or 1<gcd(xs[-1]-1,N)<N
   root=any(xs[i+1]==1 and xs[i] not in [1,N-1] for i in range(t))
   cert=any(xs[i]==N-1 for i in range(1,t))
   counts=[c+int(b) for c,b in zip(counts,[passed,split,root,cert])]
  expected=[L,sp+sq-sp*sq-L,sp*sq-L,cp*cq*F(4**k-4,3*2**(u+v))]
  assert [F(c,(p-1)*(q-1)) for c in counts]==expected,(p,q,counts,expected)
  pairs+=1
print('Verified exact MR pass, augmented gcd split, nontrivial-root split, and sqrt(-1) certificate formulas for',pairs,'prime pairs below 100, all unit bases.')
