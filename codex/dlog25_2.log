   189	# --- 2^{2/5} bracket and the cost constant -------------------------------------------------------------------
   190	def two_pow_2_5_bracket(den: int = 10 ** 6) -> Tuple[Fr, Fr]:
   191	    """Rationals lo < 2^{2/5} < hi with hi - lo = 1/den, decided exactly via x^5 vs 4."""
   192	    lo_n = 1319507 * den // 10 ** 6
   193	    while Fr(lo_n + 1, den) ** 5 < 4:
   194	        lo_n += 1
   195	    while Fr(lo_n, den) ** 5 > 4:
   196	        lo_n -= 1
   197	    return Fr(lo_n, den), Fr(lo_n + 1, den)
   198	
   199	
   200	def recursion_factor_bracket() -> Tuple[Fr, Fr]:
   201	    """Bracket for 1/(1 - 2^{-2/5}) = t/(t - 1), t = 2^{2/5} (decreasing in t)."""
   202	    lo_t, hi_t = two_pow_2_5_bracket()
   203	    return hi_t / (hi_t - 1), lo_t / (lo_t - 1)
   204	
   205	
   206	def cost_constant(a: Fr, d0: Fr, kappa: Fr, C_gamma: Fr) -> Tuple[Fr, Fr]:
   207	    """Exact bracket [lo, hi] for c = max(2a, a + s + max(a, sigma), (a + s)/(1 - 2^{-2/5})), s = 2 kappa (1 + C_gamma)."""
   208	    a, kappa, C_gamma = Fr(a), Fr(kappa), Fr(C_gamma)
   209	    sg = sigma(a, d0, kappa)
   210	    s = 2 * kappa * (1 + C_gamma)
   211	    flo, fhi = recursion_factor_bracket()
   212	    p = max(2 * a, a + s + max(a, sg))
   213	    return max(p, (a + s) * flo), max(p, (a + s) * fhi)
   214	
