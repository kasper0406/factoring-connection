    27	theta0 = up.theta0
    28	sigma = up.sigma
    29	
    30	
    31	def two_pow_minus_2_5_bracket() -> Tuple[Fr, Fr]:
    32	    """Rationals lo < 2^{-2/5} < hi (from the exact bracket of 2^{2/5})."""
    33	    lo_t, hi_t = up.two_pow_2_5_bracket()
    34	    return 1 / hi_t, 1 / lo_t
    35	
    36	
    37	def s_of(kappa, C_gamma) -> Fr:
    38	    return 2 * Fr(kappa) * (1 + Fr(C_gamma))
    39	
    40	
    41	def terms(a, d0, kappa, C_gamma, c_sub: Tuple[Fr, Fr]) -> Dict[str, Tuple[Fr, Fr]]:
    42	    """Exact brackets of the three terms of (6.1); c_sub is a bracket (lo, hi) of the subroutine constant."""
    43	    a, d0, kappa = Fr(a), Fr(d0), Fr(kappa)
    44	    s = s_of(kappa, C_gamma)
    45	    sg = sigma(a, d0, kappa)
    46	    m_lo, m_hi = two_pow_minus_2_5_bracket()
    47	    la = (3 * a, 3 * a)
    48	    sq = (a + s + max(a, sg),) * 2
    49	    sh = (a + s + m_lo * c_sub[0], a + s + m_hi * c_sub[1])
    50	    return {"LA_3a": la, "specialq": sq, "shape": sh}
    51	
    52	
    53	def c_dl(a, d0, kappa, C_gamma, c_sub: Tuple[Fr, Fr]) -> Tuple[Fr, Fr]:
    54	    t = terms(a, d0, kappa, C_gamma, c_sub)
    55	    return max(v[0] for v in t.values()), max(v[1] for v in t.values())
    56	
    57	
    58	def binding(a, d0, kappa, C_gamma, c_sub) -> str:
    59	    t = terms(a, d0, kappa, C_gamma, c_sub)
    60	    return max(t, key=lambda k: t[k][1])
    61	
    62	
    63	def c_u(a, d0, kappa, C_gamma) -> Tuple[Fr, Fr]:
    64	    return up.cost_constant(a, d0, kappa, C_gamma)
    65	
    66	
    67	def default_grids():
    68	    grid_a = [Fr(i, 20) for i in range(1, 41)]
    69	    grid_kappa = [Fr(1, 2 ** j) for j in range(0, 12)] + [Fr(i, 200) for i in range(1, 41)]
    70	    return grid_a, grid_kappa
    71	
    72	
    73	def _d0_cands(kappa):
    74	    out = set()
    75	    for num in range(1, 400):
