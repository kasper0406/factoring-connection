    50	def run_case(p: int, k: int, Glo: int, Ghi: int, Y: int):
    51	    assert isprime(p) and 2 * Y * Y < p
    52	    G = list(primerange(Glo + 1, Ghi + 1))
    53	    S = build_S(G, k, Y)
    54	    Sset = set(S)
    55	    Pprime = sum(1 for u in S for v in S if gcd(u, v) == 1)
    56	    hits = 0
    57	    t0 = time.time()
    58	    for T in range(1, p):
    59	        u, v = gauss_reduce(p, T)
    60	        if v < 0 or (v == 0 and u < 0):
    61	            u, v = -u, -v
    62	        if u in Sset and v in Sset and gcd(u, v) == 1:
    63	            hits += 1
    64	    lb_hyp = len(S) >= comb(len(G), k) / (2 * k)
    65	    rec = {"p": p, "k": k, "G": [Glo, Ghi], "absG": len(G), "Y": Y, "absS": len(S), "Pprime": Pprime,
    66	           "hits": hits, "identity_ok": hits == Pprime,
    67	           "Sbig_hyp": lb_hyp, "G_ge_4k3": len(G) >= 4 * k ** 3,
    68	           "Pprime_ge_bound": Pprime >= len(S) ** 2 * (1 - 2 * k ** 3 / len(G)) if G else True,
    69	           "pr_ratio": (hits / (p - 1)) / (len(S) ** 2 / (2 * (p - 1))) if S else None,
    70	           "secs": round(time.time() - t0, 2)}
    71	    return rec
    72	
