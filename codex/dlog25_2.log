    67	def default_grids():
     1	"""Exact asymptotic bookkeeping for Theorem U (rigorous L[2/5]; notes/lv5unif_results.md §§1, 10).
     2	
     3	Every log-size is an `AExp`: a finite sum  sum_j c_j (log N)^{p_j} (log log N)^{q_j}  with Fraction
     4	coefficients and exponents.  A quantity X "beats" Y (X/Y -> infinity) iff the leading term of
     5	log X - log Y has positive coefficient, leading = lexicographically largest (p, q).  This is exactly how
     6	the margins are compared in the notes (every margin there is a ratio exp(c (log N)^p (loglog N)^q)).
     7	
     8	Parameters (D := log N / log log N, Lambda := Lambda_{2/5} = (log N)^{2/5} (log log N)^{3/5} = D^{2/5} log log N):
     9	  d   ~ d0 * D^{1/5}   (odd),        k ~ kappa * D^{2/5},      nu = 1/(4k),
    10	  B   = exp(a Lambda),               eta0 = D^{-1/2},
    11	  theta * D^{1/5} -> theta0(d0, kappa) = 3/d0           if kappa >= d0^2/4   (level+window floors bind)
    12	                                       = 2/d0 + d0/(4 kappa) otherwise     (Kern+window floors bind)
    13	  log(1/(rho_r rho_F)) = sigma Lambda (1 + o(1)),  sigma = 2 theta0 / (5 a)        [CEP, u ~ D^{2/5}]
    14	  S^2 = (log N)^{C3} / (rho_r rho_F)  (Lemma CS)  =>  log S^2 = sigma Lambda (1 + o(1)).
    15	Split acceptance per attempt >= (gamma/(16 log N))^{2k+1}/(128 k^2), gamma >= (log N)^{-C_gamma}
    16	  => log(1/p) = 2 kappa (1 + C_gamma) Lambda (1 + o(1)).
    17	Cost (Prop select-U + Lemma F_alpha):  c = max( 2a,  a + s + max(a, sigma),  (a + s)/(1 - 2^{-2/5}) ),
    18	  s := 2 kappa (1 + C_gamma).
    19	No floating point is used for any decision; 2^{2/5} is bracketed by exact rationals.
    20	"""
    21	from __future__ import annotations
    22	
    23	from fractions import Fraction as Fr
    24	from typing import Dict, List, Tuple
    25	
    26	Key = Tuple[Fr, Fr]
    27	
    28	
    29	class AExp:
    30	    """sum c (log N)^p (loglog N)^q, exact."""
    31	
    32	    def __init__(self, terms: Dict[Key, Fr] | None = None):
    33	        self.t: Dict[Key, Fr] = {}
    34	        for k, v in (terms or {}).items():
    35	            if v != 0:
    36	                self.t[(Fr(k[0]), Fr(k[1]))] = self.t.get((Fr(k[0]), Fr(k[1])), Fr(0)) + Fr(v)
    37	        self.t = {k: v for k, v in self.t.items() if v != 0}
    38	
    39	    @staticmethod
    40	    def mono(c, p, q) -> "AExp":
    41	        return AExp({(Fr(p), Fr(q)): Fr(c)})
    42	
    43	    def __add__(self, o: "AExp") -> "AExp":
    44	        r = dict(self.t)
    45	        for k, v in o.t.items():
    46	            r[k] = r.get(k, Fr(0)) + v
    47	        return AExp(r)
    48	
    49	    def __neg__(self) -> "AExp":
    50	        return AExp({k: -v for k, v in self.t.items()})
    51	
    52	    def __sub__(self, o: "AExp") -> "AExp":
    53	        return self + (-o)
    54	
    55	    def scale(self, c) -> "AExp":
    56	        return AExp({k: Fr(c) * v for k, v in self.t.items()})
    57	
    58	    def times_mono(self, p, q) -> "AExp":
    59	        return AExp({(k[0] + Fr(p), k[1] + Fr(q)): v for k, v in self.t.items()})
    60	
    61	    def leading(self) -> Tuple[Key, Fr] | None:
    62	        if not self.t:
    63	            return None
    64	        k = max(self.t)
    65	        return k, self.t[k]
    66	
    67	    def tends_to_plus_infinity(self) -> bool:
    68	        """True iff the leading term is positive and of positive order (p, q) > (0, 0)."""
    69	        ld = self.leading()
    70	        return ld is not None and ld[1] > 0 and ld[0] > (Fr(0), Fr(0))
    71	
    72	    def __repr__(self) -> str:
    73	        return " + ".join(f"{v}*(logN)^{k[0]}*(loglogN)^{k[1]}" for k, v in sorted(self.t.items(), reverse=True))
    74	
    75	
    76	# --- basic sizes ------------------------------------------------------------------------------------------
    77	LOGN = AExp.mono(1, 1, 0)
    78	LOGLOGN = AExp.mono(1, 0, 1)
    79	LAM = AExp.mono(1, Fr(2, 5), Fr(3, 5))          # Lambda_{2/5}
    80	
    81	
    82	def D_pow(s) -> Key:
    83	    """D^s = (log N)^s (log log N)^{-s}, as an exponent pair."""
    84	    return (Fr(s), -Fr(s))
    85	
    86	
    87	def theta0(d0: Fr, kappa: Fr) -> Fr:
    88	    d0, kappa = Fr(d0), Fr(kappa)
    89	    if kappa >= d0 * d0 / 4:
    90	        return Fr(3) / d0
    91	    return Fr(2) / d0 + d0 / (4 * kappa)
    92	
    93	
    94	def sigma(a: Fr, d0: Fr, kappa: Fr) -> Fr:
    95	    return 2 * theta0(d0, kappa) / (5 * Fr(a))
    96	
    97	
    98	def sizes(a: Fr, d0: Fr, kappa: Fr) -> Dict[str, AExp]:
    99	    a, d0, kappa = Fr(a), Fr(d0), Fr(kappa)
   100	    th0 = theta0(d0, kappa)
   101	    sg = sigma(a, d0, kappa)
   102	    p, q = D_pow(Fr(-1, 5))
   103	    out = {
   104	        "logN": LOGN,
   105	        "Lambda": LAM,
   106	        "logB": LAM.scale(a),
   107	        "log_ell": AExp.mono(Fr(1) / (2 * kappa), Fr(3, 5), Fr(2, 5)),      # 2 nu log N = log N/(2k)
   108	        "nu_logN": AExp.mono(Fr(1) / (4 * kappa), Fr(3, 5), Fr(2, 5)),
   109	        "theta_logN": AExp.mono(th0, 1 + p, q),                               # theta0 D^{-1/5} log N
   110	        "eta0_logN": AExp.mono(1, Fr(1, 2), Fr(1, 2)),                        # D^{-1/2} log N
   111	        "logS2": LAM.scale(sg),
   112	        "d": AExp.mono(d0, *D_pow(Fr(1, 5))),                                 # d itself (a size, not a log)
   113	        "k": AExp.mono(kappa, *D_pow(Fr(2, 5))),
   114	        "d_logd": AExp.mono(d0 / 5, Fr(1, 5), Fr(4, 5)),                      # d log d ~ d0 D^{1/5} (1/5) loglogN
   115	        "omega_log2_upper": AExp.mono(Fr(1) / a, Fr(3, 5), Fr(-3, 5)),        # omega(N) <= log N/log B (times log 2 <= 1)
   116	        "u": AExp.mono(th0 / a, *D_pow(Fr(2, 5))),                            # total u_r + u_F
   117	    }
   118	    return out
   119	
