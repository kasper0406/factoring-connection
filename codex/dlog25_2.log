    22	
    23	def gauss_reduce(p: int, T: int):
    24	    """Shortest nonzero vector of {(u, v): u = T v mod p} (Lagrange-Gauss reduction, exact integers)."""
    25	    b1, b2 = (p, 0), (T % p, 1)
    26	    n1, n2 = b1[0] ** 2 + b1[1] ** 2, b2[0] ** 2 + b2[1] ** 2
    27	    if n1 < n2:
    28	        b1, b2, n1, n2 = b2, b1, n2, n1
    29	    while True:
    30	        # make b2 the shorter; reduce b1 by b2
    31	        dot = b1[0] * b2[0] + b1[1] * b2[1]
    32	        # nearest integer to dot/n2
    33	        m = (2 * dot + n2) // (2 * n2)
    34	        b1 = (b1[0] - m * b2[0], b1[1] - m * b2[1])
    35	        n1 = b1[0] ** 2 + b1[1] ** 2
    36	        if n1 >= n2:
    37	            return b2
    38	        b1, b2, n1, n2 = b2, b1, n2, n1
    39	
