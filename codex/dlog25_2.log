    85	
    86	
    87	def optimise_dl(C_gamma, c_sub: Tuple[Fr, Fr], grid_a=None, grid_kappa=None) -> Dict:
    88	    ga, gk = default_grids()
    89	    grid_a, grid_kappa = grid_a or ga, grid_kappa or gk
    90	    best = None
