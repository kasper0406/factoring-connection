    41	def build_S(G, k, Y):
    42	    S = []
    43	    for c in itertools.combinations(G, k):
    44	        x = math.prod(c)
    45	        if Y // 2 <= x <= Y:     # window [Y/2, Y] (integer endpoints, Y/2 rounded down: still 2Y^2 < p)
    46	            S.append(x)
    47	    return sorted(S)
    48	
