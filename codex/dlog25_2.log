+"""Read-only referee checks; all output stays in this scratch directory."""
+import itertools
+import json
+import math
+import sys
+from collections import Counter
+from fractions import Fraction as F
+
+sys.path.insert(0, "/Volumes/git/factoring-connection")
+from src.dlog25 import params as P
+
+
+def primes_below(n):
+    return [q for q in range(2, n) if all(q % t for t in range(2, math.isqrt(q) + 1))]
+
+
+def shortest(p, T):
+    # Independent brute-force shortest-vector enumeration. A candidate of squared
+    # length <= p + 1 always exists among the vectors enumerated below.
+    lim = math.isqrt(2 * p) + 1
+    best = None
+    for v in range(-lim, lim + 1):
+        r = (T * v) % p
+        for u in (r, r - p):
+            if u == v == 0:
+                continue
+            key = (u * u + v * v, u, v)
+            if best is None or key < best:
+                best = key
+    _, u, v = best
+    if v < 0:
+        u, v = -u, -v
+    return u, v
+
+
+def split_checks():
+    result = []
+    for p, Y, k in [(211, 10, 1), (401, 14, 1), (1009, 22, 2), (2003, 31, 2)]:
+        G = primes_below(Y + 1)
+        S = {math.prod(c) for c in itertools.combinations(G, k)
+             if Y <= 2 * math.prod(c) <= 2 * Y}
+        assert 2 * Y * Y < p
+        pairs = [(u, v) for u in S for v in S if math.gcd(u, v) == 1]
+        targets = {u * pow(v, -1, p) % p for u, v in pairs}
+        hits = sum(shortest(p, T) in pairs for T in range(1, p))
+        assert hits == len(pairs) == len(targets)
+        result.append(dict(p=p, Y=Y, k=k, G=len(G), S=len(S), pairs=len(pairs), hits=hits))
+    return result
+
+
+def hidden_label_checks():
+    checked = 0
+    for p in [7, 13, 19]:
+        n = p - 1
+        for X in range(n):
+            joint = Counter(((a + X * b) % n, b) for a in range(n) for b in range(n))
+            assert len(joint) == n * n and set(joint.values()) == {1}
+            for xstar in [(1, 0), (2, 3), (3, 5), (4, 7)]:
+                image = Counter((xstar[0] * b0 + xstar[1] * b1) % n
+                                for b0 in range(n) for b1 in range(n))
+                assert len(image) == n and set(image.values()) == {n}
+                checked += 1
+    return checked
+
+
+def constant_checks():
+    # Arguments to the Python API: (a,d0,kappa,Cgamma).
+    outer = (F(3), F(3, 10), F(1, 100), F(1))
+    sub = (F(13, 20), F(4, 5), F(2, 25), F(1))
