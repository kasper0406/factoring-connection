   121	def margins(a: Fr, d0: Fr, kappa: Fr, C: Fr = Fr(100)) -> List[Tuple[str, bool, str]]:
   122	    """The growth comparisons listed in notes/lv5unif_results.md (Lemma P and the margins named in §§4-6, 11), with a
   123	    generous constant C where the notes say 'B^{O(1)}' or '(log N)^{O(1)}'.  Returns (name, holds, where-used).
