   144	    # eta0 = o(theta): theta log N - C eta0 log N
   145	    chk("theta logN - C eta0 logN", s["theta_logN"] - s["eta0_logN"].scale(C), "eta0 slack is o(theta) in the constant")
   146	    # eta0 log N >> d (window floor with 2^{2d+6}; H >= d V^2 margins)
