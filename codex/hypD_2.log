import math

def golden(f,lo,hi):
    r=(math.sqrt(5)-1)/2
    c=hi-r*(hi-lo); d=lo+r*(hi-lo)
    fc=f(c); fd=f(d)
    for _ in range(85):
        if fc<fd:
            hi=d; d=c; fd=fc; c=hi-r*(hi-lo); fc=f(c)
