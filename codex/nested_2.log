+            ce, cu, cn = counts[rng.randrange(len(counts))]
+            se += ce
+            su += cu
+            sn += cn
+        if sn:
+            diffs.append((se - su) / sn)
+    diffs.sort()
+    out['checks'][kind + suffix] = {'n': n, 'endo': e/n, 'uniform': u/n, 'diff': (e-u)/n,
+                                  'ci95': [diffs[int(.025*len(diffs))], diffs[int(.975*len(diffs))-1]]}
+
+def type_rates(ps):
+    ans = {}
+    for k in ['a', 'r']:
+        cs = [c for p in ps for c in p['children'] if c['kind'] == k]
+        ans[k] = sum(c['base_d1'] for c in cs) / len(cs) if cs else 0
+    return ans
+
+pooled = type_rates(parents)
+multi = [p for p in parents if len(p['children']) >= 2]
+actual = sum(all(c['d1'] for c in p['children']) for p in multi)
+expected_pooled = sum(math.prod(pooled[c['kind']] for c in p['children']) for p in multi)
+expected_local = 0
+local = []
+for row in rows:
+    rates = type_rates(row['parents'])
+    local.append({'seed': row['seed'], 'rates': rates})
+    expected_local += sum(math.prod(rates[c['kind']] for c in p['children'])
+                          for p in row['parents'] if len(p['children']) >= 2)
+out['p3'] = {'nodes': len(multi), 'all_good_count': actual, 'observed_rate': actual/len(multi),
+             'expected_pooled_rate': expected_pooled/len(multi), 'pooled_ratio': actual/expected_pooled,
+             'field_rate_ratio': actual/expected_local, 'field_rates': local}
+out['children_hist'] = dict(sorted(collections.Counter(len(p['children']) for p in parents).items()))
+out['degenerate_children'] = sum(p['degenerate'] for p in parents)
+out['time_total_s'] = sum(row['time'] for row in rows)
+out['nr_constant'] = 5/(1-2**(-1/3))
+
+# A concrete prime ideal which does not extend to a scalar-root condition:
+# K1=Q, K2=Q(sqrt(2)), q=7.  sqrt(2) has distinct roots 3 and 4 modulo 7.
+out['fb_example'] = {'prime': 7, 'roots_of_x2_minus_2': [a for a in range(7) if (a*a-2)%7 == 0]}
+
+# A pointwise counterexample to the claimed generic coefficient lower bound.
+out['r2_example'] = {'f': 'x^3-2', 'N': 123, 'm': 5, 'height': 2,
+                     'N_power_one_over_d_plus_one': 123**.25, 'F_m': 5**3-2}
+
+dest = pathlib.Path(__file__).with_name('review_checks.json')
+dest.write_text(json.dumps(out, indent=2) + '\n')
+print(json.dumps(out, indent=2))
