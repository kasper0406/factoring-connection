"""Exact helper computations for notes/nested_results.md (barrier propositions).  DIAGNOSTIC / analysis only.

Functions here are elementary and exact (Fractions / integers); floats only for display.
"""
from __future__ import annotations

from fractions import Fraction
from math import comb, factorial
from typing import Dict, List

from src.thmA import arith


def is_smooth(x: int, B: int) -> bool:
    """x != 0 is B-smooth (trial division; for tests only)."""
    x = abs(x)
    assert x > 0
    for p in arith.primes_upto(B):
        while x % p == 0:
            x //= p
        if x == 1:
            return True
    return x == 1


# ---------------------------------------------------------------- Theorem AF: Gamma law of the cofactor norm
def gamma_upper_tail(r: int, V: Fraction) -> Fraction:
    """Pr[Gamma(r,1) >= V] for integer shape r >= 1, as exp(-V) * sum_{j<r} V^j/j!  (returned WITHOUT the
    exp(-V) factor, i.e. the Poisson partial sum; multiply by exp(-V) in floating point for display)."""
    s, term = Fraction(0), Fraction(1)
    for j in range(r):
        if j:
            term = term * V / j
        s += term
    return s


def af_weight(r: int, X: Fraction, T: Fraction) -> float:
    """Upper bound factor in Cor AF: Pr_v[X e^{-v} <= T] for v ~ Gamma(r,1), i.e. Pr[v >= log(X/T)]."""
    import math
    V = math.log(float(X / T)) if X > T else 0.0
    if V <= 0:
        return 1.0
    s, term = 0.0, 1.0
    for j in range(r):
        if j:
            term *= V / j
        s += term
    return math.exp(-V) * s


# ---------------------------------------------------------------- Prop OD: same-field children vs parameters
def min_children(d: int, lam: Fraction) -> Fraction:
    """Size-model lower bound for the number of algebraic children of a node: (d/2)/lam (log|F| >= (d/2) log q,
    children <= q^lam)."""
    return Fraction(d, 2) / lam


def overdetermined(d: int, lam: Fraction, depth: int, params_extra: int = 3) -> bool:
    """True iff a parent+children configuration of the given depth (1: parent with children; 2: plus
    grandchildren) has more algebraic values than the field has parameters (d + params_extra)."""
    m = min_children(d, lam)
    nodes = sum(m ** j for j in range(depth + 1))
    return nodes > d + params_extra


# ---------------------------------------------------------------- Prop BT: backtracking cost exponent (model)
def backtrack_log_cost(m: Fraction, levels: int, log_inv_p: List[Fraction]) -> Fraction:
    """Model: log of the multiplicative search overhead prod_j (m * p_j^{-m}) = sum_j (log m + m log(1/p_j));
    log m is passed implicitly as 0 here (it is O(levels * log m), negligible); returns m * sum log(1/p_j)."""
    assert len(log_inv_p) == levels
    return m * sum(log_inv_p)


# ---------------------------------------------------------------- Theorem NR: the constant
def nr_constant(b: float, b1: float, s: float, delta: float) -> float:
    """c_NR = max(2b, (b + 1/b1)/(1 - 2^{-1/3}), (b + 2s)/(1 - (delta*b1/2)^{1/3})); needs delta*b1/2 < 1."""
    tau = delta * b1 / 2
    assert 0 < tau < 1
    return max(2 * b, (b + 1 / b1) / (1 - 2 ** (-1 / 3)), (b + 2 * s) / (1 - tau ** (1 / 3)))


def ad_heuristic_ok(b: float, s: float, delta: float, lam: float, kappa_F: float, m0: float) -> bool:
    """Standard heuristic compatibility of Hypothesis AD (Poisson model): 2s > (1/3)[(kappa_F + m0)/(lam b)
    + delta/(2 lam) + delta s/(lam b)] (search exponent beats the smoothness exponent u log u = E/3 per D')."""
    rhs = ((kappa_F + m0) / (lam * b) + delta / (2 * lam) + delta * s / (lam * b)) / 3
    return 2 * s > rhs
"""E1 analysis (notes/nested_prereg.md): P1-P4 with bootstrap CIs over parent nodes.

Usage: .venv/bin/python -m src.nested.analyze_e1 experiments/raw/nested_e1.jsonl experiments/raw/nested_e1_summary.json
"""
from __future__ import annotations

import json
import random
import sys
from collections import Counter


def _rates(parents, kind, field):
    e = b = n = 0
    for p in parents:
        for c in p["children"]:
            if c["kind"] != kind:
                continue
            if field == "A":
                e += c["d1"]; b += c["base_d1"]; n += 1
            else:
                if c.get("d1_A2") is None:
                    continue
                e += c["d1_A2"]; b += c["base_d1_A2"]; n += 1
    return e, b, n


def diff_ci(parents, kind, field, B=2000, seed=0):
    rng = random.Random(seed)
    e, b, n = _rates(parents, kind, field)
    point = (e - b) / n if n else float("nan")
    ds = []
    for _ in range(B):
        samp = [parents[rng.randrange(len(parents))] for _ in range(len(parents))]
        e2, b2, n2 = _rates(samp, kind, field)
        if n2:
            ds.append((e2 - b2) / n2)
    ds.sort()
    return {"n": n, "rate_endo": e / n if n else None, "rate_unif": b / n if n else None, "diff": point,
            "ci95": [ds[int(0.025 * len(ds))], ds[int(0.975 * len(ds)) - 1]]}


def main():
    rows = [json.loads(l) for l in open(sys.argv[1])]
    parents = [p for r in rows for p in r["parents"]]
    out = {"instances": len(rows), "parents": len(parents), "S": rows[0].get("S")}
    out["P1_alg_A"] = diff_ci(parents, "a", "A")
    out["P2_rat_A"] = diff_ci(parents, "r", "A")
    out["P4_rat_A2"] = diff_ci(parents, "r", "A2")
    # pooled matched-uniform rates per type
    pt = {}
    for k in ("a", "r"):
        e, b, n = _rates(parents, k, "A")
        pt[k] = b / n if n else 0.0
    multi = [p for p in parents if len(p["children"]) >= 2]
    obs = sum(all(c["d1"] for c in p["children"]) for p in multi) / max(1, len(multi))
    exp = 0.0
    for p in multi:
        pr = 1.0
        for c in p["children"]:
            pr *= pt[c["kind"]]
        exp += pr
    exp /= max(1, len(multi))
    out["P3"] = {"nodes": len(multi), "obs_all_good": obs, "expected_indep": exp,
                 "ratio": obs / exp if exp else None}
    nch = Counter(len(p["children"]) for p in parents)
    out["children_hist"] = dict(sorted(nch.items()))
    out["frac_nodes_gt6_children"] = sum(v for k, v in nch.items() if k > 6) / len(parents)
    out["degenerate_children"] = sum(p["degenerate"] for p in parents)
    out["dead"] = {r["seed"]: r["dead"] for r in rows if "dead" in r}
    out["time_total_s"] = sum(r["time"] for r in rows)
    win = 0.08
    out["verdict"] = {
        "P1": win >= max(abs(x) for x in out["P1_alg_A"]["ci95"]),
        "P2": win >= max(abs(x) for x in out["P2_rat_A"]["ci95"]),
        "P3": out["P3"]["ratio"] is not None and 0.75 <= out["P3"]["ratio"] <= 1.33,
        "P4": win >= max(abs(x) for x in out["P4_rat_A2"]["ci95"]),
    }
    json.dump(out, open(sys.argv[2], "w"), indent=1)
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()

