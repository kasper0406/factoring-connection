     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  (h) Lemma 10: the CRT count (FULL is rare), core counting statements.
     4	-/
     5	import Mathlib
     6	
     7	namespace FactoringLean
     8	
     9	open Finset
    10	
    11	/-- **Counting in one residue class.** A set of naturals in `[a, a + len)` whose elements are
    12	pairwise congruent modulo `M` has at most `len / M + 1` elements. -/
    13	theorem card_le_of_pairwise_modEq (S : Finset ℕ) (a len M : ℕ)
    14	    (hS : S ⊆ Ico a (a + len)) (hcong : ∀ x ∈ S, ∀ y ∈ S, x ≡ y [MOD M]) :
    15	    S.card ≤ len / M + 1 := by
    16	  have hmaps : ∀ x ∈ S, (x - a) / M ∈ range (len / M + 1) := by
    17	    intro x hx
    18	    have hx' := mem_Ico.1 (hS hx)
    19	    rw [mem_range, Nat.lt_succ_iff]
    20	    exact Nat.div_le_div_right (by omega)
    21	  have hinj : Set.InjOn (fun x => (x - a) / M) S := by
    22	    intro x hx y hy hxy
    23	    simp only at hxy
    24	    have hx' := mem_Ico.1 (hS hx)
    25	    have hy' := mem_Ico.1 (hS hy)
    26	    have hc : (x - a) ≡ (y - a) [MOD M] := by
    27	      apply Nat.ModEq.add_left_cancel' a
    28	      rw [Nat.add_sub_cancel' hx'.1, Nat.add_sub_cancel' hy'.1]
    29	      exact hcong x hx y hy
    30	    have e1 := Nat.div_add_mod (x - a) M
    31	    have e2 := Nat.div_add_mod (y - a) M
    32	    unfold Nat.ModEq at hc
    33	    rw [hxy, hc] at e1
    34	    omega
    35	  calc S.card ≤ (range (len / M + 1)).card := card_le_card_of_injOn _ hmaps hinj
    36	    _ = len / M + 1 := card_range _
    37	
    38	/-- The set of `p` solving the two congruences of Lemma 10 for one triple `(v, ℓ, δ)`:
    39	`ℓ ∣ B p − A q` (coverage) and `d ∣ (A − B)(p − 1) − ℓ² δ` (FULL in a clean band). -/
    40	def lemma10Set (a len ℓ d : ℕ) (A B q δ : ℤ) : Finset ℕ :=
    41	  (Ico a (a + len)).filter
    42	    (fun p : ℕ => (ℓ : ℤ) ∣ B * p - A * q ∧ (d : ℤ) ∣ (A - B) * (p - 1) - ℓ ^ 2 * δ)
    43	
    44	/-- The CRT modulus of Lemma 10: `ℓ · d / gcd(d, A − B)`. -/
    45	def lemma10Modulus (ℓ d : ℕ) (A B : ℤ) : ℕ := ℓ * (d / Int.gcd d (A - B))
    46	
    47	/-- Any two solutions of the Lemma 10 congruences are congruent modulo `ℓ · d / gcd(d, A − B)`
    48	(CRT: `ℓ ∤ d` since the band is clean, `ℓ ∤ B`). -/
    49	theorem lemma10_pairwise_modEq (a len ℓ d : ℕ) (A B q δ : ℤ) (hℓ : ℓ.Prime)
    50	    (hB : ¬ (ℓ : ℤ) ∣ B) (hd : 0 < d) (hℓd : ¬ ℓ ∣ d) :
    51	    ∀ x ∈ lemma10Set a len ℓ d A B q δ, ∀ y ∈ lemma10Set a len ℓ d A B q δ,
    52	      x ≡ y [MOD lemma10Modulus ℓ d A B] := by
    53	  intro x hx y hy
    54	  obtain ⟨-, hx1, hx2⟩ := mem_filter.1 hx
    55	  obtain ⟨-, hy1, hy2⟩ := mem_filter.1 hy
    56	  set g := Int.gcd d (A - B)
    57	  -- modulo ℓ
    58	  have hℓxy : (ℓ : ℤ) ∣ (x : ℤ) - y := by
    59	    have : (ℓ : ℤ) ∣ B * ((x : ℤ) - y) := by
    60	      have e : B * ((x : ℤ) - y) = (B * x - A * q) - (B * y - A * q) := by ring
    61	      rw [e]; exact dvd_sub hx1 hy1
    62	    rcases (Nat.prime_iff_prime_int.mp hℓ).dvd_or_dvd this with h | h
    63	    · exact absurd h hB
    64	    · exact h
    65	  have hmodℓ : x ≡ y [MOD ℓ] := by
    66	    rw [← Int.natCast_modEq_iff]
    67	    exact (Int.modEq_iff_dvd.2 (by rw [← neg_sub]; exact (dvd_neg).2 hℓxy))
    68	  -- modulo d / g
    69	  have hdxy : (A - B) * x ≡ (A - B) * y [ZMOD d] := by
    70	    rw [Int.modEq_iff_dvd]
    71	    have e : (A - B) * (y : ℤ) - (A - B) * x =
    72	        ((A - B) * (y - 1) - ℓ ^ 2 * δ) - ((A - B) * (x - 1) - ℓ ^ 2 * δ) := by ring
    73	    rw [e]; exact dvd_sub hy2 hx2
    74	  have hdg : (x : ℤ) ≡ y [ZMOD (d : ℤ) / (g : ℤ)] :=
    75	    Int.ModEq.cancel_left_div_gcd (by exact_mod_cast hd) hdxy
    76	  have hmodd : x ≡ y [MOD d / g] := by
    77	    rw [← Int.natCast_modEq_iff]; push_cast; exact hdg
    78	  -- combine (CRT)
    79	  have hcop : Nat.Coprime ℓ (d / g) := by
    80	    have h1 : Nat.Coprime ℓ d := (Nat.Prime.coprime_iff_not_dvd hℓ).2 hℓd
    81	    exact h1.coprime_dvd_right (Nat.div_dvd_of_dvd (Int.gcd_dvd_left (d : ℤ) (A - B) |>
    82	      fun h => by exact_mod_cast h))
    83	  exact (Nat.modEq_and_modEq_iff_modEq_mul hcop).1 ⟨hmodℓ, hmodd⟩
    84	
    85	/-- **Lemma 10, single triple.** For a fixed `(A, B, ℓ, δ)` with `ℓ` prime, `ℓ ∤ B`, `ℓ ∤ d`,
    86	`d > 0`, the number of `p ∈ [a, a + len)` with `ℓ ∣ B p − A q` and
    87	`d ∣ (A − B)(p − 1) − ℓ² δ` is at most `len / (ℓ · d / gcd(d, A − B)) + 1`. -/
    88	theorem lemma10_single (a len ℓ d : ℕ) (A B q δ : ℤ) (hℓ : ℓ.Prime)
    89	    (hB : ¬ (ℓ : ℤ) ∣ B) (hd : 0 < d) (hℓd : ¬ ℓ ∣ d) :
    90	    (lemma10Set a len ℓ d A B q δ).card ≤ len / lemma10Modulus ℓ d A B + 1 :=
    91	  card_le_of_pairwise_modEq _ a len _ (filter_subset _ _)
    92	    (lemma10_pairwise_modEq a len ℓ d A B q δ hℓ hB hd hℓd)
    93	
    94	/-- The modulus is large: `ℓ · d ≤ (ℓ · d / gcd(d, A − B)) · |A − B|` when `A ≠ B`. With
    95	`|A − B| < H` this is the note's `ℓ d / g′ ≥ ℓ d / H`. -/
    96	theorem lemma10Modulus_ge (ℓ d : ℕ) (A B : ℤ) (hAB : A ≠ B) :
    97	    ℓ * d ≤ lemma10Modulus ℓ d A B * (A - B).natAbs := by
    98	  unfold lemma10Modulus
    99	  set g := Int.gcd d (A - B)
   100	  have hgd : g ∣ d := by exact_mod_cast Int.gcd_dvd_left (d : ℤ) (A - B)
   101	  have hgAB : g ≤ (A - B).natAbs := by
   102	    apply Nat.le_of_dvd (Int.natAbs_pos.2 (sub_ne_zero.2 hAB))
   103	    exact Int.natCast_dvd.mp (Int.gcd_dvd_right _ _)
   104	  calc ℓ * d = ℓ * (d / g) * g := by rw [mul_assoc, Nat.div_mul_cancel hgd]
   105	    _ ≤ ℓ * (d / g) * (A - B).natAbs := Nat.mul_le_mul_left _ hgAB
   106	
   107	/-- **Lemma 10 (union bound).** For a finite family of triples `t ∈ I` (weights `A t, B t`,
   108	band prime `ℓ t`, shift `δ t`), each satisfying the hypotheses of `lemma10_single`, the set
   109	`F` of `p ∈ [a, a + len)` that solve the two congruences for *some* triple satisfies
   110	`|F| ≤ Σ_t (len / M_t + 1)`. -/
   111	theorem lemma10_union {ι : Type*} (I : Finset ι) (a len d : ℕ) (q : ℤ)
   112	    (A B δ : ι → ℤ) (ℓ : ι → ℕ)
   113	    (hℓ : ∀ t ∈ I, (ℓ t).Prime) (hB : ∀ t ∈ I, ¬ ((ℓ t : ℕ) : ℤ) ∣ B t) (hd : 0 < d)
   114	    (hℓd : ∀ t ∈ I, ¬ ℓ t ∣ d) :
   115	    ((Ico a (a + len)).filter (fun p : ℕ => ∃ t ∈ I,
   116	        ((ℓ t : ℕ) : ℤ) ∣ B t * p - A t * q ∧
   117	        (d : ℤ) ∣ (A t - B t) * (p - 1) - (ℓ t : ℤ) ^ 2 * δ t)).card
   118	      ≤ ∑ t ∈ I, (len / lemma10Modulus (ℓ t) d (A t) (B t) + 1) := by
   119	  classical
   120	  have hsub : (Ico a (a + len)).filter (fun p : ℕ => ∃ t ∈ I,
   121	        ((ℓ t : ℕ) : ℤ) ∣ B t * p - A t * q ∧
   122	        (d : ℤ) ∣ (A t - B t) * (p - 1) - (ℓ t : ℤ) ^ 2 * δ t)
   123	      ⊆ I.biUnion (fun t => lemma10Set a len (ℓ t) d (A t) (B t) q (δ t)) := by
   124	    intro p hp
   125	    obtain ⟨hpI, t, ht, h1, h2⟩ := mem_filter.1 hp
   126	    exact mem_biUnion.2 ⟨t, ht, mem_filter.2 ⟨hpI, h1, h2⟩⟩
   127	  calc _ ≤ _ := card_le_card hsub
   128	    _ ≤ ∑ t ∈ I, (lemma10Set a len (ℓ t) d (A t) (B t) q (δ t)).card := card_biUnion_le
   129	    _ ≤ _ := sum_le_sum fun t ht =>
   130	        lemma10_single a len (ℓ t) d (A t) (B t) q (δ t) (hℓ t ht) (hB t ht) hd (hℓd t ht)
   131	
   132	end FactoringLean
lean/FactoringLean/Coverage.lean
     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  (b) The coverage criterion.
     4	  (c) Lemma 1: the modulus-squared class lock (HH 2022 Prop. 3.3).
     5	  Distinctness of the excluded classes used in Lemma 9.
     6	-/
     7	import Mathlib
     8	
     9	namespace FactoringLean
    10	
    11	/-! ### (b) Coverage criterion -/
    12	
    13	/-- **Coverage criterion.** For a prime `ℓ` with `ℓ ∤ p` (in particular when `ℓ ∤ N = p q`),
    14	`ℓ ∣ B p² − A N  ↔  ℓ ∣ B p − A q`. -/
    15	theorem coverage_criterion (ℓ A B p q : ℤ) (hℓ : Prime ℓ) (hp : ¬ ℓ ∣ p) :
    16	    ℓ ∣ B * p ^ 2 - A * (p * q) ↔ ℓ ∣ B * p - A * q := by
    17	  have e : B * p ^ 2 - A * (p * q) = p * (B * p - A * q) := by ring
    18	  rw [e]
    19	  constructor
    20	  · intro h
    21	    rcases hℓ.dvd_or_dvd h with h | h
    22	    · exact absurd h hp
    23	    · exact h
    24	  · intro h; exact dvd_mul_of_dvd_right h p
    25	
    26	/-- Coverage criterion with the hypothesis as in the note: `ℓ ∤ N`. -/
    27	theorem coverage_criterion' (ℓ A B p q : ℤ) (hℓ : Prime ℓ) (hN : ¬ ℓ ∣ p * q) :
    28	    ℓ ∣ B * p ^ 2 - A * (p * q) ↔ ℓ ∣ B * p - A * q :=
    29	  coverage_criterion ℓ A B p q hℓ (fun h => hN (dvd_mul_of_dvd_left h q))
    30	
    31	/-- The computed roots: if `p ≡ r (mod ℓ)` then `ℓ ∣ B r² − A N ↔ ℓ ∣ B p² − A N`. So
    32	"`p mod ℓ` is a root of `B X² ≡ A N`" is the same as `ℓ ∣ B p² − A N`. -/
    33	theorem root_iff_of_modEq (ℓ A B N p r : ℤ) (h : ℓ ∣ p - r) :
    34	    ℓ ∣ B * r ^ 2 - A * N ↔ ℓ ∣ B * p ^ 2 - A * N := by
    35	  have e : B * p ^ 2 - A * N = (B * r ^ 2 - A * N) + (p - r) * (B * (p + r)) := by ring
    36	  rw [e]
    37	  exact (dvd_add_left (dvd_mul_of_dvd_left h _)).symm
    38	
    39	/-! ### (c) Lemma 1: the modulus-squared class lock -/
    40	
    41	/-- **Lemma 1 (class lock).** Let `ℓ` be prime, `N = p q`, `r` with `ℓ ∤ r` and
    42	`B r² ≡ A N (mod ℓ)`, `s ≡ N r⁻¹ (mod ℓ²)` (i.e. `ℓ² ∣ r s − N`) and
    43	`c ≡ B r + A s (mod ℓ²)`. If `p ≡ r (mod ℓ)` then `ℓ² ∣ B p + A q − c`, i.e.
    44	`g = (B p + A q − c)/ℓ²` is an integer. -/
    45	theorem lemma1_class_lock (ℓ A B p q r s c : ℤ) (hℓ : Prime ℓ) (hr : ¬ ℓ ∣ r)
    46	    (hroot : ℓ ∣ B * r ^ 2 - A * (p * q))
    47	    (hs : ℓ ^ 2 ∣ r * s - p * q)
    48	    (hc : ℓ ^ 2 ∣ c - (B * r + A * s))
    49	    (hpr : ℓ ∣ p - r) :
    50	    ℓ ^ 2 ∣ B * p + A * q - c := by
    51	  -- ℓ ∤ p since p ≡ r
    52	  have hp : ¬ ℓ ∣ p := by
    53	    intro h; apply hr
    54	    have : r = p - (p - r) := by ring
    55	    rw [this]; exact dvd_sub h hpr
    56	  -- coverage: ℓ ∣ B p − A q
    57	  have hcov : ℓ ∣ B * p - A * q :=
    58	    (coverage_criterion ℓ A B p q hℓ hp).1 ((root_iff_of_modEq ℓ A B (p * q) p r hpr).1 hroot)
    59	  obtain ⟨x, hx⟩ := hpr
    60	  obtain ⟨y, hy⟩ := hcov
    61	  obtain ⟨t, ht⟩ := hs
    62	  obtain ⟨u, hu⟩ := hc
    63	  -- r · (B p + A q − c) is an explicit multiple of ℓ²
    64	  have key : r * (B * p + A * q - c) = ℓ ^ 2 * (x * (y - x * B) - (A * t + r * u)) := by
    65	    have hp' : p = r + ℓ * x := by linarith
    66	    have hc' : c = B * r + A * s + ℓ ^ 2 * u := by linarith
    67	    have hN : A * (r * q) = A * (r * s) - A * ℓ ^ 2 * t - A * (ℓ * x * q) := by
    68	      have : r * q = p * q - ℓ * x * q := by rw [hp']; ring
    69	      rw [this]; linear_combination (-A) * ht
    70	    have hy' : r * B - A * q = ℓ * y - ℓ * x * B := by
    71	      have : r = p - ℓ * x := by linarith
    72	      rw [this]; linear_combination hy
    73	    calc r * (B * p + A * q - c)
    74	        = r * B * p + A * (r * q) - r * c := by ring
    75	      _ = ℓ * x * (r * B - A * q) - ℓ ^ 2 * (A * t + r * u) := by
    76	          rw [hN, hc', hp']; ring
    77	      _ = ℓ ^ 2 * (x * (y - x * B) - (A * t + r * u)) := by rw [hy']; ring
    78	  have hdvd : ℓ ^ 2 ∣ r * (B * p + A * q - c) := ⟨_, key⟩
    79	  have hcop : IsCoprime (ℓ ^ 2) r :=
    80	    ((Irreducible.coprime_iff_not_dvd hℓ.irreducible).2 hr).pow_left
    81	  exact hcop.dvd_of_dvd_mul_left hdvd
    82	
    83	/-! ### Distinct excluded classes (used in Lemma 9)
    84	
    85	For a prime `ℓ ∤ q`, `ℓ ∣ B p − A q` defines the class `p ≡ A q B⁻¹ (mod ℓ)`. Two weights
    86	`(A, B)`, `(A', B')` with `0 < A, B, A', B' ≤ H`, `H² < ℓ`, and `gcd(A,B) = gcd(A',B') = 1`
    87	give the same class only if they are equal. -/
    88	
    89	/-- If both `ℓ ∣ B p − A q` and `ℓ ∣ B' p − A' q` with `ℓ ∤ q` prime, then
    90	`ℓ ∣ A B' − A' B`. -/
    91	theorem same_class_dvd (ℓ A B A' B' p q : ℤ) (hℓ : Prime ℓ) (hq : ¬ ℓ ∣ q)
    92	    (h1 : ℓ ∣ B * p - A * q) (h2 : ℓ ∣ B' * p - A' * q) : ℓ ∣ A * B' - A' * B := by
    93	  have e : q * (A * B' - A' * B) = B * (B' * p - A' * q) - B' * (B * p - A * q) := by ring
    94	  have : ℓ ∣ q * (A * B' - A' * B) := by
    95	    rw [e]; exact dvd_sub (dvd_mul_of_dvd_right h2 _) (dvd_mul_of_dvd_right h1 _)
    96	  rcases hℓ.dvd_or_dvd this with h | h
    97	  · exact absurd h hq
    98	  · exact h
    99	
   100	/-- **Distinct classes.** Primitive weights in `[1, H]²` with `H² < ℓ` that cover the same
   101	class modulo a prime `ℓ ∤ q` are equal. Hence the excluded classes number exactly `|V|`. -/
   102	theorem weights_eq_of_same_class (ℓ H : ℕ) (A B A' B' : ℕ) (p q : ℤ)
   103	    (hℓ : ℓ.Prime) (hH : H ^ 2 < ℓ)
   104	    (hA : 0 < A ∧ A ≤ H) (hB : 0 < B ∧ B ≤ H) (hA' : 0 < A' ∧ A' ≤ H) (hB' : 0 < B' ∧ B' ≤ H)
   105	    (hAB : Nat.Coprime A B) (hAB' : Nat.Coprime A' B')
   106	    (hq : ¬ (ℓ : ℤ) ∣ q)
   107	    (h1 : (ℓ : ℤ) ∣ B * p - A * q) (h2 : (ℓ : ℤ) ∣ B' * p - A' * q) :
   108	    A = A' ∧ B = B' := by
   109	  have hd := same_class_dvd ℓ A B A' B' p q (Nat.prime_iff_prime_int.mp hℓ) hq h1 h2
   110	  -- |A B' − A' B| < H² < ℓ, so A B' = A' B
   111	  have hlt1 : A * B' ≤ H ^ 2 := by nlinarith [hA.2, hB'.2]
   112	  have hlt2 : A' * B ≤ H ^ 2 := by nlinarith [hA'.2, hB.2]
   113	  have heq : A * B' = A' * B := by
   114	    have habs : ((A * B' : ℕ) : ℤ) - ((A' * B : ℕ) : ℤ) = 0 := by
   115	      apply Int.eq_zero_of_abs_lt_dvd (m := (ℓ : ℤ))
   116	      · push_cast; exact hd
   117	      · have h1' : ((A * B' : ℕ) : ℤ) < ℓ := by exact_mod_cast lt_of_le_of_lt hlt1 hH
   118	        have h2' : ((A' * B : ℕ) : ℤ) < ℓ := by exact_mod_cast lt_of_le_of_lt hlt2 hH
   119	        rw [abs_lt]; constructor <;> omega
   120	    omega
   121	  -- primitive: A ∣ A' B and gcd(A,B)=1 ⇒ A ∣ A'; symmetric
   122	  have hA_dvd : A ∣ A' := by
   123	    have : A ∣ A' * B := ⟨B', heq.symm ▸ rfl⟩
   124	    exact hAB.dvd_of_dvd_mul_right this
   125	  have hA'_dvd : A' ∣ A := by
   126	    have : A' ∣ A * B' := ⟨B, heq⟩
   127	    exact hAB'.dvd_of_dvd_mul_right this
   128	  have hAA : A = A' := Nat.dvd_antisymm hA_dvd hA'_dvd
   129	  subst hAA
   130	  refine ⟨rfl, ?_⟩
   131	  exact (Nat.eq_of_mul_eq_mul_left hA.1 heq).symm
   132	end FactoringLean
lean/FactoringLean/Exponents.lean
     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  (a) The exponent identity and its Fermat consequence.
     4	  Lemma 3 (exact collision mod p) and Lemma 4 (discrepancy mod q).
     5	-/
     6	import Mathlib
     7	
     8	namespace FactoringLean
     9	
    10	/-! ### (a) The exponent identity -/
    11	
    12	/-- **Exponent identity.** `B + A N − (B p + A q) = (p − 1)(A q − B)` when `N = p q`. -/
    13	theorem exponent_identity (A B p q : ℤ) :
    14	    B + A * (p * q) - (B * p + A * q) = (p - 1) * (A * q - B) := by
    15	  ring
    16	
    17	/-- **Fermat consequence of the exponent identity.** In `ZMod p`, `a^(B + A N) = a^(B p + A q)`
    18	for `N = p q`. This holds for every `a` (no hypothesis `p ∤ a` is needed), since
    19	`x^p = x` in `ZMod p`. -/
    20	theorem pow_exponent_identity_zmod (p : ℕ) [Fact p.Prime] (a : ZMod p) (A B q : ℕ) :
    21	    a ^ (B + A * (p * q)) = a ^ (B * p + A * q) := by
    22	  have hp : ∀ k : ℕ, a ^ (p * k) = a ^ k := by
    23	    intro k; rw [pow_mul, ZMod.pow_card]
    24	  have e1 : A * (p * q) = p * (A * q) := by ring
    25	  rw [pow_add, pow_add, e1, hp, mul_comm B p, hp]
    26	
    27	/-- Natural-number congruence form of (a): `a^(B + A N) ≡ a^(B p + A q) (mod p)`. -/
    28	theorem pow_exponent_identity_modEq (p : ℕ) (hp : p.Prime) (a A B q : ℕ) :
    29	    a ^ (B + A * (p * q)) ≡ a ^ (B * p + A * q) [MOD p] := by
    30	  have := Fact.mk hp
    31	  rw [← ZMod.natCast_eq_natCast_iff]
    32	  push_cast
    33	  exact pow_exponent_identity_zmod p (a : ZMod p) A B q
    34	
    35	/-- The same statement with the hypothesis `p ∤ a` of the note (Fermat), stated over `ℤ` with
    36	integer exponent difference: if `p ∤ a`, then for integer exponents `e₁ e₂` with
    37	`(p − 1) ∣ e₁ − e₂` the unit `a` satisfies `a^e₁ = a^e₂` in `(ZMod p)ˣ`. -/
    38	theorem units_zpow_eq_of_sub_dvd (p : ℕ) [hp : Fact p.Prime] (u : (ZMod p)ˣ) (e₁ e₂ : ℤ)
    39	    (h : ((p : ℤ) - 1) ∣ e₁ - e₂) : u ^ e₁ = u ^ e₂ := by
    40	  obtain ⟨k, hk⟩ := h
    41	  have h1 : u ^ ((p : ℤ) - 1) = 1 := by
    42	    have hp1 : (1 : ℕ) ≤ p := hp.out.one_lt.le
    43	    have : ((p : ℤ) - 1) = ((p - 1 : ℕ) : ℤ) := by push_cast [hp1]; ring
    44	    rw [this, zpow_natCast, ZMod.units_pow_card_sub_one_eq_one]
    45	  have : e₁ = e₂ + ((p : ℤ) - 1) * k := by linarith
    46	  rw [this, zpow_add, zpow_mul, h1, one_zpow, mul_one]
    47	
    48	/-! ### Lemma 3 (exact collision mod p)
    49	
    50	Notation of the note: the base `x` (= 2), `M = L/ℓ²`, `u = x^M`, `γ = x^L = u^{ℓ²}`.
    51	The class lock (Lemma 1) gives an integer `g` with `ℓ² g = B p + A q − c`. -/
    52	
    53	/-- **Lemma 3, core.** If `ℓ² g = B p + A q − c` then `u^(B + A N − c) = γ^g` modulo `p`,
    54	where `u = x^M` and `γ = x^(M ℓ²)`, for any unit `x` mod `p`. No order hypothesis. -/
    55	theorem lemma3_core (p : ℕ) [Fact p.Prime] (x : (ZMod p)ˣ) (M A B q c ℓ g : ℤ)
    56	    (hg : ℓ ^ 2 * g = B * p + A * q - c) :
    57	    (x ^ M) ^ (B + A * (p * q) - c) = (x ^ (M * ℓ ^ 2)) ^ g := by
    58	  rw [← zpow_mul, ← zpow_mul]
    59	  apply units_zpow_eq_of_sub_dvd
    60	  refine ⟨M * (A * q - B), ?_⟩
    61	  have : M * ℓ ^ 2 * g = M * (B * p + A * q - c) := by rw [← hg]; ring
    62	  rw [this]; ring
    63	
    64	/-- **Lemma 3.** With `i* = g − g_lo − j m`, the true giant
    65	`G = u^(B + A N − c) · γ^(−(g_lo + j m))` equals the baby `γ^(i*)` modulo `p`. -/
    66	theorem lemma3 (p : ℕ) [Fact p.Prime] (x : (ZMod p)ˣ) (M A B q c ℓ g glo j m : ℤ)
    67	    (hg : ℓ ^ 2 * g = B * p + A * q - c) :
    68	    (x ^ M) ^ (B + A * (p * q) - c) * (x ^ (M * ℓ ^ 2)) ^ (-(glo + j * m))
    69	      = (x ^ (M * ℓ ^ 2)) ^ (g - glo - j * m) := by
    70	  rw [lemma3_core p x M A B q c ℓ g hg, ← zpow_add]
    71	  congr 1; ring
    72	
    73	/-! ### Lemma 4 (discrepancy mod q) -/
    74	
    75	/-- **Lemma 4, core.** If `ℓ² g = B p + A q − c`, then modulo the prime `q`,
    76	`u^(B + A N − c) = γ^g · u^((A − B)(p − 1))`. -/
    77	theorem lemma4_core (q : ℕ) [Fact q.Prime] (x : (ZMod q)ˣ) (M A B p c ℓ g : ℤ)
    78	    (hg : ℓ ^ 2 * g = B * p + A * q - c) :
    79	    (x ^ M) ^ (B + A * (p * q) - c) = (x ^ (M * ℓ ^ 2)) ^ g * (x ^ M) ^ ((A - B) * (p - 1)) := by
    80	  rw [← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_add]
    81	  apply units_zpow_eq_of_sub_dvd
    82	  refine ⟨M * A * (p - 1), ?_⟩
    83	  have : M * ℓ ^ 2 * g = M * (B * p + A * q - c) := by rw [← hg]; ring
    84	  rw [this]; ring
    85	
    86	/-- The exponent difference in Lemma 4 is `(A − B)(p − 1)` modulo `q − 1`:
    87	`(B + A N − c) − (B p + A q − c) ≡ (A − B)(p − 1) (mod q − 1)`. -/
    88	theorem lemma4_exponent_difference (A B p q c : ℤ) :
    89	    ((q - 1) ∣ (B + A * (p * q) - c) - (B * p + A * q - c) - (A - B) * (p - 1)) :=
    90	  ⟨A * (p - 1), by ring⟩
    91	
    92	/-- **Lemma 4.** The true giant equals `γ^(i*) · u^((A − B)(p − 1))` modulo `q`. -/
    93	theorem lemma4 (q : ℕ) [Fact q.Prime] (x : (ZMod q)ˣ) (M A B p c ℓ g glo j m : ℤ)
    94	    (hg : ℓ ^ 2 * g = B * p + A * q - c) :
    95	    (x ^ M) ^ (B + A * (p * q) - c) * (x ^ (M * ℓ ^ 2)) ^ (-(glo + j * m))
    96	      = (x ^ (M * ℓ ^ 2)) ^ (g - glo - j * m) * (x ^ M) ^ ((A - B) * (p - 1)) := by
    97	  rw [lemma4_core q x M A B p c ℓ g hg, mul_right_comm, ← zpow_add]
    98	  congr 2; ring
    99	
   100	end FactoringLean
lean/FactoringLean/LargeSieve.lean
     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3–4.
     3	  Lemma 9 (coverage via the arithmetic large sieve) and the exceptional-set bound E_b,
     4	  DEDUCED FROM the large-sieve inequality, which is NOT proved here: it enters only as the
     5	  explicit hypothesis `ArithmeticLargeSieve` (a `Prop`, passed as an argument; no `axiom`).
     6	-/
     7	import Mathlib
     8	import FactoringLean.Coverage
     9	
    10	namespace FactoringLean
    11	
    12	open Finset
    13	
    14	/-- **HYPOTHESIS — NOT PROVED IN THIS DEVELOPMENT.**
    15	The arithmetic large sieve, keeping only the `d = 1` and prime `d = ℓ` terms
    16	(Montgomery 1968; Montgomery–Vaughan 1973, constant `N₀ + Q²`):
    17	
    18	let `U` be a finite set of integers in `(M₀, M₀ + N₀]`, `Ps` a finite set of primes `≤ Q`, and
    19	for each `ℓ ∈ Ps` let `Ω ℓ ⊆ [0, ℓ)` be a set of `ω(ℓ) < ℓ` residues that `U` avoids modulo `ℓ`.
    20	Then `|U| · (1 + Σ_{ℓ ∈ Ps} ω(ℓ)/(ℓ − ω(ℓ))) ≤ N₀ + Q²`.
    21	
    22	Theorems below that use it take `(hLS : ArithmeticLargeSieve)` as an argument. -/
    23	def ArithmeticLargeSieve : Prop :=
    24	  ∀ (M₀ : ℤ) (N₀ Q : ℕ) (U : Finset ℤ) (Ps : Finset ℕ) (Ω : ℕ → Finset ℤ),
    25	    (∀ u ∈ U, M₀ < u ∧ u ≤ M₀ + N₀) →
    26	    (∀ ℓ ∈ Ps, ℓ.Prime ∧ ℓ ≤ Q) →
    27	    (∀ ℓ ∈ Ps, (Ω ℓ).card < ℓ ∧ ∀ w ∈ Ω ℓ, 0 ≤ w ∧ w < (ℓ : ℤ)) →
    28	    (∀ u ∈ U, ∀ ℓ ∈ Ps, ∀ w ∈ Ω ℓ, ¬ (ℓ : ℤ) ∣ u - w) →
    29	    (U.card : ℝ) * (1 + ∑ ℓ ∈ Ps, ((Ω ℓ).card : ℝ) / ((ℓ : ℝ) - (Ω ℓ).card)) ≤ N₀ + (Q : ℝ) ^ 2
    30	
    31	/-- The excluded residue of the weight `(A, B)` modulo `ℓ`: the `r ∈ [0, ℓ)` with
    32	`B r ≡ A q (mod ℓ)`. -/
    33	noncomputable def excludedResidue (ℓ : ℕ) (q : ℤ) (v : ℕ × ℕ) : ℤ :=
    34	  ((((v.1 : ℤ) * q : ℤ) : ZMod ℓ) * ((v.2 : ℕ) : ZMod ℓ)⁻¹).val
    35	
    36	theorem excludedResidue_spec (ℓ : ℕ) [Fact ℓ.Prime] (q : ℤ) (v : ℕ × ℕ)
    37	    (hB : ¬ ℓ ∣ v.2) :
    38	    0 ≤ excludedResidue ℓ q v ∧ excludedResidue ℓ q v < ℓ ∧
    39	      (ℓ : ℤ) ∣ (v.2 : ℤ) * excludedResidue ℓ q v - v.1 * q := by
    40	  refine ⟨by unfold excludedResidue; positivity, ?_, ?_⟩
    41	  · unfold excludedResidue; exact_mod_cast ZMod.val_lt _
    42	  · rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    43	    unfold excludedResidue
    44	    have hB' : ((v.2 : ℕ) : ZMod ℓ) ≠ 0 := by
    45	      rwa [Ne, ZMod.natCast_eq_zero_iff]
    46	    push_cast
    47	    rw [ZMod.natCast_val, ZMod.cast_id', id, mul_comm (((v.1 : ZMod ℓ)) * (q : ZMod ℓ)),
    48	      ← mul_assoc, mul_inv_cancel₀ hB', one_mul, sub_self]
    49	
    50	/-- `V ⊆ [1,H]²` has at most `H²` elements. -/
    51	theorem card_weights_le (V : Finset (ℕ × ℕ)) (H : ℕ)
    52	    (hV : ∀ v ∈ V, 0 < v.1 ∧ v.1 ≤ H ∧ 0 < v.2 ∧ v.2 ≤ H) : V.card ≤ H ^ 2 := by
    53	  have : V ⊆ Icc 1 H ×ˢ Icc 1 H := by
    54	    intro v hv
    55	    obtain ⟨h1, h2, h3, h4⟩ := hV v hv
    56	    simp only [mem_product, mem_Icc]; omega
    57	  calc V.card ≤ (Icc 1 H ×ˢ Icc 1 H).card := card_le_card this
    58	    _ = H ^ 2 := by simp [sq]
    59	
    60	/-- **Lemma 9 (from the large sieve).** Fix `q`. Let `V` be primitive weights in `[1, H]²`, `Ps`
    61	primes in `(H², Q]` not dividing `q`, and `U` integers in `(M₀, M₀ + N₀]` that no target covers:
    62	`ℓ ∤ B p − A q` for all `(A, B) ∈ V`, `ℓ ∈ Ps`. Assuming the large sieve,
    63	`|U| · |V| · Σ_{ℓ ∈ Ps} 1/ℓ ≤ N₀ + Q²`. -/
    64	theorem lemma9_of_largeSieve (hLS : ArithmeticLargeSieve) (M₀ : ℤ) (N₀ Q H : ℕ) (q : ℤ)
    65	    (V : Finset (ℕ × ℕ)) (Ps : Finset ℕ)
    66	    (hV : ∀ v ∈ V, 0 < v.1 ∧ v.1 ≤ H ∧ 0 < v.2 ∧ v.2 ≤ H ∧ Nat.Coprime v.1 v.2)
    67	    (hP : ∀ ℓ ∈ Ps, ℓ.Prime ∧ ℓ ≤ Q ∧ H ^ 2 < ℓ ∧ ¬ (ℓ : ℤ) ∣ q)
    68	    (U : Finset ℤ) (hU : ∀ u ∈ U, M₀ < u ∧ u ≤ M₀ + N₀)
    69	    (huncov : ∀ u ∈ U, ∀ v ∈ V, ∀ ℓ ∈ Ps, ¬ (ℓ : ℤ) ∣ (v.2 : ℤ) * u - v.1 * q) :
    70	    (U.card : ℝ) * ((V.card : ℝ) * ∑ ℓ ∈ Ps, (1 : ℝ) / ℓ) ≤ N₀ + (Q : ℝ) ^ 2 := by
    71	  classical
    72	  set Ω : ℕ → Finset ℤ := fun ℓ => V.image (excludedResidue ℓ q)
    73	  have hVcard : V.card ≤ H ^ 2 :=
    74	    card_weights_le V H (fun v hv => ⟨(hV v hv).1, (hV v hv).2.1, (hV v hv).2.2.1,
    75	      (hV v hv).2.2.2.1⟩)
    76	  -- ℓ ∤ B for (A,B) ∈ V, ℓ ∈ Ps
    77	  have hBℓ : ∀ ℓ ∈ Ps, ∀ v ∈ V, ¬ ℓ ∣ v.2 := by
    78	    intro ℓ hℓ v hv h
    79	    have := Nat.le_of_dvd (hV v hv).2.2.1 h
    80	    have h2 : v.2 ≤ H ^ 2 := by
    81	      have := (hV v hv).2.2.2.1
    82	      rcases Nat.eq_zero_or_pos H with h0 | h0
    83	      · omega
    84	      · nlinarith
    85	    have := (hP ℓ hℓ).2.2.1
    86	    omega
    87	  -- the excluded residues are distinct, so |Ω ℓ| = |V|
    88	  have hΩcard : ∀ ℓ ∈ Ps, (Ω ℓ).card = V.card := by
    89	    intro ℓ hℓ
    90	    have := Fact.mk (hP ℓ hℓ).1
    91	    apply card_image_of_injOn
    92	    intro v hv v' hv' hvv
    93	    have h1 := (excludedResidue_spec ℓ q v (hBℓ ℓ hℓ v hv)).2.2
    94	    have h2 := (excludedResidue_spec ℓ q v' (hBℓ ℓ hℓ v' hv')).2.2
    95	    rw [← hvv] at h2
    96	    obtain ⟨hA, hB⟩ := weights_eq_of_same_class ℓ H v.1 v.2 v'.1 v'.2
    97	      (excludedResidue ℓ q v) q (hP ℓ hℓ).1 (hP ℓ hℓ).2.2.1
    98	      ⟨(hV v hv).1, (hV v hv).2.1⟩ ⟨(hV v hv).2.2.1, (hV v hv).2.2.2.1⟩
    99	      ⟨(hV v' hv').1, (hV v' hv').2.1⟩ ⟨(hV v' hv').2.2.1, (hV v' hv').2.2.2.1⟩
   100	      (hV v hv).2.2.2.2 (hV v' hv').2.2.2.2 (hP ℓ hℓ).2.2.2
   101	      (by rw [mul_comm]; exact (by simpa [mul_comm] using h1))
   102	      (by rw [mul_comm]; exact (by simpa [mul_comm] using h2))
   103	    exact Prod.ext hA hB
   104	  have hLS' := hLS M₀ N₀ Q U Ps Ω hU (fun ℓ hℓ => ⟨(hP ℓ hℓ).1, (hP ℓ hℓ).2.1⟩)
   105	    (by
   106	      intro ℓ hℓ
   107	      have := Fact.mk (hP ℓ hℓ).1
   108	      refine ⟨by rw [hΩcard ℓ hℓ]; exact lt_of_le_of_lt hVcard (hP ℓ hℓ).2.2.1, ?_⟩
   109	      intro w hw
   110	      obtain ⟨v, hv, rfl⟩ := mem_image.1 hw
   111	      exact ⟨(excludedResidue_spec ℓ q v (hBℓ ℓ hℓ v hv)).1,
   112	        (excludedResidue_spec ℓ q v (hBℓ ℓ hℓ v hv)).2.1⟩)
   113	    (by
   114	      intro u hu ℓ hℓ w hw hdiv
   115	      have := Fact.mk (hP ℓ hℓ).1
   116	      obtain ⟨v, hv, rfl⟩ := mem_image.1 hw
   117	      apply huncov u hu v hv ℓ hℓ
   118	      have h1 := (excludedResidue_spec ℓ q v (hBℓ ℓ hℓ v hv)).2.2
   119	      have e : (v.2 : ℤ) * u - v.1 * q =
   120	          v.2 * (u - excludedResidue ℓ q v) + (v.2 * excludedResidue ℓ q v - v.1 * q) := by ring
   121	      rw [e]; exact dvd_add (dvd_mul_of_dvd_right hdiv _) h1)
   122	  -- ω/(ℓ − ω) ≥ ω/ℓ, so 1 + Σ ω/(ℓ−ω) ≥ |V| Σ 1/ℓ
   123	  have hJ : (V.card : ℝ) * ∑ ℓ ∈ Ps, (1 : ℝ) / ℓ ≤
   124	      1 + ∑ ℓ ∈ Ps, ((Ω ℓ).card : ℝ) / ((ℓ : ℝ) - (Ω ℓ).card) := by
   125	    rw [mul_sum]
   126	    have : ∑ ℓ ∈ Ps, (V.card : ℝ) * (1 / ℓ) ≤
   127	        ∑ ℓ ∈ Ps, ((Ω ℓ).card : ℝ) / ((ℓ : ℝ) - (Ω ℓ).card) := by
   128	      apply sum_le_sum
   129	      intro ℓ hℓ
   130	      rw [hΩcard ℓ hℓ]
   131	      have hlt : (V.card : ℝ) < ℓ := by
   132	        exact_mod_cast lt_of_le_of_lt hVcard (hP ℓ hℓ).2.2.1
   133	      have hV0 : (0 : ℝ) ≤ V.card := by positivity
   134	      rw [mul_one_div]
   135	      apply div_le_div_of_nonneg_left hV0 (by linarith) (by linarith)
   136	    linarith
   137	  calc (U.card : ℝ) * ((V.card : ℝ) * ∑ ℓ ∈ Ps, (1 : ℝ) / ℓ)
   138	      ≤ (U.card : ℝ) * (1 + ∑ ℓ ∈ Ps, ((Ω ℓ).card : ℝ) / ((ℓ : ℝ) - (Ω ℓ).card)) :=
   139	        mul_le_mul_of_nonneg_left hJ (by positivity)
   140	    _ ≤ N₀ + (Q : ℝ) ^ 2 := hLS'
   141	
   142	/-- The uncovered set `U_k(q)` of Lemma 9, over the integer interval `(M₀, M₀ + N₀]`. -/
   143	def uncovered (M₀ : ℤ) (N₀ : ℕ) (V : Finset (ℕ × ℕ)) (Ps : Finset ℕ) (q : ℤ) : Finset ℤ :=
   144	  (Ioc M₀ (M₀ + N₀)).filter (fun p => ∀ v ∈ V, ∀ ℓ ∈ Ps, ¬ (ℓ : ℤ) ∣ (v.2 : ℤ) * p - v.1 * q)
   145	
   146	/-- **Exceptional set `E_b` (from the large sieve).** Summing Lemma 9 over a finite set `Qs` of
   147	primes `q` (each with its own band `Ps q`, e.g. the least clean band `k(q)`):
   148	`(Σ_{q ∈ Qs} |U(q)|) · J ≤ |Qs| · (N₀ + Q²)`, where `J ≤ |V| Σ_{ℓ ∈ Ps q} 1/ℓ` for all `q`.
   149	The note then uses `J ≥ c₁ H²/n` (PNT mod 4) and `|S_n| ≥ c₀ P²/n²`; those analytic inputs are
   150	NOT formalized. -/
   151	theorem exceptional_Eb_of_largeSieve (hLS : ArithmeticLargeSieve) (M₀ : ℤ) (N₀ Q H : ℕ)
   152	    (V : Finset (ℕ × ℕ)) (Qs : Finset ℤ) (Ps : ℤ → Finset ℕ) (J : ℝ)
   153	    (hV : ∀ v ∈ V, 0 < v.1 ∧ v.1 ≤ H ∧ 0 < v.2 ∧ v.2 ≤ H ∧ Nat.Coprime v.1 v.2)
   154	    (hP : ∀ q ∈ Qs, ∀ ℓ ∈ Ps q, ℓ.Prime ∧ ℓ ≤ Q ∧ H ^ 2 < ℓ ∧ ¬ (ℓ : ℤ) ∣ q)
   155	    (hJ : ∀ q ∈ Qs, J ≤ (V.card : ℝ) * ∑ ℓ ∈ Ps q, (1 : ℝ) / ℓ) :
   156	    (∑ q ∈ Qs, ((uncovered M₀ N₀ V (Ps q) q).card : ℝ)) * J ≤ Qs.card * (N₀ + (Q : ℝ) ^ 2) := by
   157	  rw [sum_mul]
   158	  have : ∀ q ∈ Qs, ((uncovered M₀ N₀ V (Ps q) q).card : ℝ) * J ≤ N₀ + (Q : ℝ) ^ 2 := by
   159	    intro q hq
   160	    have h := lemma9_of_largeSieve hLS M₀ N₀ Q H q V (Ps q) hV (hP q hq)
   161	      (uncovered M₀ N₀ V (Ps q) q)
   162	      (fun u hu => by
   163	        have := (mem_filter.1 hu).1
   164	        rw [mem_Ioc] at this; exact this)
   165	      (fun u hu => (mem_filter.1 hu).2)
   166	    exact (mul_le_mul_of_nonneg_left (hJ q hq) (by positivity)).trans h
   167	  calc ∑ q ∈ Qs, ((uncovered M₀ N₀ V (Ps q) q).card : ℝ) * J
   168	      ≤ ∑ _q ∈ Qs, (N₀ + (Q : ℝ) ^ 2) := sum_le_sum this
   169	    _ = Qs.card * (N₀ + (Q : ℝ) ^ 2) := by rw [sum_const, nsmul_eq_mul]
   170	
   171	end FactoringLean
lean/FactoringLean/SingleTarget.lean
     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  Lemma 2 (window: AM–GM lower end, convexity upper end, indexing) and the
     4	  single-target extraction theorem, which chains Lemmas 1, 3, 4, 5 and 7:
     5	  a covering target of a clean band whose true giant is not FULL makes the
     6	  algorithm's gcd equal to p.
     7	-/
     8	import Mathlib
     9	import FactoringLean.Exponents
    10	import FactoringLean.Bands
    11	
    12	namespace FactoringLean
    13	
    14	open Finset
    15	
    16	/-! ### Lemma 2 (window) -/
    17	
    18	/-- **Lemma 2, lower end (AM–GM).** `Lo_v = ⌊2√(A B N)⌋ = ⌊√(4 A B N)⌋ ≤ B p + A q`. -/
    19	theorem lemma2_lower (A B p q : ℕ) : Nat.sqrt (4 * A * B * (p * q)) ≤ B * p + A * q := by
    20	  have : 4 * A * B * (p * q) ≤ (B * p + A * q) ^ 2 := by
    21	    have h : (0 : ℤ) ≤ ((B : ℤ) * p - A * q) ^ 2 := sq_nonneg _
    22	    have : ((4 * A * B * (p * q) : ℕ) : ℤ) ≤ (((B * p + A * q) ^ 2 : ℕ) : ℤ) := by
    23	      push_cast; nlinarith
    24	    exact_mod_cast this
    25	  calc Nat.sqrt (4 * A * B * (p * q)) ≤ Nat.sqrt ((B * p + A * q) ^ 2) := Nat.sqrt_le_sqrt this
    26	    _ = B * p + A * q := Nat.sqrt_eq' _
    27	
    28	/-- **Lemma 2, upper end (convexity).** For `0 < a ≤ x ≤ b` and `A, B, N ≥ 0`,
    29	`F(x) = B x + A N / x ≤ max(F(a), F(b))`. -/
    30	theorem lemma2_upper (A B N a b x : ℝ) (hA : 0 ≤ A) (hN : 0 ≤ N) (ha : 0 < a) (hax : a ≤ x)
    31	    (hxb : x ≤ b) :
    32	    B * x + A * N / x ≤ max (B * a + A * N / a) (B * b + A * N / b) := by
    33	  have hx : 0 < x := lt_of_lt_of_le ha hax
    34	  have hb : 0 < b := lt_of_lt_of_le hx hxb
    35	  have hAN : 0 ≤ A * N := mul_nonneg hA hN
    36	  -- F(x) − F(a) = (x − a)(B − AN/(a x)),  F(x) − F(b) = (x − b)(B − AN/(b x))
    37	  have ea : B * x + A * N / x - (B * a + A * N / a) = (x - a) * (B - A * N / (a * x)) := by
    38	    field_simp; ring
    39	  have eb : B * x + A * N / x - (B * b + A * N / b) = (x - b) * (B - A * N / (b * x)) := by
    40	    field_simp; ring
    41	  by_cases h : B ≤ A * N / (a * x)
    42	  · apply le_max_of_le_left
    43	    have : (x - a) * (B - A * N / (a * x)) ≤ 0 :=
    44	      mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith)
    45	    linarith
    46	  · apply le_max_of_le_right
    47	    push Not at h
    48	    have hle : A * N / (b * x) ≤ A * N / (a * x) :=
    49	      div_le_div_of_nonneg_left hAN (by positivity) (by nlinarith)
    50	    have : (x - b) * (B - A * N / (b * x)) ≤ 0 :=
    51	      mul_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    52	    linarith
    53	
    54	/-- **Lemma 2, window.** With `K = ℓ² > 0`, `g_lo = ⌈(Lo − c)/K⌉ = −⌊(c − Lo)/K⌋` and
    55	`g_hi = ⌊(Hi − c)/K⌋`: if `Lo ≤ K g + c ≤ Hi` (i.e. `Lo ≤ Bp + Aq ≤ Hi`), then
    56	`g_lo ≤ g ≤ g_hi`. -/
    57	theorem lemma2_window (K g c Lo Hi : ℤ) (hK : 0 < K) (hLo : Lo ≤ K * g + c)
    58	    (hHi : K * g + c ≤ Hi) : -((c - Lo) / K) ≤ g ∧ g ≤ (Hi - c) / K := by
    59	  constructor
    60	  · have : -g ≤ (c - Lo) / K := by
    61	      rw [Int.le_ediv_iff_mul_le hK]; linarith
    62	    linarith
    63	  · rw [Int.le_ediv_iff_mul_le hK]; linarith
    64	
    65	/-- **Lemma 2, indexing.** With `i_full = g − g_lo`, `j* = ⌊i_full/m⌋`, `i* = i_full − j* m`:
    66	`0 ≤ i* < m` and `g − (g_lo + j* m) = i*`; and if `g_lo ≤ g ≤ g_hi` then
    67	`0 ≤ j* ≤ (g_hi − g_lo)/m`, so the true giant is among those computed. -/
    68	theorem lemma2_index (g glo ghi m : ℤ) (hm : 0 < m) :
    69	    (0 ≤ (g - glo) % m ∧ (g - glo) % m < m ∧ g - (glo + (g - glo) / m * m) = (g - glo) % m) ∧
    70	    (glo ≤ g → g ≤ ghi → 0 ≤ (g - glo) / m ∧ (g - glo) / m ≤ (ghi - glo) / m) := by
    71	  refine ⟨⟨Int.emod_nonneg _ hm.ne', Int.emod_lt_of_pos _ hm, ?_⟩, fun h1 h2 => ⟨?_, ?_⟩⟩
    72	  · have := Int.ediv_mul_add_emod (g - glo) m
    73	    linarith
    74	  · exact Int.ediv_nonneg (by linarith) hm.le
    75	  · exact Int.ediv_le_ediv hm (by linarith)
    76	
    77	/-! ### Single-target extraction -/
    78	
    79	/-- **Single-target extraction (Lemmas 3, 4, 5, 7 chained).**
    80	
    81	Setting: distinct primes `p, q`, `N = p q`; the base reduces to units `xp` mod `p` and `xq`
    82	mod `q` (both are images of `2` in the note); `u = x^M`, `γ = x^(M ℓ²)`, with
    83	`M = L/ℓ²`. The target covers `p`, so (Lemma 1) `ℓ² g = B p + A q − c`; the true giant has
    84	index `j*` and baby index `i*`, `g − g_lo = j* m + i*`, `0 ≤ i* < m`. The integers `G, γ` are
    85	the algorithm's residues (mod `N`) of the true giant and of `γ`.
    86	
    87	Hypotheses on `q`: the band is clean (`gcd(M, ord_q x) = 1`, see `lemma7_coprime_zmod`) and
    88	the FULL condition of Lemma 7 fails for every `δ ∈ [−i*, m − 1 − i*]`.
    89	
    90	Conclusion: `gcd(f(G), N) = p`, where `f(X) = ∏_{i<m} (X − γ^i)`. -/
    91	theorem single_target_extraction (p q : ℕ) [hp : Fact p.Prime] [hq : Fact q.Prime]
    92	    (hpq : p ≠ q) (xp : (ZMod p)ˣ) (xq : (ZMod q)ˣ)
    93	    (M A B c ℓ g glo jstar istar : ℤ) (m : ℕ)
    94	    (hg : ℓ ^ 2 * g = B * p + A * q - c)
    95	    (hsplit : g - glo = jstar * m + istar) (hi0 : 0 ≤ istar) (him : istar < m)
    96	    (G γ : ℤ)
    97	    (hγp : (γ : ZMod p) = ((xp ^ (M * ℓ ^ 2) : (ZMod p)ˣ) : ZMod p))
    98	    (hγq : (γ : ZMod q) = ((xq ^ (M * ℓ ^ 2) : (ZMod q)ˣ) : ZMod q))
    99	    (hGp : (G : ZMod p) = (((xp ^ M) ^ (B + A * (p * q) - c) *
   100	        (xp ^ (M * ℓ ^ 2)) ^ (-(glo + jstar * m)) : (ZMod p)ˣ) : ZMod p))
   101	    (hGq : (G : ZMod q) = (((xq ^ M) ^ (B + A * (p * q) - c) *
   102	        (xq ^ (M * ℓ ^ 2)) ^ (-(glo + jstar * m)) : (ZMod q)ˣ) : ZMod q))
   103	    (hclean : IsCoprime M (orderOf xq : ℤ))
   104	    (hnotfull : ∀ δ : ℤ, -istar ≤ δ → δ ≤ m - 1 - istar →
   105	        ¬ (orderOf xq : ℤ) ∣ (A - B) * (p - 1) - ℓ ^ 2 * δ) :
   106	    Int.gcd (∏ i ∈ range m, (G - γ ^ i)) ((p * q : ℕ) : ℤ) = p := by
   107	  have hidx : g - glo - jstar * m = istar := by linarith
   108	  -- Lemma 3: G ≡ γ^{i*} (mod p)
   109	  have h3 := lemma3 p xp M A B q c ℓ g glo jstar m hg
   110	  rw [hidx] at h3
   111	  have hcol : (p : ℤ) ∣ G - γ ^ istar.toNat := by
   112	    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_sub, Int.cast_pow, hGp, h3, hγp,
   113	      ← Units.val_pow_eq_pow_val, ← zpow_natCast, Int.toNat_of_nonneg hi0, sub_self]
   114	  -- Lemma 4 + Lemma 7: G is not FULL mod q
   115	  have h4 := lemma4 q xq M A B p c ℓ g glo jstar m hg
   116	  rw [hidx] at h4
   117	  have hnf : ∀ i < m, ¬ (q : ℤ) ∣ G - γ ^ i := by
   118	    intro i hi hdiv
   119	    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_sub, Int.cast_pow, sub_eq_zero, hGq, h4,
   120	      hγq, ← Units.val_pow_eq_pow_val, Units.val_inj, ← zpow_natCast] at hdiv
   121	    obtain ⟨δ, hδ0, hδm, hδ⟩ := (lemma7_full_iff xq M ℓ ((A - B) * (p - 1)) istar m hclean).1
   122	      ⟨i, by positivity, by exact_mod_cast hi, hdiv⟩
   123	    exact hnotfull δ hδ0 hδm hδ
   124	  -- Lemma 5
   125	  exact lemma5_one_sided p q hp.out hq.out hpq G γ m istar.toNat (by omega) hcol hnf
   126	
