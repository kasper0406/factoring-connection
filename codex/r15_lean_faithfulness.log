    12	/-- **Exponent identity.** `B + A N − (B p + A q) = (p − 1)(A q − B)` when `N = p q`. -/
    13	theorem exponent_identity (A B p q : ℤ) :
    14	    B + A * (p * q) - (B * p + A * q) = (p - 1) * (A * q - B) := by
    15	  ring
    16	
    17	/-- **Fermat consequence of the exponent identity.** In `ZMod p`, `a^(B + A N) = a^(B p + A q)`
    18	for `N = p q`. This holds for every `a` (no hypothesis `p ∤ a` is needed), since
    19	`x^p = x` in `ZMod p`. -/
    20	theorem pow_exponent_identity_zmod (p : ℕ) [Fact p.Prime] (a : ZMod p) (A B q : ℕ) :
    21	    a ^ (B + A * (p * q)) = a ^ (B * p + A * q) := by
    22	  have hp : ∀ k : ℕ, a ^ (p * k) = a ^ k := by
    23	    intro k; rw [pow_mul, ZMod.pow_card]
    24	  have e1 : A * (p * q) = p * (A * q) := by ring
    25	  rw [pow_add, pow_add, e1, hp, mul_comm B p, hp]
    26	
    27	/-- Natural-number congruence form of (a): `a^(B + A N) ≡ a^(B p + A q) (mod p)`. -/
    28	theorem pow_exponent_identity_modEq (p : ℕ) (hp : p.Prime) (a A B q : ℕ) :
    29	    a ^ (B + A * (p * q)) ≡ a ^ (B * p + A * q) [MOD p] := by
    30	  have := Fact.mk hp
    31	  rw [← ZMod.natCast_eq_natCast_iff]
    32	  push_cast
    33	  exact pow_exponent_identity_zmod p (a : ZMod p) A B q
    34	
    35	/-- The same statement with the hypothesis `p ∤ a` of the note (Fermat), stated over `ℤ` with
    36	integer exponent difference: if `p ∤ a`, then for integer exponents `e₁ e₂` with
    37	`(p − 1) ∣ e₁ − e₂` the unit `a` satisfies `a^e₁ = a^e₂` in `(ZMod p)ˣ`. -/
    38	theorem units_zpow_eq_of_sub_dvd (p : ℕ) [hp : Fact p.Prime] (u : (ZMod p)ˣ) (e₁ e₂ : ℤ)
    39	    (h : ((p : ℤ) - 1) ∣ e₁ - e₂) : u ^ e₁ = u ^ e₂ := by
    40	  obtain ⟨k, hk⟩ := h
