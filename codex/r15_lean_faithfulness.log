     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  Lemma 5 (one-sided extraction), (e) Lemma 6 (four-band pigeonhole),
     4	  (f) Lemma 7 (clean-band FULL criterion).
     5	-/
     6	import Mathlib
     7	
     8	namespace FactoringLean
     9	
    10	open Finset
    11	
    12	/-! ### Lemma 5: one-sided extraction -/
    13	
    14	/-- **Lemma 5 (one-sided extraction).** Let `f(X) = ∏_{i<m} (X − γ^i)`. If the giant `G`
    15	collides with a baby modulo `p` (`p ∣ G − γ^{i*}`, `i* < m`) and with no baby modulo `q`
    16	(`G` not FULL), then `gcd(f(G), p q) = p`. -/
    17	theorem lemma5_one_sided (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    18	    (G γ : ℤ) (m istar : ℕ) (hi : istar < m)
    19	    (hcol : (p : ℤ) ∣ G - γ ^ istar)
    20	    (hnotfull : ∀ i < m, ¬ (q : ℤ) ∣ G - γ ^ i) :
    21	    Int.gcd (∏ i ∈ range m, (G - γ ^ i)) ((p * q : ℕ) : ℤ) = p := by
    22	  set F := ∏ i ∈ range m, (G - γ ^ i)
    23	  have hpF : (p : ℤ) ∣ F := hcol.trans (dvd_prod_of_mem _ (mem_range.2 hi))
    24	  have hqF : ¬ (q : ℤ) ∣ F := by
    25	    intro h
    26	    obtain ⟨i, hi, hdi⟩ := ((Nat.prime_iff_prime_int.mp hq).dvd_finsetProd_iff _).1 h
    27	    exact hnotfull i (mem_range.1 hi) hdi
    28	  have hcop : Nat.Coprime p q := (Nat.coprime_primes hp hq).2 hpq
    29	  show Nat.gcd F.natAbs (p * q) = p
    30	  rw [Nat.Coprime.gcd_mul _ hcop]
    31	  have h1 : Nat.gcd F.natAbs p = p := Nat.gcd_eq_right (Int.natCast_dvd.mp hpF)
    32	  have h2 : Nat.gcd F.natAbs q = 1 := by
    33	    have : ¬ q ∣ F.natAbs := fun h => hqF (Int.natCast_dvd.mpr h)
    34	    exact Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hq).2 this)
    35	  rw [h1, h2, mul_one]
    36	
    37	/-- The FULL condition in `ZMod q` is the same as the divisibility condition in Lemma 5. -/
    38	theorem not_full_iff (q : ℕ) (G γ : ℤ) (m : ℕ) :
    39	    (∀ i < m, (G : ZMod q) ≠ (γ : ZMod q) ^ i) ↔ (∀ i < m, ¬ (q : ℤ) ∣ G - γ ^ i) := by
    40	  refine forall₂_congr fun i _ => ?_
    41	  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_sub, Int.cast_pow, sub_eq_zero]
    42	
    43	/-! ### (e) Lemma 6: the four-band pigeonhole -/
    44	
    45	/-- **Lemma 6 (clean band).** Let `S₀, …, S₃` be pairwise disjoint sets of primes, all
    46	`> Y`. If `0 < n < (Y+1)^4` (in the note `n = q − 1 < q < Y⁴`), then some band `S_k` contains
    47	no prime dividing `n`. -/
    48	theorem lemma6_clean_band (S : Fin 4 → Finset ℕ)
    49	    (hdisj : ∀ i j, i ≠ j → Disjoint (S i) (S j))
    50	    (Y n : ℕ) (hprime : ∀ i, ∀ ℓ ∈ S i, ℓ.Prime) (hbig : ∀ i, ∀ ℓ ∈ S i, Y < ℓ)
    51	    (hn : 0 < n) (hY : n < (Y + 1) ^ 4) :
    52	    ∃ k, ∀ ℓ ∈ S k, ¬ ℓ ∣ n := by
    53	  by_contra h
    54	  push Not at h
    55	  choose f hf hfd using h
    56	  have hinj : Function.Injective f := by
    57	    intro i j hij
    58	    by_contra hne
    59	    exact Finset.disjoint_left.mp (hdisj i j hne) (hf i) (hij ▸ hf j)
    60	  set s := (univ : Finset (Fin 4)).image f
    61	  have hcard : s.card = 4 := by
    62	    rw [card_image_of_injective _ hinj]; simp
    63	  have hdvd : (∏ a ∈ s, a) ∣ n := by
    64	    apply Finset.prod_primes_dvd
    65	    · intro a ha
    66	      obtain ⟨i, -, rfl⟩ := mem_image.1 ha
    67	      exact Nat.prime_iff.mp (hprime i _ (hf i))
    68	    · intro a ha
    69	      obtain ⟨i, -, rfl⟩ := mem_image.1 ha
    70	      exact hfd i
    71	  have hge : (Y + 1) ^ 4 ≤ ∏ a ∈ s, a := by
    72	    rw [← hcard]
    73	    apply Finset.pow_card_le_prod
    74	    intro a ha
    75	    obtain ⟨i, -, rfl⟩ := mem_image.1 ha
    76	    exact hbig i _ (hf i)
    77	  have := Nat.le_of_dvd hn hdvd
    78	  omega
    79	
    80	/-- Lemma 6 in the form used: for a prime `q ≤ Y⁴`, some band is clean for `q`, i.e. no
    81	band prime divides `q − 1`. -/
    82	theorem lemma6_clean_band_prime (S : Fin 4 → Finset ℕ)
    83	    (hdisj : ∀ i j, i ≠ j → Disjoint (S i) (S j))
    84	    (Y q : ℕ) (hprime : ∀ i, ∀ ℓ ∈ S i, ℓ.Prime) (hbig : ∀ i, ∀ ℓ ∈ S i, Y < ℓ)
    85	    (hq : q.Prime) (hY : q ≤ Y ^ 4) :
    86	    ∃ k, ∀ ℓ ∈ S k, ¬ ℓ ∣ q - 1 := by
    87	  apply lemma6_clean_band S hdisj Y (q - 1) hprime hbig
    88	  · have := hq.two_le; omega
    89	  · have : Y ^ 4 < (Y + 1) ^ 4 := Nat.pow_lt_pow_left (Nat.lt_succ_self Y) (by norm_num)
    90	    omega
    91	
    92	/-! ### (f) Lemma 7: the clean-band FULL criterion -/
    93	
    94	/-- **(f) core.** If `gcd(e, d) = 1` then `d ∣ e x ↔ d ∣ x`. -/
    95	theorem coprime_dvd_mul_iff (e d x : ℕ) (h : Nat.Coprime e d) : d ∣ e * x ↔ d ∣ x :=
    96	  ⟨fun hd => (Nat.Coprime.symm h).dvd_of_dvd_mul_left hd, fun hd => dvd_mul_of_dvd_right hd e⟩
    97	
    98	/-- **(f) core, integer version.** -/
    99	theorem coprime_dvd_mul_iff_int (e d x : ℤ) (h : IsCoprime e d) : d ∣ e * x ↔ d ∣ x :=
   100	  ⟨fun hd => h.symm.dvd_of_dvd_mul_left hd, fun hd => dvd_mul_of_dvd_right hd e⟩
   101	
   102	/-- Cleanliness gives the coprimality used in Lemma 7: if no band prime divides `q − 1`, then
   103	`L = ∏ ℓ²` is coprime to `q − 1`. -/
   104	theorem clean_coprime (S : Finset ℕ) (hprime : ∀ ℓ ∈ S, ℓ.Prime) (n : ℕ)
   105	    (hclean : ∀ ℓ ∈ S, ¬ ℓ ∣ n) : Nat.Coprime (∏ ℓ ∈ S, ℓ ^ 2) n := by
   106	  apply Nat.Coprime.prod_left
   107	  intro ℓ hℓ
   108	  exact Nat.Coprime.pow_left 2 ((Nat.Prime.coprime_iff_not_dvd (hprime ℓ hℓ)).2 (hclean ℓ hℓ))
   109	
   110	/-- `gcd(L, q − 1) = 1`, `M ∣ L` and `d ∣ q − 1` give `gcd(M, d) = 1`
   111	(with `M = L/ℓ²` and `d = ord_q(2)`). -/
   112	theorem coprime_of_clean (L M d n : ℕ) (hL : Nat.Coprime L n) (hM : M ∣ L) (hd : d ∣ n) :
   113	    Nat.Coprime M d :=
   114	  (hL.coprime_dvd_left hM).coprime_dvd_right hd
   115	
   116	/-- **Lemma 7, group core.** In any group, with `u = x^M`, `γ = x^(M ℓ²)` and
   117	`gcd(M, ord x) = 1`: `u^D = γ^δ ↔ ord x ∣ D − ℓ² δ`. -/
   118	theorem lemma7_core {G : Type*} [Group G] (x : G) (M ℓ D δ : ℤ)
   119	    (hM : IsCoprime M (orderOf x : ℤ)) :
   120	    (x ^ M) ^ D = (x ^ (M * ℓ ^ 2)) ^ δ ↔ (orderOf x : ℤ) ∣ D - ℓ ^ 2 * δ := by
   121	  rw [← zpow_mul, ← zpow_mul, ← div_eq_one, div_eq_mul_inv, ← zpow_sub,
   122	    ← orderOf_dvd_iff_zpow_eq_one]
   123	  have e : M * D - M * ℓ ^ 2 * δ = M * (D - ℓ ^ 2 * δ) := by ring
   124	  rw [e]
   125	  exact coprime_dvd_mul_iff_int _ _ _ hM
   126	
   127	/-- **Lemma 7 (FULL in a clean block).** Let the true giant be `γ^{i*} · u^D` mod `q`
   128	(Lemma 4, with `D = (A−B)(p−1)`) and `0 ≤ i* < m`. It is FULL (equals some baby `γ^{i'}`,
   129	`0 ≤ i' < m`) iff `ord ∣ D − ℓ² δ` for some `δ ∈ [−i*, m − 1 − i*]`. -/
   130	theorem lemma7_full_iff {G : Type*} [Group G] (x : G) (M ℓ D istar m : ℤ)
   131	    (hM : IsCoprime M (orderOf x : ℤ)) :
   132	    (∃ i' : ℤ, 0 ≤ i' ∧ i' < m ∧
   133	        (x ^ (M * ℓ ^ 2)) ^ istar * (x ^ M) ^ D = (x ^ (M * ℓ ^ 2)) ^ i') ↔
   134	      (∃ δ : ℤ, -istar ≤ δ ∧ δ ≤ m - 1 - istar ∧ (orderOf x : ℤ) ∣ D - ℓ ^ 2 * δ) := by
   135	  set γ := x ^ (M * ℓ ^ 2)
   136	  have key : ∀ i' : ℤ, γ ^ istar * (x ^ M) ^ D = γ ^ i' ↔ (x ^ M) ^ D = γ ^ (i' - istar) := by
   137	    intro i'
   138	    have hsplit : γ ^ i' = γ ^ istar * γ ^ (i' - istar) := by
   139	      rw [← zpow_add]; congr 1; ring
   140	    rw [hsplit, mul_right_inj]
   141	  constructor
   142	  · rintro ⟨i', h0, hm, h⟩
   143	    refine ⟨i' - istar, by omega, by omega, ?_⟩
   144	    exact (lemma7_core x M ℓ D _ hM).1 ((key i').1 h)
   145	  · rintro ⟨δ, h0, hm, h⟩
   146	    refine ⟨δ + istar, by omega, by omega, ?_⟩
   147	    rw [key]
   148	    have : δ + istar - istar = δ := by ring
   149	    rw [this]
   150	    exact (lemma7_core x M ℓ D δ hM).2 h
   151	
   152	/-- Lemma 7 specialised to `(ZMod q)ˣ`: with a clean band (`gcd(L, q − 1) = 1`) and
   153	`M ∣ L`, the coprimality hypothesis of `lemma7_full_iff` holds for every unit `x`. -/
   154	theorem lemma7_coprime_zmod (q : ℕ) [Fact q.Prime] (x : (ZMod q)ˣ) (L M : ℕ)
   155	    (hL : Nat.Coprime L (q - 1)) (hM : M ∣ L) :
   156	    IsCoprime (M : ℤ) (orderOf x : ℤ) := by
   157	  rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_natCast_natCast]
   158	  exact coprime_of_clean L M (orderOf x) (q - 1) hL hM (ZMod.orderOf_units_dvd_card_sub_one x)
   159	
   160	end FactoringLean
