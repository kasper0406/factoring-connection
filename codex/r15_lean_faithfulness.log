    11	/-- **Counting in one residue class.** A set of naturals in `[a, a + len)` whose elements are
    12	pairwise congruent modulo `M` has at most `len / M + 1` elements. -/
    13	theorem card_le_of_pairwise_modEq (S : Finset ℕ) (a len M : ℕ)
    14	    (hS : S ⊆ Ico a (a + len)) (hcong : ∀ x ∈ S, ∀ y ∈ S, x ≡ y [MOD M]) :
    15	    S.card ≤ len / M + 1 := by
    16	  have hmaps : ∀ x ∈ S, (x - a) / M ∈ range (len / M + 1) := by
    17	    intro x hx
    18	    have hx' := mem_Ico.1 (hS hx)
    19	    rw [mem_range, Nat.lt_succ_iff]
