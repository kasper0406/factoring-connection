     7	import Mathlib
     8	
     9	namespace FactoringLean
    10	
    11	/-! ### (b) Coverage criterion -/
    12	
    13	/-- **Coverage criterion.** For a prime `ℓ` with `ℓ ∤ p` (in particular when `ℓ ∤ N = p q`),
    14	`ℓ ∣ B p² − A N  ↔  ℓ ∣ B p − A q`. -/
    15	theorem coverage_criterion (ℓ A B p q : ℤ) (hℓ : Prime ℓ) (hp : ¬ ℓ ∣ p) :
    16	    ℓ ∣ B * p ^ 2 - A * (p * q) ↔ ℓ ∣ B * p - A * q := by
    17	  have e : B * p ^ 2 - A * (p * q) = p * (B * p - A * q) := by ring
    18	  rw [e]
    19	  constructor
    20	  · intro h
    21	    rcases hℓ.dvd_or_dvd h with h | h
    22	    · exact absurd h hp
    23	    · exact h
    24	  · intro h; exact dvd_mul_of_dvd_right h p
    25	
    26	/-- Coverage criterion with the hypothesis as in the note: `ℓ ∤ N`. -/
    27	theorem coverage_criterion' (ℓ A B p q : ℤ) (hℓ : Prime ℓ) (hN : ¬ ℓ ∣ p * q) :
    28	    ℓ ∣ B * p ^ 2 - A * (p * q) ↔ ℓ ∣ B * p - A * q :=
    29	  coverage_criterion ℓ A B p q hℓ (fun h => hN (dvd_mul_of_dvd_left h q))
    30	
    31	/-- The computed roots: if `p ≡ r (mod ℓ)` then `ℓ ∣ B r² − A N ↔ ℓ ∣ B p² − A N`. So
    32	"`p mod ℓ` is a root of `B X² ≡ A N`" is the same as `ℓ ∣ B p² − A N`. -/
    33	theorem root_iff_of_modEq (ℓ A B N p r : ℤ) (h : ℓ ∣ p - r) :
    34	    ℓ ∣ B * r ^ 2 - A * N ↔ ℓ ∣ B * p ^ 2 - A * N := by
    35	  have e : B * p ^ 2 - A * N = (B * r ^ 2 - A * N) + (p - r) * (B * (p + r)) := by ring
    36	  rw [e]
    37	  exact (dvd_add_left (dvd_mul_of_dvd_left h _)).symm
    38	
    39	/-! ### (c) Lemma 1: the modulus-squared class lock -/
    40	
    41	/-- **Lemma 1 (class lock).** Let `ℓ` be prime, `N = p q`, `r` with `ℓ ∤ r` and
    42	`B r² ≡ A N (mod ℓ)`, `s ≡ N r⁻¹ (mod ℓ²)` (i.e. `ℓ² ∣ r s − N`) and
    43	`c ≡ B r + A s (mod ℓ²)`. If `p ≡ r (mod ℓ)` then `ℓ² ∣ B p + A q − c`, i.e.
    44	`g = (B p + A q − c)/ℓ²` is an integer. -/
    45	theorem lemma1_class_lock (ℓ A B p q r s c : ℤ) (hℓ : Prime ℓ) (hr : ¬ ℓ ∣ r)
    46	    (hroot : ℓ ∣ B * r ^ 2 - A * (p * q))
    47	    (hs : ℓ ^ 2 ∣ r * s - p * q)
    48	    (hc : ℓ ^ 2 ∣ c - (B * r + A * s))
    49	    (hpr : ℓ ∣ p - r) :
    50	    ℓ ^ 2 ∣ B * p + A * q - c := by
    51	  -- ℓ ∤ p since p ≡ r
    52	  have hp : ¬ ℓ ∣ p := by
    53	    intro h; apply hr
    54	    have : r = p - (p - r) := by ring
    55	    rw [this]; exact dvd_sub h hpr
    56	  -- coverage: ℓ ∣ B p − A q
    57	  have hcov : ℓ ∣ B * p - A * q :=
    58	    (coverage_criterion ℓ A B p q hℓ hp).1 ((root_iff_of_modEq ℓ A B (p * q) p r hpr).1 hroot)
    59	  obtain ⟨x, hx⟩ := hpr
    60	  obtain ⟨y, hy⟩ := hcov
    61	  obtain ⟨t, ht⟩ := hs
    62	  obtain ⟨u, hu⟩ := hc
    63	  -- r · (B p + A q − c) is an explicit multiple of ℓ²
    64	  have key : r * (B * p + A * q - c) = ℓ ^ 2 * (x * (y - x * B) - (A * t + r * u)) := by
    65	    have hp' : p = r + ℓ * x := by linarith
    66	    have hc' : c = B * r + A * s + ℓ ^ 2 * u := by linarith
    67	    have hN : A * (r * q) = A * (r * s) - A * ℓ ^ 2 * t - A * (ℓ * x * q) := by
    68	      have : r * q = p * q - ℓ * x * q := by rw [hp']; ring
    69	      rw [this]; linear_combination (-A) * ht
    70	    have hy' : r * B - A * q = ℓ * y - ℓ * x * B := by
    71	      have : r = p - ℓ * x := by linarith
    72	      rw [this]; linear_combination hy
    73	    calc r * (B * p + A * q - c)
    74	        = r * B * p + A * (r * q) - r * c := by ring
    75	      _ = ℓ * x * (r * B - A * q) - ℓ ^ 2 * (A * t + r * u) := by
    76	          rw [hN, hc', hp']; ring
    77	      _ = ℓ ^ 2 * (x * (y - x * B) - (A * t + r * u)) := by rw [hy']; ring
    78	  have hdvd : ℓ ^ 2 ∣ r * (B * p + A * q - c) := ⟨_, key⟩
    79	  have hcop : IsCoprime (ℓ ^ 2) r :=
    80	    ((Irreducible.coprime_iff_not_dvd hℓ.irreducible).2 hr).pow_left
    81	  exact hcop.dvd_of_dvd_mul_left hdvd
    82	
    83	/-! ### Distinct excluded classes (used in Lemma 9)
    84	
    85	For a prime `ℓ ∤ q`, `ℓ ∣ B p − A q` defines the class `p ≡ A q B⁻¹ (mod ℓ)`. Two weights
    86	`(A, B)`, `(A', B')` with `0 < A, B, A', B' ≤ H`, `H² < ℓ`, and `gcd(A,B) = gcd(A',B') = 1`
    87	give the same class only if they are equal. -/
    88	
    89	/-- If both `ℓ ∣ B p − A q` and `ℓ ∣ B' p − A' q` with `ℓ ∤ q` prime, then
    90	`ℓ ∣ A B' − A' B`. -/
    91	theorem same_class_dvd (ℓ A B A' B' p q : ℤ) (hℓ : Prime ℓ) (hq : ¬ ℓ ∣ q)
    92	    (h1 : ℓ ∣ B * p - A * q) (h2 : ℓ ∣ B' * p - A' * q) : ℓ ∣ A * B' - A' * B := by
    93	  have e : q * (A * B' - A' * B) = B * (B' * p - A' * q) - B' * (B * p - A * q) := by ring
    94	  have : ℓ ∣ q * (A * B' - A' * B) := by
    95	    rw [e]; exact dvd_sub (dvd_mul_of_dvd_right h2 _) (dvd_mul_of_dvd_right h1 _)
    96	  rcases hℓ.dvd_or_dvd this with h | h
    97	  · exact absurd h hq
    98	  · exact h
    99	
   100	/-- **Distinct classes.** Primitive weights in `[1, H]²` with `H² < ℓ` that cover the same
   101	class modulo a prime `ℓ ∤ q` are equal. Hence the excluded classes number exactly `|V|`. -/
   102	theorem weights_eq_of_same_class (ℓ H : ℕ) (A B A' B' : ℕ) (p q : ℤ)
   103	    (hℓ : ℓ.Prime) (hH : H ^ 2 < ℓ)
   104	    (hA : 0 < A ∧ A ≤ H) (hB : 0 < B ∧ B ≤ H) (hA' : 0 < A' ∧ A' ≤ H) (hB' : 0 < B' ∧ B' ≤ H)
   105	    (hAB : Nat.Coprime A B) (hAB' : Nat.Coprime A' B')
   106	    (hq : ¬ (ℓ : ℤ) ∣ q)
   107	    (h1 : (ℓ : ℤ) ∣ B * p - A * q) (h2 : (ℓ : ℤ) ∣ B' * p - A' * q) :
   108	    A = A' ∧ B = B' := by
