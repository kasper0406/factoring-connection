    67	    (hg : ℓ ^ 2 * g = B * p + A * q - c) :
    68	    (x ^ M) ^ (B + A * (p * q) - c) * (x ^ (M * ℓ ^ 2)) ^ (-(glo + j * m))
    69	      = (x ^ (M * ℓ ^ 2)) ^ (g - glo - j * m) := by
    70	  rw [lemma3_core p x M A B q c ℓ g hg, ← zpow_add]
    71	  congr 1; ring
