     1	/-
     2	  Theorem D′, notes/dcltheorem_results.md §3.
     3	  (g) Lemma 8: primes q with small ord_q(2) are few.
     4	-/
     5	import Mathlib
     6	
     7	namespace FactoringLean
     8	
     9	open Finset
    10	
    11	/-- A set `s` of primes, each `≥ Q`, all dividing `n ≠ 0`, satisfies `Q^|s| ≤ n`. -/
    12	theorem pow_card_le_of_primes_dvd (s : Finset ℕ) (Q n : ℕ) (hn : n ≠ 0)
    13	    (hprime : ∀ q ∈ s, q.Prime) (hQ : ∀ q ∈ s, Q ≤ q) (hdvd : ∀ q ∈ s, q ∣ n) :
    14	    Q ^ s.card ≤ n := by
    15	  have h1 : (∏ q ∈ s, q) ∣ n :=
    16	    Finset.prod_primes_dvd n (fun q hq => Nat.prime_iff.mp (hprime q hq)) hdvd
    17	  exact (Finset.pow_card_le_prod s id Q hQ).trans (Nat.le_of_dvd (Nat.pos_of_ne_zero hn) h1)
    18	
    19	/-- If `q` is an odd prime and `ord_q(2) ≤ T`, then `q ∣ 2^k − 1` for some `1 ≤ k ≤ T`. -/
    20	theorem dvd_two_pow_sub_one_of_orderOf_le (q T : ℕ) (hq : q.Prime) (hq2 : q ≠ 2)
    21	    (hT : orderOf (2 : ZMod q) ≤ T) : ∃ k, 1 ≤ k ∧ k ≤ T ∧ q ∣ 2 ^ k - 1 := by
    22	  have := Fact.mk hq
    23	  have h2 : (2 : ZMod q) ≠ 0 := by
    24	    intro h
    25	    have : q ∣ 2 := by exact_mod_cast (ZMod.natCast_eq_zero_iff 2 q).1 (by exact_mod_cast h)
    26	    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 this)
    27	  have hpow : (2 : ZMod q) ^ (q - 1) = 1 := ZMod.pow_card_sub_one_eq_one h2
    28	  have hpos : 0 < orderOf (2 : ZMod q) :=
    29	    orderOf_pos_iff.2 (isOfFinOrder_iff_pow_eq_one.2 ⟨q - 1, by have := hq.two_le; omega, hpow⟩)
    30	  refine ⟨orderOf (2 : ZMod q), hpos, hT, ?_⟩
    31	  rw [← ZMod.natCast_eq_zero_iff, Nat.cast_sub Nat.one_le_two_pow]
    32	  push_cast
    33	  rw [pow_orderOf_eq_one, sub_self]
    34	
    35	/-- Primes dividing `2^k − 1` (`k ≥ 1`) and exceeding `2^b`: at most `(k−1)/b` of them, i.e.
    36	`b · #s < k`. -/
    37	theorem card_mul_lt_of_dvd_mersenne (s : Finset ℕ) (b k : ℕ) (hk : 1 ≤ k)
    38	    (hprime : ∀ q ∈ s, q.Prime) (hbig : ∀ q ∈ s, 2 ^ b ≤ q) (hdvd : ∀ q ∈ s, q ∣ 2 ^ k - 1) :
    39	    b * s.card < k := by
    40	  have hne : 2 ^ k - 1 ≠ 0 := by
    41	    have : 2 ≤ 2 ^ k := by
    42	      calc 2 = 2 ^ 1 := by norm_num
    43	        _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    44	    omega
    45	  have h := pow_card_le_of_primes_dvd s (2 ^ b) (2 ^ k - 1) hne hprime hbig hdvd
