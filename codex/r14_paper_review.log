    36	\title[Deterministic factoring of almost all balanced semiprimes]{A deterministic
    37	algorithm that factors almost all balanced semiprimes\\ in time $N^{1/6}(\log N)^{O(1)}$}
    38	
    39	\author{[Author]}
    40	\address{[Address]}
