"""HARNESS analysis for E1-E3 (frozen with the pre-registration).  Reads
experiments/raw/detqs_e*.  Writes experiments/analysis/detqs_summary.json."""
from __future__ import annotations

import json
import math
import os
from collections import defaultdict
from typing import Dict, List

import numpy as np

from .harness import ANA, RAW, E1_M, E2_M, T_of, y_of

# model local pair ratios rho_l^model = avg_{l|k} R / avg_{l nmid k} R (frozen, from
# localmodel.pair_ratio_model at u(T/4), see prereg table)
MODEL_R = {}  # filled from prereg values at import of summarize


def _binom_two_sided(k: int, M: int, p: float) -> float:
    """Exact two-sided binomial p-value (sum of probs <= P(k)); log-space pmf
    (post-prereg fix: the float form overflowed at M = 4600; same test)."""
    def lp(j: int) -> float:
        return (math.lgamma(M + 1) - math.lgamma(j + 1) - math.lgamma(M - j + 1)
                + j * math.log(p) + (M - j) * math.log1p(-p))
    lk = lp(k)
    tot = 0.0
    for j in range(M + 1):
        lj = lp(j)
        if lj <= lk + 1e-9:
            tot += math.exp(lj)
    return min(1.0, tot)


def _var(xs: List[float]) -> float:
    m = sum(xs) / len(xs)
    return sum((x - m) ** 2 for x in xs) / len(xs)


def e1_stats(n: int) -> Dict:
    recs = [json.loads(l) for l in open(os.path.join(RAW, f"detqs_e1_n{n}.jsonl"))]
    out: Dict = {"n": n, "y": y_of(n), "T": T_of(n)}
    I = [r for r in recs if r["kind"] == "int" and not r.get("square")]
    S = [r for r in recs if r["kind"] == "sp" and not r.get("square")]
    Zi = [r["Z"] for r in I]
    Li = [r["L"] for r in I]
    Zbar = sum(Zi) / len(Zi)
    Lbar = sum(Li) / len(Li)
    V = _var([z / Zbar for z in Zi])
    VL = _var([l / Lbar for l in Li])
    corr = float(np.corrcoef(np.array(Zi, float), np.array(Li, float))[0, 1])
    c = sum(Zi) / sum(Li)
    ri = [z / (c * l) for z, l in zip(Zi, Li)]
    Vres = _var(ri)
    strata = defaultdict(list)
    for r in I:
        N = int(r["N"])
        strata[(N % 8, N % 3, N % 5)].append(r["Z"] / Zbar)
    num, den = 0.0, 0
    for v in strata.values():
        if len(v) >= 2:
            m = sum(v) / len(v)
            num += sum((x - m) ** 2 for x in v)
            den += len(v)
    Vstrat = num / den
    rs = [r["Z"] / (c * r["L"]) for r in S]
    out.update(dict(M_int=len(I), M_sp=len(S), Zbar=Zbar, V=V, poisson=1 / Zbar, VL=VL, corr=corr,
                    Vres=Vres, Vstrat=Vstrat, min_r_int=min(ri), min_r_sp=min(rs),
                    mean_r_sp=sum(rs) / len(rs), min_Z_over_fb_sp=min(r["Z"] / (r["fb"] + 2) for r in S),
                    h1_fail_sp=sum(1 for r in S if r["Z"] < r["fb"] + 2),
                    frac_Z_below_half_mean_int=sum(1 for z in Zi if z < Zbar / 2) / len(Zi)))
    out["P1a"] = V >= 10 / Zbar
    out["P1b"] = 0.4 * VL <= V <= 2.5 * VL
    out["P1c"] = corr >= 0.8
    out["P1d"] = Vres <= 0.25 * V
    out["P1e"] = Vstrat <= 0.6 * V
    out["P1f"] = min(ri) >= 0.5 and min(rs) >= 0.5
    out["P1g"] = out["h1_fail_sp"] == 0
    out["P1h"] = abs(out["mean_r_sp"] - 1) <= 0.15
    return out


def e3_stats(n: int, model: Dict[int, float]) -> Dict:
    d = np.load(os.path.join(RAW, f"detqs_e3_n{n}.npz"))
    A, G, cnt, T = d["A"], d["G"], int(d["cnt"]), int(d["T"])
    ks = np.arange(T // 8, T // 2)
    C = (A[ks] / cnt) / (G[ks] / cnt / cnt)
    out = {"n": n}
    for l in (2, 3, 5):
        a = C[ks % l == 0].mean()
        b = C[ks % l != 0].mean()
        rat = float(a / b)
        out[f"ratio_{l}"] = rat
        out[f"model_{l}"] = model[l]
        out[f"P3a_{l}"] = rat > 1
        out[f"P3b_{l}"] = 0.4 <= (rat - 1) / (model[l] - 1) <= 2.0
    return out


def e2_stats(n: int) -> Dict:
    recs = [json.loads(l) for l in open(os.path.join(RAW, f"detqs_e2_n{n}.jsonl"))]
    M = len(recs)
    dstar = [r["first_fruitful"] if r["first_fruitful"] is not None else 10 ** 6 for r in recs]
    out: Dict = {"n": n, "M": M}
    pv = {}
    for j in range(1, 6):
        k = sum(1 for d in dstar if d > j)
        pv[j] = (k, _binom_two_sided(k, M, 2.0 ** (-j)))
    out["tail_counts"] = {j: pv[j][0] for j in pv}
    out["tail_pvals"] = {j: pv[j][1] for j in pv}
    out["n_gt15"] = sum(1 for d in dstar if d > 15)
    jm = [r["jacobi_match"] for r in recs if r["jacobi_match"] is not None]
    out["jacobi_runs"] = len(jm)
    out["P2a"] = all(jm)
    out["P2b_count"] = sum(1 for j in pv if pv[j][1] >= 0.001)
    out["h1_fail"] = sum(1 for r in recs if r["Z"] < r["fb"] + 2)
    out["accidental"] = sum(1 for r in recs if r["class"] == "ACCIDENTAL")
    out["success"] = sum(1 for r in recs if r["class"] == "STRUCTURAL")
    small = [(s, o) for r in recs for s, o in zip(r["dep_sizes"], r["outcomes"]) if s <= 2]
    out["small_deps"] = len(small)
    out["P2f"] = all(o == 1 for s, o in small)
    out["mean_deps"] = sum(r["deps_tested"] for r in recs) / M
    return out


def summarize() -> None:
    from .prereg_values import MODEL_PAIR_RATIO
    res = {"E1": {}, "E2": {}, "E3": {}}
    for n in sorted(E1_M):
        if os.path.exists(os.path.join(RAW, f"detqs_e1_n{n}.jsonl")):
            res["E1"][n] = e1_stats(n)
            res["E3"][n] = e3_stats(n, MODEL_PAIR_RATIO[n])
    for n in sorted(E2_M):
        if os.path.exists(os.path.join(RAW, f"detqs_e2_n{n}.jsonl")):
            res["E2"][n] = e2_stats(n)
    # pooled E2
    allrec = []
    for n in res["E2"]:
        allrec += [json.loads(l) for l in open(os.path.join(RAW, f"detqs_e2_n{n}.jsonl"))]
    if allrec:
        M = len(allrec)
        dstar = [r["first_fruitful"] if r["first_fruitful"] is not None else 10 ** 6 for r in allrec]
        res["E2_pooled"] = {"M": M, "tail": {j: (sum(1 for d in dstar if d > j),
                                                _binom_two_sided(sum(1 for d in dstar if d > j), M, 2.0 ** (-j)))
                                             for j in range(1, 6)},
                            "n_gt15": sum(1 for d in dstar if d > 15)}
        res["E2_pooled"]["P2b_pooled"] = all(v[1] >= 0.001 for v in res["E2_pooled"]["tail"].values())
        res["E2_pooled"]["P2c"] = res["E2_pooled"]["n_gt15"] <= 2
    json.dump(res, open(os.path.join(ANA, "detqs_summary.json"), "w"), indent=1, default=str)
    print(json.dumps(res, indent=1, default=str))
"""HARNESS (diagnostic; uses primality of p, q for instance generation; never
imported by operational code).  Pre-registered experiments E1-E3 of
notes/detqs_prereg.md.

    PYTHONPATH=. .venv/bin/python -m src.detqs.harness e1 [n ...]
    PYTHONPATH=. .venv/bin/python -m src.detqs.harness e2 [n ...]
    PYTHONPATH=. .venv/bin/python -m src.detqs.harness summary

Parameters (frozen): y(n) = 2^floor(n/5); T(n) from FROZEN_T; samples from FROZEN_M.
"""
from __future__ import annotations

import json
import math
import os
import random
import sys
import time
from typing import Dict, List, Tuple

import gmpy2
import numpy as np

from .localmodel import _vdist, rho, u_blocks
from .qs import qs_run
from .sieve import factor_base, primes_upto, smooth_mask

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
RAW = os.path.join(ROOT, "experiments", "raw")
ANA = os.path.join(ROOT, "experiments", "analysis")

FROZEN_T = {40: 16, 48: 18, 56: 18, 64: 19, 72: 20, 80: 21}   # log2 T
E1_M = {40: (2000, 1000), 48: (2000, 1000), 56: (2000, 1000), 64: (2000, 1000), 72: (1000, 500)}
E2_M = {40: 1000, 48: 1000, 56: 1000, 64: 1000, 72: 400, 80: 200}
DMAX = 30


def y_of(n: int) -> int:
    return 1 << (n // 5)


def T_of(n: int) -> int:
    return 1 << FROZEN_T[n]


# ----------------------------------------------------------------- instances
def rand_int(n: int, i: int) -> int:
    rng = random.Random(f"detqs|int|{n}|{i}")
    return rng.randrange(1 << (n - 1), 1 << n)


def rand_semiprime(n: int, i: int, tag: str = "sp") -> Tuple[int, int, int]:
    """Uniform over S_n = {(p,q): p < q <= 2p primes, 2^{n-1} <= pq < 2^n} (rectangle rejection)."""
    rng = random.Random(f"detqs|{tag}|{n}|{i}")
    lo, hi = 1 << (n - 1), 1 << n
    A = int(gmpy2.isqrt(lo // 2))
    B = int(gmpy2.isqrt(hi)) + 1
    while True:
        p = rng.randrange(A, B)
        q = rng.randrange(A, 2 * B)
        if not (p < q <= 2 * p):
            continue
        N = p * q
        if not (lo <= N < hi):
            continue
        if gmpy2.is_prime(p) and gmpy2.is_prime(q):
            return N, p, q


# ----------------------------------------------------------------- local model, fast form
class LModel:
    """L(N) of localmodel.model_LN, with per-(l, u) caches (same numbers, faster)."""

    def __init__(self, n: int, y: int, T: int, nblocks: int = 8, E: int = 12):
        self.y, self.E = y, E
        self.logy = math.log(y)
        self.us, self.ws = u_blocks(n, y, T, nblocks)
        self.ps = primes_upto(y)
        self.g = {}   # (l, b) -> list g(e)
        self.den = {}
        for b, u in enumerate(self.us):
            r0 = rho(u)
            for l in self.ps:
                g = [rho(u - e * math.log(l) / self.logy) / r0 for e in range(E + 1)]
                self.g[(l, b)] = g
                self.den[(l, b)] = sum((1 - 1 / l) * l ** (-e) * g[e] for e in range(E)) + l ** (-E) * g[E]
        self.lam = {}  # (l, b, chi) -> log lambda for odd l not dividing N
        for b in range(len(self.us)):
            for l in self.ps:
                if l == 2:
                    continue
                for chi in (1, -1):
                    Nfake = self._rep(l, chi)
                    self.lam[(l, b, chi)] = math.log(self._lf(l, b, _vdist(l, Nfake, E)))
        self.cache2: Dict[Tuple[int, int], List[float]] = {}

    @staticmethod
    def _rep(l: int, chi: int) -> int:
        a = 1
        while True:
            c = 1 if pow(a, (l - 1) // 2, l) == 1 else -1
            if a % l and c == chi:
                return a
            a += 1

    def _lf(self, l: int, b: int, d: List[float]) -> float:
        g = self.g[(l, b)]
        return sum(d[e] * g[e] for e in range(self.E + 1)) / self.den[(l, b)]

    def L(self, N: int) -> float:
        tot = 0.0
        dl: Dict[int, List[float]] = {}
        chis: Dict[int, int] = {}
        for l in self.ps:
            if l == 2 or N % l == 0:
                EE = self.E
                while l ** EE > 131072:
                    EE -= 1
                key = (l, N % (l ** EE))
                if key not in self.cache2:
                    self.cache2[key] = _vdist(l, N, self.E)
                dl[l] = self.cache2[key]
            else:
                chis[l] = 1 if pow(N % l, (l - 1) // 2, l) == 1 else -1
        for b, w in enumerate(self.ws):
            s = 0.0
            for l, c in chis.items():
                s += self.lam[(l, b, c)]
            for l, d in dl.items():
                s += math.log(max(self._lf(l, b, d), 1e-300))
            tot += w * math.exp(s)
        return tot / sum(self.ws)


# ----------------------------------------------------------------- E1 + E3
def _autocorr(f: np.ndarray) -> np.ndarray:
    T = f.size
    F = np.fft.rfft(f.astype(np.float64), 2 * T)
    a = np.fft.irfft(F * np.conj(F), 2 * T)[:T]
    r = np.rint(a)
    assert np.max(np.abs(a - r)) < 0.01
    return r.astype(np.int64)


def run_e1(n: int) -> None:
    y, T = y_of(n), T_of(n)
    Mi, Ms = E1_M[n]
    model = LModel(n, y, T)
    out = open(os.path.join(RAW, f"detqs_e1_n{n}.jsonl"), "w")
    A = np.zeros(T, dtype=np.int64)   # sum_N autocorr (integers only, E3)
    F = np.zeros(T, dtype=np.int64)   # sum_N f
    cnt = 0
    t0 = time.time()
    jobs = [("int", i) for i in range(Mi)] + [("sp", i) for i in range(Ms)]
    for kind, i in jobs:
        if kind == "int":
            N = rand_int(n, i)
            p = q = None
        else:
            N, p, q = rand_semiprime(n, i)
        r = int(gmpy2.isqrt(N))
        if r * r == N:
            out.write(json.dumps({"n": n, "kind": kind, "i": i, "N": str(N), "square": True}) + "\n")
            continue
        fb = factor_base(N, y)
        mask, m, Q, fb = smooth_mask(N, y, T, fb)
        Z = int(mask.sum())
        rec = {"n": n, "kind": kind, "i": i, "N": str(N), "Z": Z, "fb": len(fb.primes),
               "fb_divides_N": fb.divides_N[:3], "L": model.L(N), "N_mod8": N % 8}
        if kind == "sp":
            rec["blum"] = bool(p % 4 == 3 and q % 4 == 3)
        out.write(json.dumps(rec) + "\n")
        if kind == "int":
            f = mask.astype(np.int64)
            A += _autocorr(f)
            F += f
            cnt += 1
    out.close()
    # E3 aggregate
    G = _autocorr(F)  # sum_t F(t) F(t+k)
    np.savez_compressed(os.path.join(RAW, f"detqs_e3_n{n}.npz"), A=A, G=G, cnt=cnt, T=T)
    print(f"E1/E3 n={n} done in {time.time()-t0:.1f}s", flush=True)


# ----------------------------------------------------------------- E2
def run_e2(n: int) -> None:
    y, T = y_of(n), T_of(n)
    out = open(os.path.join(RAW, f"detqs_e2_n{n}.jsonl"), "w")
    t0 = time.time()
    for i in range(E2_M[n]):
        N, p, q = rand_semiprime(n, i, tag="e2")
        res = qs_run(N, y, T, dmax=DMAX)
        blum = bool(p % 4 == 3 and q % 4 == 3)
        cls = "none"
        if res.factor is not None:
            cls = "STRUCTURAL" if res.how == "dependency" else "ACCIDENTAL"
            assert res.factor in (p, q) or res.how == "square"
        jac_match = None
        if blum and res.dep_outcomes:
            jac_match = all((j == -1) == bool(o) for j, o in zip(res.dep_jacobi, res.dep_outcomes))
        rec = {"n": n, "i": i, "N": str(N), "blum": blum, "Z": res.Z, "fb": res.fb_size,
               "how": res.how, "class": cls, "first_fruitful": res.first_fruitful,
               "deps_tested": res.deps_tested, "relations_used": res.relations_used,
