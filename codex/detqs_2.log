                self.g[(l, b)] = g
                self.den[(l, b)] = sum((1 - 1 / l) * l ** (-e) * g[e] for e in range(E)) + l ** (-E) * g[E]
        self.lam = {}  # (l, b, chi) -> log lambda for odd l not dividing N
        for b in range(len(self.us)):
            for l in self.ps:
