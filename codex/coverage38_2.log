"""Cost-model calculations for notes/coverage38_results.md (model level).

Cost model (multimod / below16 M+): a design is a finite set of targets; target tau has a
modulus M, a weight v of height h, a coverage weight pi (probability over the population
S_n that tau covers the true pair) and a window of w g-values.  The cost is
    X >= max(T, sqrt(sum w))      (T = number of (weight, modulus) target groups).
Window hypothesis (WIN): w_tau >= c1 * pi_tau^2 * h_tau * P  (P = sqrt N).
  * full windows:     pi ~ 1/M,              w ~ h P / M^2
  * Lehman windows:   pi ~ Delta/(M h P),    w ~ Delta^2 / (h P M^2)
Both satisfy (WIN) with equality up to constants.

Theorem U:  X >= (c P)^{2/5} * lam^{4/5} * J^{-1/5},   lam = sum pi,  J = #distinct moduli.
All floating point here is model arithmetic (exponents, constants), not factoring output.
"""
from __future__ import annotations

from math import sqrt
from typing import Dict, Iterable, List, Sequence, Tuple


# ---------------------------------------------------------------------------
# exponents
# ---------------------------------------------------------------------------
def exponent_from_theta(theta: float) -> float:
    """Worst-case exponent of N if coverage is provable at lam = J^theta (single band,
    J ~ Y): (1+theta)/(6+theta), capped at the Minkowski value 1/5."""
    return min(0.2, (1.0 + theta) / (6.0 + theta))


def theta_from_c(c: float) -> float:
    """Theorem W's c (H = sqrt(Y) J^{-c})  <->  lam = J^{1-2c}."""
    return 1.0 - 2.0 * c


def gain_factor(lam: float, J: float) -> float:
    """Cost relative to N^{1/5}: (lam^4 / J)^{1/5}  (Theorem U, attained by one band)."""
    return (lam ** 4 / J) ** 0.2


# ---------------------------------------------------------------------------
# designs
# ---------------------------------------------------------------------------
def design_stats(targets: Iterable[Tuple[int, int, float, float]], P: float) -> Dict:
    """targets: (M, h, pi, w).  Returns T, J, lam, sum_w, cost = max(T, sqrt(sum w))."""
    T = 0
    mods = set()
    lam = 0.0
    sw = 0.0
    for M, h, pi, w in targets:
        T += 1
        mods.add(M)
        lam += pi
        sw += w
    return {"T": T, "J": len(mods), "lam": lam, "sum_w": sw, "cost": max(T, sqrt(sw))}


def universal_lower_bound(lam: float, J: int, P: float, c1: float = 1.0, R: int = 1) -> float:
    """Theorem U with explicit constant: X >= (c2 P)^{2/5} lam^{4/5} J^{-1/5},
    c2 = c1 / (2 sqrt 3 R)  (R = max number of root-targets per (weight, modulus))."""
    c2 = c1 / (2.0 * sqrt(3.0) * R)
    return (c2 * P) ** 0.4 * lam ** 0.8 * J ** (-0.2)


def heights_sorted(t: int) -> List[int]:
    """Heights of the t lowest-height signed primitive weights (A != 0, B >= 1)."""
    from math import gcd
    out = []
    h = 1
    while len(out) < t:
        # weights of height exactly h
        cur = []
        for B in range(1, h + 1):
            for A in range(-h, h + 1):
                if A == 0 or max(abs(A), B) != h or gcd(abs(A), B) != 1:
                    continue
                cur.append(h)
        out.extend(cur)
        h += 1
    return out[:t]


def box_design(P: float, Y: float, J: int, H: int) -> List[Tuple[int, int, float, float]]:
    """J moduli 'near Y' (labels Y+1..Y+J; model only), all weights of height <= H,
    full windows: pi = 1/M, w = h P / M^2."""
    hs = heights_sorted_upto(H)
    out = []
    for k in range(J):
        M = int(Y) + 1 + k
        for h in hs:
            out.append((M, h, 1.0 / M, h * P / M ** 2))
    return out


def lehman_design(P: float, Y: float, J: int, H: int, Delta: float):
    hs = heights_sorted_upto(H)
    out = []
    for k in range(J):
        M = int(Y) + 1 + k
        for h in hs:
            d = min(Delta, h * P)
            out.append((M, h, d / (M * h * P), d * d / (h * P * M ** 2)))
    return out


def heights_sorted_upto(H: int) -> List[int]:
    from math import gcd
    return [max(abs(A), B) for B in range(1, H + 1) for A in range(-H, H + 1)
            if A != 0 and gcd(abs(A), B) == 1]


# ---------------------------------------------------------------------------
# closed-form optima of the two single-band families (continuous model)
# ---------------------------------------------------------------------------
def box_cost(P: float, Y: float, J: float, lam: float) -> float:
    """Full windows: T = lam Y, sum w = lam H P / Y, H = sqrt(lam Y / J)."""
    H = sqrt(lam * Y / J)
    return max(lam * Y, sqrt(lam * H * P / Y))


def lehman_cost(P: float, J: float, H: float, lam: float) -> float:
    """Lehman windows (Y free in [J, J H^2/lam]): T = J H^2, sum w = lam^2 P /(J H)."""
    return max(J * H * H, lam * sqrt(P / (J * H)))


def optimise(fn, lo: float, hi: float, iters: int = 200) -> Tuple[float, float]:
    """Golden-section on log scale (unimodal model functions)."""
    import math
    a, b = math.log(lo), math.log(hi)
    g = (sqrt(5) - 1) / 2
    for _ in range(iters):
        c = b - g * (b - a)
        d = a + g * (b - a)
        if fn(math.exp(c)) < fn(math.exp(d)):
            b = d
        else:
            a = c
    x = math.exp((a + b) / 2)
    return x, fn(x)
"""Lehman / stationary-point side of the dichotomy (notes/coverage38_results.md §4).

* lehman_factor(N, h0, X0): OPERATIONAL (sees only N).  For weights 1 <= A <= B <= h0
  (gcd 1) it scans S = ceil(2 sqrt(ABN)) .. + X0 and tests whether S^2 - 4ABN = D^2.
  The true S = Bp + Aq satisfies S^2 - 4ABN = (Bp - Aq)^2, and
  S - 2 sqrt(ABN) <= (Bp - Aq)^2 / (4 sqrt(ABN)).  Cost: sum over weights of X0 + 1
  isqrt tests (the BSGS-shared version costs ~ h0^2 + sqrt(h0^2 X0)).
* lehman_score(p, q): HARNESS.  L(p,q) = min over 1 <= B <= Bmax, A in {floor, ceil}(Bp/q)
  of max(B^2, delta^2 / (4 sqrt(ABN))), delta = Bp - Aq.  Dirichlet gives L <= C P^{2/5};
  "Lehman-easy at gain G" means L <= P^{2/5} / G.
"""
from __future__ import annotations

from math import gcd, isqrt
from typing import Optional

import numpy as np


def _proper(d: int, N: int) -> Optional[int]:
    return d if 1 < d < N and N % d == 0 else None


def lehman_factor(N: int, h0: int, X0: int) -> Optional[int]:
    """OPERATIONAL.  Returns a proper divisor or None."""
    if N < 4:
        return None
    if N % 2 == 0:
        return 2
    for B in range(1, h0 + 1):
        for A in range(1, B + 1):
            if gcd(A, B) != 1:
                continue
            k4 = 4 * A * B * N
            s0 = isqrt(k4)
            if s0 * s0 < k4:
                s0 += 1
            for S in range(s0, s0 + X0 + 1):
                d2 = S * S - k4
                D = isqrt(d2)
                if D * D == d2:
                    for c in ((S + D) // 2, (S - D) // 2):
                        r = _proper(gcd(c, N), N)
                        if r:
                            return r
    return None


def lehman_score_exact_le(p: int, q: int, X0: int, Bmax: int) -> bool:
    """HARNESS, exact: is there B <= min(Bmax, isqrt(X0)) and A >= 1 with
    delta^4 <= 16 X0^2 A B N (i.e. delta^2/(4 sqrt(ABN)) <= X0)?"""
    N = p * q
    for B in range(1, min(Bmax, isqrt(X0)) + 1):
        a0 = (B * p) // q
        for A in (a0, a0 + 1):
            if A < 1:
                continue
            d = B * p - A * q
            if d ** 4 <= 16 * X0 * X0 * A * B * N:
                return True
    return False


def lehman_score_vec(P: np.ndarray, Q: np.ndarray, Bmax: int) -> np.ndarray:
    """HARNESS.  L(p,q) as float64 (a classification statistic; thresholds are
    re-checked exactly near ties by lehman_classify)."""
    N = P.astype(np.float64) * Q.astype(np.float64)
    best = np.full(len(P), np.inf)
    for B in range(1, Bmax + 1):
        a0 = (B * P) // Q
        for A in (a0, a0 + 1):
            ok = A >= 1
            d = (B * P - A * Q).astype(np.float64)
            Af = np.maximum(A, 1).astype(np.float64)
            w = d * d / (4.0 * np.sqrt(Af * B * N))
            val = np.maximum(float(B * B), w)
            val = np.where(ok, val, np.inf)
            np.minimum(best, val, out=best)
    return best


def lehman_classify(P: np.ndarray, Q: np.ndarray, X0: int, Bmax: int,
                    score: np.ndarray = None) -> np.ndarray:
    """Exact boolean 'L(p,q) <= X0' (float score + exact re-check within 1e-6)."""
    if score is None:
        score = lehman_score_vec(P, Q, Bmax)
    easy = score <= X0
    near = np.nonzero(np.abs(score - X0) <= 1e-6 * max(1, X0))[0]
    for i in near:
        easy[i] = lehman_score_exact_le(int(P[i]), int(Q[i]), X0, Bmax)
    return easy
"""Linear-statistics barrier (notes/coverage38_results.md §3).  DIAGNOSTIC / HARNESS.

Reciprocal model.  For a pair (p, q) and band primes l, x_l = p * l^{-1} mod q.
l | Bp - Aq with |A| <~ H  <=>  B x_l mod q is ~ a multiple of l of size <~ H q / Y,
so coverage is "some x_l falls in the Farey-arc set
    S = {x in Z/q : exists 1 <= B <= H with |B x mods q| <= k0}."
K(h) = sum_l e(h x_l / q).  For fixed q, K_p(h) = K_1(h p mod q).

Exact parts: the point sets, the target set, hit counts (integers).
Floating point (numpy FFT) is used ONLY for the magnitudes |K(h)|, |S^(h)| -- the
analytic statistics whose size is the object of study; nothing is a factoring output.
"""
from __future__ import annotations

from typing import Dict, Sequence

import numpy as np


def farey_arc_set(q: int, H: int, k0: int) -> np.ndarray:
    S = np.zeros(q, dtype=bool)
    r = np.arange(-k0, k0 + 1, dtype=np.int64) % q
    for B in range(1, H + 1):
        Binv = pow(B, -1, q)
        S[(r * Binv) % q] = True
    return S


def points(p: int, q: int, band: Sequence[int]) -> np.ndarray:
    return np.array([(p * pow(l, -1, q)) % q for l in band], dtype=np.int64)


def fourier_abs(ind: np.ndarray) -> np.ndarray:
    """|sum_x ind[x] e(h x / q)| for all h (float)."""
    return np.abs(np.fft.fft(ind.astype(np.float64)))


def stats_for_p(absK1: np.ndarray, absS: np.ndarray, p: int, q: int, Q0: int) -> Dict:
    """Uses |K_p(h)| = |K_1(h p)|.  E_abs = (1/q) sum_{h != 0} |S^(h)| |K_p(h)|
    (the absolute-value Erdos-Turan error bound); Mlow = max_{1<=h<=Q0} |K_p(h)|."""
    h = np.arange(q, dtype=np.int64)
    idx = (h * p) % q
    Kp = absK1[idx]
    E_abs = float((absS[1:] * Kp[1:]).sum() / q)
    Mlow = float(Kp[1:Q0 + 1].max())
    Mall = float(Kp[1:].max())
    return {"E_abs": E_abs, "Mlow": Mlow, "Mall": Mall}


def random_complement(q: int, S: np.ndarray, J: int, rng: np.random.Generator) -> np.ndarray:
    comp = np.nonzero(~S)[0]
    return rng.choice(comp, size=J, replace=False)


def hoeffding_level(J: int, Q: int) -> float:
    """Deviation level 2 sqrt(J log(8Q)) of Prop. L (simultaneously for Q test sums
    with coefficients of modulus <= 1, failure probability <= 1/2)."""
    return 2.0 * np.sqrt(J * np.log(8.0 * Q))

