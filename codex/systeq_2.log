diff --git a/codex/scratch/systeq_2/audit_systeq.py b/codex/scratch/systeq_2/audit_systeq.py
new file mode 100644
index 0000000000000000000000000000000000000000..293119b99c7defb6f35cd3c69a727f01d28e903a
--- /dev/null
+++ b/codex/scratch/systeq_2/audit_systeq.py
@@ -0,0 +1,52 @@
+"""Read-only audit of repository inputs; outputs stay in this scratch directory."""
+import sys, json, random, math, collections
+from pathlib import Path
+ROOT = Path('/Volumes/git/factoring-connection')
+sys.path.insert(0, str(ROOT))
+from src.systeq.intanalog import vfamily_candidates, is_smooth, phi_n, ev
+import sympy as S
+
+rows=[]
+for n,m in [(5,520),(7,130),(11,19),(13,11)]:
+    N,cands=vfamily_candidates(n,m,32,200000,0)
+    trivial=[(v,r) for v,r in cands if v==r]
+    nontrivial=[(v,r) for v,r in cands if v!=r]
+    below=[(v,r) for v,r in cands if abs(v)<N]
+    obs=sum(is_smooth(v,65536) for v,r in cands)
+    nontriv_obs=sum(is_smooth(v,65536) for v,r in nontrivial)
+    row=dict(n=n,m=m,N=N,observed=obs,trivial=len(trivial),below_N=len(below),
+             nontrivial_observed=nontriv_obs,max_abs_r=max(abs(r) for v,r in cands),
+             unique_unsigned_pairs=len(set((abs(v),abs(r)) for v,r in cands)),
+             nonunit=sum(math.gcd(v,N)>1 for v,r in cands),
+             example_trivial=trivial[:1])
+    original=next(json.loads(t) for t in (ROOT/'experiments/raw/systeq_E2.jsonl').read_text().splitlines() if json.loads(t)['n']==n)
+    pred=original['predicted']['float']
+    row['G_excluding_trivial']=nontriv_obs/(pred-len(trivial))
+    rows.append(row)
+    print(json.dumps(row),flush=True)
+
+x=S.symbols('x')
+examples={}
+F=x**6-x-1
+examples['free_cyclotomic']={str(g):int(S.resultant(F,g,x)) for g in [x,x**6-1,x-1,x+1,x*x+x+1,x*x-x+1]}
+F4=S.prod(x-j for j in range(4))-x-1
+examples['falling_factorial']={'F':str(S.expand(F4)),'norms':[int(S.resultant(F4,x-j,x)) for j in range(4)],'norm_h':int(S.resultant(F4,x+1,x))}
+examples['cyclotomic_at_2']={'Phi12_2':int(S.cyclotomic_poly(12,x).subs(x,2)),'Phi6_2':int(S.cyclotomic_poly(6,x).subs(x,2))}
+Fpartial=x**6+3*x**5+7*x**4+9*x**3+7*x**2+3*x+1
+examples['partial_power']={'F':str(Fpartial),'s':11,
+    'carry_remainder':str(S.rem((x+1)**11-x**11-1,Fpartial,x)),
+    'failure_global_mod_10403':(2**11-2)%10403}
+examples['falling_factorial_N_shift']={'norm_factors':'N-1,N-2,N-3,N-4','norm_h':'N+24'}
+from itertools import product
+def variation(vals):
+    signs=[1 if v>0 else -1 for v in vals if v]
+    return sum(a!=b for a,b in zip(signs,signs[1:]))
+examples['descartes_max']={}
+for n in range(2,11):
+    max_nonzero=max(variation([a,b,c,d])+variation([a*(-1)**(n+1),b*(-1)**n,-c,d])
+        for a,b,c,d in product([-1,0,1],repeat=4) if a and d)
+    max_Dzero=max(variation([a,b,c])+variation([a*(-1)**n,b*(-1)**(n-1),c])
+        for a,b,c in product([-1,0,1],repeat=3) if a and c)
+    examples['descartes_max'][n]={'D_nonzero':max_nonzero,'D_zero_C_nonzero_after_x':max_Dzero}
+print(json.dumps(examples),flush=True)
+Path('audit_systeq.json').write_text(json.dumps({'E2':rows,'examples':examples},indent=2)+'\n')

