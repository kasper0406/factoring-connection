"""POSITIVE CONTROL: the small-characteristic systematic-equation relation family (BGJT/KW).

Setting (Kleinjung-Wesolowski 2019, Sect. 2-3.4; BGJT 2014):
  * base field k' = F_Q with Q = q^2, q = p^{e0};
  * target F_{Q^kk} = F_Q[X]/(I), I an irreducible factor of degree kk of h1 X^q - h0,
    deg h0, h1 <= 2, so that X^q == h0/h1 (mod I)   ("Frobenius is a small rational function");
  * V = span(X^{q+1}, X^q, X, 1).  For f = A X^{q+1} + B X^q + C X + D in V,
        h1 f == r_f := A X h0 + B h0 + C X h1 + D h1   (mod I),   deg r_f <= 3;
  * a RELATION is an f in P(V)(F_Q) that splits into linear factors over F_Q and whose
    r_f also splits.  The PGL_2(F_Q)-orbit of X^q - X (size q^3 + q) consists of split f.

Everything is exact.  `exhaustive_v_split` counts the split elements of P(V)(F_Q) exactly
(all ~Q^3 of them), using the fact that for f = t(x) + D the roots are the fibre t^{-1}(-D)
and that a repeated root can only sit at the unique zero of f' (= A x^q + C in char p).
"""
from __future__ import annotations

import random
from fractions import Fraction
from typing import Dict, List, Optional, Tuple

import numpy as np

from .ffield import GF, split_count_formula


def make_field(p: int, e0: int) -> Tuple[GF, int]:
    """F_{q^2} with q = p^e0. Returns (field, q)."""
    return GF(p, 2 * e0), p ** e0


def _mult_at(F: GF, f: List[int], x0: int) -> int:
    mu = 0
    while len(f) > 1 and F.peval(f, x0) == 0:
        f, rem = F.pdivmod(f, [int(F.neg[x0]), 1])
        assert not rem
        mu += 1
    return mu


def exhaustive_v_split(F: GF, q: int) -> Dict:
    """Exact enumeration of P(V)(F_Q). Returns counts and the list of split (A,B,C,D)."""
    Q = F.Q
    xs = F.elems
    xq = F.powvec(q)
    xq1 = F.mul[xq, xs]
    split: List[Tuple[int, int, int, int]] = []
    total = 0
    # case A = 1: f = x^{q+1} + B x^q + C x + D ; f' = x^q + C
    # x0 with x0^q = -C : Frobenius is a bijection, x0 = (-C)^{q^{?}}; find by table.
    inv_frob = np.zeros(Q, dtype=np.int64)
    inv_frob[xq] = xs  # xq is a permutation
    for B in range(Q):
        base = F.add[xq1, F.mul[B, xq]]
        for C in range(Q):
            t = F.add[base, F.mul[C, xs]]
            cnt = np.bincount(t, minlength=Q)
            x0 = int(inv_frob[int(F.neg[C])])
            D0 = int(F.neg[int(t[x0])])  # the only D for which x0 is a (repeated) root
            total += Q
            for val in np.nonzero(cnt >= 1)[0]:
                D = int(F.neg[int(val)])
                c = int(cnt[val])
                if D == D0:
                    f = [D, C] + [0] * (q - 2) + [B, 1]
                    mu = _mult_at(F, f, x0)
                    if c - 1 + mu == q + 1:
                        split.append((1, B, C, D))
                elif c == q + 1:
                    split.append((1, B, C, D))
    # case A = 0, B = 1: f = x^q + C x + D ; f' = C
    for C in range(Q):
        t = F.add[xq, F.mul[C, xs]]
        cnt = np.bincount(t, minlength=Q)
        total += Q
        for D in range(Q):
            if C == 0:
                split.append((0, 1, 0, D))  # (x + D^{1/q})^q
            elif cnt[int(F.neg[D])] == q:
                split.append((0, 1, C, D))
    # case A = B = 0, C = 1 (degree 1) and the constant form: always split
    for D in range(Q):
        split.append((0, 0, 1, D))
    split.append((0, 0, 0, 1))
    total += Q + 1
    assert total == (Q ** 4 - 1) // (Q - 1)
    return {"total": total, "split": split}


def orbit_size(q: int) -> int:
    """|PGL2(F_{q^2})| / |PGL2(F_q)| = q^3 + q."""
    return q ** 3 + q


def find_model(F: GF, q: int, seed: int, min_k: int = 3, tries: int = 4000):
    """Random h0, h1 of degree <= 2 with an irreducible factor I of h1 x^q - h0 of the largest
    degree kk >= min_k found (DDF piece of degree kk that is itself a single factor)."""
    rng = random.Random(f"systeq|bgjt-model|{F.Q}|{q}|{seed}")
    best = None
    for _ in range(tries):
        h0 = F.trim([rng.randrange(F.Q) for _ in range(3)])
        h1 = F.trim([rng.randrange(F.Q) for _ in range(2)] + [rng.randrange(1, F.Q)])
        if not h0:
            continue
        P = F.psub(F.pmul(h1, [0] * q + [1]), h0)
        dP = F.trim([F.m(i % F.p, c) for i, c in enumerate(P)][1:])
        if len(F.pgcd(P, dP)) > 1:
            continue
        for deg, g in F.irreducible_factors_ddf(P):
            if len(g) - 1 == deg and deg >= min_k and (best is None or deg > best[0]):
                best = (deg, h0, h1, g)
        if best is not None and best[0] >= q - 1:
            break
    if best is None:
        raise RuntimeError("no model found")
    kk, h0, h1, I = best
    return {"k": kk, "h0": h0, "h1": h1, "I": I}


def r_of(F: GF, f4, h0, h1):
    A, B, C, D = f4
    r = F.padd(F.pmul(F.trim([B, A]), h0), F.pmul(F.trim([D, C]), h1))
    return r


def f_poly(F: GF, q: int, f4):
    A, B, C, D = f4
    return F.trim([D, C] + [0] * (q - 2) + [B, A])


def relation_yield(F: GF, q: int, model: Dict, split_list) -> Dict:
    """Among split f in P(V), count those whose r_f is nonzero and splits.  Verifies
    h1 f == r_f (mod I) exactly for every relation."""
    h0, h1, I = model["h0"], model["h1"], model["I"]
    rel = 0
    checked = 0
    for f4 in split_list:
        r = r_of(F, f4, h0, h1)
        if not r:
            continue
        if F.splits(r):
            rel += 1
            f = f_poly(F, q, f4)
            lhs = F.pmod(F.psub(F.pmul(h1, f), r), I)
            assert not lhs, "congruence h1 f == r_f mod I failed"
            checked += 1
    return {"relations": rel, "verified_mod_I": checked}


def control_summary(p: int, e0: int, seed: int = 0) -> Dict:
    F, q = make_field(p, e0)
    Q = F.Q
    ex = exhaustive_v_split(F, q)
    S = len(ex["split"])
    model = find_model(F, q, seed)
    ry = relation_yield(F, q, model, ex["split"])
    sq, tq = split_count_formula(Q, q + 1)
    s3, t3 = split_count_formula(Q, 3)
    P_rand_q1 = Fraction(sq, tq)
    P_rand_3 = Fraction(s3, t3)
    frac_split = Fraction(S, ex["total"])
    Y = Fraction(ry["relations"], ex["total"])
    return {
        "p": p, "q": q, "Q": Q, "k": model["k"], "P_V": ex["total"], "split_in_V": S,
        "orbit_q3_plus_q": orbit_size(q),
        "frac_split_V": frac_split, "P_rand_split_deg_q+1": P_rand_q1,
        "G_V": frac_split / P_rand_q1,
        "relations": ry["relations"], "verified_mod_I": ry["verified_mod_I"],
        "yield_per_candidate": Y, "pred_size": P_rand_q1 * P_rand_3,
        "G_FF": Y / (P_rand_q1 * P_rand_3),
        "rel_over_factor_base": Fraction(ry["relations"], Q + 1),
    }


def classify_split(F: GF, q: int, f4) -> str:
    """'orbit' (squarefree split: exactly the PGL2(F_{q^2})-orbit of X^q - X, q^3 + q of them),
    'frobpow' ((X+b)^q (X+c) or (X+b)^q: repeated roots), or 'deg<=1'."""
    A, B, C, D = f4
    if A == 0 and B == 0:
        return "deg<=1"
    f = f_poly(F, q, f4)
    rts = F.root_multiset(f)
    return "orbit" if len(set(rts)) == len(f) - 1 else "frobpow"


def posthoc_by_type(p: int, e0: int, seed: int = 0) -> Dict:
    """POST-HOC (disclosed, not pre-registered): relation yield split by candidate type."""
    F, q = make_field(p, e0)
    ex = exhaustive_v_split(F, q)
    model = find_model(F, q, seed)
    out = {"q": q, "Q": F.Q, "P_V": ex["total"]}
    sq, tq = split_count_formula(F.Q, q + 1)
    s3, t3 = split_count_formula(F.Q, 3)
    pred = Fraction(sq, tq) * Fraction(s3, t3)
    for typ in ("orbit", "frobpow", "deg<=1"):
        lst = [f4 for f4 in ex["split"] if classify_split(F, q, f4) == typ]
        ry = relation_yield(F, q, model, lst)
        out[typ] = {"split": len(lst), "relations": ry["relations"],
                    "rel_per_split": Fraction(ry["relations"], len(lst)) if lst else None,
                    "G": Fraction(ry["relations"], ex["total"]) / pred}
    return out
"""DIAGNOSTIC checkers for the systeq barriers (they may use the factors of toy N; never
imported by operational code).  Exact arithmetic.

Prop F  (additive power maps): if z -> z^s is additive on a Z/N-algebra A, then (p-1) | (s-1)
        for every prime p dividing char A.  Checked by brute force on tiny algebras.
Lemma CF (constant field): a systematic product prod_{c in S}(T - c) vanishing on the image
        of Z in A has |S| >= p for each p | char A; over F_p[sqrt D] (D a non-residue) the
        Wilson-type identity prod_{c=0}^{p-1}(z - c) = sigma(z) - z holds.
Lemma SUB (substitution Frobenius in char 0): with sigma_q(f)(t) = f(t^q),
        sigma_q(f) g - f sigma_q(g) = (ad - bc)(t^q - t) for f = at+b, g = ct+d: the
        homography trick yields ONE relation, not q^3.
Zsigmondy: m^n - 1 (m >= 2, n >= B >= 7) is never B-smooth.
"""
from __future__ import annotations

import random
from itertools import product
from typing import List, Tuple

from sympy import Poly, symbols

from .intanalog import is_smooth


# --- Prop F ------------------------------------------------------------------------------
def _alg_mul(a, b, F, N):
    """Multiply in (Z/N)[t]/(F), F monic given low->high; elements are coefficient tuples."""
    d = len(F) - 1
    r = [0] * (2 * d - 1)
    for i, x in enumerate(a):
        for j, y in enumerate(b):
            r[i + j] += x * y
    for k in range(len(r) - 1, d - 1, -1):
        c = r[k]
        if c:
            for i in range(d + 1):
                r[k - d + i] -= c * F[i]
    return tuple(v % N for v in r[:d])


def _alg_pow(a, s, F, N):
    d = len(F) - 1
    r = tuple([1] + [0] * (d - 1))
    while s:
        if s & 1:
            r = _alg_mul(r, a, F, N)
        a = _alg_mul(a, a, F, N)
        s >>= 1
    return r


def additive_exponents(N: int, F: List[int], s_max: int) -> List[int]:
    """All s in [2, s_max] with (x+y)^s = x^s + y^s for ALL x, y in A = (Z/N)[t]/(F)."""
    d = len(F) - 1
    elems = list(product(range(N), repeat=d))
    out = []
    for s in range(2, s_max + 1):
        pw = {e: _alg_pow(e, s, F, N) for e in elems}
        ok = True
        for x in elems:
            for y in elems:
                z = tuple((u + v) % N for u, v in zip(x, y))
                if pw[z] != tuple((u + v) % N for u, v in zip(pw[x], pw[y])):
                    ok = False
                    break
            if not ok:
                break
        if ok:
            out.append(s)
    return out


# --- Lemma CF ------------------------------------------------------------------------------
def wilson_frobenius_check(p: int, D: int, trials: int = 50, seed: int = 0) -> bool:
    """In F_p[sqrt D], D a non-residue: prod_{c=0}^{p-1} (z - c) == sigma(z) - z."""
    assert pow(D % p, (p - 1) // 2, p) == p - 1
    rng = random.Random(f"systeq|wilson|{p}|{D}|{seed}")
    mul = lambda u, v: ((u[0] * v[0] + D * u[1] * v[1]) % p, (u[0] * v[1] + u[1] * v[0]) % p)
    for _ in range(trials):
        z = (rng.randrange(p), rng.randrange(p))
        pr = (1, 0)
        for c in range(p):
            pr = mul(pr, ((z[0] - c) % p, z[1]))
        sig = (z[0], (-z[1]) % p)
        if pr != ((sig[0] - z[0]) % p, (sig[1] - z[1]) % p):
            return False
    return True


def systematic_degree_lower_bound(S: List[int], p: int) -> bool:
    """prod_{c in S}(T - c) vanishes on F_p  =>  S covers all residues mod p (so |S| >= p)."""
    return {c % p for c in S} == set(range(p))


# --- Lemma SUB -----------------------------------------------------------------------------
def substitution_homography(q: int):
    a, b, c, d, t = symbols("a b c d t")
    f, g = a * t + b, c * t + d
    sf, sg = a * t ** q + b, c * t ** q + d
    lhs = Poly(sf * g - f * sg, t)
    rhs = Poly((a * d - b * c) * (t ** q - t), t)
    return lhs == rhs


# --- Zsigmondy ---------------------------------------------------------------------------
def zsigmondy_check(B: int, m_max: int, n_extra: int) -> Tuple[int, int]:
    """Count (m, n), 2 <= m <= m_max, B <= n < B + n_extra, with m^n - 1 B-smooth (expect 0)."""
    hits, tot = 0, 0
    for m in range(2, m_max + 1):
        for n in range(B, B + n_extra):
            tot += 1
            hits += is_smooth(m ** n - 1, B)
    return hits, tot

