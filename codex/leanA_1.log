    (hC0 : ∀ᶠ N : ℕ in atTop, 0 ≤ Ctrial N)
    (hTp : LBound (1 / 2) (3 * a) Tpost)
    (hp : ∀ ε > 0, ∀ᶠ N : ℕ in atTop, LN (1 / 2) (-ε) N ≤ pT N) :
