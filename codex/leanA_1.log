-- ===== statements from LeanA/Fruitfulness.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- MAIN. [pp] Theorem thm:DD, exact form. Let `N > 1` be odd. Fix the squares `R` and the coins
`ξ`, and suppose the dependency `S(R, ξ)` is nonempty and `X² = Y²` holds on the fibre, where
`X = ∏_{i ∈ S} r_i`. Then among the roots `r` with `r_i² = R_i`, exactly the proportion
`1 − 2/|μ₂(ℤ/N)|` has `1 < gcd(X − Y, N) < N`. -/
theorem dixon_descent (N : ℕ) [NeZero N] (hodd : Odd N) (h1 : 1 < N) {n : ℕ} {Ξ : Type*}
    (S : (Fin n → (ZMod N)ˣ) → Ξ → Finset (Fin n))
    (Y : (Fin n → (ZMod N)ˣ) → Ξ → (ZMod N)ˣ)
    (R : Fin n → (ZMod N)ˣ) (ξ : Ξ) (hne : (S R ξ).Nonempty)
    (hsq : ∀ r : Fin n → (ZMod N)ˣ, (∀ i, r i ^ 2 = R i) →
      (∏ i ∈ S R ξ, r i) ^ 2 = (Y R ξ) ^ 2) :
    ((univ.filter (fun r : Fin n → (ZMod N)ˣ => (∀ i, r i ^ 2 = R i) ∧
        ProperGcd N (((∏ i ∈ S R ξ, r i : (ZMod N)ˣ) : ZMod N) - ((Y R ξ : (ZMod N)ˣ) : ZMod N)))).card
        : ℝ) =
      (1 - 2 / ((muTwo N).card : ℝ)) *
        ((univ.filter (fun r : Fin n → (ZMod N)ˣ => ∀ i, r i ^ 2 = R i)).card : ℝ) := by
  sorry

/-- MAIN. `|μ₂(ℤ/N)| = 2^{ω(N)}` for odd `N ≥ 1` ([pp] §sec:notation). -/
theorem card_muTwo (N : ℕ) [NeZero N] (hodd : Odd N) :
    (muTwo N).card = 2 ^ omega N := by
  sorry

/-- MAIN. Consequently the fruitfulness probability of Theorem DD is `1 − 2^{1−ω(N)} ≥ 1/2`
when `N` is odd with `ω(N) ≥ 2`. -/
theorem dd_prob_ge_half (N : ℕ) [NeZero N] (hodd : Odd N) (hω : 2 ≤ omega N) :
    1 - 2 / ((muTwo N).card : ℝ) = 1 - 2 ^ (1 - (omega N : ℤ)) ∧
      (1 : ℝ) / 2 ≤ 1 - 2 / ((muTwo N).card : ℝ) := by
  sorry

/-- MAIN. For `ζ ∈ μ₂(ℤ/N)` with `N` odd: `gcd(ζ − 1, N)` is proper iff `ζ ≠ ±1`
(the last step of the proof of Theorem DD). -/
theorem properGcd_iff_ne_pm_one (N : ℕ) [NeZero N] (hodd : Odd N) (h1 : 1 < N)
    (ζ : (ZMod N)ˣ) (hζ : ζ ^ 2 = 1) :
    ProperGcd N ((ζ : ZMod N) - 1) ↔ ζ ≠ 1 ∧ ζ ≠ -1 := by
  sorry

end FactoringA

-- ===== statements from LeanA/SplitCounting.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- MAIN. `[(ℤ/N)ˣ : Q_N] = |μ₂(ℤ/N)|` (squaring is a homomorphism with kernel `μ₂`), so for odd `N`
the index is `2^{ω(N)}`. -/
theorem card_unitSquares_mul (N : ℕ) [NeZero N] :
    (unitSquares N).card * (muTwo N).card = Fintype.card (ZMod N)ˣ := by
  sorry

/-- MAIN. [pp] Theorem thm:S (split counting; ratio form of the Dixon–Pomerance lemma), probability
bound. -/
theorem split_counting (N : ℕ) [NeZero N] (hodd : Odd N) (Y' : ℝ) (hY : 2 ≤ Y')
    (hYN : 2 * Y' ^ 2 < N) (S : Finset ℕ)
    (hS : ∀ s ∈ S, Y' / 2 ≤ (s : ℝ) ∧ (s : ℝ) ≤ Y' ∧ Nat.Coprime s N) :
    (S.card : ℝ) ^ 4 / (2 * 2 ^ omega N * (Nat.totient N : ℝ) * Y' ^ 2 * (1 + Real.log Y')) ≤
      prob (unitSquares N) (fun R => SplitEvent N S (R : ZMod N)) := by
  sorry

/-- MAIN. [pp] Theorem thm:S, second part: if `2Y'² < N`, `u, v ∈ [1, Y']` and `u ≡ R v`, then
`(u, v)` is an integer multiple of every shortest nonzero vector of `Λ_R`. -/
theorem split_multiple_of_shortest (N : ℕ) (Y' : ℝ) (hYN : 2 * Y' ^ 2 < N) (R : ZMod N)
    (u v : ℕ) (hu : 1 ≤ u) (hv : 1 ≤ v) (huY : (u : ℝ) ≤ Y') (hvY : (v : ℝ) ≤ Y')
    (huv : (u : ZMod N) = R * (v : ZMod N)) (x y : ℤ) (hxy : IsShortestVec N R x y) :
    ∃ j : ℤ, (u : ℤ) = j * x ∧ (v : ℤ) = j * y := by
  sorry

/-- MAIN. [pp] Theorem thm:Sprime (k-products). `D` is a set of primes in a dyadic interval
`(Z, 2Z]`, all coprime to `N`, with `|D| ≥ 4k²`; `S` is a set of products of exactly `k` distinct
primes of `D` in the window `[Y'/2, Y']`, `2Y'² < N`, and `|S| ≥ C(|D|, k)/(2k)`. -/
theorem split_counting_kprod (N : ℕ) [NeZero N] (hodd : Odd N) (k : ℕ) (hk : 1 ≤ k) (Z : ℕ)
    (D : Finset ℕ) (hD : ∀ p ∈ D, p.Prime ∧ Z < p ∧ p ≤ 2 * Z ∧ Nat.Coprime p N)
    (hDcard : 4 * k ^ 2 ≤ D.card) (Y' : ℝ) (hYN : 2 * Y' ^ 2 < N) (S : Finset ℕ)
    (hSsub : S ⊆ kProducts D k) (hSwin : ∀ s ∈ S, Y' / 2 ≤ (s : ℝ) ∧ (s : ℝ) ≤ Y')
    (hScard : (Nat.choose D.card k : ℝ) / (2 * k) ≤ S.card) :
    (S.card : ℝ) ^ 2 / (cK k * 2 ^ omega N * (Nat.totient N : ℝ)) ≤
      prob (unitSquares N) (fun R => SplitEvent N S (R : ZMod N)) := by
  sorry

/-- MAIN. [pp] Theorem thm:K, combinatorial core. Let `N` be odd, `X` with `2X² < N`, and `Y` with
`(2Y)^k ≤ X < (4Y)^k` (as for `J = (Y, 2Y]` in [pp] §sec:params). Let `D ⊆ J` be primes coprime to
`N` with `|D| ≥ 4k²`. For `r` uniform on `[1, N−1]`, with probability at least
`(|D|/k)^{2k} / (4k² c_k 2^{ω(N)} N)` the root `r` is a unit and every shortest nonzero vector
`(u₀, v₀)` of `Λ_{r²}` has `u₀v₀ ≠ 0` and both `|u₀|`, `|v₀|` products of at most `k` distinct
primes of `D` (so the shape test of DESCEND_ONCE passes with targets in `D`). -/
theorem complete_descent_prob (N k X Y : ℕ) [NeZero N] (hodd : Odd N) (hk : 1 ≤ k)
    (hXN : 2 * X ^ 2 < N) (hYX : (2 * Y) ^ k ≤ X) (hXY : X < (4 * Y) ^ k)
    (D : Finset ℕ) (hD : ∀ p ∈ D, p.Prime ∧ Y < p ∧ p ≤ 2 * Y ∧ Nat.Coprime p N)
    (hDcard : 4 * k ^ 2 ≤ D.card) :
    ((D.card : ℝ) / k) ^ (2 * k) / (4 * (k : ℝ) ^ 2 * cK k * 2 ^ omega N * N) ≤
      prob (Icc 1 (N - 1)) (fun r : ℕ => IsUnit (r : ZMod N) ∧
        ∀ x y : ℤ, IsShortestVec N ((r : ZMod N) ^ 2) x y →
          x * y ≠ 0 ∧ IsProdAtMostK D k x.natAbs ∧ IsProdAtMostK D k y.natAbs) := by
  sorry

end FactoringA

-- ===== statements from LeanA/Moments.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- MAIN. [pp] Lemma lem:revmarkov (reverse Markov): if `Z ∈ [0, 1]` and `E Z ≥ β`, then
`Pr[Z ≥ β/2] ≥ β/2`. -/
theorem reverse_markov {α : Type*} (s : Finset α) (Z : α → ℝ) (hZ : ∀ x ∈ s, 0 ≤ Z x ∧ Z x ≤ 1)
    (β : ℝ) (hβ : β ≤ expect s Z) :
    β / 2 ≤ prob s (fun x => β / 2 ≤ Z x) := by
  sorry

/-- MAIN. [hypD] Prop PZ / [pp] Theorem thm:Dk, Paley–Zygmund in the form used there:
for a nonnegative integer count `X` with `E X > 0`,
`Pr[X ≥ 1] ≥ (E X)² / (E[X(X−1)] + E X)`. No lower bound `E X ≥ 1` is needed. -/
theorem paley_zygmund {α : Type*} (s : Finset α) (X : α → ℕ)
    (hpos : 0 < expect s (fun x => (X x : ℝ))) :
    (expect s (fun x => (X x : ℝ))) ^ 2 /
        (expect s (fun x => (X x : ℝ) * ((X x : ℝ) - 1)) + expect s (fun x => (X x : ℝ))) ≤
      prob s (fun x => 1 ≤ X x) := by
  sorry

/-- MAIN. [pp] Theorem thm:Dk, assembly: if `E X ≥ m/P` and `E[X(X−1)] ≤ P m²` with `m, P > 0`,
then `Pr[X ≥ 1] ≥ 1/(P³ + P/m)`. -/
theorem relation_supply_from_moments {α : Type*} (s : Finset α) (X : α → ℕ) (m P : ℝ)
    (hm : 0 < m) (hP : 0 < P)
    (h1 : m / P ≤ expect s (fun x => (X x : ℝ)))
    (h2 : expect s (fun x => (X x : ℝ) * ((X x : ℝ) - 1)) ≤ P * m ^ 2) :
    1 / (P ^ 3 + P / m) ≤ prob s (fun x => 1 ≤ X x) := by
  sorry

/-- MAIN. [pp] Prop. prop:select(ii), the harmonic-mean identity. Let fields `A` be uniform on `s`,
`ς_A ∈ [0, 1]` the per-call row probability, `b = E ς > 0`, and let the kept field have law
`ς_A/(b·|s|)`. Then `E[1/ς_{A*}] = Pr[ς > 0]/b ≤ 1/b` (with `1/0 = 0`). -/
theorem harmonic_mean_identity {α : Type*} (s : Finset α) (ς : α → ℝ)
    (hς : ∀ A ∈ s, 0 ≤ ς A ∧ ς A ≤ 1) (hb : 0 < expect s ς) :
    ∑ A ∈ s, (ς A / (expect s ς * s.card)) * (1 / ς A) = prob s (fun A => 0 < ς A) / expect s ς ∧
      ∑ A ∈ s, (ς A / (expect s ς * s.card)) * (1 / ς A) ≤ 1 / expect s ς := by
  sorry

/-- MAIN. [pp] Prop. prop:select(ii), cost bookkeeping. With trial success probability `p ≥ b > 0`
(`b = E ς`), selection cost `C/p`, the kept-field branch reached with probability `b/p` and costing
at most `2(M·C/ς_A + T)` given `A* = A` (two expected DD rounds), the total is
`≤ 3(M·C + T)/p`. -/
theorem split_cost_bookkeeping {α : Type*} (s : Finset α) (ς : α → ℝ)
    (hς : ∀ A ∈ s, 0 ≤ ς A ∧ ς A ≤ 1) (hb : 0 < expect s ς) (p M C T : ℝ)
    (hp : expect s ς ≤ p) (hM : 1 ≤ M) (hC : 0 ≤ C) (hT : 0 ≤ T) :
    C / p + (expect s ς / p) *
        ∑ A ∈ s, (ς A / (expect s ς * s.card)) * (2 * (M * C * (1 / ς A) + T)) ≤
      3 * (M * C + T) / p := by
  sorry

/-- PUBLISHED INPUT (Brun–Titchmarsh). H. L. Montgomery and R. C. Vaughan, *The large sieve*,
Mathematika 20 (1973), 119–134, Theorem 2: for positive reals `x, y` and coprime positive integers
`q, a` with `y > q`, `π(x+y; q, a) − π(x; q, a) < 2y/(φ(q) log(y/q))`. -/
def BrunTitchmarsh : Prop :=
  ∀ (x y : ℝ) (q a : ℕ), 0 < x → 0 < y → 1 ≤ q → 1 ≤ a → Nat.Coprime a q → (q : ℝ) < y →
    (primeCountAP (x + y) q a : ℝ) - primeCountAP x q a <
      2 * y / ((Nat.totient q : ℝ) * Real.log (y / q))

/-- PUBLISHED INPUT (Rosser–Schoenfeld). J. B. Rosser and L. Schoenfeld, *Approximate formulas
for some functions of prime numbers*, Illinois J. Math. 6 (1962), 64–94: Corollary 1
(`π(z) < 1.25506 z/log z` for `z > 1`) and Corollary 3 (`π(2z) − π(z) > 3z/(5 log z)` for
`z ≥ 20.5`). -/
def RosserSchoenfeld : Prop :=
  (∀ z : ℝ, 1 < z → (Nat.primeCounting ⌊z⌋₊ : ℝ) < 1.25506 * z / Real.log z) ∧
    (∀ z : ℝ, 20.5 ≤ z →
      3 * z / (5 * Real.log z) < (Nat.primeCounting ⌊2 * z⌋₊ : ℝ) - Nat.primeCounting ⌊z⌋₊)

/-- MAIN. [pp] Lemma lem:W (residue spreading), from Brun–Titchmarsh and Rosser–Schoenfeld: for `w`
uniform among the primes of `(W, 2W]`, every modulus `1 ≤ t < W` and residue `r`,
`Pr[w ≡ r (mod t)] ≤ (24/η₀)/φ(t)`, provided `log W ≤ 2 log N` and `log(W/t) ≥ (η₀/3) log N`. -/
theorem residue_spreading (hBT : BrunTitchmarsh) (hRS : RosserSchoenfeld) (N W t r : ℕ)
    (η₀ : ℝ) (hη : 0 < η₀) (hN : 2 ≤ N) (ht : 1 ≤ t) (htW : t < W) (hW : 21 ≤ W)
    (hlogW : Real.log W ≤ 2 * Real.log N)
    (hgap : η₀ / 3 * Real.log N ≤ Real.log ((W : ℝ) / t)) :
    prob (primesIoc W (2 * W)) (fun w => w ≡ r [MOD t]) ≤ (24 / η₀) / (Nat.totient t : ℝ) := by
  sorry

end FactoringA

