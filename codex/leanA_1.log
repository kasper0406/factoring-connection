      ((portfolioParams j).θ : ℝ) < 3 / ((2 * j + 7 : ℝ) + 1) + 5 / (2 * j + 7 : ℝ) ^ 2) ∧
    Filter.Tendsto (fun j => ((portfolioParams j).θ : ℝ)) Filter.atTop (nhds 0) := by
