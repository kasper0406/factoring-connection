    (hrec : ∀ᶠ x in atTop, F x ≤ 2 * Real.logb 2 x * (Pc x + D x * F (Real.sqrt (2 * x)))) :
    LBound (2 / 5) (max (max (2 * a) (a + s + max a σ)) ((a + s) / (1 - 2 ^ (-(2 / 5 : ℝ)))))
      (fun N => F N) := by
