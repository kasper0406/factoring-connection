namespace FactoringA

open Real Finset Filter Topology

/-- MAIN. [pp] Lemma lem:GB: `F̂(g₀, g₁) = T`. -/
theorem gb_identity (g0 g1 T : ℤ) (d : ℕ) (hg1 : 2 ≤ g1) (hcop : IsCoprime g0 g1) :
    gbForm g0 g1 T d g0 g1 = T := by
  sorry

/-- MAIN. [pp] Lemma lem:GB: `|a_i| ≤ g₁/2` for `1 ≤ i ≤ d`. -/
theorem gb_digit_bound (g0 g1 T : ℤ) (d i : ℕ) (hg1 : 2 ≤ g1) (hi1 : 1 ≤ i) (hid : i ≤ d) :
    2 * |gbCoeff g0 g1 T d i| ≤ g1 := by
  sorry

/-- MAIN. [pp] Lemma lem:GB: if `g₀, g₁ ∈ [M/2, M]` then `|a₀| ≤ 2^d T/M^d + d 2^{d−1} M`. -/
theorem gb_a0_bound (g0 g1 T : ℤ) (d : ℕ) (M : ℝ) (hg1 : 2 ≤ g1) (hcop : IsCoprime g0 g1)
    (hT : 0 ≤ T) (h0 : M / 2 ≤ g0) (h0' : (g0 : ℝ) ≤ M) (h1 : M / 2 ≤ g1) (h1' : (g1 : ℝ) ≤ M) :
    |(gbCoeff g0 g1 T d 0 : ℝ)| ≤ 2 ^ d * T / M ^ d + d * 2 ^ (d - 1) * M := by
  sorry

/-- MAIN. [pp] Lemma lem:GB: `a_d ≢ 0 (mod g₁)` when `T` is a unit modulo `g₁`. -/
theorem gb_ad_not_dvd (g0 g1 T : ℤ) (d : ℕ) (hd : 1 ≤ d) (hg1 : 2 ≤ g1)
    (hcop : IsCoprime g0 g1) (hT : IsCoprime T g1) :
    ¬ g1 ∣ gbCoeff g0 g1 T d d := by
  sorry

/-- MAIN. [pp] Lemma lem:homog: `g₁^d F_A(P) ≡ T b^d (mod G(P))`. -/
theorem homogeneity (g0 g1 T : ℤ) (d : ℕ) (c : Fin d → ℤ) (a b : ℤ) (hg1 : 2 ≤ g1)
    (hcop : IsCoprime g0 g1) :
    g1 ^ d * FA g0 g1 T d c a b ≡ T * b ^ d [ZMOD Gform g0 g1 a b] := by
  sorry

/-- MAIN. [pp] Lemma lem:coprime (coprimality and the forced residue). Here `T = N w`,
`t = |G(P)| = ℓ|n|` with `n = G(P)/ℓ` `B`-smooth, `b` a prime with `B < b < ℓ`, `ℓ ∤ N` prime,
every prime factor of `N` exceeds `B`, and `w > t` is prime. Then `gcd(t, b g₁ N w) = 1` and
`F̂(P) ≡ N b^d g₁^{−d} w (mod t)`. -/
theorem forced_residue (N w B ℓ : ℕ) (g0 g1 a b : ℤ) (d : ℕ) (hg1 : 2 ≤ g1)
    (hcop : IsCoprime g0 g1) (hb : (b.natAbs).Prime) (hb0 : 0 < b) (hBb : (B : ℤ) < b)
    (hbℓ : b < ℓ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hdiv : (ℓ : ℤ) ∣ Gform g0 g1 a b)
    (hsm : IsSmooth B (Gform g0 g1 a b / ℓ)) (hNB : ∀ p : ℕ, p.Prime → p ∣ N → B < p)
    (hw : w.Prime) (hwt : |Gform g0 g1 a b| < w) :
    Nat.Coprime (Gform g0 g1 a b).natAbs (b.natAbs * g1.natAbs * N * w) ∧
      ((gbForm g0 g1 ((N : ℤ) * w) d a b : ℤ) : ZMod (Gform g0 g1 a b).natAbs) =
        (N : ZMod (Gform g0 g1 a b).natAbs) * (b : ZMod (Gform g0 g1 a b).natAbs) ^ d *
          ((g1 : ZMod (Gform g0 g1 a b).natAbs)⁻¹) ^ d * (w : ZMod (Gform g0 g1 a b).natAbs) := by
  sorry

/-- MAIN. [pp] Lemma lem:kern(ii): for primitive `P = (a, b)`, `P′ = (a′, b′)` with `b, b′ ≥ 1`
and `Δ ≠ 0`, `ker Φ` consists exactly of the coefficient vectors of `Q·E` with
`Q = (bx − ay)(b′x − a′y)` and `E` a form of degree `d − 3`; in coordinates
`c_i = bb′ e_i − (ab′ + a′b) e_{i−1} + aa′ e_{i−2}` (with `e_j = 0` outside `[0, d−3]`). -/
theorem kern_kernel (d : ℕ) (hd : 3 ≤ d) (a b a' b' : ℤ) (hb : 1 ≤ b) (hb' : 1 ≤ b')
    (hP : IsCoprime a b) (hP' : IsCoprime a' b') (hΔ : a * b' - a' * b ≠ 0) (c : Fin d → ℤ) :
    PhiK d a b a' b' c = (0, 0) ↔
      ∃ e : ℕ → ℤ, (∀ j, d - 2 ≤ j → e j = 0) ∧
        ∀ i : Fin d, c i = b * b' * e i - (a * b' + a' * b) * (if 1 ≤ (i : ℕ) then e (i - 1) else 0) +
          a * a' * (if 2 ≤ (i : ℕ) then e (i - 2) else 0) := by
  sorry

/-- MAIN. Lemma Kern-U (lv5unif §3), count: every fibre of `Φ` on `C_H` has at most
`(⌊2H/(bb′)⌋ + 1)^{d−2}` points. -/
theorem kernU_count (d : ℕ) (hd : 3 ≤ d) (a b a' b' : ℤ) (hb : 1 ≤ b) (hb' : 1 ≤ b')
    (hP : IsCoprime a b) (hP' : IsCoprime a' b') (hΔ : a * b' - a' * b ≠ 0) (H : ℕ)
    (z : ℤ × ℤ) :
    (((cube d H).filter (fun c => PhiK d a b a' b' c = z)).card : ℤ) ≤
      ((2 * (H : ℤ)) / (b * b') + 1) ^ (d - 2) := by
  sorry

/-- MAIN. Lemma Kern-U (lv5unif §3), probability: if `bb′ d ≤ 2H + 1` then
`Pr_{c ∈ C_H}[Φ(c) = z] ≤ e/((2H+1)² (bb′)^{d−2})`. -/
theorem kernU_prob (d : ℕ) (hd : 3 ≤ d) (a b a' b' : ℤ) (hb : 1 ≤ b) (hb' : 1 ≤ b')
    (hP : IsCoprime a b) (hP' : IsCoprime a' b') (hΔ : a * b' - a' * b ≠ 0) (H : ℕ)
    (hH : b * b' * d ≤ 2 * (H : ℤ) + 1) (z : ℤ × ℤ) :
    prob (cube d H) (fun c => PhiK d a b a' b' c = z) ≤
      Real.exp 1 / ((2 * (H : ℝ) + 1) ^ 2 * ((b * b' : ℤ) : ℝ) ^ (d - 2)) := by
  sorry

/-- MAIN. [pp] Lemma lem:kern(iii) in the form used for Theorem A (explicit `C_d = 3^{d−2}/2^d`):
if `|a|, |b|, |a′|, |b′| ≤ V` and `H ≥ 4V²` then
`Pr_{c ∈ C_H}[Φ(c) = z] ≤ 3^{d−2}/(2^d H² (bb′)^{d−2})`. -/
theorem kern_prob (d : ℕ) (hd : 3 ≤ d) (a b a' b' : ℤ) (hb : 1 ≤ b) (hb' : 1 ≤ b')
    (hP : IsCoprime a b) (hP' : IsCoprime a' b') (hΔ : a * b' - a' * b ≠ 0) (H V : ℕ)
    (ha : |a| ≤ V) (hbV : b ≤ V) (ha' : |a'| ≤ V) (hbV' : b' ≤ V) (hH : 4 * V ^ 2 ≤ H)
    (z : ℤ × ℤ) :
    prob (cube d H) (fun c => PhiK d a b a' b' c = z) ≤
      3 ^ (d - 2) / (2 ^ d * (H : ℝ) ^ 2 * ((b * b' : ℤ) : ℝ) ^ (d - 2)) := by
  sorry

/-- MAIN. [pp] Lemma lem:pairs. Let `ℓ` be prime, `g = (g₀, g₁)` coprime, and `P ≠ P′` points
`(a, b)` with `b > 0`, `gcd(a, b) = 1`, `|a|, |b| ≤ V`, both in `Λ_ℓ(g) = {ℓ ∣ g₁x − g₀y}`.
Then `Δ = det(P, P′) ≠ 0`, `ℓ ∣ Δ` and `|Δ| ≤ 2V²` (so `q = |Δ|/ℓ ≤ 2S²` when `V² ≤ ℓS²`). -/
theorem pairs (ℓ : ℕ) (hℓ : ℓ.Prime) (g0 g1 : ℤ) (hg : IsCoprime g0 g1) (V : ℕ)
    (a b a' b' : ℤ) (hb : 0 < b) (hb' : 0 < b') (hP : IsCoprime a b) (hP' : IsCoprime a' b')
    (ha : |a| ≤ V) (hbV : b ≤ V) (ha' : |a'| ≤ V) (hbV' : b' ≤ V)
    (hL : (ℓ : ℤ) ∣ Gform g0 g1 a b) (hL' : (ℓ : ℤ) ∣ Gform g0 g1 a' b') (hne : (a, b) ≠ (a', b')) :
    a * b' - a' * b ≠ 0 ∧ (ℓ : ℤ) ∣ a * b' - a' * b ∧ |a * b' - a' * b| ≤ 2 * (V : ℤ) ^ 2 := by
  sorry

/-- MAIN. [pp] Lemma lem:pairs, multiplicity: for `P = (a, b)` with `2b > V` and `D ∈ ℤ`, at most
`6` points `P′ ∈ [−V, V]²` have `det(P, P′) = D`. -/
theorem pairs_count (V : ℕ) (a b : ℤ) (hb : (V : ℤ) < 2 * b) (hP : IsCoprime a b) (D : ℤ) :
    ((((Icc (-(V : ℤ)) V) ×ˢ (Icc (-(V : ℤ)) V)).filter
      (fun Q : ℤ × ℤ => a * Q.2 - Q.1 * b = D)).card) ≤ 6 := by
  sorry

end FactoringA

-- ===== statements from LeanA/Recursion.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- MAIN. Lemma F_α (lv5unif §10; [pp] Lemma lem:F is `α = 1/2`). Let `F` be nonnegative and
nondecreasing on `[2, ∞)` and suppose, for `x ≥ x₀`,
`F(x) ≤ L_x^{p+ε(x)} + L_x^{δ+ε(x)} F(√(2x))` with `ε(x) → 0`, where `L_x^{b} = LN α b x`.
Then `F(x) ≤ L_x^{c+o(1)}` with `c = max(p, δ/(1 − 2^{−α}))`: for every `η > 0` there is `K` with
`F(x) ≤ K L_x^{c+η}` for all `x ≥ 2`. -/
theorem lemmaF (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (F : ℝ → ℝ)
    (hF0 : ∀ x, 2 ≤ x → 0 ≤ F x) (hmono : MonotoneOn F (Set.Ici 2))
    (p δ : ℝ) (hp : 0 ≤ p) (hδ : 0 ≤ δ) (ε : ℝ → ℝ) (hε : Tendsto ε atTop (𝓝 0)) (x₀ : ℝ)
    (hrec : ∀ x, x₀ ≤ x →
      F x ≤ LN α (p + ε x) x + LN α (δ + ε x) x * F (Real.sqrt (2 * x))) :
    ∀ η > 0, ∃ K : ℝ, ∀ x, 2 ≤ x → F x ≤ K * LN α (max p (δ / (1 - 2 ^ (-α))) + η) x := by
  sorry

/-- MAIN. The form of Lemma F used for Theorems RA and U: the recursion inequality of [pp]
Theorem thm:RA, `F(x) ≤ 2 log₂x [P(x) + 2 D(x) F(√(2x))]` with `P(x) ≤ L_x^{p+o(1)}` and
`D(x) ≤ L_x^{δ+o(1)}`, gives `F(x) ≤ L_x^{max(p, δ/(1−2^{−α}))+o(1)}`. -/
theorem lemmaF_logfactor (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (F P D : ℝ → ℝ)
    (hF0 : ∀ x, 2 ≤ x → 0 ≤ F x) (hmono : MonotoneOn F (Set.Ici 2))
    (p δ : ℝ) (hp : 0 ≤ p) (hδ : 0 ≤ δ)
    (hP : ∀ η > 0, ∀ᶠ x in atTop, P x ≤ LN α (p + η) x)
    (hD : ∀ η > 0, ∀ᶠ x in atTop, D x ≤ LN α (δ + η) x)
    (hD0 : ∀ᶠ x in atTop, 0 ≤ D x)
    (hrec : ∀ᶠ x in atTop, F x ≤ 2 * Real.logb 2 x * (P x + 2 * D x * F (Real.sqrt (2 * x)))) :
    ∀ η > 0, ∃ K : ℝ, ∀ x, 2 ≤ x → F x ≤ K * LN α (max p (δ / (1 - 2 ^ (-α))) + η) x := by
  sorry

/-- MAIN. [pp] Corollary cor:P, the series of the restart schedule:
`2^{s₀+1} + Σ_{m ≥ 1} 2^{s₀+m} 2^{−m(m+1)/2} ≤ 4·2^{s₀}`. -/
theorem restart_series (s₀ : ℕ) :
    (2 : ℝ) ^ (s₀ + 1) + ∑' m : ℕ, (2 : ℝ) ^ (s₀ + (m + 1)) * (2 : ℝ)⁻¹ ^ ((m + 1) * (m + 2) / 2) ≤
      4 * 2 ^ s₀ := by
  sorry

/-- MAIN. [pp] Corollary cor:P, assembly: if `T_j(N) ≤ L_N[1/2, c_j + o(1)]` for each `j`, with
`c_j → 0`, and for each `j` the portfolio's expected time is eventually at most
`K_j (log N)^{K_j} T_j(N)`, then the portfolio runs in `L_N[1/2, o(1)]`. -/
theorem portfolio_assembly (T : ℕ → ℝ) (Tj : ℕ → ℕ → ℝ) (c : ℕ → ℝ)
    (hc : Tendsto c atTop (𝓝 0)) (hTj : ∀ j, LBound (1 / 2) (c j) (Tj j))
    (hport : ∀ j, ∃ K : ℝ, 0 ≤ K ∧ ∀ᶠ N : ℕ in atTop, T N ≤ K * (Real.log N) ^ K * Tj j N) :
    LBound (1 / 2) 0 T := by
  sorry

end FactoringA

-- ===== statements from LeanA/RelationSupply.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- PUBLISHED INPUT (Canfield–Erdős–Pomerance). E. R. Canfield, P. Erdős and C. Pomerance, *On a
problem of Oppenheim concerning "factorisatio numerorum"*, J. Number Theory 17 (1983), 1–28,
Corollary to Theorem 3.1 ([pp] Fact fact:CEP): for each `ε > 0`, uniformly for `u → ∞` with
`u ≤ (1 − ε) log x / log log x`, `Ψ(x, x^{1/u}) = x u^{−u(1+o(1))}`. -/
def CEP : Prop :=
  ∀ ε > 0, ∀ δ > 0, ∃ U₀ : ℝ, ∀ x u : ℝ, U₀ ≤ u → u ≤ (1 - ε) * Real.log x / Real.log (Real.log x) →
    x * u ^ (-(u * (1 + δ))) ≤ (Psi x (x ^ (1 / u)) : ℝ) ∧
      (Psi x (x ^ (1 / u)) : ℝ) ≤ x * u ^ (-(u * (1 - δ)))

/-- INTERNAL HYPOTHESIS ([pp] Theorem thm:FM, first moment; with [pp] Lemma lem:generala for general
`a`): for split inputs `N ≥ N₀`, `E_{ℓ ∈ J} E_{A ∼ 𝒜} N_ℓ(A) ≥ S² ρ_r ρ_F / (log N)^C`. -/
def FirstMoment (P : Params) (a : ℝ) : Prop :=
  ∃ C N₀ : ℝ, ∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
    (P.Ssz a N : ℝ) ^ 2 * P.rhoR a N * P.rhoF a N / (Real.log N) ^ C ≤
      expect (P.fields N ×ˢ P.Jset N) (fun x => (P.countN a N x.1 x.2 : ℝ))

/-- INTERNAL HYPOTHESIS ([pp] Theorem thm:LD, "LD*", second moment; with [pp] Lemma lem:generala):
for split inputs `N ≥ N₀`, `E_{ℓ,A}[N_ℓ(A)(N_ℓ(A) − 1)] ≤ (log N)^C S⁴ ρ_r² ρ_F²`. -/
def SecondMoment (P : Params) (a : ℝ) : Prop :=
  ∃ C N₀ : ℝ, ∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
    expect (P.fields N ×ˢ P.Jset N)
        (fun x => (P.countN a N x.1 x.2 : ℝ) * ((P.countN a N x.1 x.2 : ℝ) - 1)) ≤
      (Real.log N) ^ C * (P.Ssz a N : ℝ) ^ 4 * (P.rhoR a N) ^ 2 * (P.rhoF a N) ^ 2

/-- MAIN. [pp] Lemma lem:omega: if `N > 1` has no prime factor `≤ B` (`B ≥ 2`), then
`ω(N) log B ≤ log N`. -/
theorem omega_le (N B : ℕ) (hN : 1 < N) (hB : 2 ≤ B) (hNB : ∀ p : ℕ, p.Prime → p ∣ N → B < p) :
    (omega N : ℝ) * Real.log B ≤ Real.log N := by
  sorry

/-- MAIN. [pp] Theorem thm:Dk (relation supply): from the two moment hypotheses and CEP,
`γ ≥ L^{−o(1)}` uniformly over split inputs. -/
theorem relation_supply (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a) (hCEP : CEP)
    (hFM : FirstMoment P a) (hLD : SecondMoment P a) :
    ∀ ε > 0, ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
      LN (1 / 2) (-ε) N ≤ P.gammaD a N := by
  sorry

/-- MAIN. [pp] Prop. prop:select(i) with Theorem thm:K, concrete form: for any set `𝓡` of fields
with `Pr_𝒜(𝓡) ≤ γ/2`, the probability that a raw field is not in `𝓡` and a uniform `r ∈ [1, N−1]`
gives a complete descent in it is `≥ L^{−o(1)}`, uniformly over split inputs. -/
theorem descent_supply (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a) (hCEP : CEP)
    (hRS : RosserSchoenfeld) (hFM : FirstMoment P a) (hLD : SecondMoment P a) :
    ∀ ε > 0, ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
      ∀ Rej : Finset P.Field, Rej ⊆ P.fields N →
        prob (P.fields N) (fun A => A ∈ Rej) ≤ P.gammaD a N / 2 →
          LN (1 / 2) (-ε) N ≤
            expect (P.fields N) (fun A => if A ∈ Rej then 0 else P.descentProb a N A) := by
  sorry

end FactoringA

-- ===== statements from LeanA/MainTheorems.lean =====

noncomputable section
open Classical

namespace FactoringA

open Real Finset Filter Topology

/-- PUBLISHED INPUT (Lenstra–Pomerance). H. W. Lenstra, Jr. and C. Pomerance, *A rigorous time
bound for factoring integers*, J. Amer. Math. Soc. 5 (1992), 483–516, Theorem 1.1 ([pp] Fact
fact:LP): their Las Vegas algorithm finds the complete prime factorisation of every `n > 1` in
expected time `≤ L_n[1/2, 1 + o(1)]`. Stated for `T n` = the maximum over inputs `≤ n` of that
expected time, the function used by a cost model below. -/
def LenstraPomerance (T : ℕ → ℝ) : Prop := LBound (1 / 2) 1 T

/-- The maximum of `f` over the split inputs `n` with `N₀ ≤ n ≤ x` (`0` if there are none). -/
def supSplit (f : ℕ → ℝ) (a N₀ x : ℝ) : ℝ :=
  sSup (f '' {n : ℕ | N₀ ≤ n ∧ (n : ℝ) ≤ x ∧ Params.SplitInput a n})

/-- Cost-accounting model of FACTOR with the Lenstra–Pomerance shape test ([pp] §sec:alg). All
entries are functions of the input `N`. -/
structure CostModelA (P : Params) where
  /-- expected running time of FACTOR(N) -/
  factorCost : ℕ → ℝ
  /-- expected running time of SPLIT(N) -/
  splitCost : ℕ → ℝ
  /-- probability that one trial (SAMPLE_FIELD, then DESCEND_ONCE) ends in a row or a factor exit -/
  pTrial : ℕ → ℝ
  /-- the rejection event `𝓡` of [pp] Lemma lem:reject, as a set of raw fields -/
  rej : (N : ℕ) → Finset P.Field
  /-- uniform bound on the expected cost of one trial and of one DESCEND_ONCE call -/
  Ctrial : ℕ → ℝ
  /-- uniform bound on the expected cost of POSTPROCESS -/
  Tpost : ℕ → ℝ
  /-- the row target `M_rows` -/
  Mrows : ℕ → ℝ
  /-- expected cost of the shape test (two Lenstra–Pomerance runs on `|u₀|, |v₀| ≤ √(2N)` and AKS) -/
  Tshape : ℕ → ℝ
  /-- expected cost of one SQ_SEARCH -/
  Tsq : ℕ → ℝ
  /-- maximum over inputs `≤ n` of the Lenstra–Pomerance expected time -/
  TLP : ℕ → ℝ

/-- The interface of the cost model at smoothness exponent `a` (constants `C`, threshold `N₀`). -/
structure CostInterfaceA (P : Params) (a : ℝ) (M : CostModelA P) : Prop where
  /-- One constant and one threshold for all the bookkeeping below. -/
  bounds : ∃ C N₀ : ℝ, 0 ≤ C ∧
    (∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
      -- [pp] Prop. prop:select(i) proof / Theorem thm:K proof: a field outside `𝓡` either exits in
      -- SAMPLE_FIELD or is returned, and on the complete-descent event DESCEND_ONCE returns a row
      -- or exits (Prop. prop:BS); so a trial succeeds with at least this probability.
      expect (P.fields N) (fun A => if A ∈ M.rej N then 0 else P.descentProb a N A) ≤ M.pTrial N ∧
      -- [pp] Lemma lem:reject.
      M.rej N ⊆ P.fields N ∧
      prob (P.fields N) (fun A => A ∈ M.rej N) ≤
        Real.exp (-(Real.log (P.Hb N) / (13 * P.d * Real.log (Real.log (P.Hb N))))) +
          2 / (2 * (P.Hb N : ℝ) + 1) + 1 / (P.Wb N : ℝ) ∧
      -- [pp] Prop. prop:select(ii).
      M.splitCost N ≤ 3 * (M.Mrows N * M.Ctrial N + M.Tpost N) / M.pTrial N ∧
      -- [pp] eq:Mrows: `M_rows = C_col + 12 ≤ (d+1)π(B) + O_d(log N)`.
      1 ≤ M.Mrows N ∧ M.Mrows N ≤ (P.d + 1) * (Nat.primeCounting (Params.Bsm a N) : ℝ) + C * Real.log N ∧
      -- [pp] Prop. prop:cost, "One trial": shape test, at most 2k searches, polylog bookkeeping.
      0 ≤ M.Ctrial N ∧ M.Ctrial N ≤ M.Tshape N + 2 * P.k * M.Tsq N + (Real.log N) ^ C ∧
      M.Tshape N ≤ 2 * M.TLP ⌊Real.sqrt (2 * N)⌋₊ + (Real.log N) ^ C ∧
      -- [pp] Prop. prop:BS: `Õ(B + S² log N)`.
      M.Tsq N ≤ (Real.log N) ^ C * ((Params.Bsm a N : ℝ) + (P.Ssz a N : ℝ) ^ 2 * Real.log N) ∧
      0 ≤ M.Tpost N) ∧
    -- [pp] Prop. prop:lv6: `T_post ≤ M_rows² (log N)^{O(1)} + B^{1+o(1)}`.
    (∀ ε > 0, ∃ N₁ : ℝ, ∀ N : ℕ, N₁ ≤ N → Params.SplitInput a N →
      M.Tpost N ≤ M.Mrows N ^ 2 * (Real.log N) ^ C + (Params.Bsm a N : ℝ) ^ (1 + ε)) ∧
    -- [pp] §sec:uniform (proof of Theorem thm:main): at most `log₂N` calls of SPLIT, each raced
    -- against trial division (constant cost below `N₀`), on inputs `≤ N`, plus preprocessing
    -- (primality, perfect powers, trial division to `B`) at every node.
    (∀ N : ℕ, 2 ≤ N → M.factorCost N ≤ C + (Real.logb 2 N + 1) *
      (C * (Params.Bsm a N : ℝ) * (Real.log N) ^ C + 2 * supSplit M.splitCost a N₀ N))

/-- MAIN. [pp] Theorem thm:main (Theorem A), conditional form. For admissible `(d, k, μ, η₀)`, with
`a = θ/√2`: from the published inputs (CEP, Rosser–Schoenfeld, Lenstra–Pomerance), the internal
moment hypotheses FM and LD*, and the cost interface, the expected time of FACTOR is
`≤ L_N[1/2, (1+θ)/√2 + o(1)]`. -/
theorem theoremA (P : Params) (hP : P.Admissible) (hCEP : CEP) (hRS : RosserSchoenfeld)
    (hFM : FirstMoment P ((P.θ : ℝ) / Real.sqrt 2))
    (hLD : SecondMoment P ((P.θ : ℝ) / Real.sqrt 2))
    (M : CostModelA P) (hM : CostInterfaceA P ((P.θ : ℝ) / Real.sqrt 2) M)
    (hLP : LenstraPomerance M.TLP) :
    LBound (1 / 2) P.cA M.factorCost := by
  sorry

/-- MAIN. [pp] Corollary cor:main, conditional form: if the hypotheses of `theoremA` hold for every
admissible tuple, then for every `c > 1/√2` some admissible tuple's FACTOR runs in expected time
`O(L_N[1/2, c])`. -/
theorem corollaryA (hCEP : CEP) (hRS : RosserSchoenfeld)
    (hFM : ∀ P : Params, P.Admissible → FirstMoment P ((P.θ : ℝ) / Real.sqrt 2))
    (hLD : ∀ P : Params, P.Admissible → SecondMoment P ((P.θ : ℝ) / Real.sqrt 2))
    (M : ∀ P : Params, CostModelA P)
    (hM : ∀ P : Params, P.Admissible → CostInterfaceA P ((P.θ : ℝ) / Real.sqrt 2) (M P))
    (hLP : ∀ P : Params, LenstraPomerance (M P).TLP) (c : ℝ) (hc : 1 / Real.sqrt 2 < c) :
    ∃ P : Params, P.Admissible ∧
      ∃ K : ℝ, ∀ N : ℕ, 2 ≤ N → (M P).factorCost N ≤ K * LN (1 / 2) c N := by
  sorry

/-- Cost-accounting model of FACTOR_rec[a] ([pp] §sec:recursive). -/
structure CostModelRA (P : Params) where
  /-- `F(x) = sup_{2 ≤ n ≤ x} E[cost of FACTOR_rec[a](n)]` -/
  Fsup : ℝ → ℝ
  /-- expected number of DESCEND_ONCE calls in SPLIT^O(N) -/
  tau : ℕ → ℝ
  /-- expected work of SPLIT^O(N) outside the calls of the shape-test oracle `O` -/
  nonO : ℕ → ℝ
  /-- as in `CostModelA` -/
  pTrial : ℕ → ℝ
  rej : (N : ℕ) → Finset P.Field
  Mrows : ℕ → ℝ
  Tsq : ℕ → ℝ
  Tpost : ℕ → ℝ

/-- The interface of the recursive model at smoothness exponent `a`. -/
structure CostInterfaceRA (P : Params) (a : ℝ) (M : CostModelRA P) : Prop where
  bounds : ∃ C N₀ : ℝ, 0 ≤ C ∧
    (∀ N : ℕ, N₀ ≤ N → Params.SplitInput a N →
      -- as in `CostInterfaceA`
      expect (P.fields N) (fun A => if A ∈ M.rej N then 0 else P.descentProb a N A) ≤ M.pTrial N ∧
      M.rej N ⊆ P.fields N ∧
      prob (P.fields N) (fun A => A ∈ M.rej N) ≤
        Real.exp (-(Real.log (P.Hb N) / (13 * P.d * Real.log (Real.log (P.Hb N))))) +
          2 / (2 * (P.Hb N : ℝ) + 1) + 1 / (P.Wb N : ℝ) ∧
      1 ≤ M.Mrows N ∧ M.Mrows N ≤ (P.d + 1) * (Nat.primeCounting (Params.Bsm a N) : ℝ) + C * Real.log N ∧
      M.Tsq N ≤ (Real.log N) ^ C * ((Params.Bsm a N : ℝ) + (P.Ssz a N : ℝ) ^ 2 * Real.log N) ∧
      0 ≤ M.Tsq N ∧ 0 ≤ M.Tpost N ∧ 0 ≤ M.tau N ∧
      -- [pp] Lemma lem:generala (A1): Prop. prop:select(ii) counting DESCEND_ONCE calls.
      M.tau N ≤ 3 * M.Mrows N / M.pTrial N ∧
      -- [pp] Lemma lem:generala (A2): Prop. prop:select(ii) with the oracle's cost removed and at
      -- most 2k searches charged to every DESCEND_ONCE call.
      M.nonO N ≤ 3 * (M.Mrows N * (2 * P.k * M.Tsq N + (Real.log N) ^ C) + M.Tpost N) / M.pTrial N) ∧
    -- [pp] Prop. prop:lv6, as in `CostInterfaceA`
    (∀ ε > 0, ∃ N₁ : ℝ, ∀ N : ℕ, N₁ ≤ N → Params.SplitInput a N →
      M.Tpost N ≤ M.Mrows N ^ 2 * (Real.log N) ^ C + (Params.Bsm a N : ℝ) ^ (1 + ε)) ∧
    -- `F` is finite, nonnegative, nondecreasing ([pp] Theorem thm:RA, "Finiteness").
    (∀ x, 2 ≤ x → 0 ≤ M.Fsup x) ∧ MonotoneOn M.Fsup (Set.Ici 2) ∧
    -- [pp] Theorem thm:RA, "Recursion": factor tree (< 2 log₂x splitting nodes), race against trial
    -- division (factor 2), Lemma OS, Lemma lem:waldrec, and at most two oracle calls per
    -- DESCEND_ONCE call on inputs `≤ √(2x)`.
    (∀ x : ℝ, N₀ ≤ x → M.Fsup x ≤ 2 * Real.logb 2 x *
      (C + C * (Params.Bsm a ⌊x⌋₊ : ℝ) * (Real.log x) ^ C + 2 * supSplit M.nonO a N₀ x +
        2 * (2 * supSplit M.tau a N₀ x) * M.Fsup (Real.sqrt (2 * x))))

/-- MAIN. [pp] Theorem thm:RA (Theorem RA), conditional form. For admissible `(d, k, μ, η₀)` and any
fixed `a > 0`, the expected time of FACTOR_rec[a] is `≤ L_N[1/2, c(a) + o(1)]`,
`c(a) = max(a + θ/(2a), (2+√2)a)`. -/
theorem theoremRA (P : Params) (hP : P.Admissible) (a : ℝ) (ha : 0 < a) (hCEP : CEP)
    (hRS : RosserSchoenfeld) (hFM : FirstMoment P a) (hLD : SecondMoment P a)
    (M : CostModelRA P) (hM : CostInterfaceRA P a M) :
    LBound (1 / 2) (costExpRA (P.θ : ℝ) a) (fun N => M.Fsup N) := by
  sorry

/-- MAIN. [pp] Theorem thm:RA at the optimal `a* = √((√2−1)θ/2)`: expected time
`≤ L_N[1/2, √((1+√2)θ) + o(1)]`. -/
theorem theoremRA_opt (P : Params) (hP : P.Admissible) (hCEP : CEP) (hRS : RosserSchoenfeld)
    (hFM : FirstMoment P (Real.sqrt ((Real.sqrt 2 - 1) * P.θ / 2)))
    (hLD : SecondMoment P (Real.sqrt ((Real.sqrt 2 - 1) * P.θ / 2)))
    (M : CostModelRA P) (hM : CostInterfaceRA P (Real.sqrt ((Real.sqrt 2 - 1) * P.θ / 2)) M) :
    LBound (1 / 2) P.cRAstar (fun N => M.Fsup N) := by
