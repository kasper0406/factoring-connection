theorem theoremDL_assembly (θ a : ℝ) (ha : 0 < a) (T Mrows Ctrial Tpost pT : ℕ → ℝ)
    (hT : ∀ᶠ N : ℕ in atTop, T N ≤ (Mrows N * Ctrial N + Tpost N) / pT N)
    (hM : LBound (1 / 2) a Mrows) (hM0 : ∀ᶠ N : ℕ in atTop, 0 ≤ Mrows N)
