  1893	\subsection{Linear algebra and the congruence}
  1894	
  1895	\begin{algorithm}[$\mathrm{POSTPROCESS}(A,\text{rows})$]\label{alg:lv6}
  1896	\begin{enumerate}[label=\arabic*.]
  1897	\item Sample $\fp_1,\dots,\fp_{t_\chi}$ and build the $M_{\rm rows}\times C_{\rm col}$ matrix over $\F_2$ of columns (a)--(e).
  1898	\item Sample two uniform left-kernel vectors $s_1,s_2$ (Wiedemann's method over $\F_{2^e}$ with the Kaltofen--Saunders
  1899	  preconditioners \cite{wiedemann1986,kaltofensaunders1991}). Verify them, and retry until they are linearly independent.
  1900	\item For $\sS=s_1,s_2,s_1+s_2$ in turn, run SQ on $\Gamma_\sS:=g'(\beta)^2\prod_Pz_P^{|e_P(\sS)|}$, and stop at the first $\sS$ for which it returns $\eta$.
  1901	  If none does, go back to step~1 with fresh characters.
  1902	\item Return $\sS$ and
  1903	  \[
  1904	  \sY_\sS:=\sqrt{\fq_\sS}\cdot f_d^{-E(\sS)/2}\cdot\psi(\eta)\cdot\bigl(\psi(\gamma^-_\sS)\psi(g'(\beta))\bigr)^{-1}\bmod N,\qquad\gamma^-_\sS:=\prod_{e_P(\sS)<0}z_P^{|e_P(\sS)|}.
  1905	  \]
  1906	\end{enumerate}
  1907	\end{algorithm}
  1908	
  1909	\begin{proposition}[post-processing]\label{prop:lv6}
  1910	Let $N\ge N_0$ and fix an accepted field and $M_{\rm rows}\ge C_{\rm col}+12$ rows. Algorithm~\ref{alg:lv6} is Las Vegas. Its expected time is
  1911	$M_{\rm rows}^2(\log N)^{O_d(1)}+B^{1+o(1)}$, and it returns a nonempty set $\sS$ of rows and $\sY_\sS\in(\Z/N)^\times$ with
  1912	$\prod_{i\in\sS}r_i^2\equiv\sY_\sS^2\pmod N$. Its output and all its intermediate quantities are functions of the field, the
  1913	certificates $(R_i,u_0,v_0,\text{atoms})$ and its own coins.
  1914	\end{proposition}
  1915	
  1916	\begin{proof}
  1917	\emph{Kernel sampling.} The matrix has at most $M_{\rm rows}(2k\log_2N+t_\chi+2)$ nonzero entries. Wiedemann's method with the Kaltofen--Saunders preconditioners,
  1918	run over $\F_{2^e}$ with $2^e\ge M_{\rm rows}^4$, returns a uniformly random kernel element of a black-box singular system in expected
  1919	$\tilde O(M_{\rm rows}\cdot\#\text{entries}+M_{\rm rows}^2)$ field operations \cite[Thms.~2--4]{kaltofensaunders1991}. Here is how to sample uniformly from the binary
  1920	kernel. Draw $x$ uniform in $\F_2^{M_{\rm rows}}$, solve $A^\top y=A^\top x$ (padding $A^\top$ to a square matrix), and return the coordinate of $x-y$ at the basis
  1921	element $1$ of a fixed $\F_2$-basis of $\F_{2^e}$. Given $A^\top x$, the vector $x$ is uniform on a coset of the kernel, and the solver sees only $A^\top x$; so
  1922	the output is uniform on the binary kernel. Every output is verified. The kernel has dimension $r\ge12$, so two samples are independent with probability
  1923	$(1-2^{-r})(1-2^{1-r})\ge1-3\cdot2^{-12}$.
  1924	
  1925	\emph{One of three is a square.} Columns (a)--(d) vanish on $s_1,s_2$, so $\phi(s_1),\phi(s_2)\in\sH$. Columns (e) vanish too, so they lie in $\sH_0$. If
  1926	$|\sH_0|\le2$ (probability $\ge1-(\log N)^{-2}$ by Lemma~\ref{lem:X}), either one of $\phi(s_1),\phi(s_2)$ is $0$ or both equal the
  1927	nonzero element, and then $\phi(s_1+s_2)=0$. In every case some $\sS\in\{s_1,s_2,s_1+s_2\}$ is nonempty with $\gamma_\sS\in K^{\times2}$. Then
  1928	$\gamma'_\sS:=\prod_Pz_P^{e_P(\sS)}=f_d^{E(\sS)}\gamma_\sS$ is a square ($E(\sS)$ even), hence so is $\Gamma_\sS=g'(\beta)^2\gamma'_\sS(\gamma_\sS^-)^2$, and SQ returns $\eta$
  1929	by Lemma~\ref{lem:SQ}. A failed round has probability at most $(\log N)^{-2}+3\cdot2^{-12}$, so the expected number of rounds is $O(1)$.
  1930	
  1931	\emph{The congruence.} $\psi$ is a ring homomorphism, so $\psi(\eta)^2=\psi(g'(\beta))^2\prod_P\psi(z_P)^{|e_P|}$. Hence
  1932	\[
  1933	\sY_\sS^2=\fq_\sS f_d^{-E(\sS)}\prod_P\psi(z_P)^{|e_P|}\big/\psi(\gamma^-_\sS)^2=\fq_\sS f_d^{-E(\sS)}\prod_P\psi(z_P)^{e_P(\sS)}\equiv\prod_{i\in\sS}r_i^2
  1934	\]
  1935	by \eqref{eq:row}. Every quantity inverted is a unit modulo $N$. Indeed $\psi(z_P)=f_dG(P)/g_1$ with $G(P)=\pm\ell n_P$ coprime to $N$;
  1936	$\psi(g'(\beta))=f_d^{d-2}f'(m)$ by the field check; and $\sqrt{\fq_\sS}$ involves only $g_1$ and primes $\le B$.
  1937	
  1938	\emph{Cost.} Building the matrix and the characters costs $M_{\rm rows}(\log N)^{O(1)}$, and kernel sampling $M_{\rm rows}^2(\log N)^{O(1)}$. Each SQ call costs
  1939	$O(\mathsf M(kM_{\rm rows}\log N)\log\log N)$ by Lemma~\ref{lem:SQ}. The Hensel prime costs $\tilde O(B)$, and $\sqrt{\fq_\sS}$ costs $M_{\rm rows}(\log N)^{O(1)}$. No square
  1940	root modulo $N$ is ever extracted. The last claim of the proposition holds by construction: no step reads a root $r_i$.
  1941	\end{proof}
  1942	
  1943	\begin{remark}[relation to the literature]
  1944	The obstruction-group chain is \cite[Thm.~6.7]{blp1993}, with the index $[\cO_K:\Z[\alpha]]$ replaced by $2^{|S_D|}$. The random characters were suggested in
  1945	\cite[\S8]{blp1993} and carried out rigorously in \cite[\S6]{lv2018}. The $p$-adic square root with exact verification is
  1946	\cite[\S9]{blp1993}, after \cite{weinbergerrothschild1976}. Lee--Venkatesan's degree is $\asymp(\log N)^{1/3}$, which leads to $O(\log\log N)$ exceptional
  1947	classes and an exceptional set of fields. At fixed degree, Lemma~\ref{lem:E} gives at most one exceptional class for every field, and three tests
  1948	suffice. We know of no explicit statement of this specialisation. Lenstra--Pomerance \cite[\S\S3--4]{lp1992} use a similar
  1949	explicit Hecke-character estimate with at most one exceptional zero, and random primes up to $\exp(c(\log|\Delta|)^2)$ to avoid GRH.
  1950	\end{remark}
