   715	\subsection{The algorithm}\label{sec:alg}
   716	
   717	\begin{algorithm}[$\mathrm{FACTOR}(N)$]\label{alg:factor}
   718	\begin{enumerate}[label=\arabic*.]
   719	\item If $N=1$ return the empty list. If $N$ is prime (AKS), return $[N]$. If $N=m^e$ with $e\ge2$ (integer roots,
   720	  $e\le\log_2N$), return $\mathrm{FACTOR}(m)$ with all exponents multiplied by $e$.
   721	\item Trial-divide $N$ by all primes $\le B(N)$. Record the primes found, and let $N'$ be the cofactor. If $N'=1$,
   722	  stop. If $N'$ is prime or a perfect power, handle it as in step 1.
   723	\item Run $\mathrm{SPLIT}(N')$ and trial division of $N'$ in parallel, alternating steps, until one returns a
   724	  proper factor $g$ of $N'$. (This alternation removes the need for any branch ``$N'<N_0$'': the algorithm then uses no analytic
   725	  constant at all, and pays at most a factor $2$ in expected time; see Remark~\ref{rem:noN0}.)
   726	\item Return $\mathrm{FACTOR}(g)$ merged with $\mathrm{FACTOR}(N'/g)$, together with the primes from step 2.
   727	\end{enumerate}
   728	\end{algorithm}
   729	
   730	\begin{algorithm}[$\mathrm{SPLIT}(N)$; $N$ odd, all prime factors $>B$, not a prime power]\label{alg:split}
   731	\begin{enumerate}[label=\arabic*.]
   732	\item[0.] \emph{Guards.} If any structural prerequisite fails ($M<4$, $J=\emptyset$, $(W,2W]$ contains no prime, $H<1$, or $2X^2\ge N$), return FAIL
   733	  at once. This happens only for $N$ below an explicit bound, where the trial-division branch of FACTOR finishes the job.
   734	\item \emph{Field selection.} Repeat: $A\leftarrow\mathrm{SAMPLE\_FIELD}$; if $A$ is rejected, continue;
   735	  $\mathrm{row}\leftarrow\mathrm{DESCEND\_ONCE}(A)$; if a row is returned, keep $A$ and go to step~2.
   736	  (Any factor exit returns the factor.)
   737	\item \emph{Rows.} Call $\mathrm{DESCEND\_ONCE}(A)$ until $M_{\rm rows}$ rows are held, where $M_{\rm rows}$ is
   738	  defined in \eqref{eq:Mrows}.
   739	\item \emph{Post-processing.} Run $\mathrm{POSTPROCESS}(A,\text{rows})$ (Algorithm~\ref{alg:lv6}). It returns a nonempty set
   740	  $\sS$ of rows and $\sY_\sS\in(\Z/N)^\times$. Compute $\sX_\sS:=\prod_{i\in\sS}r_i\bmod N$ and
   741	  $g:=\gcd(\sX_\sS-\sY_\sS,N)$. If $1<g<N$ return $g$.
   742	\item Otherwise discard all rows and go to step~2 (same field, fresh hidden roots).
   743	\end{enumerate}
   744	\end{algorithm}
   745	
   746	\begin{algorithm}[$\mathrm{SAMPLE\_FIELD}$]\label{alg:field}
   747	\begin{enumerate}[label=\arabic*.]
   748	\item Draw $(g_0,g_1)$ uniformly from $[M/2,M]^2\cap\Z^2$ until $\gcd(g_0,g_1)=1$. Draw a uniform prime $w\in(W,2W]$
   749	  (uniform integers and AKS). Draw $c$ uniform in $C_H$. Gcd-check $g_1$, $w$ and then $f_d=a_d+g_1c_0$. (All
   750	  three are nonzero and smaller than $N$, by Lemma~\ref{lem:sizes}, so these checks either exit with a factor or pass.)
   751	\item Compute $f$. Let $e$ be its content. Then $e\mid F_A(g_0,g_1)=Nw$ and $e\le|f_d|<N$. Gcd-check $e$. If it
   752	  passes, $e\in\{1,w\}$. If $e=w$, \emph{reject}.
   753	\item \emph{Irreducibility certificate} (Lemma~\ref{lem:IR}): if no prime $r\in(r_0(d),\tfrac12\log H]$ has $f\bmod r$ of degree $d$
   754	  and irreducible over $\F_r$, \emph{reject}.
   755	\item Gcd-check $f_d^{d-2}f'(m)$, where $m=g_0g_1^{-1}\bmod N$; if $N\mid f'(m)$, \emph{reject}.
   756	\item Return $A$.
   757	\end{enumerate}
   758	\end{algorithm}
   759	
   760	\begin{algorithm}[$\mathrm{DESCEND\_ONCE}(A)$]\label{alg:descend}
   761	\begin{enumerate}[label=\arabic*.]
   762	\item Draw $r$ uniform in $[1,N-1]$; gcd-check $r$ (a non-unit $r$ gives a factor exit). Put $R:=r^2\bmod N$.
   763	\item Let $(u_0,v_0)$ be a shortest nonzero vector of $\Lambda_R:=\{(u,v)\in\Z^2:u\equiv Rv\pmod N\}$ (Gauss
   764	  reduction, ties broken by a fixed rule). Gcd-check $u_0$ and $v_0$.
   765	\item \emph{Shape test.} Factor $|u_0|$ and $|v_0|$ completely with the algorithm of Fact~\ref{fact:LP}, and certify each
   766	  output prime with AKS. Require that $|u_0|$ and $|v_0|$ are each a product of at most $k$ \emph{distinct} primes, all
   767	  in $J$; otherwise return FAIL.
   768	\item For each prime $\ell\mid u_0v_0$, gcd-check $\ell$ and run $\mathrm{SQ\_SEARCH}(A,\ell)$ (cached per $(A,\ell)$). If any
   769	  search fails, return FAIL.
   770	\item Return the row $(r,R,\sgn(u_0v_0),(e_\ell)_\ell,(P_\ell)_\ell)$, where $e_\ell=+1$ if $\ell\mid u_0$, $e_\ell=-1$ if $\ell\mid v_0$,
   771	  and $P_\ell$ is the atom found for $\ell$, with the factorisations of $n_{P_\ell}$ and $F_A(P_\ell)$.
   772	\end{enumerate}
   773	\end{algorithm}
   774	
   775	\begin{algorithm}[$\mathrm{SQ\_SEARCH}(A,\ell)$; a deterministic function of $(A,\ell)$]\label{alg:sq}
   776	\begin{enumerate}[label=\arabic*.]
   777	\item Gauss-reduce a basis of $\Lambda_\ell(g)$. If $\lambda_1<\sqrt\ell/(2S)$, return FAIL (Lemma~\ref{lem:reg}).
   778	\item Enumerate $\Lambda_\ell(g)\cap[-V_\ell,V_\ell]^2$ (at most $200S^2$ points). Keep the points $P\in\cP_\ell$ ($b$ prime by
   779	  AKS) with $G(P)\ne0$, $F_A(P)\ne0$ and $|G(P)|\ge MV_\ell/32$. Gcd-check $G(P)$ and $F_A(P)$ for each.
   780	\item Compute the $B$-smooth parts of all the numbers $|G(P)/\ell|$ and $|F_A(P)|$ with one batch (Proposition~\ref{prop:BS}).
   781	\item Return the first kept $P$, in a fixed order, for which both numbers are $B$-smooth, together with the
   782	  factorisations of its two values (trial division by the primes $\le B$). If there is none, return FAIL.
   783	\end{enumerate}
   784	\end{algorithm}
   785	
   786	\noindent $\mathrm{POSTPROCESS}$ is Algorithm~\ref{alg:lv6} in Section~\ref{sec:lv6}. The number of rows is
   787	\begin{equation}\label{eq:Mrows}
   788	M_{\rm rows}:=C_{\rm col}+12,\qquad C_{\rm col}:=2+\pi(B)+\#\{(r,s):r\le B\text{ prime},\ r\nmid D,\ f(s)\equiv0\ (r)\}+t_\chi,
   789	\end{equation}
   790	where $D=f_d\disc(f)$ and $t_\chi=O_d(\log N)$ is defined in Lemma~\ref{lem:X}. So $M_{\rm rows}\le(d+1)\pi(B)+O_d(\log N)$.
   791	
   792	\begin{remark}[on the design]\label{rem:design}
   793	Each design choice serves one step of the proof.
   794	\begin{itemize}
   795	\item \emph{$b$ prime in $(V/2,V]$.} This makes every moving residue reduced (Lemma~\ref{lem:coprime}), removes
   796	  small $b$, and gives the effective wedge bound in Lemma~\ref{lem:kern}.
   797	\item \emph{The filter $|G(P)|\ge MV/32$.} Candidates with small $|G|$ have algebraic values smaller by a power of $N$.
   798	  Their smoothness probability could then exceed $\rF$ by $L^{\Theta(1)}$, which would spoil the second
   799	  moment. The first moment only uses $|G|\asymp MV$, so the filter costs nothing.
   800	\item \emph{Two-dimensional rational side.} With $(g_0,g_1)$ random, the rational values of a fixed candidate
   801	  fill whole fibres of a linear map. The rational part of the first moment is then an interval count,
   802	  and the partner's rational weight in the second moment can be bounded by divisor switching along a
   803	  fibre (Step~5 of Theorem~\ref{thm:LD}).
   804	\item \emph{The multiplier $w$.} By Lemma~\ref{lem:homog} every algebraic value of a candidate lies in one class
   805	  modulo $G(P)$, and that class is determined by the rational data. With $F(g_0,g_1)=N$ this class
   806	  moves together with the partner's rational indicator, and we know no way to decouple them.
   807	  Proposition~\ref{prop:gauss} shows that no randomisation of the coefficients at a fixed resultant can move it. Multiplying the resultant
   808	  by an independent random prime $w>t$ makes the class $c_Pw$ almost uniform (Lemma~\ref{lem:W}).
   809	\item \emph{The windows.} The window floor $h\ge1-d\mu+\nu+\eta_0$ keeps the large constant coefficient
   810	  $a_0\approx Nw/M^d$ invisible at the scale $MHV^d$ (Lemma~\ref{lem:valuesizes}). The level floor keeps the moduli
   811	  $|G(P)|\approx N^{\mu+\nu}$ below the square root of the algebraic values, as Lemma~\ref{lem:85} requires. The
   812	  kernel floor $H\ge V^2$ is needed by Lemma~\ref{lem:kern}.
   813	\end{itemize}
   814	\end{remark}
