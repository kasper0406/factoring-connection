  1242	\[
  1243	\cT_Q:=\{t=\ell s\in(Q/2,Q]:\ \ell\in J,\ s\ge1,\ \Pp(s)\le B\}.
  1244	\]
  1245	Then, uniformly in such $x,Q$,
  1246	\[
  1247	\sum_{t\in\cT_Q}\ \max_{(r,t)=1}\Bigl|\Psi(x;t,r)-\frac{\Psi_t(x)}{\varphi(t)}\Bigr|\ \le\ \varepsilon_N\,\Psi(x)\,\frac{\#\cT_Q}{Q},
  1248	\]
  1249	where $\varepsilon_N=C\exp\bigl(-c_0(\log N)^{1/2}(\log\log N)^{-5/2}\bigr)$ for some fixed $C,c_0>0$. In particular
  1250	$\varepsilon_N(\log N)^{A}\to0$ for every fixed $A$.
