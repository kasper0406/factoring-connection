   543	\subsection{Parameters}\label{sec:params}
   544	\emph{Fixed parameters.} An odd integer $d\ge3$; an integer $k>(d+1)/4$; $\nu:=1/(4k)$; a rational $\mu$ with
   545	$\nu+\eta_0\le\mu<1$; a rational $\eta_0>0$. Put
   546	\[
   547	h:=h_*(\mu)+\eta_0,\qquad h_*(\mu)=\max\bigl(\underbrace{2\nu}_{\text{kernel}},\ \underbrace{\mu-(d-2)\nu}_{\text{level }1/2},\
   548	\underbrace{1-d\mu+\nu}_{\text{window}}\bigr),\qquad \theta:=2\mu+h+(d-1)\nu,
   549	\]
   550	and assume $\theta<1$. Put $a:=\theta/\sqrt2$.
   551	
   552	\emph{Quantities depending on $N$} (the integer handed to the splitting routine, see
   553	Section~\ref{sec:uniform}):
   554	\begin{itemize}
   555	\item $B:=\lfloor L^{a}\rfloor$, the smoothness bound;
   556	\item $X:=\lfloor\sqrt{N/2}\rfloor$; $j$ maximal with $2^{kj}\le X$; $Y:=2^{j-1}$; $J:=\{\ell\text{ prime}:Y<\ell\le2Y\}$;
   557	  $\pi_J:=\#J$;
   558	\item $S:=\lceil L^{1/(2\sqrt2)}\rceil$, so that $S^2=L^{\theta/(2a)+o(1)}$;
   559	\item for $\ell\in J$: $V_\ell:=\lfloor\sqrt\ell\,S\rfloor$, with envelopes $\Vm:=\lfloor\sqrt Y\,S\rfloor\le
   560	  V_\ell\le\VM:=\lfloor\sqrt{2Y}\,S\rfloor$; and $T_\ell:=dHV_\ell^{d-1}$;
   561	\item $M:=\lfloor N^\mu\rfloor$, $H:=\lfloor N^h\rfloor$, $W:=\lceil N^{\mu+\nu+\eta_0/2}\rceil$;
   562	\item $\XF:=C'_dMH\VM^d$ and $\Xr:=2M\VM/Y$, where $C'_d:=2^{2d+5}+2d$; and
   563	  $\rr:=\varrho(\Xr)$, $\rF:=\varrho(\XF)$.
   564	\end{itemize}
   565	Since $2^{k(j+1)}>X$, we have $X^{1/k}/4<Y\le X^{1/k}/2$, so $Y=N^{2\nu+o(1)}$ and every product of $k$ primes of $J$ is at most $X$.
   566	$V_\ell=N^\nu L^{1/(2\sqrt2)+o(1)}$, $\Xr=N^{\mu-\nu}L^{O(1)}$ and $\XF=N^{\mu+h+d\nu}L^{O(1)}$. By Lemma~\ref{lem:local}(iv),
   567	\begin{equation}\label{eq:rhosizes}
   568	\rr\rF=L^{-(\mu-\nu+\mu+h+d\nu)/(2a)+o(1)}=L^{-\theta/(2a)+o(1)}=L^{-1/\sqrt2+o(1)},\qquad\text{so}\qquad S^2\rr\rF=L^{o(1)}.
   569	\end{equation}
   570	
   571	\begin{lemma}[size relations]\label{lem:sizes}
   572	For $N\ge N_0(d,k,\mu,\eta_0)$:
   573	\begin{enumerate}[label=(\alph*)]
   574	\item $B<2S^2<Y<\ell$ for $\ell\in J$; $S<\sqrt Y$; $V_\ell<\ell$; and $B<V_\ell/2$.
   575	\item $2M\VM<W$, $W/(2M\VM)\ge N^{\eta_0/3}$, and $2W<N$.
   576	\item $M/\VM\ge N^{\eta_0/2}$ and $H/\VM^2\ge N^{\eta_0/2}$.
   577	\item $M(H+1)<N$ and $2H+1<N$.
   578	\item $2X^2<N$.
   579	\end{enumerate}
   580	\end{lemma}
   581	
   582	\begin{proof}
   583	(a) $B=L^{\theta/\sqrt2}\le L^{1/\sqrt2}<2S^2$ since $\theta<1$; $S^2=L^{O(1)}$ while $Y=N^{2\nu+o(1)}$; $V_\ell\le\sqrt\ell S<\ell$; $V_\ell/2\ge N^{\nu+o(1)}>B$.
   584	(b) $2M\VM=N^{\mu+\nu}L^{O(1)}$. Also $\mu+\nu+\eta_0/2\le\theta<1$, because $\mu\ge\nu$, $h\ge2\nu+\eta_0$ and $d\ge3$.
   585	(c) $\mu-\nu\ge\eta_0$ and $h-2\nu\ge\eta_0$.
   586	(d) $\mu+h=\theta-\mu-(d-1)\nu<\theta<1$.
   587	(e) $N$ is odd in our application, so $2X^2\le N-1$.
   588	\end{proof}
   589	
   590	\noindent At $d=9$, $k=13$ the exponents are $\nu=1/52$, $\mu=17/156$, $h=1/26+\eta_0$; the rational
