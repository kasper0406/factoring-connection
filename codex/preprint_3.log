   953	\begin{theorem}[$k$-products]\label{thm:Sprime}
   954	Let $\cD$ be a set of primes in a dyadic interval, all coprime to $N$, with $n:=|\cD|\ge4k^2$. Let $\cS$ be a set of
   955	products of exactly $k$ distinct primes of $\cD$, contained in a window $[Y'/2,Y']$ with $2Y'^2<N$, and
   956	with $|\cS|\ge\binom nk/(2k)$. Then
   957	\[
   958	\Prob[E_\cS]\ \ge\ \frac{|\cS|^2}{c_kh_2\varphi(N)},\qquad c_k:=8k^2\binom{2k}{k}.
   959	\]
   960	\end{theorem}
