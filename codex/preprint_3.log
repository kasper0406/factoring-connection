  1264	
  1265	\begin{lemma}[fibres]\label{lem:fibres}
  1266	Fix $\ell\in J$ and $P=(a,b)\in\cP_\ell$, and put $\cG_P(n):=\{g\in\cG:G_g(P)=\ell n\}$.
  1267	\begin{enumerate}[label=(\roman*)]
  1268	\item The $g\in\Z^2$ with $G_g(P)=\ell n$ form a line $g^*+\Z(a,b)$, and $|\cG_P(n)|\le\sqrt2M/V_\ell+1\le2M/V_\ell$ for every $n$.
  1269	\item There is a set $I_P$ of consecutive integers $n$, of length at least $MV_\ell/(16\ell)-1$, on which $\ell n$ has constant sign,
  1270	  $MV_\ell/32\le\ell|n|\le2MV_\ell$, and $|\cG_P(n)|\ge M/(CV_\ell\log\log N)$.
  1271	\end{enumerate}
  1272	\end{lemma}
  1273	
  1274	\begin{proof}
  1275	Write $V=V_\ell$. (i) $G_g(P)=g_1a-g_0b$ is constant along the direction $(a,b)$, which is primitive with
  1276	$|(a,b)|\ge b>V/2$, and the square $[M/2,M]^2$ has diameter $M/\sqrt2$.
  1277	
  1278	(ii) Let $(g_0,g_1)$ be uniform on the real square $[M/2,M]^2$. Then $G=ag_1-bg_0$ is a sum of independent uniform
  1279	variables on intervals of lengths $\alpha\le\beta$ with $\beta=V'M/2$, $V'=\max(|a|,b)$. Its density is at least $1/(2\beta)$ on an
  1280	interval of length $\beta$. The density at $s$ equals (length of the chord $\{G=s\}$)$/(|(a,b)|M^2/4)$, so on that interval the
  1281	chord has length at least $(1/(V'M))\cdot V'\cdot M^2/4=M/4$. Removing $(-MV/32,MV/32)$ from an interval of length $\ge MV/4$
  1282	leaves a subinterval of length $\ge MV/16$ of constant sign. Let $I_P$ be the integers $n$ with $\ell n$ in it. For $n\in I_P$
  1283	the fibre line meets the closed square in at least $\lfloor(M/4)/|(a,b)|\rfloor\ge M/(8V)$ consecutive lattice points
  1284	$g^*+j(a,b)$.
  1285	
  1286	\emph{Coprimality.} Fix $e\ge1$. Choose $x,y$ with $xa+yb=1$. If $e\mid\gcd(g_0,g_1)$ then $e\mid G=\ell n$. Conversely, if $e\mid\ell n$,
  1287	the $j$ with $e\mid g^*+j(a,b)$ are exactly those with $j\equiv-(xg_0^*+yg_1^*)\pmod e$: the matrix
  1288	$\bigl(\begin{smallmatrix}x&y\\-b&a\end{smallmatrix}\bigr)$ has determinant $1$ and maps $g$ to $(xg_0+yg_1,G)$. By M\"obius
  1289	inversion over $e\mid\ell|n|$, the number of coprime points among $J_0\ge M/(8V)$ consecutive ones is at least
  1290	$J_0\varphi(\ell|n|)/(\ell|n|)-2^{\omega(\ell|n|)}$. Finally $\varphi(m)/m\gg1/\log\log m$, and $2^{\omega(m)}=N^{o(1)}$ is small
  1291	compared with $M/V\ge N^{\eta_0/2}$ (Lemma~\ref{lem:sizes}(c)).
  1292	\end{proof}
