  1990	\section{Cost assembly and the constant}\label{sec:cost}
  1991	%======================================================================
  1992	
  1993	\begin{proposition}[cost of one split]\label{prop:cost}
  1994	For $N\ge N_0$ as in Section~\ref{sec:K}, the expected running time of $\mathrm{SPLIT}(N)$ is at most
  1995	\[
  1996	L^{\max(a+1/\sqrt2,\ a+\theta/(2a),\ 2a)+o(1)}=L^{(1+\theta)/\sqrt2+o(1)}.
  1997	\]
  1998	\end{proposition}
  1999	
  2000	\begin{proof}
  2001	By Lemma~\ref{lem:reject} and Theorem~\ref{thm:Dk}, the hypotheses of Proposition~\ref{prop:select}(i) hold, so $p\ge L^{-o(1)}$. We bound the
  2002	remaining quantities in Proposition~\ref{prop:select}(ii).
  2003	\begin{itemize}
  2004	\item \emph{Rows.} $M_{\rm rows}\le(d+1)\pi(B)+O_d(\log N)=L^{a+o(1)}$.
  2005	\item \emph{One trial.} SAMPLE\_FIELD costs $(\log N)^{O(1)}$ in expectation. DESCEND\_ONCE costs one Gauss reduction, two runs of the
  2006	  Lenstra--Pomerance algorithm on integers $\le\sqrt{2N}$, and at most $2k$ special-$q$ searches. The first has expected cost
  2007	  $L_{\sqrt{2N}}[1/2,1+o(1)]=L^{1/\sqrt2+o(1)}$ (Fact~\ref{fact:LP}), uniformly over the inputs. Each search costs $\tilde O(B+S^2\log N)=L^{1/\sqrt2+o(1)}$
  2008	  (Proposition~\ref{prop:BS}; recall $S^2=L^{\theta/(2a)+o(1)}$ and $\theta/(2a)=1/\sqrt2$). AKS certification of the output primes is
  2009	  polynomial. So $C_{\rm trial}=L^{\max(1/\sqrt2,\theta/(2a))+o(1)}$.
  2010	\item \emph{Post-processing.} $\mathrm T_{\rm post}=M_{\rm rows}^2(\log N)^{O(1)}+B^{1+o(1)}=L^{2a+o(1)}$ (Proposition~\ref{prop:lv6}).
  2011	\end{itemize}
  2012	Hence the expected time is at most $L^{o(1)}(L^{a+o(1)}L^{\max(1/\sqrt2,\theta/(2a))}+L^{2a})$. With $a=\theta/\sqrt2$ the first two exponents
  2013	both equal $(1+\theta)/\sqrt2$, and $2a=\sqrt2\theta<(1+\theta)/\sqrt2$ because $\theta<1$.
  2014	\end{proof}
  2015	
  2016	\begin{remark}[the choice of $a$]
  2017	For a general smoothness exponent $a$ (with $S^2=L^{\theta/(2a)}$) the same proof gives $L^{c(a)+o(1)}$ with
  2018	$c(a)=\max(2a,a+1/\sqrt2,a+\theta/(2a))$. For $a>\theta/\sqrt2$ the term $a+1/\sqrt2$ exceeds $(1+\theta)/\sqrt2$. On $(0,\theta/\sqrt2)$ the function
  2019	$a+\theta/(2a)$ is decreasing, because $\theta/\sqrt2<\sqrt{\theta/2}$ for $\theta<1$. So $a=\theta/\sqrt2$ is optimal, and the minimum is $(1+\theta)/\sqrt2$.
  2020	\end{remark}
