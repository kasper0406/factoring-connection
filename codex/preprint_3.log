  1990	\section{Cost assembly and the constant}\label{sec:cost}
  1991	%======================================================================
  1992	
  1993	\begin{proposition}[cost of one split]\label{prop:cost}
  1994	For $N\ge N_0$ as in Section~\ref{sec:K}, the expected running time of $\mathrm{SPLIT}(N)$ is at most
  1995	\[
  1996	L^{\max(a+1/\sqrt2,\ a+\theta/(2a),\ 2a)+o(1)}=L^{(1+\theta)/\sqrt2+o(1)}.
  1997	\]
  1998	\end{proposition}
  1999	
  2000	\begin{proof}
