  1853	\subsection{Square roots}
  1854	
  1855	\begin{algorithm}[$\mathrm{SQ}(\Gamma)$; after {\cite[\S9]{blp1993}}]\label{alg:SQ}
  1856	Input: $\Gamma=g'(\beta)^2\prod_Pz_P^{|e_P|}\in\Z[\beta]$, and the bound $A_{\rm sq}$ of Lemma~\ref{lem:SQ}.
  1857	\begin{enumerate}[label=\arabic*.]
  1858	\item Let $p$ be the least prime in $(B,2B]$ with $p\nmid D$, found by sieving $(B,2B]$ once per field. Then $g\bmod p$ is squarefree, and
  1859	  $\Gamma$ is a unit at $p$, because $\Norm(\Gamma)=\pm\disc(g)^2\prod(f_d^{d-1}F_A(P))^{|e_P|}$ has only prime factors $\le B$ or dividing $D$.
  1860	\item Factor $g\bmod p=\phi_1\cdots\phi_\tau$ over $\F_p$. In each $\F_p[y]/(\phi_j)$ test whether $\Gamma$ is a square and compute a
  1861	  square root $\rho_j$ (Tonelli--Shanks). If some component is a non-square, output NONSQUARE.
  1862	\item For each of the $2^{\tau-1}$ sign vectors $\epsilon$ with $\epsilon_1=+1$: combine the $\epsilon_j\rho_j$ by the Chinese remainder theorem to
  1863	  $\rho_\epsilon\in\Z[\beta]/p$; Newton-lift the inverse square root from $z_0=\rho_\epsilon^{-1}$ by $z\mapsto z+z(1-\Gamma z^2)/2$ to precision
  1864	  $p^e>2A_{\rm sq}$; put $\eta_\epsilon:=\Gamma z\bmod p^e$ with centred coefficients. If $\eta_\epsilon^2=\Gamma$ exactly, output $\eta_\epsilon$.
  1865	\item Output NONSQUARE.
  1866	\end{enumerate}
  1867	\end{algorithm}
  1868	
  1869	\begin{lemma}[square roots]\label{lem:SQ}
  1870	Let $\mathrm{Mh}:=\lfloor\|g\|_2\rfloor+1$, $g_{\rm d}:=d\|g\|_1\mathrm{Mh}^{d-1}$, $U:=g_{\rm d}^2\prod_P(\|z_P\|_1\mathrm{Mh}^{d-1})^{|e_P|}$ and
  1871	$A_{\rm sq}:=d\lceil U^{1/2}\rceil2^{d-1}\mathrm{Mh}\,g_{\rm d}^{d-1}$. Then:
  1872	\begin{enumerate}[label=(\roman*)]
  1873	\item Any output $\eta$ satisfies $\eta^2=\Gamma$. If $\Gamma\in K^{\times2}$, then $\Gamma=\eta^2$ with $\eta\in\Z[\beta]$, $\|\eta\|_\infty\le A_{\rm sq}$, and SQ outputs $\pm\eta$.
  1874	\item $\log A_{\rm sq}=O_d((1+\sum_P|e_P|)\log N)$, and SQ runs in $O_d(\mathsf M(\log A_{\rm sq})\log\log A_{\rm sq})+(\log N)^{O(1)}$ bit operations
  1875	  (Las Vegas), where $\mathsf M$ is the cost of integer multiplication.
  1876	\end{enumerate}
  1877	\end{lemma}
  1878	
  1879	\begin{proof}
  1880	(i) If $\Gamma=\delta^2$ with $\delta\in K$, then $(\delta/g'(\beta))^2=\prod z_P^{|e_P|}\in\cO_K$, so $\delta/g'(\beta)\in\cO_K$. Moreover
  1881	$g'(\beta)\cO_K\subset\Z[\beta]$, because $\cO_K\subset\cO_K^\vee\subset\Z[\beta]^\vee=g'(\beta)^{-1}\Z[\beta]$ (Euler's lemma). So $\eta:=\delta\in\Z[\beta]$.
  1882	Since $p\nmid\disc g$, $\Z_p[\beta]\cong\prod_j\Z_p[y]/(G_j)$ with unramified local factors lifting the $\phi_j$. The reduction of $\eta$ is $\pm\rho_\epsilon$ for exactly
  1883	one $\epsilon$ with $\epsilon_1=+1$. A unit square root with prescribed residue lifts uniquely ($p$ odd), so $\eta_\epsilon\equiv\pm\eta\pmod{p^e}$, and centring recovers
  1884	$\pm\eta$ since $p^e>2A_{\rm sq}$. NONSQUARE at step~2 is correct, since $\eta$ would reduce to a square in each residue field
  1885	$\cO_K/\fP=\F_p[y]/(\phi_j)$ ($p$ is prime to the index). The coefficient bound: the conjugates satisfy $|\sigma_k(z)|\le\|z\|_1\mathrm{Mh}^{d-1}$ and
  1886	$|g'(\beta_k)|\le g_{\rm d}$, so $|\sigma_k(\eta)|\le U^{1/2}$. The coefficients of $\eta$ are recovered with the inverse Vandermonde matrix,
  1887	$(V^{-1})_{jk}=[y^j](g(y)/(y-\beta_k))/g'(\beta_k)$. Its numerators are the coefficients of $\prod_{j\ne k}(y-\beta_j)$, which are at most $2^{d-1}\prod_j\max(1,|\beta_j|)=2^{d-1}\mathrm{M}(g)\le2^{d-1}\mathrm{Mh}$ in absolute
  1888	value (Mahler measure, $\mathrm M(g)\le\|g\|_2$), and
  1889	$\prod_k|g'(\beta_k)|=|\disc g|\ge1$ gives $|g'(\beta_k)|\ge g_{\rm d}^{-(d-1)}$. (ii) The bound on $\log A_{\rm sq}$ is immediate. The cost
  1890	consists of a product tree for $\Gamma$, Newton iteration doubling the precision with $O(d^2)$ multiplications per step, and $2^{d-1}=O(1)$ sign vectors.
  1891	\end{proof}
