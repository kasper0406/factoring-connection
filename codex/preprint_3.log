  1039	\section{Bounded-\texorpdfstring{$k$}{k} splits and field selection}\label{sec:K}
  1040	%======================================================================
  1041	
  1042	From now on $N$ is the input of SPLIT: odd, with no prime factor $\le B$ and not a prime power, and $N\ge N_0$.
  1043	
  1044	\begin{lemma}[reverse Markov]\label{lem:revmarkov}
  1045	If $Z\in[0,1]$ and $\Ex Z\ge\beta$, then $\Prob[Z\ge\beta/2]\ge\beta/2$.
  1046	\end{lemma}
  1047	
  1048	\begin{proof}
  1049	$\beta\le\Ex Z\le\beta/2+\Prob[Z\ge\beta/2]$.
  1050	\end{proof}
  1051	
  1052	\begin{theorem}[complete descents in one field]\label{thm:K}
  1053	Let $A$ be a field for which $\mathrm{SAMPLE\_FIELD}$ returns $A$ (no rejection and no factor exit), and suppose
  1054	$|\cD_A|\ge4k^2$. Then one call of $\mathrm{DESCEND\_ONCE}(A)$ returns a row or makes a factor exit with probability at
  1055	least
  1056	\[
  1057	c_k'\Bigl(\frac{\delta_A}{\log N}\Bigr)^{2k}2^{-\omega(N)},
  1058	\]
  1059	with $c_k'>0$ depending only on $k$.
  1060	\end{theorem}
  1061	
  1062	\begin{proof}
  1063	The products of $k$ distinct primes of $\cD_A\subset J$ lie in $(Y^k,(2Y)^k]\subset(X2^{-2k},X]$. By pigeonhole one of the $2k$
  1064	dyadic windows $[Y'/2,Y']$ with $Y'=X2^{-i}$, $0\le i<2k$, contains a set $\cS$ of at least $\binom{|\cD_A|}k/(2k)$ of them, and
  1065	$2Y'^2\le2X^2<N$ (Lemma~\ref{lem:sizes}(e)).
  1066	Every $\ell\in\cD_A$ satisfies $\ell\nmid N$, by definition of $N_\ell$. Let $E$ be the event that $r$ is a unit and $R\equiv u/v$
  1067	with $u,v\in\cS$. Given that $r$ is a unit, $R$ is uniform on $Q_N$, so Theorem~\ref{thm:Sprime} gives
  1068	\[
  1069	\Prob_r[E]\ge\frac{\varphi(N)}{N}\cdot\frac{|\cS|^2}{c_kh_2\varphi(N)}=\frac{|\cS|^2}{c_kh_2N}.
  1070	\]
  1071	Now $|\cS|\ge(|\cD_A|/k)^k/(2k)$ and $|\cD_A|=\delta_A\pi_J\ge\delta_AY/(2\log Y)$, while
  1072	$Y^{2k}\ge X^2/16^k\ge N/(4\cdot16^k)$ and $2k\log Y\le\log N$. This gives the displayed lower bound for $\Prob_r[E]$.
  1073	
  1074	On $E$, Theorem~\ref{thm:S} shows $(u,v)=j(u_0,v_0)$. Unless a gcd check exits, $|u_0|$ and $|v_0|$ divide $u$ and $v$, so
  1075	each is a product of at most $k$ distinct primes of $\cD_A$. (This is why the rule says \emph{at most} $k$: the
  1076	condition is closed under taking divisors, whereas ``exactly $k$'' is not.) So the shape test passes. For each such
  1077	$\ell$ we have $N_\ell(A)\ge1$, and by Proposition~\ref{prop:BS} $\mathrm{SQ\_SEARCH}(A,\ell)$ returns an atom unless a gcd check
  1078	exits first. Hence the call returns a row or exits with a factor.
  1079	\end{proof}
  1080	
  1081	\paragraph{Trials and costs.} A \emph{trial} is one call of SAMPLE\_FIELD followed, if a field is returned, by one call
  1082	of DESCEND\_ONCE. Its outcome is a factor exit, a row, or neither. Let $p_F$ and $b$ be the probabilities of the first two
  1083	outcomes and $p:=p_F+b$. For a field $A$ let $\varsigma_A$ be the probability that DESCEND\_ONCE$(A)$ returns a row ($\varsigma_A:=0$
  1084	for rejected fields and for fields on which SAMPLE\_FIELD exits). Let $C_{\rm trial}$ be a uniform upper bound for the
  1085	expected cost of one trial and of one call of DESCEND\_ONCE, conditional on everything before it.
  1086	Let $\mathrm T_{\rm post}$ be a uniform bound for the expected cost of POSTPROCESS. Let $\cR$ be the set of fields $A$ with $\gcd(g_1,N)=1$
  1087	that satisfy one of the rejection conditions (i)--(iii) of Lemma~\ref{lem:reject}, regardless of other exits. (A field with
  1088	$\gcd(g_1,N)>1$ always produces a factor exit.)
  1089	
  1090	\begin{proposition}[field selection with factor exits]\label{prop:select}
  1091	\begin{enumerate}[label=(\roman*)]
  1092	\item If $\gamma\ge L^{-o(1)}$ and $\Prob_\cA(\cR)\le\gamma/2$, then $p\ge L^{-o(1)}$.
  1093	\item The expected running time of $\mathrm{SPLIT}(N)$ is at most $3(M_{\rm rows}C_{\rm trial}+\mathrm T_{\rm post})/p$.
  1094	\end{enumerate}
  1095	\end{proposition}
  1096	
  1097	\begin{proof}
  1098	(i) Since $0\le\delta_A\le1$, $\Ex[\delta_A1_{\cR^c}]\ge\gamma-\Prob(\cR)\ge\gamma/2$. By Lemma~\ref{lem:revmarkov}, the set
  1099	$\cG^*:=\{A\notin\cR:\delta_A\ge\gamma/4\}$ has probability at least $\gamma/4$. For $A\in\cG^*$, either SAMPLE\_FIELD exits
  1100	with a factor, or it returns $A$. In the latter case $|\cD_A|\ge\gamma\pi_J/4\ge4k^2$ for large $N$ (as
  1101	$\pi_J=N^{2\nu+o(1)}$), and Theorem~\ref{thm:K} applies. Hence
  1102	$p\ge(\gamma/4)c_k'(\gamma/(4\log N))^{2k}2^{-\omega(N)}=L^{-o(1)}$, by Lemma~\ref{lem:omega} and because $k$ is fixed.
  1103	
  1104	(ii) Trials are i.i.d., so the number of trials until the outcome is a factor or a row is geometric with
  1105	mean $1/p$. By Wald's identity the expected cost of selection is at most $C_{\rm trial}/p$. On a factor exit we are done; in
  1106	particular, if $b=0$ the bound is $C_{\rm trial}/p$. Assume $b>0$, and let $M_{\rm rows}$ denote a deterministic upper bound for the row target (as in
  1107	\eqref{eq:Mrows}).
  1108	Otherwise the outcome is a row, and the kept field $A^*$ has law $\Prob[A^*\in dA]=\varsigma_A\Prob_\cA(dA)/b$. Given $A^*=A$, a
  1109	round collects $M_{\rm rows}$ rows with an expected $M_{\rm rows}/\varsigma_A$ calls (or ends earlier with a factor), at expected cost at most
  1110	$M_{\rm rows}C_{\rm trial}/\varsigma_A+\mathrm T_{\rm post}$. By Theorem~\ref{thm:DD} and Remark~\ref{rem:T}, each round that reaches its final gcd succeeds with
  1111	conditional probability at least $1/2$, whatever happened before. So the expected cost given $A^*=A$ is at most
  1112	$2(M_{\rm rows}C_{\rm trial}/\varsigma_A+\mathrm T_{\rm post})$. Averaging over the law of $A^*$,
  1113	\[
  1114	\Ex\bigl[1/\varsigma_{A^*}\bigr]=\int\frac1{\varsigma_A}\frac{\varsigma_A}{b}\,\Prob_\cA(dA)=\frac{\Prob(\varsigma_A>0)}{b}\le\frac1b.
  1115	\]
  1116	The kept-field branch is reached with probability $b/p$, so its contribution is at most
  1117	$(b/p)\cdot2(M_{\rm rows}C_{\rm trial}/b+\mathrm T_{\rm post})\le2(M_{\rm rows}C_{\rm trial}+\mathrm T_{\rm post})/p$. Factor exits during collection only shorten the run.
  1118	\end{proof}
  1119	
  1120	\begin{remark}
  1121	No lower bound on $\varsigma_A$ for the kept field is used: the harmonic-mean identity makes the cost
  1122	depend only on $b$. Nor do we claim that the law of the non-terminating fields retains $\gamma/2$. Factor exits are
  1123	absorbed as successful outcomes, which repairs a gap in an earlier draft of the argument.
  1124	\end{remark}
