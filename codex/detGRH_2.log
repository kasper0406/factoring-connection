+            control = Matrix([2] + [0] * (k-1))
+            cols = [control] + [basis * Matrix([rng.randint(-3, 3) for _ in range(k)])
+                                for _ in range(k+1)]
+            collected = Matrix.hstack(*cols)
+            coordinates = inv * collected
+            assert all(x.q == 1 for x in coordinates)
+            vc = binary_rank([list(coordinates[:, j]) for j in range(coordinates.cols)])
+            union = binary_rank([list(coordinates[:, j]) for j in range(coordinates.cols)] + w_vectors)
+            intersection = vc + w - union
+            images = set()
+            for z in product((0, 1), repeat=collected.cols):
+                v = collected * Matrix(z)
+                if all(x % 2 == 0 for x in v):
+                    images.add(ev(n, generators, [x // 2 for x in v]))
+            fruitful = bool(images - {1, n-1})
+            assert len(images) == 2**intersection
+            assert fruitful == (intersection >= 2)
+            if collected.rank() == k and k-vc <= w-2:
+                assert fruitful
+            count += 1
+    return count
+
+
+def check_miller():
+    count = 0
+    outside_count = 0
+    for n in range(3, 402, 2):
+        f = factorint(n)
+        if len(f) < 2:
+            continue
+        lam = lcm(*(int(totient(p**e)) for p, e in f.items()))
+        u = units(n)
+        for multiplier in (1, 2, 3, 4):
+            m = lam * multiplier
+            t, s = m, 0
+            while t % 2 == 0:
+                t //= 2
+                s += 1
+            k = max(j for j in range(s) if any(pow(a, 2**j * t, n) == n-1 for a in u))
+            h = {a for a in u if pow(a, 2**k * t, n) in (1, n-1)}
+            assert len(h) < len(u)
+            for a in set(u) - h:
+                x = pow(a, 2**k * t, n)
+                while x*x % n != 1:
+                    x = x*x % n
+                assert x not in (1, n-1)
+                assert 1 < gcd(x-1, n) < n
+                outside_count += 1
+            count += 1
+    return count, outside_count
+
+
+def examples():
+    n = 77
+    u = units(n)
+    squares = {a*a % n for a in u}
+    principal = {s: next(a for a in squares if a*a % n == s) for s in squares}
+    assert principal[4] == 9
+    assert all(principal[a*b % n] == principal[a]*principal[b] % n for a in squares for b in squares)
+    assert closure(77, [-1, 2, 3]) == set(u)
+    defect = (2 * pow(9, -1, 77)) % 77
+    assert defect == 43 and gcd(defect-1, 77) == 7
+    subgroup = closure(65, [-1, 2])
+    assert len(subgroup) == 12 and {a for a in subgroup if a*a % 65 == 1} == {1, 64}
+    assert [pow(2, 3*2**j, 65) for j in range(3)] == [8, 64, 1]
+    assert pow(3, 4, 77) == pow(2, 2, 77) == 4
+    assert 9*9-77 == 4
+    rough_n = 1019 * 1031
+    odd_exponent = lcm(509, 515)
+    principal_rough = lambda s: pow(s, pow(2, -1, odd_exponent), rough_n)
+    honest = {r*r: r for r in primerange(2, 2*log(rough_n)**2)}
+    selected = lambda s: honest.get(s, principal_rough(s))
+    assert gcd(selected(36)-selected(4)*selected(9), rough_n) == 1031
+    # -1 and 2 generate U: ord_1019(2)=1018, ord_1031(2)=515;
+    # -1 has a second-component sign outside <2>.
+    from sympy import n_order, legendre_symbol
+    assert n_order(2, 1019) == 1018 and n_order(2, 1031) == 515
+    biased_s = [a for a in range(1, 1026)
+                if gcd(a, rough_n) == 1 and legendre_symbol(a, 1019) == 1]
+    assert sum(int(legendre_symbol(a, 1019)) for a in biased_s) == len(biased_s)
+    return {
+        "CD_selected_root_counterexample": {"N": 77, "FB": [-1, 2, 3], "principal_root_of_4": 9,
+                                          "other_root_of_4": 2, "ratio": defect},
+        "S_sequence_counterexample": {"N": 65, "G_order": len(subgroup), "M": 12,
+                                      "base": 2, "sequence": [8, 64, 1]},
+        "QS_kernel_exception": {"N": 77, "x": 9, "Qx": 4, "relation": "3^4 * 2^-2 = 1 mod 77"},
+        "G_nonvacuous_example": {"N": rough_n, "small_prime_bound": 2*log(rough_n)**2,
+                                  "y4": selected(4), "y9": selected(9), "y36": selected(36),
+                                  "factor_from_defect": 1031},
+        "CS_biased_subset": {"N": rough_n, "interval_end": 1025,
+                              "size_and_character_sum": len(biased_s)},
+        "RA_cubic_ratio": 3/(2+sqrt(2)),
+        "theta_0.75_cubic_cost": 3*0.75/sqrt(2),
+        "theta_0.75_original_cost": 1.75/sqrt(2),
+    }
+
+
+if __name__ == "__main__":
+    result = {"MR_odd_moduli_tested": check_mr(), "FL_lattices_tested": check_fl()}
+    result["Miller_modulus_multiplier_pairs"], result["Miller_outside_bases_tested"] = check_miller()
+    result.update(examples())
+    Path("referee_checks.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result, indent=2))

