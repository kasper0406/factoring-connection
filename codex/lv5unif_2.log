   166	def two_pow_2_5_bracket(den: int = 10 ** 6) -> Tuple[Fr, Fr]:
   167	    """Rationals lo < 2^{2/5} < hi with hi - lo = 1/den, decided exactly via x^5 vs 4."""
   168	    lo_n = 1319507 * den // 10 ** 6
   169	    while Fr(lo_n + 1, den) ** 5 < 4:
   170	        lo_n += 1
   171	    while Fr(lo_n, den) ** 5 > 4:
   172	        lo_n -= 1
   173	    return Fr(lo_n, den), Fr(lo_n + 1, den)
