   176	def recursion_factor_bracket() -> Tuple[Fr, Fr]:
   177	    """Bracket for 1/(1 - 2^{-2/5}) = t/(t - 1), t = 2^{2/5} (decreasing in t)."""
   178	    lo_t, hi_t = two_pow_2_5_bracket()
   179	    return hi_t / (hi_t - 1), lo_t / (lo_t - 1)
