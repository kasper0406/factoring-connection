    13	def gauss_reduce(b1, b2):
    14	    """Lagrange-Gauss reduction (exact integers); returns (shortest, second)."""
    15	    n = lambda v: v[0] * v[0] + v[1] * v[1]
    16	    if n(b1) > n(b2):
    17	        b1, b2 = b2, b1
    18	    while True:
    19	        # round(<b1,b2>/<b1,b1>) exactly
    20	        num = b1[0] * b2[0] + b1[1] * b2[1]
    21	        den = n(b1)
    22	        m = (2 * num + den) // (2 * den)
    23	        b2 = (b2[0] - m * b1[0], b2[1] - m * b1[1])
    24	        if n(b2) >= n(b1):
    25	            return b1, b2
    26	        b1, b2 = b2, b1
    27	
    28	
    29	def lattice_of(cfg):
    30	    """cfg: tuple of (l, (A, B)) with distinct l.  Lattice {a == r b mod d}."""
    31	    d, r = 1, 0
    32	    for l, (A, B) in cfg:
    33	        ri = A * pow(B, -1, l) % l
    34	        # CRT r mod d, ri mod l
    35	        t = ((ri - r) * pow(d, -1, l)) % l
    36	        r, d = r + d * t, d * l
    37	    return d, r % d
    38	
