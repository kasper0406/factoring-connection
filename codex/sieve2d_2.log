+import sys
+from itertools import combinations, product
+from math import comb, gcd, hypot, prod, sqrt
+from collections import Counter
+import random
+import numpy as np
+
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+from tests.test_sieve2d_bound import gauss_reduce, lattice_of
+from src.sieve2d.bound import check_box, err_terms
+from src.dcltheorem.params import primes_upto
+
+rng = random.Random(83071)
+counts = Counter()
+worst = [0, None]
+
+def per_config(H, Y, X, V, cfg):
+    j = len(cfg)
+    d, a = lattice_of(cfg)
+    u, _ = gauss_reduce((d, 0), (a, 1))
+    rho = hypot(*u)
+    assert rho <= 1.0746 * sqrt(d)
+    # Count a = residue mod d, 1 <= a,b <= X, then remove each V-line.
+    b = np.arange(1, X + 1, dtype=np.int64)
+    residues = (a * b) % d if d * X < 2**62 else np.array([(a * int(bb)) % d for bb in b])
+    first = np.where(residues == 0, d, residues)
+    cnt0 = int(np.maximum(0, (X - first) // d + 1).sum())
+    other, removed, par = 0., 0, []
+    for v in V:
+        tv = prod(l for l, w in cfg if w != v)
+        rv = sum(w != v for l, w in cfg)
+        removed += X // (tv * max(v))
+        if u[0] * v[1] == u[1] * v[0]:
+            par.append((v, tv, rv))
+        else:
+            assert rv >= (j + 1) // 2, (H, Y, cfg, u, v, rv)
+            other += X / (tv * max(v))
+    cnt = cnt0 - removed
+    assert cnt >= 0
+    if not par:
+        counts['case_i'] += 1
+        assert all(v[1]*u[0] - v[0]*u[1] != 0 for v in V)
+        events = [(l,v) for v in V for l in primes_upto(2*Y)
+                  if l>Y and (v[1]*u[0] - v[0]*u[1]) % l == 0]
+        assert len(events) <= 2*len(V)
+        bound = 1 + 3.266 * X / rho + other
+    else:
+        counts['case_ii'] += 1
+        assert len(par) == 1
+        v, tv, rv = par[0]
+        assert rv <= j // 2
+        assert u in [(tv*v[0],tv*v[1]), (-tv*v[0],-tv*v[1])]
+        g = d // tv
+        if j-rv >= 4:
+            counts['pure4'] += 1
+            assert cnt == 0
+            return
+        bound = 2*sqrt(2)*X/(tv*hypot(*v)) + 2*H*X/g + other
+    ratio = abs(cnt-X*X/d)/bound
+    if ratio > worst[0]:
+        worst[:] = [ratio, (H,Y,X,cfg,u,cnt,d,bound)]
+    assert ratio <= 1 + 1e-10, worst
+
+for H, Y, X, width, jmax in [(2,64,413,6,4),(3,144,317,5,4)]:
+    V = [(a,b) for a in range(1,H+1) for b in range(1,H+1) if gcd(a,b)==1]
+    band = [l for l in primes_upto(2*Y) if l>Y][:width]
+    for j in range(1,jmax+1):
+        for ls in combinations(band,j):
+            for vs in product(V,repeat=j):
+                per_config(H,Y,X,V,tuple(zip(ls,vs)))
+
+for it in range(3000):
+    H = rng.randint(2,12)
+    Y = rng.randint(16*H*H,20*H*H)
+    V0 = [(a,b) for a in range(1,H+1) for b in range(1,H+1) if gcd(a,b)==1]
+    V = rng.sample(V0, rng.randint(1,len(V0)))
+    band = [l for l in primes_upto(2*Y) if l>Y]
+    j = rng.randint(1,4)
+    cfg = tuple(zip(rng.sample(band,j),rng.choices(V,k=j)))
+    per_config(H,Y,rng.randint(1,1000),V,cfg)
+
+print('Per-configuration checks:',dict(counts),'worst ratio:',worst,flush=True)
+box_count = 0
+lambda_valid = 0
+for H in [2,3,4,5,8,12]:
+    Y = 16*H*H
+    V0 = [(a,b) for a in range(1,H+1) for b in range(1,H+1) if gcd(a,b)==1]
+    band0 = [l for l in primes_upto(2*Y) if l>Y]
+    for X in [1,2,17,67,257,701]:
+        for omit_diagonal in [False,True]:
+            V = [v for v in V0 if not omit_diagonal or v!=(1,1)]
+            r = check_box(H,X,Y,band0,V)
+            assert all(a<=b+1e-8 for a,b in zip(r['actual_err'],r['bound_err']))
+            if 'thm1_bound' in r:
+                lambda_valid += 1
+                assert r['uncovered'] <= r['thm1_bound'] + 1e-8
+                assert r['sum_dev4'] <= r['dev4_bound'] + 1e-8
+            box_count += 1
+print('Moment/whole-box checks:',box_count,'with lambda>=1:',lambda_valid,flush=True)

