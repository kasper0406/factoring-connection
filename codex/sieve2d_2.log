    68	        p = nV / l
    69	        for j in range(jmax, 0, -1):
    70	            e[j] += e[j - 1] * p
    71	    out = []
    72	    f = 1
    73	    for j in range(jmax + 1):
    74	        if j:
    75	            f *= j
    76	        out.append(e[j] * f)
    77	    return out
