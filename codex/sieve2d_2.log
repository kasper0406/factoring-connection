   109	def check_box(H, X, Y, band, V) -> Dict:
   110	    st = exhaustive_stats(H, X, band, V)
   111	    mod = model_factorial_moments(band, len(V))
   112	    actual = [abs(st["fact_sums"][j] - X * X * mod[j]) for j in range(5)]
   113	    bnd = [2 * H * X] + [err_terms(H, X, Y, band, V, j)["total"] for j in (1, 2, 3, 4)]
   114	    out = {"H": H, "X": X, "Y": Y, "K": len(band), "lam": st["lam"],
   115	           "actual_err": actual, "bound_err": bnd,
   116	           "uncovered": st["uncovered"], "npts": st["npts"]}
   117	    if st["lam"] >= 1:
   118	        out["thm1_bound"] = theorem1_bound(H, X, Y, band, V)["bound"]
   119	        out["dev4_bound"] = out["thm1_bound"] * st["lam"] ** 4
   120	        out["sum_dev4"] = st["sum_dev4"]
   121	    return out
