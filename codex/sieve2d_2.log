    40	def test_lattice_lemma_random():
    41	    rng = np.random.default_rng(7)
    42	    X = 120
    43	    a = np.arange(1, X + 1)
    44	    A2, B2 = np.meshgrid(a, a, indexing="ij")
    45	    for _ in range(300):
    46	        d = int(rng.integers(2, 5000))
    47	        r = int(rng.integers(0, d))
    48	        cnt = int((((A2 - r * B2) % d) == 0).sum())
    49	        u, _ = gauss_reduce((d, 0), (r, 1))
    50	        rho = sqrt(u[0] ** 2 + u[1] ** 2)
    51	        assert abs(cnt - X * X / d) <= 1 + 3.266 * X / rho + 1e-9
