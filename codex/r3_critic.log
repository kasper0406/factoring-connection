def four(start):
 out=[]
 while len(out)<4:
  if prime(start):out.append(start)
  start+=1
 return out
def run(job):
 split,p=job;start=process_time();m=isqrt(p)//2;L=2*m+1
 H={j*j%p for j in range(p)};best=m+1;w=None;valid=0;checks=0
