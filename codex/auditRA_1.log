 148:   draw r uniform in [1, N − 1]; gcd check r            # a non-unit r is a factor (gcd = N impossible)
 149:   R := r^2 mod N
 150:   (u0, v0) := shortest nonzero vector of {(u, v) ∈ Z^2 : u ≡ R v (mod N)} (Gauss reduction)
 151:   factor |u0| and |v0| completely with Lenstra–Pomerance (1992)          # the shape test, T_shape
 152:   certify every output prime by AKS                                       # Las Vegas (complexity critic C1)
