"""Instrumented polynomial collision detection over Z/N (any N; fmpz_mod_poly).

OPERATIONAL helpers: see only N and ring elements.  Only multiplication and
division by MONIC polynomials are used, so everything is valid over the ring
Z/N with N composite.  No gcd/xgcd/factor of polynomials over Z/N is called.

Cost charging (notes/dcltheorem_prereg.md, metric E):
  poly_cost += (d + 1) * ceil(log2(d + 2))   for every product / remainder whose
               result (product) or dividend (remainder) has degree d
  (FFT-model M(d) in Z/N-multiplication equivalents).  Scalar multiplications
  mod N are charged in mulN; gcds with N in gcdN.
"""
from __future__ import annotations

from math import gcd
from typing import List, Optional, Tuple

import flint


def _pc(d: int) -> int:
    d = max(0, d)
    return (d + 1) * max(1, (d + 1).bit_length())


def poly_mul(a, b, met):
    met.inc("poly_ops")
    met.inc("poly_cost", _pc(a.degree() + b.degree()))
    return a * b


def poly_rem(a, b, met):
    met.inc("poly_ops")
    met.inc("poly_cost", _pc(a.degree()))
    if a.degree() < b.degree():
        return a
    return a % b


def tree_levels(ctx, pts: List[int], met):
    """Product tree of the linear polynomials X - x (bottom level first)."""
    levels = [[ctx([(-x), 1]) for x in pts]]
    while len(levels[-1]) > 1:
        cur, nxt = levels[-1], []
        for i in range(0, len(cur) - 1, 2):
            nxt.append(poly_mul(cur[i], cur[i + 1], met))
        if len(cur) % 2:
            nxt.append(cur[-1])
        levels.append(nxt)
    return levels


def product_poly(ctx, pts: List[int], met):
    return tree_levels(ctx, pts, met)[-1][0]


def multipoint(ctx, f, pts: List[int], met) -> List[int]:
    """f(x) for all x in pts by a remainder tree (monic divisors only)."""
    if not pts:
        return []
    levels = tree_levels(ctx, pts, met)
    rems = [poly_rem(f, levels[-1][0], met)]
    for lev in range(len(levels) - 2, -1, -1):
        cur, new = levels[lev], []
        for i, node in enumerate(cur):
            new.append(poly_rem(rems[i // 2], node, met))
        rems = new
    out = []
    for r in rems:
        c = r.coeffs()
        out.append(int(c[0]) if c else 0)
    return out


def eval_baby_poly_at_giants(N: int, gamma: int, m: int, giants: List[int], met) -> List[int]:
    """f(G) for f(X) = prod_{0<=i<m} (X - gamma^i), for every giant G.
    Baby powers gamma^i are charged (m-1 multiplications)."""
    ctx = flint.fmpz_mod_poly_ctx(N)
    babies, x = [], 1
    for i in range(m):
        babies.append(x)
        x = x * gamma % N
        met.inc("mulN")
    f = product_poly(ctx, babies, met)
    return multipoint(ctx, f, giants, met)


# ---------------------------------------------------------------------------
# Harvey 2021 Alg. 4.1 (product tree over giants, Bluestein over the
# geometric babies alpha^i), fully charged -- used for the HH baseline.
# ---------------------------------------------------------------------------
class _FactorFound(Exception):
    def __init__(self, d: int, how: str):
        self.d, self.how = d, how


def harvey_find_collisions(N: int, alpha: int, kappa: int, vals: List[int], met) -> Optional[int]:
    """Same interface/semantics as src.cycloharvey.operational.find_collisions,
    but over fmpz_mod_poly (any N) and with every scalar multiplication charged:
    the chirp powers alpha^{C(i,2)} are generated by the recurrences
    alpha^{C(i+1,2)} = alpha^{C(i,2)} * alpha^i (two multiplications per index)."""
    if not vals:
        return None
    ctx = flint.fmpz_mod_poly_ctx(N)
    f = product_poly(ctx, vals, met)
    n = f.degree()
    fc = [int(c) for c in f.coeffs()] + [0] * (n + 1 - len(f.coeffs()))
    met.inc("gcdN")
    if gcd(alpha, N) != 1:
        g = gcd(alpha, N)
        if 1 < g < N:
            met.set("hit", None)
            return g
        return None
    ainv = pow(alpha, -1, N)
    met.inc("invN")

    def chirp(base: int, count: int) -> List[int]:
        # base^{C(k,2)} for k = 0..count-1:  C(k+1,2) = C(k,2) + k
        out, cur, bk = [], 1, 1        # cur = base^{C(k,2)}, bk = base^k
        for k in range(count):
            out.append(cur)
            cur = cur * bk % N
            bk = bk * base % N
            met.inc("mulN", 2)
        return out

    h = chirp(alpha, max(kappa, n + 2))           # alpha^{C(i,2)}, i >= 0
    fpj = []
    # alpha^{C(j+1,2)} = h[j+1]
    for j in range(n + 1):
        fpj.append(h[j + 1] * fc[j] % N)
    met.inc("mulN", n + 1)
    # g_k = alpha^{-C(k,2)} for k in [-n, kappa): C(-k,2) = C(k+1,2)
    gpos = chirp(ainv, max(kappa, n + 2))         # ainv^{C(k,2)}, k >= 0
    gk = [gpos[k + 1] for k in range(n, 0, -1)] + [gpos[k] for k in range(kappa)]
    F = ctx(fpj)
    G = ctx(gk)
    P = poly_mul(F, G, met)
    pc = [int(c) for c in P.coeffs()]
    ai = 1
    for i in range(kappa):
        idx = i + n
        s = pc[idx] if idx < len(pc) else 0
        e = h[i] * s % N
        met.inc("mulN")
        met.inc("gcdN")
        g = gcd(e, N)
        if g > 1:
            for hh, v in enumerate(vals):
                met.inc("gcdN")
                g2 = gcd((v - ai) % N, N)
                if 1 < g2 < N:
                    met.set("hit", [i, hh])
                    return g2
        ai = ai * alpha % N
        met.inc("mulN")
    return None
"""Baseline: Harvey--Hittmeir 2022 Alg. 4.3 (signsplit's operational V0, imported
unchanged), with its stage 3 (Harvey Alg. 4.1) replaced at call time by
stage3.harvey_find_collisions -- the same algorithm over fmpz_mod_poly (works
for N >= 2^64) with every scalar multiplication charged.  OPERATIONAL (sees N,
public M, m0, seed only).  Parameter choice: min over M in the primorials of
signsplit.accounting.best_shared (list count), as in signsplit.

Counter mapping to metric E: signsplit's Ring charges rn_mul (square-and-multiply
exact) and gcd/inv; stage 3 charges mulN/gcdN/invN/poly_cost.
"""
from __future__ import annotations

from typing import Dict

import src.signsplit.hh as sshh
from src.signsplit.accounting import best_shared

from .stage3 import harvey_find_collisions

PRIMORIALS = (1, 2, 6, 30, 210, 2310, 30030)


def hh_params(N: int) -> Dict:
    best = None
    for M in PRIMORIALS:
        b = best_shared(N, M, "V0")
        if best is None or b["work"] < best["work"]:
            best = b
    return best


def hh_run(N: int, params: Dict, seed: int = 0) -> Dict:
    orig = sshh.find_collisions
    sshh.find_collisions = harvey_find_collisions
    try:
        r = sshh.hh_search(N, params["M"], params["m0"], "V0", seed=seed)
    finally:
        sshh.find_collisions = orig
    return r


def hh_E(counts: Dict[str, int], n: int) -> int:
    lg = max(1, (n - 1).bit_length())
    return (counts.get("rn_mul", 0) + counts.get("mulN", 0) + counts.get("poly_cost", 0)
            + lg * (counts.get("gcd", 0) + counts.get("gcdN", 0) + counts.get("inv", 0)
                    + counts.get("invN", 0)))

