+"""Independent exact referee checks. No imports from the repository."""
+from math import gcd, isqrt, prod, log2
+from fractions import Fraction
+from collections import Counter
+import json
+
+def primes(B):
+    a = bytearray([1]) * (B+1)
+    a[:2] = bytes(2)
+    for d in range(2, isqrt(B)+1):
+        if a[d]:
+            for x in range(d*d, B+1, d): a[x] = 0
+    return [d for d in range(2, B+1) if a[d]]
+
+def order(a, q):
+    v = a % q
+    d = 1
+    while v != 1:
+        v = v*a % q
+        d += 1
+    return d
+
+def ceildiv(a, b): return -((-a)//b)
+
+def pmul(a, b, N):
+    c = [0]*(len(a)+len(b)-1)
+    for i,x in enumerate(a):
+        for j,y in enumerate(b): c[i+j] = (c[i+j]+x*y) % N
+    return c
+
+def prem(a, b, N):
+    a = a[:]
+    assert b[-1] == 1
+    for i in range(len(a)-len(b), -1, -1):
+        v = a[i+len(b)-1]
+        for j,y in enumerate(b): a[i+j] = (a[i+j]-v*y) % N
+    return a[:len(b)-1]
+
+def ptree(xs, N):
+    lv = [[[(-x)%N, 1] for x in xs]]
+    while len(lv[-1])>1:
+        cur = lv[-1]
+        lv.append([pmul(cur[j],cur[j+1],N) if j+1<len(cur) else cur[j]
+                   for j in range(0,len(cur),2)])
+    return lv
+
+def mpe(f, xs, N):
+    lv = ptree(xs,N)
+    rr = [prem(f,lv[-1][0],N)]
+    for nodes in reversed(lv[:-1]):
+        rr = [prem(rr[j//2], node,N) for j,node in enumerate(nodes)]
+    return [r[0] if r else 0 for r in rr]
+
+def exptree(base, es, N):
+    lv = [es]
+    while len(lv[-1])>1:
+        cur=lv[-1]
+        lv.append([prod(cur[j:j+2]) for j in range(0,len(cur),2)])
+    vv=[base%N]
+    for cur in reversed(lv[:-1]):
+        vv=[pow(vv[j//2],cur[j^1],N) if (j^1)<len(cur) else vv[j//2]
+            for j in range(len(cur))]
+    return vv, lv[-1][0]
+
+C=Counter()
+examples={}
+allpr=primes(16384)
+for T in range(1,15):
+    for Q0 in (2,5,17,100,1000):
+        bad=[q for q in allpr if Q0<q<(1<<T) and order(2,q)<=T]
+        assert len(bad)<=T*(T+1)/(2*log2(Q0))
+        assert prod(bad)<(1<<(T*(T+1)//2)) or not bad
+        C['small_order_bounds']+=1
+
+# Small versions of the asymptotic design. All use Y>H^2 and 16Y<p.
+for n,H,Y in ((18,2,11),(20,3,17),(22,3,23),(24,4,37)):
+    P=1<<(n//2)
+    V=[(A,B) for A in range(1,H+1) for B in range(1,H+1)
+       if A!=B and gcd(A,B)==1]
+    bands=[[l for l in allpr if (1<<k)*Y<l<=(2<<k)*Y and l%4==3] for k in range(4)]
+    assert Y>H*H and Y**4>isqrt(2*P*P)+1
+    ps=[p for p in allpr if P//2<p<P]
+    qs=[q for q in allpr if q*q>P*P//2 and q*q<2*P*P]
+    pairs=[(p,q) for q in qs for p in ps
+           if p<q<=2*p and (1<<(n-1))<=p*q<(1<<n) and p>16*Y]
+    # Deterministic evenly spaced sample, augmented by low-order q.
+    take=set(pairs[::max(1,len(pairs)//100)][:100])
+    low=sorted(qs,key=lambda q:order(2,q))[:12]
+    for q in low:
+        partners=[p for p,qq in pairs if qq==q]
+        for p in partners[::max(1,len(partners)//8)][:8]: take.add((p,q))
+    for p,q in sorted(take):
+        N=p*q
+        a=isqrt(N//2)
+        if 2*a*a<N: a+=1
+        b=isqrt(N)
+        d=order(2,q)
+        clean=[all((q-1)%l for l in band) for band in bands]
+        assert any(clean)
+        C['clean_band_pairs']+=1
+        certified=False
+        succeeds=False
+        for k,band in enumerate(bands):
+            us,L=exptree(2,[l*l for l in band],N)
+            assert all(u==pow(2,L//(l*l),N) for l,u in zip(band,us))
+            gamma=pow(2,L,N)
+            sp=(5*H*(P+1))//2+2*H+3
+            mb=sp//((1<<k)*Y)**2+2
+            for l,u in zip(band,us):
+                C['exponent_handles']+=1
+                if clean[k]: assert gcd(L,q-1)==1 and order(gamma%q,q)==d
+                for A,B in V:
+                    if (B*p-A*q)%l: continue
+                    r=p%l
+                    aa=A*N*pow(B,-1,l)%l
+                    assert pow(aa,(l-1)//2,l)==1
+                    root=pow(aa,(l+1)//4,l)
+                    assert root*root%l==aa and r in (root,l-root)
+                    c=(B*r+A*(N*pow(r,-1,l*l)%(l*l)))%(l*l)
+                    assert (B*p+A*q-c)%(l*l)==0
+                    g=(B*p+A*q-c)//(l*l)
+                    lo=isqrt(4*A*B*N)
+                    hi=max(B*x+ceildiv(A*N,x) for x in (a,b))
+                    gl=ceildiv(lo-c,l*l)
+                    gh=(hi-c)//(l*l)
+                    assert gl>=0 and gl<=g<=gh and gh-gl+1<=mb
+                    # Multiple baby lengths exercise j>0 and the asymmetric delta range.
+                    for m in sorted({1,min(3,mb),mb}):
+                        j,i=divmod(g-gl,m)
+                        G=pow(u,B+A*N-c,N)*pow(gamma,-(gl+j*m),N)%N
+                        assert G%p==pow(gamma,i,p)
+                        assert G%q==pow(gamma,i,q)*pow(u,(A-B)*(p-1),q)%q
+                        babies=[pow(gamma,z,N) for z in range(m)]
+                        full=any(G%q==z%q for z in babies)
+                        fval=prod((G-z)%N for z in babies)%N
+                        gg=gcd(fval,N)
+                        assert gg==(N if full else p)
+                        C['covering_target_m_checks']+=1
+                        if clean[k]:
+                            cf=any(((A-B)*(p-1)-l*l*delta)%d==0
+                                   for delta in range(-i,m-i))
+                            assert cf==full
+                            C['clean_FULL_checks']+=1
+                            C['clean_FULL' if full else 'clean_nonFULL']+=1
+                            if not full:
+                                certified=True
+                                if order(gamma%p,p)<m: examples.setdefault('small_p_order_success',[p,q,A,B,l,m,order(gamma%p,p)])
+                        else:
+                            cf=any(((A-B)*(p-1)-l*l*delta)%d==0
+                                   for delta in range(-i,m-i))
+                            if cf!=full: examples.setdefault('dirty_band_criterion_fails',[p,q,A,B,l,m,i,d])
+                        if 1<gg<N: succeeds=True
+                        if full: examples.setdefault('FULL_target',[p,q,A,B,l,m,i,d,clean[k]])
+                        if not full: examples.setdefault('nonFULL_target',[p,q,A,B,l,m,i,d,clean[k]])
+                    C['covering_targets']+=1
+            # Independently exercise monic polynomial product/remainder trees.
+            if k==0:
+                m=min(mb,23)
+                babies=[pow(gamma,i,N) for i in range(m)]
+                xs=[(z*z+17)%N for z in range(13)]+babies[:5]
+                f=ptree(babies,N)[-1][0]
+                vals=mpe(f,xs,N)
+                assert vals==[prod((x-b)%N for b in babies)%N for x in xs]
+                C['composite_multipoint_cases']+=1
+        assert not certified or succeeds
+        C['certified_pairs']+=certified
+        C['sampled_pairs']+=1
+    # L9: exact residue distinctness and finite-interval sieve bound.
+    for q in qs[::max(1,len(qs)//12)][:12]:
+        for k,band in enumerate(bands):
+            for l in band:
+                rs={A*q*pow(B,-1,l)%l for A,B in V}
+                assert len(rs)==len(V)
+            U=[p for p in range(P//2,P+1)
+               if all((B*p-A*q)%l for A,B in V for l in band)]
+            J=sum((Fraction(len(V),l-len(V)) for l in band),Fraction(0))
+            assert len(U)*J<=P//2+1+((2<<k)*Y)**2
+            C['large_sieve_bounds']+=1
+    # L10: count solutions before union bound; exact CRT modulus.
+    for q in low[:4]:
+        d=order(2,q)
+        for k,band in enumerate(bands):
+            if any((q-1)%l==0 for l in band): continue
+            mb=((5*H*(P+1))//2+2*H+3)//((1<<k)*Y)**2+2
+            for A,B in V:
+                gp=gcd(A-B,d)
+                for l in band:
+                    for delta in range(-min(mb-1,5),min(mb-1,5)+1):
+                        rs=[p for p in range(P//2,P+1)
+                            if (B*p-A*q)%l==0 and ((A-B)*(p-1)-l*l*delta)%d==0]
+                        if rs: assert all((p-rs[0])%(l*d//gp)==0 for p in rs)
+                        assert len(rs)<=Fraction(P*gp,2*l*d)+1
+                        C['CRT_bounds']+=1
+out={'counts':dict(C),'examples':examples}
+print(json.dumps(out,indent=2))
+open('/tmp/claude-r13/independent_results.json','w').write(json.dumps(out,indent=2)+'\n')

