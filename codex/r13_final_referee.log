   197	def choose_m(targets: List[Dict], mbar: int) -> int:
   198	    """Public choice of the baby length: minimise m + sum ceil(W/m) over a
   199	    geometric grid in [1, max W] (never above max W; max W <= mbar)."""
   200	    if not targets:
   201	        return 1
   202	    Wmax = max(t["W"] for t in targets)
   203	    best, m = None, 1
   204	    while True:
   205	        mm = min(m, Wmax)
   206	        c = mm + sum(-(-t["W"] // mm) for t in targets)
   207	        if best is None or c < best[0]:
   208	            best = (c, mm)
   209	        if mm == Wmax:
   210	            break
   211	        m = (119 * m) // 100 + 1            # integer-only grid (no float overflow)
   212	    return best[1]
