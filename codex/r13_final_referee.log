+"""Independent N-only implementation, plus a separate comparison to repo code.
+The implementation below uses only stdlib exact arithmetic and no repo helpers.
+"""
+from math import gcd, isqrt, prod
+from collections import Counter
+import json
+
+def psieve(n):
+    return [p for p in range(2,n+1) if all(p%d for d in range(2,isqrt(p)+1))]
+
+def cdiv(a,b): return -((-a)//b)
+
+def own(N,H,Y):
+    if N<3: return None
+    if N%2==0: return 2
+    V=[(A,B) for A in range(1,H+1) for B in range(1,H+1)
+       if A!=B and gcd(A,B)==1]
+    ps=psieve(16*Y)
+    a=isqrt(N//2)
+    if 2*a*a<N: a+=1
+    b=isqrt(N)
+    for k in range(4):
+        band=[l for l in ps if (1<<k)*Y<l<=(2<<k)*Y and l%4==3]
+        if not band: continue
+        ts=[]
+        for l in band:
+            if N%l==0:
+                if l<N: return l
+                return None
+            for A,B in V:
+                if A*B%l==0: continue
+                aa=A*N*pow(B,-1,l)%l
+                if pow(aa,(l-1)//2,l)!=1: continue
+                r0=pow(aa,(l+1)//4,l)
+                lo=isqrt(4*A*B*N)
+                hi=max(B*x+cdiv(A*N,x) for x in (a,b))
+                for r in sorted({r0,l-r0}):
+                    c=(B*r+A*N*pow(r,-1,l*l))%(l*l)
+                    gl=cdiv(lo-c,l*l)
+                    gh=(hi-c)//(l*l)
+                    ts.append((A,B,l,c,gl,max(1,gh-gl+1)))
+        if not ts: continue
+        # The same publicly specified endpoint-competitive choice; no factors used.
+        wm=max(t[-1] for t in ts)
+        candidates=[]
+        mm=1
+        while True:
+            m=min(mm,wm)
+            candidates.append((m+sum(cdiv(t[-1],m) for t in ts),m))
+            if m==wm: break
+            mm=(119*mm)//100+1
+        m=min(candidates,key=lambda x:x[0])[1]
+        L=prod(l*l for l in band)
+        gamma=pow(2,L,N)
+        us={l:pow(2,L//(l*l),N) for l in band}
+        babies=[pow(gamma,i,N) for i in range(m)]
+        for A,B,l,c,gl,W in ts:
+            for j in range(cdiv(W,m)):
+                G=pow(us[l],B+A*N-c,N)*pow(gamma,-(gl+j*m),N)%N
+                fv=prod((G-z)%N for z in babies)%N
+                d=gcd(fv,N)
+                if 1<d<N: return d
+    return None
+
+if __name__=='__main__':
+    # Repo imported only to compare outputs after independent implementation.
+    from src.dcltheorem.algorithm import dcl_det
+    from src.dcltheorem.params import Design, theorem_design
+    ps=psieve(1500)
+    pairs=[(p,q) for p in ps for q in ps
+           if p<q<=2*p and (1<<19)<=p*q<(1<<20)]
+    pairs=pairs[::max(1,len(pairs)//250)][:250]
+    D=Design(n=20,H=3,Y=17)
+    C=Counter()
+    for p,q in pairs:
+        N=p*q
+        a=own(N,3,17)
+        b=dcl_det(N,D)['factor']
+        assert (a is None)==(b is None),(N,a,b)
+        assert a is None or (1<a<N and N%a==0)
+        assert b is None or (1<b<N and N%b==0)
+        C['pair_comparisons']+=1
+        C['pair_successes']+=a is not None
+    adversarial=[1<<19,(1<<19)+1,(1<<20)-1,3*174763,5*104859,727**2,1009**2,524287,1000003]
+    for N in adversarial:
+        a=own(N,3,17)
+        b=dcl_det(N,D)['factor']
+        assert (a is None)==(b is None),(N,a,b)
+        assert b is None or (1<b<N and N%b==0)
+        C['adversarial_comparisons']+=1
+    wrong=[]
+    crashes=[]
+    for N in range(2,257):
+        try:
+            f=dcl_det(N,theorem_design(N.bit_length(),1,60))['factor']
+            if f is not None and not(1<f<N and N%f==0): wrong.append([N,f])
+        except Exception as e: crashes.append([N,type(e).__name__,str(e)])
+    out={'counts':dict(C),'small_input_wrong_outputs':wrong,'small_input_crashes':crashes}
+    print(json.dumps(out,indent=2))
+    open('/tmp/claude-r13/operational_results.json','w').write(json.dumps(out,indent=2)+'\n')

