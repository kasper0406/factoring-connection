HARNESS code: the operational algorithm (algorithm.dcl_det, hh_baseline.hh_run)
receives only N; p, q are used afterwards for classification / certificates.
"""
from __future__ import annotations

import json
import os
import sys
import time
from math import gcd, log2
from multiprocessing import Pool
from typing import Dict, List

from src.common.metrics import Metrics, append_jsonl, read_jsonl

from .algorithm import build_targets, choose_m, dcl_det, metric_E
from .harness import classify_hit, lemma_checks, ord2, predict, sample_pair
from .params import Design, lam_full, schedule_design

RAW = "experiments/raw"
CFG = "experiments/configs/dcltheorem_experiments.json"
ANA = "experiments/analysis/dcltheorem_summary.json"

CONFIG = {
    "lemma": {"n": [28, 32, 36, 40], "seeds": list(range(0, 60)), "design": "C1"},
    "oper": {"n": [40, 48, 56, 64, 72, 80], "seeds": list(range(100, 132)),
             "designs": ["C1", "C3"], "C2_n": [40, 48, 56, 64], "C2_seeds": list(range(100, 108))},
    "hh": {"n": [40, 48, 56, 64, 72, 80], "seeds": list(range(100, 116))},
    "exc": {"n": [48, 64, 80, 96], "seeds": list(range(5000, 6000)), "design": "C1"},
    "designs": {
        "C1": "schedule_design(n, 3.0, K=4, mod4=True)",
        "C2": "schedule_design(n, lam_full(n), K=4, mod4=True)",
        "C3": "schedule_design(n, 3.0, K=4, mod4=False)",
    },
    "metric_E": "mulN + mul_small + poly_cost + ceil(log2 n)*(gcdN+invN) + ceil(bigmul_bits/n)",
    "fit_range": [48, 80],
}

_DCACHE: Dict = {}


def get_design(name: str, n: int) -> Design:
    key = (name, n)
    if key not in _DCACHE:
        if name == "C1":
            _DCACHE[key] = schedule_design(n, 3.0, K=4, mod4=True, label="C1")
        elif name == "C2":
            _DCACHE[key] = schedule_design(n, lam_full(n), K=4, mod4=True, label="C2")
        elif name == "C3":
            _DCACHE[key] = schedule_design(n, 3.0, K=4, mod4=False, label="C3")
        else:
            raise ValueError(name)
    return _DCACHE[key]


def _accidental_null(N: int, p: int, q: int, blk: Dict) -> float:
    """Expected number of random giant/baby coincidences mod p or mod q over
    the block: n_giants * m * (1/ord_p(gamma) + 1/ord_q(gamma))."""
    from sympy import n_order
    g = blk["gamma"]
    tot = 0.0
    for r in (p, q):
        gr = g % r
        o = 1 if gr == 1 else int(n_order(gr, r))
        tot += blk["n_giants"] * blk["m"] / o
    return tot


def _strip(blk: Dict) -> Dict:
    return {k: v for k, v in blk.items()
            if k not in ("targets", "giant_meta", "giant_gcds", "gamma", "u")}


def run_one(args) -> Dict:
    mode, dname, n, seed = args
    N, p, q = sample_pair(n, seed)
    D = get_design(dname, n)
    met = Metrics()
    t0 = time.perf_counter()
    r = dcl_det(N, D, met, early_exit=False, record=True)
    wall = time.perf_counter() - t0
    ok = r["factor"] is None or (1 < r["factor"] < N and N % r["factor"] == 0)
    blocks = []
    Es = []
    for b in r["blocks"]:
        E = metric_E(b["met"]["counts"], n)
        Es.append(E)
        rec = _strip(b)
        rec["E"] = E
        if "targets" in b:
            rec["lemma"] = lemma_checks(N, p, q, D, b)
            rec["class"] = classify_hit(N, p, q, b) if b.get("factor") else None
            rec["acc_null"] = _accidental_null(N, p, q, b)
        else:
            rec["class"] = "GCD_" + b.get("status", "") if b.get("factor") else None
        blocks.append(rec)
    ms = [b.get("m", 0) for b in r["blocks"]]
    pr = predict(N, p, q, D, ms)
    first = next((i for i, b in enumerate(r["blocks"]) if b.get("factor")), None)
    out = {"mode": mode, "design": dname, "n": n, "seed": seed, "N": N,
           "design_summary": D.summary(), "success": r["factor"] is not None,
           "correct": ok, "first_block": first,
           "E_first": sum(Es[:first + 1]) if first is not None else None,
           "E_full": sum(Es), "E_block0": Es[0],
           "list_block0": blocks[0].get("m", 0) + blocks[0].get("n_giants", 0),
           "list_full": sum(b.get("m", 0) + b.get("n_giants", 0) for b in blocks),
           "certified": pr["certified"], "cert_blocks": pr["blocks"], "ord_q2": pr["ord_q2"],
           "q_bits": q.bit_length(), "blocks": blocks, "wall_s": round(wall, 4)}
    return out


def run_hh(args) -> Dict:
    from .hh_baseline import hh_E, hh_params, hh_run
    n, seed = args
    N, p, q = sample_pair(n, seed)
    t0 = time.perf_counter()
    prm = hh_params(N)
    r = hh_run(N, prm, seed=seed)
    wall = time.perf_counter() - t0
    c = r["met"]["counts"]
    f = r.get("factor")
    return {"mode": "hh", "n": n, "seed": seed, "N": N, "params": prm,
            "success": bool(f) and 1 < f < N and N % f == 0, "status": r["status"],
            "E": hh_E(c, n), "list": prm["work"], "counts": c, "wall_s": round(wall, 4)}


def run_exc(args) -> Dict:
    """Certificate components only (no stage 3): clean blocks, coverage,
    FULL counts, per block; m from the public choose_m."""
    n, seed = args
    N, p, q = sample_pair(n, seed)
    D = get_design("C1", n)
    ms = []
    for k in range(D.K):
        t = build_targets(N, D, k, Metrics())
        ms.append(choose_m(t, D.mbar[k]))
    pr = predict(N, p, q, D, ms)
    return {"mode": "exc", "n": n, "seed": seed, "certified": pr["certified"],
            "blocks": pr["blocks"], "ord_q2_bits": pr["ord_q2"].bit_length(),
            "q_bits": q.bit_length()}


def _pool_run(fn, jobs, path, procs=24):
    if os.path.exists(path):
        os.remove(path)
    with Pool(procs) as pool:
        for rec in pool.imap_unordered(fn, jobs):
            append_jsonl(path, rec)


def main(mode: str):
    os.makedirs(RAW, exist_ok=True)
    if mode == "config":
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        cfg = dict(CONFIG)
        cfg["design_summaries"] = {f"{d}@{n}": get_design(d, n).summary()
                                   for d in ("C1", "C3") for n in CONFIG["oper"]["n"]}
        cfg["design_summaries"].update({f"C2@{n}": get_design("C2", n).summary()
                                        for n in CONFIG["oper"]["C2_n"]})
        with open(CFG, "w") as fh:
            json.dump(cfg, fh, indent=1)
        print(json.dumps(cfg["design_summaries"], indent=0)[:3000])
    elif mode == "lemma":
        c = CONFIG["lemma"]
        jobs = [("lemma", c["design"], n, s) for n in c["n"] for s in c["seeds"]]
        _pool_run(run_one, jobs, f"{RAW}/dcltheorem_lemma.jsonl")
    elif mode == "oper":
        c = CONFIG["oper"]
        jobs = [("oper", d, n, s) for d in c["designs"] for n in c["n"] for s in c["seeds"]]
        jobs += [("oper", "C2", n, s) for n in c["C2_n"] for s in c["C2_seeds"]]
        jobs.sort(key=lambda j: -j[2])            # big first
        _pool_run(run_one, jobs, f"{RAW}/dcltheorem_oper.jsonl")
    elif mode == "hh":
        c = CONFIG["hh"]
        jobs = [(n, s) for n in c["n"] for s in c["seeds"]]
        _pool_run(run_hh, jobs, f"{RAW}/dcltheorem_hh.jsonl")
    elif mode == "exc":
        c = CONFIG["exc"]
        jobs = [(n, s) for n in c["n"] for s in c["seeds"]]
        _pool_run(run_exc, jobs, f"{RAW}/dcltheorem_exc.jsonl")
    elif mode == "summarize":
        from .analyze import summarize
        summarize()
    else:
        raise SystemExit(f"unknown mode {mode}")


if __name__ == "__main__":
    main(sys.argv[1])
"""Summaries for dcltheorem experiments (floating point only for fits)."""
from __future__ import annotations

import json
import os
from collections import defaultdict
from statistics import median

import numpy as np

from src.common.metrics import read_jsonl

RAW = "experiments/raw"
ANA = "experiments/analysis/dcltheorem_summary.json"


def _slope(xs, ys):
    xs, ys = np.array(xs, float), np.log2(np.array(ys, float))
    return float(np.polyfit(xs, ys, 1)[0]) if len(xs) >= 2 else None


def summarize():
    out = {}
    fr = (48, 80)
    p = f"{RAW}/dcltheorem_lemma.jsonl"
    if os.path.exists(p):
        R = read_jsonl(p)
        bad = defaultdict(int)
        for r in R:
            for b in r["blocks"]:
                for k, v in (b.get("lemma") or {}).get("bad", {}).items():
                    bad[k] += v
        out["lemma"] = {"runs": len(R), "incorrect": sum(not r["correct"] for r in R),
                        "lemma_bad": dict(bad),
                        "certified": sum(r["certified"] for r in R),
                        "certified_not_success": sum(r["certified"] and not r["success"] for r in R),
                        "success": sum(r["success"] for r in R),
                        "covering_targets_clean": sum(b["lemma"]["n_cover"] for r in R for b in r["blocks"] if b.get("lemma") and b["lemma"]["clean"])}
    p = f"{RAW}/dcltheorem_oper.jsonl"
    if os.path.exists(p):
        R = read_jsonl(p)
        by = defaultdict(list)
        for r in R:
            by[(r["design"], r["n"])].append(r)
        tab = {}
        for (d, n), rs in sorted(by.items()):
            bad = defaultdict(int)
            cls = defaultdict(int)
            for r in rs:
                for b in r["blocks"]:
                    for k, v in (b.get("lemma") or {}).get("bad", {}).items():
                        bad[k] += v
                fb = r["first_block"]
                if fb is not None:
                    cls[r["blocks"][fb]["class"]] += 1
            ok = [r for r in rs if r["success"]]
            tab[f"{d}@{n}"] = {
                "runs": len(rs), "success": len(ok), "incorrect": sum(not r["correct"] for r in rs),
                "certified": sum(r["certified"] for r in rs),
                "certified_not_success": sum(r["certified"] and not r["success"] for r in rs),
                "block0_success": sum(bool(r["blocks"][0].get("factor")) for r in rs),
                "first_block_hist": {str(k): sum(r["first_block"] == k for r in rs) for k in range(4)},
                "lemma_bad": dict(bad), "first_class": dict(cls),
                "acc_null_block0_median": median(r["blocks"][0].get("acc_null", 0) for r in rs),
                "med_E_first": median(r["E_first"] for r in ok) if ok else None,
                "med_E_block0": median(r["E_block0"] for r in rs),
                "med_E_full": median(r["E_full"] for r in rs),
                "med_list_block0": median(r["list_block0"] for r in rs),
                "med_list_full": median(r["list_full"] for r in rs),
                "med_wall": median(r["wall_s"] for r in rs),
                "H": rs[0]["design_summary"]["H"], "Y": rs[0]["design_summary"]["Y"],
                "lam": rs[0]["design_summary"]["lam"]}
        out["oper"] = tab
    p = f"{RAW}/dcltheorem_hh.jsonl"
    if os.path.exists(p):
        R = read_jsonl(p)
        by = defaultdict(list)
        for r in R:
            by[r["n"]].append(r)
        out["hh"] = {str(n): {"runs": len(rs), "success": sum(r["success"] for r in rs),
                              "status": {s: sum(r["status"] == s for r in rs) for s in {r["status"] for r in rs}},
                              "med_E_collision": median([r["E"] for r in rs if r["status"] == "collision"] or [0]),
                              "med_E_all": median(r["E"] for r in rs),
                              "list": median(r["list"] for r in rs),
                              "med_wall": median(r["wall_s"] for r in rs)}
                     for n, rs in sorted(by.items())}
    # slopes
    sl = {}
    if "oper" in out:
        for d in ("C1", "C2", "C3"):
            for key in ("med_E_first", "med_E_block0", "med_E_full", "med_list_block0", "med_list_full"):
                pts = [(int(k.split("@")[1]), v[key]) for k, v in out["oper"].items()
                       if k.startswith(d + "@") and v[key] and fr[0] <= int(k.split("@")[1]) <= fr[1]]
                if len(pts) >= 2:
                    sl[f"{d}:{key}"] = _slope(*zip(*pts))
    if "hh" in out:
        for key in ("med_E_collision", "med_E_all", "list"):
            pts = [(int(n), v[key]) for n, v in out["hh"].items() if v[key] and fr[0] <= int(n) <= fr[1]]
            sl[f"HH:{key}"] = _slope(*zip(*pts))
    out["slopes_48_80"] = sl
    if "oper" in out and "hh" in out:
        out["ratio_C1_first_over_HH"] = {
            n: out["oper"][f"C1@{n}"]["med_E_first"] / out["hh"][n]["med_E_collision"]
            for n in out["hh"] if f"C1@{n}" in out["oper"] and out["hh"][n]["med_E_collision"]}
    p = f"{RAW}/dcltheorem_exc.jsonl"
    if os.path.exists(p):
        R = read_jsonl(p)
        by = defaultdict(list)
        for r in R:
            by[r["n"]].append(r)
        ex = {}
        for n, rs in sorted(by.items()):
            ncov = sum(b["n_cover"] for r in rs for b in r["blocks"])
            nfull = sum(b["n_full"] for r in rs for b in r["blocks"])
            ex[str(n)] = {"pairs": len(rs), "certified": sum(r["certified"] for r in rs) / len(rs),
                          "block0_clean": sum(r["blocks"][0]["clean"] for r in rs) / len(rs),
                          "block0_cert": sum(r["blocks"][0]["cert"] for r in rs) / len(rs),
                          "block0_uncovered": sum(r["blocks"][0]["n_cover"] == 0 for r in rs) / len(rs),
                          "all_blocks_uncovered": sum(all(b["n_cover"] == 0 for b in r["blocks"]) for r in rs) / len(rs),
                          "full_over_cover": nfull / max(1, ncov),
                          "ord_q2_bits_median": median(r["ord_q2_bits"] for r in rs),
                          "q_bits_median": median(r["q_bits"] for r in rs)}
        out["exc"] = ex
    os.makedirs(os.path.dirname(ANA), exist_ok=True)
    with open(ANA, "w") as fh:
        json.dump(out, fh, indent=1)
    print(json.dumps(out, indent=1))
"""Tests for src/dcltheorem (DCL-det: deterministic divisor-cover Lehman)."""
from math import gcd, isqrt

import pytest

from src.common.metrics import Metrics
from src.dcltheorem.algorithm import (all_but_one, balanced_range, dcl_det, f_bounds,
                                      metric_E, sqrt_prime)
from src.dcltheorem.harness import (full_closed_form, lemma_checks, ord2, predict,
                                    sample_pair)
from src.dcltheorem.params import Design, schedule_design, theorem_design, weight_set


def test_weight_set_excludes_symmetric_and_noncoprime():
    V = weight_set(6)
    assert (1, 1) not in V and (2, 4) not in V and (2, 3) in V and (3, 2) in V
    assert all(A != B and gcd(A, B) == 1 for A, B in V)


def test_all_but_one_matches_direct():
    N = 1000003 * 999983
    exps = [l * l for l in (7, 11, 19, 23, 31)]
    vals, E = all_but_one(2, exps, N, Metrics())
    for e, v in zip(exps, vals):
        assert v == pow(2, E // e, N)


@pytest.mark.parametrize("l", [43, 47, 59, 61, 73, 97, 101, 113])
def test_sqrt_prime(l):
    for a in range(1, l):
        if pow(a, (l - 1) // 2, l) == 1:
            r = sqrt_prime(a, l, Metrics())
            assert r * r % l == a


def test_f_bounds_cover_balanced_range():
    N, p, q = sample_pair(30, 1)
    a0, b0 = balanced_range(N)
    assert a0 <= p <= b0
    for A, B in [(1, 2), (5, 3), (7, 1)]:
        lo, hi = f_bounds(N, A, B, a0, b0, Metrics())
        for x in (a0, b0, (a0 + b0) // 2, isqrt(A * N // B)):
            if a0 <= x <= b0:
                assert lo * x <= B * x * x + A * N <= hi * x


def test_sample_pair_population():
    for s in range(20):
        N, p, q = sample_pair(36, s)
        assert p < q <= 2 * p and (1 << 35) <= N < (1 << 36)


def test_theorem_design_shapes():
    D = theorem_design(120, 1, 60)
    assert D.K == 4 and all(l % 4 == 3 for b in D.bands for l in b)
    assert D.Y > D.H ** 2                                    # distinct sieve classes


@pytest.mark.parametrize("n", [32, 36])
def test_lemmas_and_certificate(n):
    """Lemmas 1-4, the Lemma 5/7 equivalence on clean blocks, and
    certified => success, on random pairs (harness check)."""
    D = schedule_design(n, 3.0)
    for seed in range(8):
        N, p, q = sample_pair(n, 7000 + seed)
        r = dcl_det(N, D, Metrics(), early_exit=False, record=True)
        assert r["factor"] is None or (1 < r["factor"] < N and N % r["factor"] == 0)
        for b in r["blocks"]:
            if "targets" in b:
                lc = lemma_checks(N, p, q, D, b)
                assert all(v == 0 for v in lc["bad"].values()), lc
        pr = predict(N, p, q, D, [b.get("m", 0) for b in r["blocks"]])
        if pr["certified"]:
            assert r["factor"] in (p, q)


def test_full_closed_form_exact_vs_superset():
    # superset (istar=None) is implied by the exact window
    p, q = 36697, 71249
    d = ord2(q)
    for (A, B, l, m) in [(5, 9, 151, 18), (7, 2, 167, 18)]:
        for istar in range(m):
            if full_closed_form(p, q, A, B, l, m, d, istar):
                assert full_closed_form(p, q, A, B, l, m, d)


def test_metric_E_counts_everything():
    c = {"mulN": 10, "mul_small": 3, "poly_cost": 100, "gcdN": 2, "invN": 1, "bigmul_bits": 129}
    assert metric_E(c, 64) == 10 + 3 + 100 + 6 * 3 + 3


def test_hh_baseline_runs():
    from src.dcltheorem.hh_baseline import hh_params, hh_run
    N, p, q = sample_pair(40, 3)
    r = hh_run(N, hh_params(N))
    assert r["factor"] in (p, q)

