    69	        while vals[i] - vals[j] >= W:
    70	            j += 1
    71	        best = max(best, i - j + 1)
    72	    return best
    73	
    74	
    75	# ---------------------------------------------------------------------------
    76	# exponent profile (display; floats allowed)
    77	# ---------------------------------------------------------------------------
    78	def e_dcl(theta: float) -> float:
    79	    """Regime I/II exponent at ratio N^theta (Theorems U, U_theta): (1+theta)/6."""
    80	    return (1.0 + theta) / 6.0
    81	
    82	
    83	def e_ps(theta: float) -> float:
    84	    """Pollard-Strassen exponent at ratio N^theta: p = N^{(1-theta)/2}, cost p^{1/2}."""
    85	    return (1.0 - theta) / 4.0
    86	
    87	
    88	def e_profile(theta: float) -> float:
    89	    return min(e_dcl(theta), e_ps(theta))
    90	
    91	
    92	def frac_theta_below(t: float) -> float:
    93	    """Fraction of prime pairs pq <= X with N^{1/3} <= p <= sqrt N whose ratio exponent
    94	    theta = log(q/p)/log N is <= t, asymptotically (Mertens: density of p ~ N^a is
    95	    proportional to 1/(a(1-a)) da, a = (1-theta)/2):  log2((1+t)/(1-t)) on [0, 1/3]."""
    96	    return log((1 + t) / (1 - t)) / log(2.0)
    97	
    98	
    99	def frac_covered_at(eta: float) -> float:
   100	    """Fraction of that population factored at exponent <= 1/6 + eta by the profile."""
   101	    t1 = min(1 / 3, 6 * eta)
   102	    t2 = max(0.0, 1 / 3 - 4 * eta)
   103	    if t1 >= t2:
   104	        return 1.0
   105	    return frac_theta_below(t1) + 1.0 - frac_theta_below(t2)
   106	
   107	
   108	__all__ = ["covered_count", "prop_o_bound_int", "best_window_coverage", "best_set_coverage", "prop_o_set_bound_int", "e_profile",
   109	           "frac_theta_below", "frac_covered_at"]
   110	
   111	
   112	# ---------------------------------------------------------------------------
   113	# Proposition O' (arbitrary baby exponent sets)
   114	# ---------------------------------------------------------------------------
   115	def best_set_coverage(N: int, alpha: int, beta: int, c0: int, M: int, r: int, m: int,
   116	                      x1: int, x2: int) -> int:
   117	    """Max over ALL m-element sets S of integers of #{x : floor(g(x)) in S}: the optimum
   118	    for a single giant is the m most popular floor values."""
   119	    M2 = M * M
   120	    cnt = {}
   121	    p = x1 + ((r - x1) % M)
   122	    while p <= x2:
   123	        if p > 0:
   124	            v = (alpha * p * p + beta * N + c0 * p) // (M2 * p)
   125	            cnt[v] = cnt.get(v, 0) + 1
   126	        p += M
   127	    return sum(sorted(cnt.values(), reverse=True)[:m])
   128	
   129	
   130	def prop_o_set_bound_int(N: int, beta: int, m: int, x2: int) -> int:
   131	    """2m + 8 sqrt(m x2^3 / (|beta| N)), rounded up (Proposition O', per giant)."""
   132	    S = -(-(64 * m * x2 ** 3) // (abs(beta) * N))
   133	    s = isqrt(S)
   134	    if s * s < S:
   135	        s += 1
   136	    return 2 * m + s

