+"""Small exact checks for the nfsfruit referee report; standard library only."""
+from math import gcd, isqrt
+
+
+def factor(a):
+    a = abs(a)
+    out = {}
+    p = 2
+    while p * p <= a:
+        while a % p == 0:
+            out[p] = out.get(p, 0) + 1
+            a //= p
+        p += 1
+    if a > 1:
+        out[a] = out.get(a, 0) + 1
+    return out
+
+
+def jacobi(a, n):
+    a %= n
+    out = 1
+    while a:
+        while a % 2 == 0:
+            a //= 2
+            if n % 8 in (3, 5):
+                out = -out
+        a, n = n, a
+        if a % 4 == n % 4 == 3:
+            out = -out
+        a %= n
+    return out if n == 1 else 0
+
+
+def two_part(a):
+    return (a & -a).bit_length() - 1
+
+
+def character_exponents(p, c):
+    g = next(g for g in range(2, p)
+             if all(pow(g, (p - 1) // l, p) != 1 for l in factor(p - 1)))
+    return {pow(g, j, p): j * 2 ** (c - two_part(p - 1)) % 2**c
+            for j in range(p - 1)}
+
+
+def bockstein_check(p, q):
+    n, m = p * q, 1
+    alpha = m + n
+    c = max(two_part(p - 1), two_part(q - 1))
+    cp, cq = character_exponents(p, c), character_exponents(q, c)
+    coordinates, pivots, relations = {}, {}, []
+    checked = 0
+    for b in range(-4, 5):
+        for a in range(-20, 51):
+            z, A = a - b * m, a - b * alpha
+            if gcd(a, b) != 1 or not z or not A or gcd(z * A, n) != 1:
+                continue
+            vector, t = 0, 0
+            for side, value in enumerate((z, A)):
+                entries = list(factor(value).items()) + [(-1, int(value < 0))]
+                for l, e in entries:
+                    key = side, l
+                    if key not in coordinates:
+                        coordinates[key] = len(coordinates)
+                    vector ^= (e % 2) << coordinates[key]
+                    tau = (cp[l % p] + cq[l % q]) % 2**c
+                    t += (1 if side == 0 else -1) * tau * e
+            assert t % 2**c == 0
+            beta = t // 2**c % 2
+            relation_id = len(relations)
+            relations.append((z, A, beta))
+            mask = 1 << relation_id
+            while vector:
+                k = vector.bit_length() - 1
+                if k not in pivots:
+                    pivots[k] = vector, mask
+                    break
+                v, s = pivots[k]
+                vector ^= v
+                mask ^= s
+            if vector:
+                continue
+            Z = AA = 1
+            prediction = 0
+            for j, (zz, aa, bb) in enumerate(relations):
+                if mask >> j & 1:
+                    Z *= zz
+                    AA *= aa
+                    prediction ^= bb
+            assert Z > 0 and AA > 0
+            U, V = isqrt(Z), isqrt(AA)
+            assert U * U == Z and V * V == AA
+            ratio = U * pow(V, -1, n) % n
+            assert prediction == int(ratio not in (1, n - 1))
+            checked += 1
+    print(f"Bockstein n={n}, c={c}: {checked} exact kernel vectors passed")
+
+
+if __name__ == "__main__":
+    for p, q in ((3, 7), (5, 7), (5, 13), (5, 17), (7, 13)):
+        bockstein_check(p, q)
+
+    # An extra even-weight row can kill every fruitful exact dependency.
+    U = V = 1
+    for a, b in ((82, 1), (403, 3)):
+        z, A = a - b, a - 78 * b
+        u, v = isqrt(z), isqrt(A)
+        assert u * u == z and v * v == A and gcd(a, b) == 1
+        assert u * pow(v, -1, 77) % 77 == 43
+        U *= u
+        V *= v
+    assert U % 77 == V % 77 == 26
+    print("Extra parity row counterexample: singleton ratios 43, pair ratio 1")
+
+    # The QS Jacobi formula is false outside the Blum hypothesis.
+    assert 9**2 - 65 == 4**2
+    assert jacobi(9, 65) == 1 and jacobi(2, 65) == 1
+    assert 9 * pow(4, -1, 65) % 65 not in (1, 64)
+    print("Non-Blum QS counterexample: n=65, x=9, z=16")
+
+    # All short vectors for lambda=1 lie on c=d unless they are of size >= n/2.
+    n = 1001
+    e1, e2 = (1, 1), ((n + 1) // 2, (1 - n) // 2)
+    assert e1[0] * e2[1] - e1[1] * e2[0] == -n
+    assert sum(x * y for x, y in zip(e1, e2)) == 1
+    print("Gauss-reduced lambda=1 basis:", e1, e2)

