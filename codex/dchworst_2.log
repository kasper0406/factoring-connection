+targets = wc.build_targets(N, [l], W, met)
+m = wc.choose_m(targets)
+Tprime = sum(-(-t['W']//m) for t in targets)
+record = dict(N=N,p=p,q=q,l=l,H=H,cover=cover,attempts=len(W),
