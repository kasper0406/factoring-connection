+"""Larger covered inputs with exactly Theorem R's default T and B0."""
+import collections
+import json
+import random
+import sys
+from pathlib import Path
+sys.dont_write_bytecode = True
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+import sympy
+from src.dchworst.wcalg import dcl_wc
+
+rng = random.Random(1891)
+records = []
+for n in (40, 48, 60, 72, 80):
+    for signed_case in (False, True):
+        for _ in range(4):
+            p = int(sympy.nextprime(rng.randrange(2**(n//2-1), 2**(n//2))))
+            l = int(sympy.nextprime(2**(n//6)))
+            while l % 4 != 3:
+                l = int(sympy.nextprime(l))
+            # q == p mod l gives diagonal coverage; q == -p mod l gives (-1,1).
+            residue = (-p if signed_case else p) % l
+            k = (p-residue)//l + 1 + rng.randrange(20, 100)
+            q = residue+k*l
+            while q % 2 == 0 or not sympy.isprime(q):
+                q += l
+            assert p < q <= 2*p
+            N = p*q
+            T = int(sympy.integer_nthroot(N, 3)[0])
+            if T**3 < N:
+                T += 1
+            bits = N.bit_length()
+            result = dcl_wc(N, [[l]], H=1, T=T, B0=bits**4)
+            assert result['factor'] in (p, q), (N, result)
+            records.append(dict(N=N, p=p, q=q, l=l, T=T, B0=bits**4,
+                                signed_case=signed_case, result=result))
+    print(n, 'complete', flush=True)
+Path('referee_default_parameters.json').write_text(json.dumps(records, indent=2))
+print(len(records), 'covered default-parameter runs;',
+      dict(collections.Counter(r['result']['status'] for r in records)), flush=True)

