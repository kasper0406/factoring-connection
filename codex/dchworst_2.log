@@ -0,0 +1,31 @@
+import json
+import math
+import sys
+from pathlib import Path
+sys.dont_write_bytecode = True
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+from src.common.metrics import Metrics
+from src.dchworst import wcalg as wc
+
+p, q, l, H = 1009, 2017, 251, 125
+N = p*q
+assert 2*l*l < N and H < l
+W = []
+for B in range(1, H+1):
+    for A in range(1, H+1):
+        if math.gcd(A, B) != 1:
+            continue
+        # Precisely one sign is a nonsquare, since l = 3 mod 4.
+        a = A*N*pow(B, -1, l) % l
+        W.append((A if pow(a, (l-1)//2, l) == l-1 else -A, B))
+cover = next((A,B) for A,B in wc.weights(math.isqrt(l), True, True)
+             if (B*p-A*q) % l == 0)
+W.append(cover)
+met = Metrics()
+targets = wc.build_targets(N, [l], W, met)
+m = wc.choose_m(targets)
+Tprime = sum(-(-t['W']//m) for t in targets)
+record = dict(N=N,p=p,q=q,l=l,H=H,cover=cover,attempts=len(W),
+              targets=len(targets),m=m,Tprime=Tprime,metrics=met.to_record())
+Path('referee_cost_and_claims.json').write_text(json.dumps(record, indent=2))
+print(json.dumps(record, indent=2))
