+"""Read-only audit of the parent repository; all outputs stay in this scratch dir."""
+import collections
+import json
+import math
+import random
+import sys
+import time
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+import sympy
+from src.common.metrics import Metrics
+from src.dchworst import wcalg as wc
+
+out = {'counts': collections.Counter(), 'statuses': collections.Counter(),
+       'examples': {}, 'failures': [], 'first_r_overshoots': []}
+start = time.time()
+
+def save():
+    out['seconds'] = round(time.time() - start, 3)
+    Path('referee_adversarial.json').write_text(json.dumps(out, indent=2))
+
+def check(p, q, band, W=None, mode='block', T=1, B0=3, b=2, H=3):
+    N = p*q
+    assert p < q <= 2*p
+    band = [l for l in band if H < l and 2*l*l < N and l % 4 == 3]
+    if not band:
+        return
+    W = W or wc.weights(H, True, True)
+    covers = [(A, B, l) for A, B in W for l in band if (B*p-A*q) % l == 0]
+    if not covers:
+        return
+    met, log = Metrics(), {}
+    try:
+        if mode == 'block':
+            if math.gcd(b, N) > 1:
+                return
+            wc.run_block(N, b, band, W, T, met, log)
+            result = {'factor': None, 'status': 'fail', 'log': log}
+        else:
+            result = wc.dcl_wc(N, [band], H, T, B0, met=met,
+                               force_base=b if mode == 'force' else None)
+    except wc.Found as e:
+        result = {'factor': e.d, 'status': e.how, 'log': log}
+    out['counts'][mode] += 1
+    out['statuses'][result['status']] += 1
+    info = dict(p=p, q=q, N=N, band=band, weights=W if len(W) < 5 else 'full',
+                mode=mode, T=T, B0=B0, b=b, result=result,
+                metrics=met.to_record(), covers=covers[:3])
+    out['examples'].setdefault(result['status'], info)
+    if result['factor'] not in (p, q):
+        out['failures'].append(info)
+
+# Direct single-weight blocks exercise the signed/diagonal proofs independently
+# of unrelated targets and of the base-selection shortcuts.
+primes = list(map(int, sympy.primerange(11, 1200)))
+for p in primes:
+    for q in primes:
+        if not p < q <= 2*p:
+            continue
+        for A, B in [(1, 1), (-1, 1), (-2, 1), (1, 2), (2, 1)]:
+            height = max(abs(A), B)
+            divisors = [int(l) for l in sympy.factorint(abs(B*p-A*q))
+                        if l % 4 == 3 and l > height and 2*l*l < p*q]
+            if divisors:
+                check(p, q, divisors[:2], [(A, B)], H=height)
+        if (p + q) % 7 == 0:
+            check(p, q, [7, 11, 19], mode='full', T=math.isqrt(p), H=3)
+            check(p, q, [7, 11, 19], mode='force', H=3)
+save()
+print('small pairs complete', dict(out['counts']), 'failures', len(out['failures']), flush=True)
+
+# Search balanced pairs sharing orders of bases 2,3 (and as many further bases
+# as possible), as well as ord_2 with band factors.
+buckets = collections.defaultdict(list)
+for p0 in sympy.primerange(7, 160000):
+    p = int(p0)
+    sig = tuple(int(sympy.n_order(b, p)) for b in (2, 3))
+    for old in buckets[sig]:
+        if p > 2*old:
+            continue
+        info = dict(p=old, q=p, orders=sig)
+        out['examples'].setdefault('equal_orders_2_3', info)
+        T = max(sig)
+        check(old, p, [7, 11, 19], mode='full', T=T, B0=3)
+    buckets[sig].append(p)
+
+for l in [3, 7, 11, 19, 23, 31]:
+    for o in range(1, 100):
+        D = l*o
+        pp = [j*D+1 for j in range(2, 100, 2)
+              if sympy.isprime(j*D+1) and sympy.n_order(2, j*D+1) == D]
+        for p in pp:
+            for q in pp:
+                if p < q <= 2*p:
+                    check(p, q, [l], mode='full', T=max(1, D-2), B0=3, H=min(2, l-1))
+                    check(p, q, [l], mode='force', H=min(2, l-1))
+save()
+print('equal orders complete', dict(out['counts']), 'failures', len(out['failures']), flush=True)
+
+# Threshold-boundary behavior of first_r (the code intentionally covers a full
+# last BSGS rectangle rather than clipping to T).
+rng = random.Random(713)
+for _ in range(2000):
+    p = int(sympy.nextprime(rng.randrange(20, 2000)))
+    q = int(sympy.nextprime(rng.randrange(p+1, 2*p-2)))
+    for b in (2, 3):
+        op, oq = int(sympy.n_order(b, p)), int(sympy.n_order(b, q))
+        T = max(1, min(op, oq)-1)
+        try:
+            kind, r = wc.first_r(b, T, p*q, Metrics())
+            if kind == 'equal' and r > T and len(out['first_r_overshoots']) < 5:
+                out['first_r_overshoots'].append(dict(p=p, q=q, b=b, T=T, r=r))
+        except wc.Found as e:
+            assert e.d in (p, q)
+save()
+print(json.dumps({k: out[k] for k in ['counts','statuses','failures','first_r_overshoots','seconds']}, indent=2), flush=True)
