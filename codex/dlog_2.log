   182	def gamma_exponents(rows: List[Dict], x: List[int]) -> Dict[tuple, int]:
   183	    """y_P = sum_i x_i e_{iP} over atoms P = (a, b)."""
   184	    y: Dict[tuple, int] = {}
   185	    for xi, rw in zip(x, rows):
   186	        if xi == 0:
   187	            continue
   188	        for ell, e, at in rw["atoms"]:
   189	            key = (at["a"], at["b"])
   190	            y[key] = y.get(key, 0) + xi * e
   191	    return {k: v for k, v in y.items() if v}
   192	
   193	
   194	def log_vector(y: Dict[tuple, int], logs: Dict[tuple, List]) -> List:
   195	    n = len(next(iter(logs.values()))) if logs else 0
   196	    out = [flint.arb(0)] * n
   197	    for key, v in y.items():
   198	        lv = logs[key]
   199	        out = [o + v * l for o, l in zip(out, lv)]
   200	    return out
   201	
   202	
   203	def unit_relations(basis, rows, A, ctr, extra_bits=64):
   204	    """Integer relations n with sum n_j Log(gamma_{x_j}) = 0, certified via the Blanksby-Montgomery gap."""
   205	    d = len(A["f"]) - 1
   206	    maxbits = max((abs(v).bit_length() for x in basis for v in x), default=1)
   207	    ybits = maxbits + max(4, (len(rows) * 4).bit_length()) + 8
   208	    prec = 2 * ybits + 4 * len(basis) + 128 + extra_bits
   209	    real, cplx = embeddings(A["f"], prec)
   210	    atoms = {(at["a"], at["b"]) for rw in rows for _, _, at in rw["atoms"]}
   211	    logs = {k: atom_log(k[0], k[1], real, cplx) for k in atoms}
   212	    ys = [gamma_exponents(rows, x) for x in basis]
   213	    ctr["basis_nontrivial_gamma"] = sum(1 for y in ys if y)
   214	    vs = [log_vector(y, logs) for y in ys]
   215	    s, nc = len(vs), len(real) + len(cplx)
   216	    ctr["r1r2"] = [len(real), len(cplx)]
   217	    # norm check: every gamma_x (x in Lambda_1) is a unit, so sum of the log vector is 0
   218	    for v in vs:
   219	        tot = sum(v, flint.arb(0))
   220	        if not tot.contains(0):
   221	            _inc(ctr, "NONUNIT_KERNEL_VECTOR")
   222	    kappa = prec // 2
   223	    scale = flint.arb(2) ** kappa
   224	    rowsL = []
   225	    for j, v in enumerate(vs):
   226	        r = [0] * s
   227	        r[j] = 1
   228	        r += [int((c * scale).mid().floor().unique_fmpz()) for c in v[:nc]]
   229	        rowsL.append(r)
   230	    Lred = flint.fmpz_mat(rowsL).lll()
   231	    gap = bm_bound(d) / 2
   232	    rels = []
   233	    for i in range(Lred.nrows()):
   234	        n = [int(Lred[i, j]) for j in range(s)]
   235	        if not any(n):
   236	            continue
   237	        comb = [flint.arb(0)] * nc
   238	        for nj, v in zip(n, vs):
   239	            if nj:
   240	                comb = [c + nj * vv for c, vv in zip(comb, v[:nc])]
   241	        if all(abs(c) < gap for c in comb):
   242	            rels.append(n)
   243	        elif all(abs(c) > -1 for c in comb) and any(abs(c) > gap for c in comb):
   244	            _inc(ctr, "lll_rows_nontorsion")
   245	        elif all(not (abs(c) > gap) for c in comb):
   246	            _inc(ctr, "unit_rel_undecided")
   247	    ctr["kernel_dim"] = s
   248	    ctr["unit_relations"] = len(rels)
   249	    ctr["unit_rank_implied"] = s - len(rels)
   250	    ctr["ybits"] = ybits

