from math import isqrt,gcd
B=8192
sieve=bytearray(b'\\1')*(B+1);sieve[:2]=b'\\0\\0'
for p in range(2,isqrt(B)+1):
 if sieve[p]:sieve[p*p:B+1:p]=b'\\0'*((B-p*p)//p+1)
for bits in [5,6,7,8,9,10,11,12,13]:
 lo=3*2**(bits-2);hi=2**bits
 primes=[p for p in range(lo,hi) if sieve[p]]
 cases={p*q:(p,q,1 if p%4==1 else -1) for i,p in enumerate(primes) for q in primes[i+1:] if p%4==q%4}
 ex=next(((N,cases[N],N+4,cases[N+4]) for N in cases if N+4 in cases and cases[N][2]"'!=cases[N+4][2]),None)
 if ex:
  print('"'shift example, n =',2*bits,ex);break
print('fixed 2 examples',[(N,[pow(2,(p-1)//2,p) for p in fac]) for N,fac in [(97*113,[97,113]),(101*109,[101,109])]])
print('sqrt(-1) modulo 65',[r for r in range(65) if (r*r+1)%65==0])
# Validate elementary oracle identities on a small exhaustive domain.
def factor(n):
 out={};d=2
 while d*d<=n:
  while n%d==0:out[d]=out.get(d,0)+1;n//=d
  d+=1
 if n>1:out[n]=out.get(n,0)+1
 return out
def sos(n):return all(p%4"'!=3 or e%2==0 for p,e in factor(n).items())
def qrminus(n):return n%4!=0 and all(p==2 or p%4==1 for p in factor(n))
checks=0
for N in range(3,250,2):
 for k in range(1,35):
  if gcd(k,N)!=1:continue
  for e in range(1,4):
   assert sos(k*N**e)==(sos(k) and (e%2==0 or sos(N)))
   assert qrminus(k*N**e)==(qrminus(k) and qrminus(N))
   checks+=1
print('"'multiplicative identity cases checked',checks)
