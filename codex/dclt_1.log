   141	def schedule_design(n: int, lam_target: float, K: int = 4, mod4: bool = True,
   142	                    label: str = "") -> Design:
   143	    """Smallest H whose block-0 multiplicity |V| sum 1/l reaches lam_target, with
   144	    Y minimising the n-only expected block-0 cost on a 2^(1/4) grid."""
   145	    H = 2
   146	    while True:
   147	        V = weight_set(H)
   148	        y0 = pow2_frac(n, 1, 6) / max(1.0, H ** (1.0 / 3))
   149	        best = None
   150	        for j in range(-12, 13):
   151	            Y = max(H + 1, int(y0 * 2 ** (j / 4)))
   152	            ps = [l for l in primes_upto(2 * Y) if l > Y and (not mod4 or l % 4 == 3)]
   153	            if not ps:
   154	                continue
   155	            c = _expected_cost(n, H, Y, V, ps)
   156	            if best is None or c < best[0]:
   157	                best = (c, Y, ps)
   158	        c, Y, ps = best
   159	        lam = len(V) * sum(1.0 / l for l in ps)
   160	        if lam >= lam_target:
   161	            return Design(n=n, H=H, Y=Y, K=K, mod4=mod4,
   162	                          label=label or f"schedule lam>={lam_target:.3f}")
   163	        H += 1
   164	
