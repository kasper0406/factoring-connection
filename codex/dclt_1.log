    57	@dataclass
    58	class Design:
    59	    n: int
    60	    H: int
    61	    Y: int
    62	    K: int = 4
    63	    mod4: bool = True                      # primes l == 3 (mod 4) only
    64	    label: str = ""
    65	    V: List[Tuple[int, int]] = field(default_factory=list)
    66	    bands: List[List[int]] = field(default_factory=list)
    67	    mbar: List[int] = field(default_factory=list)
    68	
    69	    def __post_init__(self):
    70	        self.V = weight_set(self.H)
    71	        top = (1 << self.K) * self.Y
    72	        ps = primes_upto(top)
    73	        self.bands = []
    74	        for k in range(self.K):
    75	            lo, hi = (1 << k) * self.Y, (1 << (k + 1)) * self.Y
    76	            band = [l for l in ps if lo < l <= hi and l > 2 and (not self.mod4 or l % 4 == 3)]
    77	            self.bands.append(band)
    78	        self.mbar = [span_bound(self.n, self.H) // (b[0] ** 2) + 2 if b else 0
    79	                     for b in self.bands]
    80	
    81	    def lam(self, k: int = 0) -> float:
    82	        """Expected sieve multiplicity of block k: |V| * sum_{l in P_k} 1/l (display)."""
    83	        return len(self.V) * sum(1.0 / l for l in self.bands[k])
    84	
    85	    def summary(self) -> Dict:
    86	        return {"n": self.n, "H": self.H, "Y": self.Y, "K": self.K, "mod4": self.mod4,
    87	                "label": self.label, "nV": len(self.V),
    88	                "band_sizes": [len(b) for b in self.bands],
    89	                "band_ranges": [[b[0], b[-1]] if b else None for b in self.bands],
    90	                "lam": [round(self.lam(k), 4) for k in range(self.K)],
    91	                "mbar": self.mbar}
