    97	def harvey_find_collisions(N: int, alpha: int, kappa: int, vals: List[int], met) -> Optional[int]:
    98	    """Same interface/semantics as src.cycloharvey.operational.find_collisions,
    99	    but over fmpz_mod_poly (any N) and with every scalar multiplication charged:
   100	    the chirp powers alpha^{C(i,2)} are generated by the recurrences
   101	    alpha^{C(i+1,2)} = alpha^{C(i,2)} * alpha^i (two multiplications per index)."""
   102	    if not vals:
   103	        return None
   104	    ctx = flint.fmpz_mod_poly_ctx(N)
   105	    f = product_poly(ctx, vals, met)
   106	    n = f.degree()
   107	    fc = [int(c) for c in f.coeffs()] + [0] * (n + 1 - len(f.coeffs()))
   108	    met.inc("gcdN")
   109	    if gcd(alpha, N) != 1:
   110	        g = gcd(alpha, N)
   111	        if 1 < g < N:
   112	            met.set("hit", None)
   113	            return g
   114	        return None
   115	    ainv = pow(alpha, -1, N)
   116	    met.inc("invN")
   117	
   118	    def chirp(base: int, count: int) -> List[int]:
   119	        # base^{C(k,2)} for k = 0..count-1:  C(k+1,2) = C(k,2) + k
   120	        out, cur, bk = [], 1, 1        # cur = base^{C(k,2)}, bk = base^k
   121	        for k in range(count):
   122	            out.append(cur)
   123	            cur = cur * bk % N
   124	            bk = bk * base % N
   125	            met.inc("mulN", 2)
   126	        return out
   127	
   128	    h = chirp(alpha, max(kappa, n + 2))           # alpha^{C(i,2)}, i >= 0
   129	    fpj = []
   130	    # alpha^{C(j+1,2)} = h[j+1]
   131	    for j in range(n + 1):
   132	        fpj.append(h[j + 1] * fc[j] % N)
   133	    met.inc("mulN", n + 1)
   134	    # g_k = alpha^{-C(k,2)} for k in [-n, kappa): C(-k,2) = C(k+1,2)
   135	    gpos = chirp(ainv, max(kappa, n + 2))         # ainv^{C(k,2)}, k >= 0
   136	    gk = [gpos[k + 1] for k in range(n, 0, -1)] + [gpos[k] for k in range(kappa)]
   137	    F = ctx(fpj)
   138	    G = ctx(gk)
   139	    P = poly_mul(F, G, met)
   140	    pc = [int(c) for c in P.coeffs()]
   141	    ai = 1
   142	    for i in range(kappa):
   143	        idx = i + n
   144	        s = pc[idx] if idx < len(pc) else 0
   145	        e = h[i] * s % N
   146	        met.inc("mulN")
   147	        met.inc("gcdN")
   148	        g = gcd(e, N)
   149	        if g > 1:
   150	            for hh, v in enumerate(vals):
   151	                met.inc("gcdN")
   152	                g2 = gcd((v - ai) % N, N)
   153	                if 1 < g2 < N:
   154	                    met.set("hit", [i, hh])
   155	                    return g2
   156	        ai = ai * alpha % N
   157	        met.inc("mulN")
   158	    return None

