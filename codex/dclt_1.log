   166	def lam_full(n: int) -> float:
   167	    """Full-coverage multiplicity target ln(#prime candidates) + 2 = ln(P / ln P) + 2."""
   168	    P = 2.0 ** (n / 2)
   169	    return log(P / log(P)) + 2.0
     1	"""Instrumented polynomial collision detection over Z/N (any N; fmpz_mod_poly).
     2	
     3	OPERATIONAL helpers: see only N and ring elements.  Only multiplication and
     4	division by MONIC polynomials are used, so everything is valid over the ring
     5	Z/N with N composite.  No gcd/xgcd/factor of polynomials over Z/N is called.
     6	
     7	Cost charging (notes/dcltheorem_prereg.md, metric E):
     8	  poly_cost += (d + 1) * ceil(log2(d + 2))   for every product / remainder whose
     9	               result (product) or dividend (remainder) has degree d
    10	  (FFT-model M(d) in Z/N-multiplication equivalents).  Scalar multiplications
    11	  mod N are charged in mulN; gcds with N in gcdN.
    12	"""
    13	from __future__ import annotations
    14	
    15	from math import gcd
    16	from typing import List, Optional, Tuple
    17	
    18	import flint
    19	
    20	
    21	def _pc(d: int) -> int:
    22	    d = max(0, d)
    23	    return (d + 1) * max(1, (d + 1).bit_length())
    24	
    25	
    26	def poly_mul(a, b, met):
    27	    met.inc("poly_ops")
    28	    met.inc("poly_cost", _pc(a.degree() + b.degree()))
    29	    return a * b
    30	
    31	
    32	def poly_rem(a, b, met):
    33	    met.inc("poly_ops")
    34	    met.inc("poly_cost", _pc(a.degree()))
    35	    if a.degree() < b.degree():
    36	        return a
    37	    return a % b
    38	
    39	
    40	def tree_levels(ctx, pts: List[int], met):
    41	    """Product tree of the linear polynomials X - x (bottom level first)."""
    42	    levels = [[ctx([(-x), 1]) for x in pts]]
    43	    while len(levels[-1]) > 1:
    44	        cur, nxt = levels[-1], []
    45	        for i in range(0, len(cur) - 1, 2):
    46	            nxt.append(poly_mul(cur[i], cur[i + 1], met))
    47	        if len(cur) % 2:
    48	            nxt.append(cur[-1])
    49	        levels.append(nxt)
    50	    return levels
    51	
    52	
    53	def product_poly(ctx, pts: List[int], met):
    54	    return tree_levels(ctx, pts, met)[-1][0]
    55	
    56	
    57	def multipoint(ctx, f, pts: List[int], met) -> List[int]:
    58	    """f(x) for all x in pts by a remainder tree (monic divisors only)."""
    59	    if not pts:
    60	        return []
    61	    levels = tree_levels(ctx, pts, met)
    62	    rems = [poly_rem(f, levels[-1][0], met)]
    63	    for lev in range(len(levels) - 2, -1, -1):
    64	        cur, new = levels[lev], []
    65	        for i, node in enumerate(cur):
    66	            new.append(poly_rem(rems[i // 2], node, met))
    67	        rems = new
    68	    out = []
    69	    for r in rems:
    70	        c = r.coeffs()
    71	        out.append(int(c[0]) if c else 0)
    72	    return out
    73	
    74	
    75	def eval_baby_poly_at_giants(N: int, gamma: int, m: int, giants: List[int], met) -> List[int]:
    76	    """f(G) for f(X) = prod_{0<=i<m} (X - gamma^i), for every giant G.
    77	    Baby powers gamma^i are charged (m-1 multiplications)."""
    78	    ctx = flint.fmpz_mod_poly_ctx(N)
    79	    babies, x = [], 1
    80	    for i in range(m):
    81	        babies.append(x)
    82	        x = x * gamma % N
    83	        met.inc("mulN")
    84	    f = product_poly(ctx, babies, met)
    85	    return multipoint(ctx, f, giants, met)
    86	
