    40	def tree_levels(ctx, pts: List[int], met):
    41	    """Product tree of the linear polynomials X - x (bottom level first)."""
    42	    levels = [[ctx([(-x), 1]) for x in pts]]
    43	    while len(levels[-1]) > 1:
    44	        cur, nxt = levels[-1], []
    45	        for i in range(0, len(cur) - 1, 2):
    46	            nxt.append(poly_mul(cur[i], cur[i + 1], met))
    47	        if len(cur) % 2:
    48	            nxt.append(cur[-1])
    49	        levels.append(nxt)
    50	    return levels
    51	
