    94	def span_bound(n: int, H: int) -> int:
    95	    """n-only upper bound for max_v (Hi_v - Lo_v) over N < 2^n:
    96	    Hi_v <= (B + sqrt2 A) sqrt N + 2H + 2 and Lo_v >= 0, so
    97	    span <= (1 + sqrt 2) H 2^(n/2) + 2H + 3  <=  (5/2) H 2^(n/2) + 2H + 3."""
    98	    return (5 * H * (pow2_frac(n, 1, 2) + 1)) // 2 + 2 * H + 3
    99	
