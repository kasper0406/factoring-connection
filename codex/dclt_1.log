   104	def theorem_design(n: int, eps_num: int, eps_den: int) -> Design:
   105	    """H = ceil(n 2^(eps n/2)), Y = ceil(2^(n/6) H^(-1/3)), K = 4, l == 3 (mod 4)."""
   106	    H = n * pow2_frac(n * eps_num, 1, 2 * eps_den)       # ~ n 2^(eps n / 2)
   107	    Y = max(3, -(-pow2_frac(n, 1, 6) // max(1, round(H ** (1.0 / 3)))))
   108	    # (the cube root of H only enters through Y; any constant-factor choice of
   109	    #  Y is allowed by the proof, so rounding here is harmless)
   110	    return Design(n=n, H=H, Y=Y, K=4, mod4=True, label=f"theorem eps={eps_num}/{eps_den}")
