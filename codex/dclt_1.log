   116	def _expected_cost(n: int, H: int, Y: int, V, band: List[int]) -> int:
   117	    """n-only estimate of the block-0 list cost m + sum ceil(W/m) with one
   118	    expected target per (v, l) (each (v, l) has 1 root on average), windows
   119	    W_v(l) = span_v/l^2 + 1 with span_v computed at N_ref = 3 * 2^(n-2)."""
   120	    Nref = 3 << (n - 2)
   121	    P = isqrt(Nref)
   122	    widths = []
   123	    for (A, B) in V:
   124	        hi = max(B * P + A * Nref // P, B * isqrt(Nref // 2) + A * Nref // isqrt(Nref // 2)) + 1
   125	        lo = isqrt(4 * A * B * Nref)
   126	        sp = hi - lo
   127	        for l in band:
   128	            widths.append(sp // (l * l) + 2)
   129	    if not widths:
   130	        return 1 << 62
   131	    best = None
   132	    m = 4
   133	    while m <= 4 * max(widths):
   134	        c = m + sum(-(-w // m) for w in widths)
   135	        if best is None or c < best:
   136	            best = c
   137	        m = int(m * 1.19) + 1
   138	    return best
