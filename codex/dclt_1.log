    51	
    52	def powN(x: int, e: int, N: int, met) -> int:
    53	    """x^e mod N, e >= 0; charges bits(e)-1 squarings + popcount(e)-1 mults."""
    54	    if e <= 0:
    55	        return 1 % N if e == 0 else None  # negative exponents are not used
    56	    met.inc("mulN", e.bit_length() + bin(e).count("1") - 2)
    57	    return pow(x, e, N)
    58	
    59	
    60	def pow_small(x: int, e: int, M: int, met) -> int:
    61	    met.inc("mul_small", max(0, e.bit_length() + bin(e).count("1") - 2))
    62	    return pow(x, e, M)
    63	
    64	
    65	# ---------------------------------------------------------------------------
    66	# balanced all-but-one exponent tree
    67	# ---------------------------------------------------------------------------
    68	def int_product_tree(xs: Sequence[int], met) -> List[List[int]]:
    69	    levels = [list(xs)]
    70	    while len(levels[-1]) > 1:
    71	        cur, nxt = levels[-1], []
    72	        for i in range(0, len(cur) - 1, 2):
    73	            met.inc("bigmul_bits", cur[i].bit_length() + cur[i + 1].bit_length())
    74	            nxt.append(cur[i] * cur[i + 1])
    75	        if len(cur) % 2:
    76	            nxt.append(cur[-1])
    77	        levels.append(nxt)
    78	    return levels
    79	
    80	
    81	def all_but_one(base: int, exps: Sequence[int], N: int, met) -> Tuple[List[int], int]:
    82	    """([base^{E/e_j} for j], E) with E = prod exps, via the balanced product
    83	    tree: a node holding base^{E/prod(node)} passes base^{E/prod(node)*prod(sib)}
    84	    to each child.  Per level the exponent bit lengths sum to <= log2 E + #nodes."""
    85	    levels = int_product_tree(exps, met)
    86	    E = levels[-1][0]
    87	    vals = [base % N]
    88	    for lev in range(len(levels) - 2, -1, -1):
    89	        cur = levels[lev]
    90	        parent_count = len(levels[lev + 1])
    91	        new = [None] * len(cur)
    92	        for pi in range(parent_count):
    93	            li, ri = 2 * pi, 2 * pi + 1
    94	            if ri < len(cur):
    95	                new[li] = powN(vals[pi], cur[ri], N, met)
    96	                new[ri] = powN(vals[pi], cur[li], N, met)
    97	            else:
    98	                new[li] = vals[pi]          # odd node carried up unchanged
    99	        vals = new
   100	    return vals, E
   101	
   102	
   103	# ---------------------------------------------------------------------------
   104	# windows (exact integers)
   105	# ---------------------------------------------------------------------------
   106	def balanced_range(N: int) -> Tuple[int, int]:
   107	    """Integers p with p^2 < N <= 2 p^2 lie in [a0, b0]."""
   108	    a0 = isqrt(N // 2)
   109	    while 2 * a0 * a0 < N:
   110	        a0 += 1
   111	    b0 = isqrt(N)
   112	    return a0, b0
   113	
   114	
   115	def f_bounds(N: int, A: int, B: int, a0: int, b0: int, met) -> Tuple[int, int]:
   116	    """Lo <= B x + A N / x <= Hi for all real x in [a0, b0]:  Lo = floor(2 sqrt(ABN))
   117	    (AM-GM), Hi = max over the endpoints of ceil(F) (convexity)."""
   118	    met.inc("isqrt_ops")
   119	    lo = isqrt(4 * A * B * N)
   120	    hi = max(B * x + -(-(A * N) // x) for x in (a0, b0))
   121	    return lo, hi
   122	
   123	
   124	# ---------------------------------------------------------------------------
   125	# one block
   126	# ---------------------------------------------------------------------------
   127	_NONRES: Dict[int, int] = {}
   128	
   129	
   130	def sqrt_prime(a: int, l: int, met) -> int:
   131	    """A square root of the nonzero square a mod the public prime l.
   132	    l == 3 (mod 4): a^{(l+1)/4}.  Otherwise Tonelli--Shanks with the least
   133	    quadratic nonresidue z (found by Euler's criterion; the search is charged
   134	    once per l -- its total over a band is O(#band) on average by Erdos 1961 /
   135	    Pollack 2012; only the secondary design mod4=False uses this branch)."""
   136	    if l % 4 == 3:
   137	        return pow_small(a, (l + 1) // 4, l, met)
   138	    if l not in _NONRES:
   139	        z = 2
   140	        while pow_small(z, (l - 1) // 2, l, met) != l - 1:
   141	            z += 1
   142	        _NONRES[l] = z
   143	        met.inc("nonres_search", z - 1)
   144	    z = _NONRES[l]
   145	    Q, S = l - 1, 0
   146	    while Q % 2 == 0:
   147	        Q //= 2
   148	        S += 1
   149	    c, x, t, R = pow_small(z, Q, l, met), pow_small(a, (Q + 1) // 2, l, met), pow_small(a, Q, l, met), S
   150	    while t != 1:
   151	        i, tt = 0, t
   152	        while tt != 1:
   153	            tt = tt * tt % l
   154	            i += 1
   155	            met.inc("mul_small")
   156	        b = pow_small(c, 1 << (R - i - 1), l, met)
   157	        x, c, t, R = x * b % l, b * b % l, t * b * b % l, i
   158	        met.inc("mul_small", 4)
   159	    return x
   160	
   161	
   162	def build_targets(N: int, design: Design, k: int, met) -> List[Dict]:
   163	    band = design.bands[k]
   164	    _NONRES.clear()                       # nonresidue searches are charged per run
   165	    a0, b0 = balanced_range(N)
   166	    bounds = {v: f_bounds(N, v[0], v[1], a0, b0, met) for v in design.V}
   167	    out = []
   168	    for l in band:
   169	        if N % l == 0:
   170	            raise Found(l, "band_prime")
   171	        l2 = l * l
   172	        Nl = N % l
   173	        for (A, B) in design.V:
   174	            met.inc("vl_pairs")
   175	            a = A * Nl * pow(B, -1, l) % l
   176	            met.inc("mul_small", 3)
   177	            if pow_small(a, (l - 1) // 2, l, met) != 1:
   178	                continue
   179	            r = sqrt_prime(a, l, met)
   180	            lo, hi = bounds[(A, B)]
   181	            for root in sorted({r, l - r}):
   182	                s = N * pow(root, -1, l2) % l2
   183	                c = (B * root + A * s) % l2
   184	                met.inc("mul_small", 4)
   185	                g_lo = -((-(lo - c)) // l2)
   186	                g_hi = (hi - c) // l2
   187	                out.append({"A": A, "B": B, "l": l, "r": root, "c": c,
   188	                            "g_lo": g_lo, "W": max(1, g_hi - g_lo + 1)})
   189	    return out
   190	
   191	
   192	def choose_m(targets: List[Dict], mbar: int) -> int:
   193	    """Public choice of the baby length: minimise m + sum ceil(W/m) over a
   194	    geometric grid in [1, max W] (never above max W; max W <= mbar)."""
   195	    if not targets:
   196	        return 1
   197	    Wmax = max(t["W"] for t in targets)
   198	    best, m = None, 1
   199	    while True:
   200	        mm = min(m, Wmax)
   201	        c = mm + sum(-(-t["W"] // mm) for t in targets)
   202	        if best is None or c < best[0]:
   203	            best = (c, mm)
   204	        if mm == Wmax:
   205	            break
   206	        m = int(m * 1.19) + 1
   207	    return best[1]
   208	
   209	
   210	def run_block(N: int, design: Design, k: int, met, record: bool = False,
   211	              m_override: Optional[int] = None) -> Dict:
   212	    band = design.bands[k]
   213	    if not band:
   214	        return {"factor": None, "status": "empty_band"}
   215	    met.start(f"block{k}")
   216	    targets = build_targets(N, design, k, met)
   217	    m = m_override or choose_m(targets, design.mbar[k])
   218	    sq = [l * l for l in band]
   219	    u_list, L = all_but_one(2, sq, N, met)
   220	    u = dict(zip(band, u_list))
   221	    gamma = powN(u_list[0], sq[0], N, met)              # 2^L
   222	    _gcd_check(gamma, N, met, "gamma")
   223	    met.inc("invN")
   224	    ginv = pow(gamma, -1, N)
   225	    gm_inv = powN(ginv, m, N, met)
   226	    Nmod = N
   227	    giants, meta = [], []
   228	    # per-l precomputation w_l = u_l^N (charged once per band prime used), then
   229	    # G = u^{B + A N - c} gamma^{-g_lo} = w^A * u^{B - c + l^2} * gamma^{-(g_lo + 1)}
   230	    # (u^{l^2} = gamma), all exponents nonnegative and O(log(H l^2)) bits.
   231	    w = {}
   232	    for t in targets:
   233	        if t["l"] not in w:
   234	            w[t["l"]] = powN(u[t["l"]], N, N, met)
   235	    for ti, t in enumerate(targets):
   236	        A, B, l, c, g_lo, W = t["A"], t["B"], t["l"], t["c"], t["g_lo"], t["W"]
   237	        G = (powN(w[l], A, N, met) * powN(u[l], B - c + l * l, N, met) % N
   238	             * powN(ginv, g_lo + 1, N, met) % N)
   239	        met.inc("mulN", 2)
   240	        for j in range(-(-W // m)):
   241	            giants.append(G)
   242	            meta.append((ti, j))
   243	            G = G * gm_inv % N
   244	            met.inc("mulN")
   245	    met.inc("giants", len(giants))
   246	    met.inc("babies", m)
   247	    met.inc("targets", len(targets))
   248	    vals = eval_baby_poly_at_giants(N, gamma, m, giants, met)
   249	    res = {"factor": None, "status": "none", "m": m, "n_targets": len(targets),
   250	           "n_giants": len(giants), "L_bits": L.bit_length()}
   251	    gs = []
   252	    for h, v in enumerate(vals):
   253	        met.inc("gcdN")
   254	        g = gcd(v, N)
   255	        if record:
   256	            gs.append(g)
   257	        if 1 < g < N and res["factor"] is None:
   258	            ti, j = meta[h]
   259	            res.update({"factor": g, "status": "collision", "hit": {"target": ti, "j": j}})
   260	            if not record:
   261	                break
   262	    if record:
   263	        res["targets"] = targets
   264	        res["giant_meta"] = meta
   265	        res["giant_gcds"] = gs
   266	        res["gamma"] = gamma
   267	        res["u"] = u
   268	    met.stop(f"block{k}")
   269	    return res
   270	
