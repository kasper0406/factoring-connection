   272	def dcl_det(N: int, design: Design, met: Optional[Metrics] = None, early_exit: bool = True,
   273	            record: bool = False, blocks: Optional[Sequence[int]] = None) -> Dict:
   274	    """Deterministic DCL.  Returns {"factor": d or None, "block": k, "blocks": [...]}.
   275	    With early_exit, stops after the first block that yields a factor; the
   276	    per-block metrics are recorded either way (prefix b{k}_)."""
   277	    met = met or Metrics()
   278	    out = {"factor": None, "status": "fail", "block": None, "blocks": []}
   279	    try:
   280	        _gcd_check(2, N, met, "even")
   281	        if N % 2 == 0:
   282	            return {"factor": 2, "status": "even", "block": None, "blocks": []}
   283	    except Found as e:
   284	        return {"factor": e.d, "status": "gcd_" + e.how, "block": None, "blocks": []}
   285	    for k in (blocks if blocks is not None else range(design.K)):
   286	        bm = Metrics()
   287	        try:
   288	            r = run_block(N, design, k, bm, record=record)
   289	        except Found as e:
   290	            r = {"factor": e.d, "status": "gcd_" + e.how}
   291	        r["k"] = k
   292	        r["met"] = bm.to_record()
   293	        met.merge(bm)
   294	        out["blocks"].append(r)
   295	        if r["factor"] and out["factor"] is None:
   296	            out.update({"factor": r["factor"], "status": r["status"], "block": k})
   297	            if early_exit:
   298	                break
   299	    return out
   300	
   301	
   302	def metric_E(counts: Dict[str, int], n: int) -> int:
   303	    """Pre-registered bit-operation proxy in n-bit-modular-multiplication units:
   304	    E = mulN + mul_small + poly_cost + ceil(log2 n) * gcdN + ceil(bigmul_bits / n)
   305	        + ceil(log2 n) * invN."""
   306	    lg = max(1, (n - 1).bit_length())
   307	    return (counts.get("mulN", 0) + counts.get("mul_small", 0) + counts.get("poly_cost", 0)
   308	            + lg * (counts.get("gcdN", 0) + counts.get("invN", 0))
   309	            + -(-counts.get("bigmul_bits", 0) // n))
     1	"""Public parameter schedules for the deterministic DCL algorithm (DCL-det).
     2	
     3	MODEL / PUBLIC code: everything here is a function of the bit length n (and
     4	of the public knobs eps / lam_target).  Nothing depends on N's factors, and
     5	-- important for the sieve proof (notes/dcltheorem_results.md, Lemma 9) --
     6	nothing depends on N itself: the prime bands and the weight set are fixed by n.
     7	
     8	Design D = (n, H, Y, K blocks):
     9	  V      = {(A, B) : 1 <= A, B <= H, gcd(A, B) = 1, A != B}
    10	  P_k    = {l prime : l == 3 (mod 4), 2^k Y < l <= 2^(k+1) Y},  k = 0..K-1
    11	  mbar_k = an n-only upper bound for every whole-range window width in block k
    12	"""
    13	from __future__ import annotations
    14	
    15	from dataclasses import dataclass, field
    16	from math import ceil, gcd, isqrt, log
    17	from typing import Dict, List, Optional, Tuple
    18	
    19	
    20	def primes_upto(n: int) -> List[int]:
    21	    if n < 2:
    22	        return []
    23	    s = bytearray([1]) * (n + 1)
    24	    s[0] = s[1] = 0
    25	    for i in range(2, isqrt(n) + 1):
    26	        if s[i]:
    27	            s[i * i::i] = bytearray(len(s[i * i::i]))
    28	    return [i for i in range(n + 1) if s[i]]
    29	
    30	
    31	def weight_set(H: int) -> List[Tuple[int, int]]:
    32	    """V(H): positive coprime pairs, A != B (the symmetric pair (1,1) is two-sided
    33	    by construction -- see Lemma 4 -- and is excluded)."""
    34	    return [(A, B) for A in range(1, H + 1) for B in range(1, H + 1)
    35	            if A != B and gcd(A, B) == 1]
    36	
    37	
    38	def iroot2_floor(x: int) -> int:
    39	    return isqrt(x)
    40	
    41	
    42	def pow2_frac(n: int, num: int, den: int) -> int:
    43	    """floor(2^(n*num/den)) exactly (integer root of a power of two)."""
    44	    e_num = n * num
    45	    # 2^(e_num/den) = (2^e_num)^(1/den)
    46	    x = 1 << e_num
    47	    lo, hi = 1, 1 << (e_num // den + 2)
    48	    while lo < hi:
    49	        mid = (lo + hi + 1) // 2
    50	        if mid ** den <= x:
    51	            lo = mid
    52	        else:
    53	            hi = mid - 1
    54	    return lo
