    39	class Found(Exception):
    40	    def __init__(self, d: int, how: str):
    41	        self.d, self.how = d, how
    42	
    43	
    44	def _gcd_check(x: int, N: int, met, how: str) -> int:
    45	    met.inc("gcdN")
    46	    g = gcd(x % N, N)
    47	    if 1 < g < N:
    48	        raise Found(g, how)
    49	    return g
