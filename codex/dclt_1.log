import sys, random, json, math, time
sys.dont_write_bytecode=True
sys.path.insert(0,'/home/knielsen/code/factoring-connection')
from sympy import isprime, factorint
from src.dcltheorem.params import Design, theorem_design
from src.dcltheorem.algorithm import run_block, dcl_det
from src.common.metrics import Metrics
from collections import Counter
C=Counter(); examples={}; rng=random.Random(18420261018)
def order2(q):
    d=q-1
    for r in factorint(d):
        while d%r==0 and pow(2,d//r,q)==1: d//=r
    return d
def pair(n):
    P=1<<(n//2)
    while True:
        p=rng.randrange(P//2+1,P)|1
        if not isprime(p):continue
        lo=max(p+1,((1<<(n-1))+p-1)//p)
        hi=min(2*p,((1<<n)-1)//p)
        if lo>hi: continue
        q=rng.randrange(lo,hi+1)|1
        if q<=hi and isprime(q):return p,q
for n in (28,32,36,40):
    P=1<<(n//2); H=3; Y=1
    while Y**3*H<P: Y+=1
    D=Design(n=n,H=H,Y=Y)
    assert Y>H*H and Y**4>2*P
    for rep in range(20):
        p,q=pair(n); N=p*q; d=order2(q)
        C['pairs']+=1; clean_exists=False; cert=False
        for k,band in enumerate(D.bands):
            clean=all((q-1)%l for l in band); clean_exists|=clean
            R=run_block(N,D,k,Metrics(),record=True)
            assert 'targets' in R
            L=math.prod(l*l for l in band); gamma=pow(2,L,N)
            assert gamma==R['gamma']; C['blocks']+=1
            for l in band:
                assert R['u'][l]==pow(2,L//(l*l),N);C['handles']+=1
            m=R['m']; assert 1<=m<=D.mbar[k]
            babies=[pow(gamma,i,q) for i in range(m)]; lookup=set(babies)
            indices={meta:h for h,meta in enumerate(R['giant_meta'])}
            targets={(t['A'],t['B'],t['l'],t['r']):ti for ti,t in enumerate(R['targets'])}
            for l in band:
                for A,B in D.V:
                    if (B*p-A*q)%l:continue
                    r=p%l; ti=targets[A,B,l,r]; t=R['targets'][ti]
                    c=(B*r+A*(N*pow(r,-1,l*l)%(l*l)))%(l*l)
                    z=B*p+A*q-c; assert z%(l*l)==0
                    g=z//(l*l); assert t['g_lo']<=g<=t['g_lo']+t['W']-1
                    j,istar=divmod(g-t['g_lo'],m)
                    u=pow(2,L//(l*l),N)
                    G=pow(u,B+A*N-c,N)*pow(gamma,-(t['g_lo']+j*m),N)%N
                    Gw=pow(pow(u,N,N),A,N)*pow(u,B-c+l*l,N)*pow(gamma,-(t['g_lo']+1+j*m),N)%N
                    assert G==Gw; assert G%p==pow(gamma,istar,p)
                    assert G%q==pow(gamma,istar,q)*pow(u,(A-B)*(p-1),q)%q
                    C['covering_targets']+=1
                    if A<B:C['negative_A_minus_B']+=1
                    if t['g_lo']+j*m>0:C['negative_giant_exponents']+=1
                    full=G%q in lookup
                    local=math.gcd(d,L//(l*l))==1
                    if local:
                        predicted=any(((A-B)*(p-1)-l*l*delta)%d==0 for delta in range(-istar,m-istar))
                        assert full==predicted; C['lemma7_coprime']+=1
                    if clean:C['lemma7_clean']+=1
                    if clean and not full:
                        h=indices[ti,j]
                        f=1
                        for i in range(m): f=f*(G-pow(gamma,i,N))%N
                        assert math.gcd(f,N)==p
                        assert R['giant_gcds'][h]==p
                        C['clean_nonfull_exact_gcd_p']+=1;cert=True
                        if n not in examples:examples[n]={'p':p,'q':q,'N':N,'k':k,'A':A,'B':B,'l':l,'m':m,'g':g,'i':istar,'j':j,'d':d,'gcd':p}
            # full array, each computed without polynomial arithmetic
            if rep<2:
                for h,(ti,j) in enumerate(R['giant_meta']):
                    t=R['targets'][ti]; u=pow(2,L//(t['l']**2),N)
                    G=pow(u,t['B']+t['A']*N-t['c'],N)*pow(gamma,-t['g_lo']-j*m,N)%N
                    f=1
                    for i in range(m):f=f*(G-pow(gamma,i,N))%N
                    assert math.gcd(f,N)==R['giant_gcds'][h];C['all_giant_gcd_checks']+=1
        assert clean_exists
        if cert:
            O=dcl_det(N,D,Metrics())
            assert O['factor'] in (p,q);C['certified_operational_success']+=1
    print(json.dumps({'finished_n':n,'counts':dict(C)}),flush=True)
