  1300	\begin{proposition}[$\mathrm{DCH}_{\mathrm{pair}}$ needs $\kappa\ge1/2$; proved]\label{prop:N}
  1301	Let $\mathcal L$ be any set of primes in $(Y,16Y]$ with $16Y\le P^\theta$, $\theta<1/2$, and let
  1302	$V$ be any weight set with $|V||\mathcal L|=o(P)$. Put $\lambda=|V|\sum_{\ell\in\mathcal
  1303	L}1/(\ell-1)$. Then at most $(2/(1-\theta)+o(1))\lambda|\Sn|+o(|\Sn|)$ pairs are covered. For
  1304	the four blocks of $\DCL_{n,H}$, a positive proportion of $\Sn$ is uncovered by every block when
  1305	$H\le0.2\sqrt n$ (positive weights) or $H\le0.14\sqrt n$ (signed weights).
  1306	\end{proposition}
  1307	\begin{proof}[Sketch]
  1308	Fix $(A,B,\ell)$ and a prime $p$. The partners $q$ with $\ell\mid Bp-Aq$ form one class modulo
  1309	$\ell$. The Brun--Titchmarsh inequality in the Montgomery--Vaughan form \cite{mv1973} bounds them
  1310	by $2|I_p|/(\varphi(\ell)\log(|I_p|/\ell))$. The $p$ near the endpoints of the range, where $|I_p|<P/n^2$,
  1311	are counted trivially. Summing over all $p$ and comparing with $|\Sn|$ gives the bound.
  1312	\end{proof}
