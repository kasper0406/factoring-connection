   712	\subsection{One run}
   713	For $T\ge1$ (an analysis-only parameter) and $(p,q)\in\Sn$, let $k(q)$ be the least block clean
   714	for $q$. Define
   715	\[
   716	  E_a(T)=\{d\le T\},\quad E_b(H)=\{d>T,\ p\in U_{k(q)}(q)\},\quad
   717	  E_c(H,T)=\{d>T,\ p\in F_{k(q)}(q)\}.
   718	\]
