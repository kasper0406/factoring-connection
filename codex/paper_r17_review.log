  1330	%======================================================================
  1331	
  1332	This section is a theorem inside a cost model. It explains why $N^{1/6}$ is the natural limit of
  1333	the method. It is not a lower bound for factoring.
  1334	
  1335	\subsection{The model}
  1336	\paragraph{Cost.} For an input $N$, a design issues \emph{targets} (labels) $\tau$, each with a
  1337	finite window $S_\tau\subset\Z$ of exponent values. A shared baby list, with any sumset
  1338	structure, tests them. The design has cost $X$ if $\#\{\tau\}\le X$ and $\sum_\tau|S_\tau|\le
  1339	X^2$, either per input or in expectation over uniform $n$-bit $N$. A baby-step/giant-step search
  1340	with list length $m\le X$ and at most $X$ giants satisfies this, since every window costs
  1341	$\lceil|S_\tau|/m\rceil\ge1$ giants.
  1342	
  1343	The model charges labels, not stored group elements: it assumes that one giant certifies at most
  1344	one label. For the targets of this paper two labels share a giant only in negligible cases, but
  1345	we have no general bound.
  1346	
  1347	\paragraph{Generators.} A \emph{residue-local degree-one generator} $\iota$ consists of the
  1348	following data:
  1349	\begin{itemize}
  1350	\item fixed integers $A,B$, not both $0$;
  1351	\item integers $M\ge1$, $K$ with $M\mid K$, and $D\ge1$;
  1352	\item a side, $p$ or $q$;
  1353	\item arbitrary maps $\kappa\mapsto R(\kappa)\subseteq\Z/M$ and $\kappa\mapsto S(\kappa)\subset\Z$
  1354	  (finite sets), defined on keys $\kappa\in\Z/K$.
  1355	\end{itemize}
  1356	Write $x$ for the class variable ($x=p$ on side $p$) and $y$ for the partner. On input $N$, with
  1357	$\kappa=N\bmod K$, the generator issues $|R(\kappa)|$ targets. They cover $(p,q)$ iff
  1358	\begin{equation}\label{eq:gen}
  1359	  x\bmod M\in R(\kappa)\quad\text{and}\quad\lfloor(Bx+Ay)/D\rfloor\in S(\kappa).
  1360	\end{equation}
  1361	
  1362	\paragraph{Locality hypothesis (L1).}
  1363	\begin{itemize}
  1364	\item $D/|A|\le C_1M^2$ if $A\ne0$, and $D/|B|\le C_1M^2$ if $A=0$;
  1365	\item $K\le C_2M^2$;
  1366	\item $M,K\le P/2$.
  1367	\end{itemize}
  1368	
  1369	\paragraph{Why this shape is general for degree one.}
  1370	Every identity-valid degree-one target has exponent $(Bx+Ay-c)/D$, with $D=C_dM^2$ and $c\in[0,D)$
  1371	fixed by the class and by $N\bmod D$ (Lemma~\ref{lem:K} for the denominator; the form of
  1372	the constant is multimod Lemma~K$'$, \texttt{notes/multimod\_results.md} \S3.1(i)). For true pairs this exponent equals
  1373	$\lfloor(Bx+Ay)/D\rfloor$, and any window placement is some finite set $S$. The count below never
  1374	uses validity: it holds for every rule of shape \eqref{eq:gen}.
  1375	
  1376	\subsection{The bound}
  1377	
  1378	\begin{lemma}[fixed-key partner count]\label{lem:partner}
  1379	Fix $x$ and a unit key $\kappa$, with $A\ne0$. The partners $y\equiv\kappa x^{-1}\pmod K$ of $x$
  1380	satisfying \eqref{eq:gen} number at most
  1381	$\min\bigl(|S(\kappa)|(\lfloor D/(|A|K)\rfloor+1),\ \lfloor\ell_y/K\rfloor+1\bigr)$, where
  1382	$\ell_y\le x$ is the length of the partner range.
  1383	\end{lemma}
  1384	\begin{proof}
  1385	The partners form an arithmetic progression of step $K$. Each value $s\in S$ confines $y$ to an
  1386	interval of length $D/|A|$.
  1387	\end{proof}
  1388	
  1389	\begin{theorem}[T1; precise form of Theorem~\ref{thm:T1}; proved]\label{thm:T1precise}
  1390	Assume (L1), and let a design be a union of generators. Suppose
  1391	$\mathbb E_N\#\{\tau\}\le X$ and $\mathbb E_N\sum_\tau|S_\tau|\le X^2$, where $\mathbb E_N$
  1392	averages over uniform $n$-bit $N$. Then
  1393	\[
  1394	  \Pr_{(p,q)\in\Sn}[\text{the true pair is covered}]\le C\,n^2X^{3/2}N^{-1/4},
  1395	\]
  1396	with $C$ depending only on $C_1,C_2$.
  1397	\end{theorem}
  1398	\begin{proof}
  1399	\begin{enumerate}[label=\arabic*.]
  1400	\item \emph{Sum by keys.} Both primes exceed $K$, so they are units modulo $K$, and each $x$ has
  1401	  one partner class $\kappa x^{-1}$ per unit key $\kappa$. Let $\varphi(\kappa)$ denote the bound
  1402	  of Lemma~\ref{lem:partner}. Then
  1403	  \[
  1404	  \mathrm{Count}(\iota)\le\sum_\kappa\varphi(\kappa)\,\#\{x:x\bmod M\in R(\kappa)\},
  1405	  \]
  1406	  and the last factor is at most $c_s|R(\kappa)|P/M$, with $c_s=1$ on side $p$ and $5/4$ on side
  1407	  $q$.
  1408	\item \emph{Bound $\varphi$.} Using $\min(u,v)\le\sqrt{uv}$ and $K\le P/2$,
  1409	  $\varphi(\kappa)\le\sqrt{2P|S(\kappa)|(D/|A|+K)}/K$.
  1410	\item \emph{Pass to $\mathbb E_N$.} Every residue class modulo $K$ contains at least
  1411	  $2^{n-2}/K$ integers of $[2^{n-1},2^n)$. So $\sum_\kappa f(\kappa)\le2K\,\mathbb E_Nf(N\bmod
  1412	  K)$ for $f\ge0$. With (L1), $\sqrt{D/|A|+K}\le M\sqrt{C_1+C_2}$, which gives
  1413	  \[
  1414	  \mathrm{Count}(\iota)\le c_1P^{3/2}\,\mathbb E_N\bigl[|R(N\bmod K)|\,|S(N\bmod K)|^{1/2}\bigr].
  1415	  \]
  1416	\item \emph{$A=0$.} Swap sides: put $R'(\kappa)=\{\kappa r^{-1}\}$ and $(A',B')=(B,0)$. The
  1417	  coverage is identical and $A'\ne0$.
  1418	\item \emph{Sum over the design and apply the budget.} Summing over generators gives
  1419	  $\mathbb E_N\sum_\tau|S_\tau|^{1/2}$, which is at most
  1420	  $\sqrt{\mathbb E\#\tau\cdot\mathbb E\sum|S_\tau|}\le X^{3/2}$ by Cauchy--Schwarz. Finally
  1421	  divide by $|\Sn|\ge c_0P^2/n^2$.
  1422	\end{enumerate}
  1423	\end{proof}
  1424	
  1425	The proof counts integer pairs and needs no flatness, height or prime equidistribution.
  1426	Arbitrary finite windows are allowed: a sparse window counts by its cardinality, not its hull.
  1427	This is what also covers searches over several rational bases with known multiplicative
  1428	relations, after a reduction to prime-valuation coordinates (\texttt{notes/below16\_results.md},
  1429	Prop.~MB).
