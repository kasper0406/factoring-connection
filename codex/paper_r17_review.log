  1689	\begin{proposition}[per-target bounds]\label{prop:pertarget}
  1690	Merge the targets with the same triple, of total width $W$ and number $w$. They cover at most:
  1691	\begin{enumerate}[label=(\roman*)]
  1692	\item $C(RW/\eta)^{1/2}+Cw$ for degree one with $K=2$, where $\eta=\max(|A|,|B|)$ in
  1693	  $\alpha=(B,A)/(C_{d_0}M^2)$;
  1694	\item $CW+Cw$ for degree one with $K=1$;
