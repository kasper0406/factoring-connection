  1011	\subsection{The small-order detector}
  1012	
  1013	\begin{lemma}[detector; elementary]\label{lem:detector}
  1014	Let $N=pq$ be odd, $T\ge1$, $m=\lceil\sqrt T\rceil$, $J=\lceil T/m\rceil$, and $d_r=\ord_r(2)$.
  1015	Form $f(X)=\prod_{0\le i<m}(X-2^i)$ over $\Z/N\Z$, and compute $G_j=\gcd(f(2^{jm}),N)$ for
  1016	$1\le j\le J$ by a product tree and a remainder tree. At the first $j$ with $G_j>1$, compute
  1017	$\gcd(2^k-1,N)$ for every $k\in((j-1)m,jm]$, and output the first proper value. If
  1018	$\min(d_p,d_q)\le T$ and $d_p\ne d_q$, this outputs the prime with the smaller order. The cost
  1019	is $\tilde O(\sqrt T\,n)$ bit operations.
  1020	\end{lemma}

