   720	\begin{proposition}[one run; proved]\label{prop:onerun}
   721	There are absolute constants $C,c$ such that for $H$ in the range \eqref{eq:Hrange} and
   722	$1\le T\le P/2$ the following hold.
   723	\begin{enumerate}[label=(\roman*)]
   724	\item $\DCL_{n,H}$ outputs a proper divisor of $N$ or \texttt{FAIL} on every input.
   725	\item It costs at most $Cn^cH^{5/3}2^{n/6}$ bit operations on every $n$-bit input.
   726	\item Every \texttt{FAIL} pair of $\Sn$ lies in $E_a(T)\cup E_b(H)\cup E_c(H,T)$, and
   727	  \[
   728	  \frac{|E_a|}{|\Sn|}\le\frac{CnT^2}{P},\quad \frac{|E_b|}{|\Sn|}\le\frac{Cn}{H^2},\quad
   729	  \frac{|E_c|}{|\Sn|}\le Cn\Bigl(\frac{H^{14/3}P^{1/3}}{T}+\frac{H^{10/3}}{P^{1/3}}\Bigr).
   730	  \]
   731	\end{enumerate}
   732	\end{proposition}
   733	\begin{proof}
   734	\begin{itemize}
   735	\item \emph{Success certificate.} Suppose $d>T$, $p\notin U_{k(q)}(q)$ and
   736	  $p\notin F_{k(q)}(q)$. By Lemma~\ref{lem:coverage} some target of block $k(q)$ covers $p$, and
   737	  by Lemma~\ref{lem:window} its true giant is computed. By Lemma~\ref{lem:full} it is not FULL,
   738	  since the exact $\delta$-range lies in $|\delta|<\mbar$. By Lemma~\ref{lem:extract} its gcd is
   739	  $p$. So some block outputs a proper divisor.
   740	\item \emph{Normalisation.} There are at most $3P/n$ primes $q\in(P/\sqrt2,\sqrt2P)$, and we
   741	  divide by $|\Sn|\ge c_0P^2/n^2$. This needs no prime counts in short intervals.
   742	\item \emph{$E_a$.} By Lemma~\ref{lem:smallorder} with $Q_0=2^{(n-1)/2}$, at most
   743	  $T(T+1)/(n-1)$ primes $q$ qualify, each with at most $P/2+1$ partners.
   744	\item \emph{$E_b$.} This follows from Lemma~\ref{lem:sieve}.
   745	\item \emph{$E_c$.} Use $|V|\le H^2$, $|\Pk|\le2^kY$ and $\mbar\le3HP/(4^kY^2)$ in
   746	  Lemma~\ref{lem:crt}. This gives $|F_k(q)|\le6H^4P^2/(Y^2T)+6H^3P/Y$. Then sum over $q$ and use
   747	  $Y\ge P^{1/3}H^{-1/3}$.
   748	\item \emph{(i).} Only validated gcds and band primes are output.
   749	\item \emph{(ii).} See \S\ref{sec:cost}.
   750	\end{itemize}
