   484	\subsection{Parameters}
   485	All parameters depend on $n$ and on an integer weight height $H$, never on $N$. We assume
   486	throughout
   487	\begin{equation}\label{eq:Hrange}
   488	  H_0\le H\le 2^{n/50},\qquad n\ge n_0,
   489	\end{equation}
   490	for absolute constants $H_0,n_0$.
   491	\begin{itemize}
   492	\item The weights are $V=\{(A,B)\in[1,H]^2:\gcd(A,B)=1,\ A\ne B\}$. For $H\ge H_0$ we have
   493	  $H^2/2\le|V|\le H^2$.
   494	\item The band scale is $Y=\lceil 2^{n/6}H^{-1/3}\rceil$.
   495	\item There are four bands, $k=0,1,2,3$:
   496	  \[\Pk=\{\ell\ \text{prime}:\ \ell\equiv3\pmod 4,\ 2^kY<\ell\le2^{k+1}Y\},\qquad
   497	  L_k=\prod_{\ell\in\Pk}\ell^2.\]
   498	\item The window bound is $\spanbar=\lfloor\tfrac52H(2^{n/2}+1)\rfloor+2H+3$, and
   499	  $\mbar=\lfloor\spanbar/(2^kY)^2\rfloor+2$.
   500	\item The base is $\beta=2$.
   501	\end{itemize}
   502	Under \eqref{eq:Hrange} the following scale separations hold:
   503	\begin{equation}\label{eq:scales}
   504	  Y\ge 16H^2,\qquad 16Y<P/2,\qquad Y^4>\sqrt2\,P,\qquad H\lceil\sqrt2P\rceil<Y^4.
   505	\end{equation}
   506	Indeed $H^{7/3}\le2^{7n/150}<2^{n/6}/32$, and $Y^4\ge2^{(2/3-4/150)n}>2^{n/2+1}H$.
   507	
   679	  $Z=\lfloor Q/2^{k+1}Y\rfloor$. Then $1\le Z<Y$ and $\ln Z\ge c''n$ by \eqref{eq:Hrange}. $U$
   680	  also avoids the class $0$ modulo every prime $r\le Z$, since $p>P/2>Z$.
   681	\item \emph{The large sieve.} Montgomery's arithmetic large sieve \cite{montgomery1968}, with the
   682	  constant of \cite{mv1973}, gives $|U|\le(P/2+1+Q^2)/J$, where
   683	  $J=\sum_{d\le Q}\mu^2(d)\prod_{r\mid d}\omega(r)/(r-\omega(r))$.
   684	\item \emph{Bounding $J$.} Keep only the terms $d=\ell a$ with $\ell\in\Pk$ and $a\le Z$
   685	  squarefree. These are squarefree and at most $Q$, because the primes of $a$ are below $Y<\ell$.
   686	  Each contributes $\frac{|V|}{\ell-|V|}\cdot\frac1{\varphi(a)}$. Using
   687	  $\sum_{a\le Z}\mu^2(a)/\varphi(a)\ge\sum_{m\le Z}1/m\ge\ln Z$, we get
   688	  $J\ge\lambda_k\ln Z$, where $\lambda_k:=|V|\sum_{\ell\in\Pk}1/\ell$.
   689	\item \emph{Conclusion.} By the prime number theorem in the progression $3\bmod4$,
   690	  $\sum_{\ell\in\Pk}1/\ell\ge c'/n$, so $\lambda_k\ge c'H^2/(2n)$. Hence
   691	  $|U|\le 2P/(\lambda_k c''n)\le CP/H^2$.
   692	\end{itemize}
   693	\end{proof}
