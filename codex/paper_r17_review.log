  1190	\begin{lemma}[one-sided order dichotomy; after {\cite{hh2026}}]\label{lem:O}
  1191	For $b$ coprime to $N$, write $o_p=\ord_p(b)$ and $o_q=\ord_q(b)$.
  1192	\begin{enumerate}[label=(\alph*)]
  1193	\item If $\min(o_p,o_q)\le T_{\mathrm{scan}}$, the scan returns $r_b=\min(o_p,o_q)$, and the gcd
  1194	  there is proper iff $o_p\ne o_q$.
  1195	\item If every $b\le B_0$ is recorded, the $\Lambda$-enumeration finds $p$ at cost at most
  1196	  $\sqrt N/\Psi(p-1,B_0)$.
  1197	\end{enumerate}
  1198	\end{lemma}
  1199	\begin{proof}
  1200	\begin{enumerate}[label=(\alph*)]
  1201	\item The first $r$ with $\gcd(b^r-1,N)>1$ is $\min(o_p,o_q)$, and at $r=o_q<o_p$ the gcd is $q$.
  1202	\item If $o_p=o_q=r_b$ for all $b\le B_0$, the subgroup $\langle2,\dots,B_0\rangle\le\mathbb
  1203	  F_p^\times$ is cyclic of order $\Lambda$ dividing $p-1$. It contains every $B_0$-smooth integer
  1204	  below $p$, so $\Lambda\ge\Psi(p-1,B_0)$. Then $p=1+j\Lambda$ with $j\le\sqrt N/\Lambda$.
  1205	  For $B_0\ge(\ln p)^4$, the elementary bound $\Psi(x,(\log x)^4)\ge x^{3/4}/(\log x)^3$ gives
  1206	  $\sqrt N/\Lambda\le P^{1/4}n^3$.
  1207	\end{enumerate}
  1208	\end{proof}
  1209	
  1210	\begin{lemma}[$\gamma$ pre-step]\label{lem:G}
  1211	One of the following holds:
  1212	\begin{itemize}
  1213	\item a proper divisor is output;
  1214	\item $\ord_p(\gamma)=\ord_q(\gamma)<m$, and the equal-order split outputs a divisor, either
  1215	  directly or through the $D$-enumeration at cost at most $\sqrt N/T$;
  1216	\item $\ord_p(\gamma)\ge m$ and $\ord_q(\gamma)\ge m$.
  1217	\end{itemize}
  1218	\end{lemma}
  1219	\begin{proof}
  1220	Suppose $\gamma^o\equiv1\pmod N$. Then $o_p,o_q\mid E=Lo$; the factorisation of $E$ is known
  1221	from the band primes and from trial division of $o<m$, at cost $\tilde O(\sqrt m)$. For each prime $\varrho\mid E$,
  1222	$y=b^{E/\varrho^e}$ has order $\varrho^{v_\varrho(o_p)}$ modulo $p$ and $\varrho^{v_\varrho(o_q)}$
  1223	modulo $q$. If these valuations differ for some $\varrho$, the corresponding gcd is $p$ or $q$.
  1224	Otherwise $o_p=o_q=D$, and $D>T$ because $b$ was selected; since $D\mid p-1$, the enumeration
  1225	finds $p$.
  1226	\end{proof}
  1227	
  1228	\begin{lemma}[exploration]\label{lem:X}
  1229	Assume $\ord_p(\gamma),\ord_q(\gamma)\ge m$.
  1230	\begin{enumerate}[label=(\alph*)]
  1231	\item Each giant has at most one $i<m$ with $G\equiv\gamma^i\pmod p$. So at most one node per
  1232	  tree level has gcd $N$, and the exploration of a giant costs $O(\log m)$ node evaluations.
  1233	\item If the true giant $G^*$ has $\gcd(f(G^*),N)=N$, its exploration outputs a proper divisor.
  1234	\end{enumerate}
  1235	\end{lemma}
  1236	\begin{proof}
  1237	(a) The $\gamma^i$, $i<m$, are distinct modulo $p$.
  1238	
  1239	(b) Every node on the path to leaf $i^*$ has value divisible by $p$, so its gcd is $p$ (which is
  1240	output) or $N$. If leaf $i^*$ is reached with $G^*\equiv\gamma^{i^*}\pmod N$, then
  1241	$S=c+\ell^2g=Bp+Aq$. Hence $S^2-4ABN=(Bp-Aq)^2$ and $\{(S\pm D_0)/2\}=\{Bp,Aq\}$. Finally
  1242	$\gcd(Bp,N)=p$ because $1\le B<q$.
  1243	\end{proof}
