   153	\subsection{Main results}
   154	
   155	\begin{theorem}[average-case complete factoring; proved]\label{thm:AV}
   156	There is a deterministic algorithm $\LAD$ and an absolute constant $c$ with the following
   157	properties.
   158	\begin{enumerate}[label=(\roman*)]
   159	\item \emph{Completeness.} On every input $N\ge2$, $\LAD$ outputs the complete prime
   160	  factorisation of $N$.
   161	\item \emph{Worst case.} On every $n$-bit input its cost is at most
   162	  \[\HH(N)+O(n^{c+4}2^{7n/36})+O(n^{O(1)}2^{3n/20})=O(\HH(N)).\]
   163	\item \emph{Average over $\Sn$.} For all large $n$,
   164	  \[
   165	    \frac1{|\Sn|}\sum_{(p,q)\in\Sn}\mathrm{cost}(pq)=O\bigl(N^{1/6}(\log N)^{c+1}\log\log N\bigr).
   166	  \]
   167	\item \emph{Other distributions.} The bound in (iii), multiplied by $K$, holds for every
   168	  distribution on $\Sn$ with point masses at most $K/|\Sn|$.
   169	\end{enumerate}
   170	\end{theorem}
   171	
   172	The constant $c$ is the polylogarithmic exponent in the cost of one run of the search
   173	(Proposition~\ref{prop:onerun}(ii)). Item (iv) covers, for instance, the product of two
   174	independent uniform $n/2$-bit primes conditioned to be distinct, for even $n$: its support lies
   175	in $\mathcal S_n\cup\mathcal S_{n-1}$ and its mass ratio is bounded (apply (iii) to each shell).
   176	It says nothing about uniform $n$-bit integers, or about key-generation rules that restrict $p$
   177	and $q$ further.
   178	
   179	\begin{theorem}[almost-all factoring at fixed cost; proved]\label{thm:D}
   180	There are deterministic algorithms $\DCL_{n,H}$ (Section~\ref{sec:alg}) with the following
   181	property. Each sees only $N$. Each outputs either a proper divisor of $N$ or \texttt{FAIL}, and
   182	never anything else.
   183	\begin{enumerate}[label=(\alph*)]
   184	\item For every fixed $\varepsilon\in(0,1/40]$ and $n\ge n_0(\varepsilon)$, the choice
   185	  $H=\lceil n2^{\varepsilon n/4}\rceil$ gives cost $N^{1/6+5\varepsilon/12}(\log N)^{O(1)}$ on
   186	  every $n$-bit input. It outputs \texttt{FAIL} on $O(N^{-\varepsilon})|\Sn|$ pairs of $\Sn$.
   187	\item For every fixed $a>0$, the choice $H=\lceil n^{1+a}\rceil$ gives cost
   188	  $N^{1/6}(\log N)^{O(1+a)}$. It outputs \texttt{FAIL} on
   189	  $O\bigl((\log N)^{-\max(4a,\,1+2a)}\bigr)|\Sn|$ pairs.
   190	\end{enumerate}
   191	\end{theorem}
   192	
   193	An earlier version of (a), proved with the arithmetic large sieve alone, gave cost
   194	$N^{1/6+5\varepsilon/6+o(1)}$ for $\varepsilon\le1/60$ (Theorem~D$'$ of the project notes;
   195	Remark~\ref{rem:Dprime}). The improvement comes from the two-variable fourth moment of
   196	Section~\ref{sec:fourth}.
