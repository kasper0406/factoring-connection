  1621	\appendix
  1622	\section{Full-candidate covering bounds}\label{app:full}
  1623	%======================================================================
  1624	
  1625	This appendix is context. It bounds families that cover \emph{every} integer candidate for a
  1626	\emph{fixed} $N$. It does not bound algorithms that only reach the true factor, and it is not a
  1627	lower bound for factoring. The exponent $1/6$ below, and its proof idea, are in Ward--Maestro
  1628	\cite[Lemma~3.2, Thm.~3.6]{wardmaestro2026} for forms without locks. That work also gives the
  1629	$N^{1/5}$ floor with materialised giants \cite[Thm.~3.4]{wardmaestro2026}, and bounded-degree
  1630	forms \cite[Thm.~9.4]{wardmaestro2026}. Our variant allows arbitrary lock moduli.
  1631	
  1632	\subsection{The model}
  1633	Fix a degree bound $d_0\ge1$ and $\theta>1$, and write $R=\sqrt N$. The candidates are the
  1634	integers $p\in[R/\sqrt\theta,R]$. A target $\tau$ consists of:
  1635	\begin{itemize}
  1636	\item a modulus $M_\tau$ with $\gcd(M_\tau,N)=1$ and a unit class $r_\tau\in(\Z/M_\tau)^\times$;
  1637	\item a support $I_\tau\subseteq[-d_0,d_0]\setminus\{0\}$ with $K_\tau=|I_\tau|$, nonzero
  1638	  coefficients $\alpha_{\tau,i}\in\Z[1/M_\tau]$ and a constant $c_\tau$, defining
  1639	  $h_\tau(x)=\sum_{i>0}\alpha_{\tau,i}x^{i}+\sum_{i<0}\alpha_{\tau,i}(N/x)^{|i|}-c_\tau$;
  1640	\item an integer window $[U_\tau,U_\tau+W_\tau)$.
  1641	\end{itemize}
  1642	\emph{Integrality} requires $h_\tau(x)\in\Z_\ell$ for every $\ell\mid M_\tau$ and every
  1643	$x\in\Z_\ell$ with $x\equiv r_\tau\pmod{\ell^{v_\ell(M_\tau)}}$. The target \emph{covers} $p$ if
  1644	$p\equiv r_\tau\pmod{M_\tau}$ and $h_\tau(p)\in[U_\tau,U_\tau+W_\tau)$. The cost is any $X$ with:
  1645	\begin{enumerate}[label=(C\arabic*)]
  1646	\item at most $X$ distinct triples $(M,r,\alpha)$;
  1647	\item at most $X$ targets;
  1648	\item $\sum W_\tau\le X^2$.
  1649	\end{enumerate}
  1650	The targets of $\DCL_{n,H}$ fit with $M_\tau=\ell$ and $h_\tau=(Bp+Aq-c)/\ell^2$.
  1651	
  1652	\begin{lemma}[coverage of one map; sketch]\label{lem:C}
  1653	For any support $I$ with $0\notin I$, $|I|=K$, and measurable $E$,
  1654	$|\{t\in J:G(t)\in E\}|\le C_I(|E|/\|b\|_\infty)^{1/K}$, where $G(t)=\sum b_it^i$.
  1655	\end{lemma}
  1656	\noindent\emph{Sketch.} The generalised Wronskian of $\{t^i\}_{i\in I}$ is nonzero. So $J$ splits
  1657	into $O_I(1)$ pieces on each of which some derivative $|G^{(k)}|$, $k\le K$, is at least
  1658	$c_I\|b\|_\infty$. On each piece apply van der Corput's sublevel-set estimate.
  1659	
  1660	\begin{lemma}[denominators]\label{lem:K}
  1661	If $h_\tau$ satisfies integrality, then $C_{d_0}M_\tau^{K_\tau}\alpha_{\tau,i}\in\Z$, with
  1662	$C_{d_0}$ supported on primes at most $2d_0$.
  1663	\end{lemma}
  1664	\begin{proof}
  1665	Fix $\ell^a\Vert M$ and let $v^*=\min_iv_\ell(\alpha_i)$. Then $f(y)=h_\tau(r+\ell^ay)$ equals
  1666	$T_0'+\sum_{n\ge1}T_n\ell^{an}y^n$, where $(T_1,\dots,T_K)=W(r)\alpha$ and $\det W(r)$ is a
  1667	Wronskian of bounded valuation $c_W$ ($c_W=0$ for $\ell>2d_0$). So some $j_0\le K$ has
  1668	$v_\ell(T_{j_0})\le v^*+c_W$.
  1669	
  1670	The finite difference $\Delta^{j_0}f(0)\in\Z_\ell$ is dominated, for $a>c_W$, by its $n=j_0$
  1671	term. This gives $v^*\ge-aK-v_\ell(K!)-c_W$. If $a\le c_W$, pass to a subclass.
  1672	\end{proof}
  1673	
  1674	\begin{proposition}[per-target bounds]\label{prop:pertarget}
  1675	Merge the targets with the same triple, of total width $W$ and number $w$. They cover at most:
  1676	\begin{enumerate}[label=(\roman*)]
  1677	\item $C(RW/\eta)^{1/2}+Cw$ for degree one with $K=2$, where $\eta=\max(|A|,|B|)$ in
  1678	  $\alpha=(B,A)/(C_{d_0}M^2)$;
  1679	\item $CW+Cw$ for degree one with $K=1$;
  1680	\item $CR^{1-\nu/K}W^{1/K}+Cw$ for degree $\nu\ge2$.
  1681	\end{enumerate}
  1682	\end{proposition}
  1683	\begin{proof}
  1684	The covered candidates lie in one class modulo $M$ and in the preimage of the windows. Apply
  1685	Lemma~\ref{lem:C} with the lower bounds on $\|b\|_\infty$ given by Lemma~\ref{lem:K}. The modulus
  1686	cancels.
  1687	\end{proof}
  1688	
  1689	\begin{theorem}[full-candidate floors; proved in the model]\label{thm:A}
  1690	Every covering family has $X\ge cN^{1/6}$. If degree-one targets cover fewer than half the
  1691	candidates, then $X\ge cN^{1/5}$. If the degree-one two-term targets use $J$ moduli, then
  1692	$X\ge cN^{1/5}(JN^{o(1)})^{-1/5}$.
  1693	\end{theorem}
  1694	\begin{proof}[Proof sketch]
  1695	For the first claim:
  1696	\begin{itemize}
  1697	\item By H\"older and Proposition~\ref{prop:pertarget}(iii), targets of degree $\ge2$ cover
  1698	  $o(R)$ candidates unless $X\gg R^{2/5}$.
  1699	\item By (ii), one-term targets cover at most $CX^2$.
  1700	\item By (i) and Cauchy--Schwarz, the two-term targets cover at most $CR^{1/2}X^{3/2}+CX$, which
  1701	  forces $X\gg R^{1/3}$.
  1702	\end{itemize}
  1703	The last claim counts the pairs (class, weight) of height at most $h$ per modulus. There are at
  1704	most $4^{\omega(M)}\gcd(A,B,M)$ admissible unit classes, which gives $h^2N^{o(1)}$ pairs per
  1705	modulus. Then optimise $\sum1/\eta$. Full proofs are in \texttt{notes/multimod\_results.md} \S3
  1706	and \texttt{notes/cycloharvey\_results.md} \S3.
  1707	\end{proof}
  1708	
  1709	\begin{remark}
  1710	A CRT decomposition of the lock lattices is multiplicative (Theorem~C in the multimod
  1711	notes). So covering \emph{all} classes of a composite modulus gains nothing. What escapes the
  1712	$N^{1/5}$ bound is \emph{selective} covering, which is exactly what $\DCL_{n,H}$ does. Whether it
  1713	covers almost every candidate for a fixed $N$ is not proved.
  1714	\end{remark}
  1715	
  1716	\section{Reproducibility}
  1717	Code, raw data and notes are in the project repository. The main entry points are:
  1718	\begin{itemize}
  1719	\item \texttt{src/dcltheorem/} (the search);
  1720	\item \texttt{src/avgtime/} (detector, ladder, exact exponent audit);
  1721	\item \texttt{src/sieve2d/} (coverage bounds and experiments);
  1722	\item \texttt{src/dchworst/} (the worst-case algorithm and coverage experiments);
  1723	\item \texttt{src/below16/} (model checks).
  1724	\end{itemize}
  1725	Each has a test file under \texttt{tests/}. In the reference implementation of $\LAD$, the
  1726	fallback is Lehman's method and primality is a BPSW-type test. These are stand-ins for
  1727	correctness tests at 32--40 bits. For example:
  1728	\begin{verbatim}
  1729	.venv/bin/python -m pytest -q tests/test_dcltheorem.py tests/test_avgtime.py \
  1730	    tests/test_sieve2d_bound.py tests/test_dchworst_wc.py tests/test_below16.py
  1731	PYTHONPATH=. .venv/bin/python -m src.dcltheorem.experiments lemma
  1732	\end{verbatim}
