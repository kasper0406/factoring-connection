  1315	%======================================================================
  1316	\section{A true-factor floor for local designs}\label{sec:lower}
  1317	%======================================================================
  1318	
  1319	This section is a theorem inside a cost model. It explains why $N^{1/6}$ is the natural limit of
  1320	the method. It is not a lower bound for factoring.
  1321	
  1322	\subsection{The model}
  1323	\paragraph{Cost.} For an input $N$, a design issues \emph{targets} (labels) $\tau$, each with a
  1324	finite window $S_\tau\subset\Z$ of exponent values. A shared baby list, with any sumset
  1325	structure, tests them. The design has cost $X$ if $\#\{\tau\}\le X$ and $\sum_\tau|S_\tau|\le
  1326	X^2$, either per input or in expectation over uniform $n$-bit $N$. A baby-step/giant-step search
  1327	with list length $m\le X$ and at most $X$ giants satisfies this, since every window costs
  1328	$\lceil|S_\tau|/m\rceil\ge1$ giants.
  1329	
  1330	The model charges labels, not stored group elements: it assumes that one giant certifies at most
  1331	one label. For the targets of this paper two labels share a giant only in negligible cases, but
  1332	we have no general bound.
  1333	
  1334	\paragraph{Generators.} A \emph{residue-local degree-one generator} $\iota$ consists of the
  1335	following data:
  1336	\begin{itemize}
  1337	\item fixed integers $A,B$, not both $0$;
  1338	\item integers $M\ge1$, $K$ with $M\mid K$, and $D\ge1$;
  1339	\item a side, $p$ or $q$;
  1340	\item arbitrary maps $\kappa\mapsto R(\kappa)\subseteq\Z/M$ and $\kappa\mapsto S(\kappa)\subset\Z$
  1341	  (finite sets), defined on keys $\kappa\in\Z/K$.
  1342	\end{itemize}
  1343	Write $x$ for the class variable ($x=p$ on side $p$) and $y$ for the partner. On input $N$, with
  1344	$\kappa=N\bmod K$, the generator issues $|R(\kappa)|$ targets. They cover $(p,q)$ iff
  1345	\begin{equation}\label{eq:gen}
  1346	  x\bmod M\in R(\kappa)\quad\text{and}\quad\lfloor(Bx+Ay)/D\rfloor\in S(\kappa).
  1347	\end{equation}
  1348	
  1349	\paragraph{Locality hypothesis (L1).}
  1350	\begin{itemize}
  1351	\item $D/|A|\le C_1M^2$ if $A\ne0$, and $D/|B|\le C_1M^2$ if $A=0$;
  1352	\item $K\le C_2M^2$;
  1353	\item $M,K\le P/2$.
  1354	\end{itemize}
  1355	
  1356	\paragraph{Why this shape is general for degree one.}
  1357	Every identity-valid degree-one target has exponent $(Bx+Ay-c)/D$, with $D=C_dM^2$ and $c\in[0,D)$
  1358	fixed by the class and by $N\bmod D$ (Lemma~\ref{lem:K}). For true pairs this exponent equals
  1359	$\lfloor(Bx+Ay)/D\rfloor$, and any window placement is some finite set $S$. The count below never
  1360	uses validity: it holds for every rule of shape \eqref{eq:gen}.
  1361	
  1362	\subsection{The bound}
  1363	
  1364	\begin{lemma}[fixed-key partner count]\label{lem:partner}
  1365	Fix $x$ and a unit key $\kappa$, with $A\ne0$. The partners $y\equiv\kappa x^{-1}\pmod K$ of $x$
  1366	satisfying \eqref{eq:gen} number at most
  1367	$\min\bigl(|S(\kappa)|(\lfloor D/(|A|K)\rfloor+1),\ \lfloor\ell_y/K\rfloor+1\bigr)$, where
  1368	$\ell_y\le x$ is the length of the partner range.
  1369	\end{lemma}
  1370	\begin{proof}
  1371	The partners form an arithmetic progression of step $K$. Each value $s\in S$ confines $y$ to an
  1372	interval of length $D/|A|$.
  1373	\end{proof}
  1374	
  1375	\begin{theorem}[T1; precise form of Theorem~\ref{thm:T1}; proved]\label{thm:T1precise}
  1376	Assume (L1), and let a design be a union of generators. Suppose
  1377	$\mathbb E_N\#\{\tau\}\le X$ and $\mathbb E_N\sum_\tau|S_\tau|\le X^2$, where $\mathbb E_N$
  1378	averages over uniform $n$-bit $N$. Then
  1379	\[
  1380	  \Pr_{(p,q)\in\Sn}[\text{the true pair is covered}]\le C\,n^2X^{3/2}N^{-1/4},
  1381	\]
  1382	with $C$ depending only on $C_1,C_2$.
  1383	\end{theorem}
  1384	\begin{proof}
  1385	\begin{enumerate}[label=\arabic*.]
  1386	\item \emph{Sum by keys.} Both primes exceed $K$, so they are units modulo $K$, and each $x$ has
  1387	  one partner class $\kappa x^{-1}$ per unit key $\kappa$. Let $\varphi(\kappa)$ denote the bound
  1388	  of Lemma~\ref{lem:partner}. Then
  1389	  \[
  1390	  \mathrm{Count}(\iota)\le\sum_\kappa\varphi(\kappa)\,\#\{x:x\bmod M\in R(\kappa)\},
  1391	  \]
  1392	  and the last factor is at most $c_s|R(\kappa)|P/M$, with $c_s=1$ on side $p$ and $5/4$ on side
  1393	  $q$.
  1394	\item \emph{Bound $\varphi$.} Using $\min(u,v)\le\sqrt{uv}$ and $K\le P/2$,
  1395	  $\varphi(\kappa)\le\sqrt{2P|S(\kappa)|(D/|A|+K)}/K$.

