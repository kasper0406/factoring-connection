  1109	\section{The worst case reduces to coverage}\label{sec:worst}
  1110	%======================================================================
  1111	
  1112	\subsection{Setting}
  1113	\begin{itemize}
  1114	\item A \emph{weight} is a primitive pair $(A,B)$ with $1\le|A|,B\le H$. \emph{Signed} weights
  1115	  allow $A<0$, and the diagonal $(1,1)$ is allowed.
  1116	\item A \emph{block} is a set of primes $\ell\equiv3\pmod4$ with $H<\ell<\sqrt{N/2}$.
  1117	\item The pair $(p,q)$ is \emph{covered} by (block, weights) if $\ell\mid Bp-Aq$ for some weight
  1118	  and some prime $\ell$ of the block.
  1119	\end{itemize}
  1120	
  1121	\subsection{The algorithm \texorpdfstring{$\DCLwc$}{DCL-wc}}
  1122	The algorithm sees only $N$ and the public parameters $H$, $V$, the blocks $\mathcal P_1,\dots,
  1123	\mathcal P_K$, $T$ and $B_0$.
  1124	\begin{enumerate}[label=\arabic*.,start=0]
  1125	\item If $N<4$, output \texttt{FAIL}. If $N$ is even, output $2$. If $N=s^2$, output $s$.
  1126	\item \emph{Base selection.} For $b=2,3,\dots,B_0$:
  1127	  \begin{itemize}
  1128	  \item check $\gcd(b,N)$;
  1129	  \item by baby-step giant-step polynomial evaluation, find the least $r\le T_{\mathrm{scan}}=
  1130	    T+O(\sqrt T)$ with $\gcd(b^r-1,N)>1$;
  1131	  \item if that gcd is proper, output it; if no such $r$ exists, \emph{select} $b$ and go to
  1132	    step~2; otherwise record $r_b$.
  1133	  \end{itemize}
  1134	  If every $b\le B_0$ was recorded, put $\Lambda=\mathrm{lcm}_b\,r_b$ and test
  1135	  $\gcd(1+j\Lambda,N)$ for $1\le j\le(\lfloor\sqrt N\rfloor-1)/\Lambda$.
  1136	\item For each block, with $L=\prod\ell^2$, $u_\ell=b^{L/\ell^2}$ (by the exponent tree) and
  1137	  $\gamma=b^L$:
  1138	  \begin{itemize}
  1139	  \item build the targets of Section~\ref{sec:alg} for all weights in $V$. For $A<0$ use
  1140	    $\mathrm{Lo}=Ba_0+\lfloor AN/a_0\rfloor$ and $\mathrm{Hi}=Bb_0+\lceil AN/b_0\rceil$, since
  1141	    $x\mapsto Bx+AN/x$ is then increasing. Choose $m$ as in step~5 there.
  1142	  \item \emph{$\gamma$ pre-step.} Find the least $r\in[1,m)$ with $\gcd(\gamma^r-1,N)>1$, by a
  1143	    product tree and binary descent. If the gcd is proper, output it. If it equals $N$, run the
  1144	    \emph{equal-order split}: $E=Lr$ is a multiple of $\ord_N(b)$ with known factorisation. For
  1145	    each prime power $\varrho^e\Vert E$ compute $y=b^{E/\varrho^e}$ and $\gcd(y^{\varrho^i}-1,N)$
  1146	    for $0\le i\le e$, and output any proper value. Otherwise the common order $D$ is now known;
  1147	    test $\gcd(1+jD,N)$ for $1\le j\le(\lfloor\sqrt N\rfloor-1)/D$.
  1148	  \item \emph{Giants.} Evaluate $f=\prod_{i<m}(X-\gamma^i)$ at all giants as in
  1149	    Section~\ref{sec:alg}. Output any proper gcd, and collect the giants with
  1150	    $\gcd(f(G),N)=N$.
  1151	  \item \emph{Exploration.} For each such giant, descend the subproduct tree of $f$. At a node
  1152	    whose value has gcd $N$, evaluate both children. Output any proper gcd, and descend into the
  1153	    children whose gcd is $N$.
  1154	  \item \emph{Exact leaf.} If leaf $i$ is reached with $G\equiv\gamma^i\pmod N$, put
  1155	    $S=c+\ell^2(g_{\mathrm{lo}}+jm+i)$. If $S^2-4ABN=D_0^2$ is a perfect square, output a proper
  1156	    $\gcd((S\pm D_0)/2,N)$.
  1157	  \end{itemize}
  1158	\item Output \texttt{FAIL}.
  1159	\end{enumerate}
  1160	All outputs are validated.
  1161	
  1162	\subsection{Theorem R}
  1163	\begin{theorem}[precise form of Theorem~\ref{thm:R}; proved]\label{thm:Rprecise}
  1164	Let $N=pq\in\Sn$. Then:
  1165	\begin{enumerate}[label=(\roman*)]
  1166	\item $\DCLwc$ outputs a proper divisor of $N$ or \texttt{FAIL};
  1167	\item if $(p,q)$ is covered by $(\mathcal P_k,V)$ for some $k$, it outputs a proper divisor;
  1168	\item its cost is
  1169	\[
  1170	  \tilde O\Bigl(\sum_k(m_k+T'_k+|V||\mathcal P_k|+|\mathcal P_k|\log Y)+B_0T^{1/2}+\sqrt N/T
  1171	  +\sqrt N/\Psi(\sqrt{N/2}-1,B_0)\Bigr)
  1172	\]
  1173	ring operations modulo $N$, plus $\tilde O(|V||\mathcal P_k|)$ word operations. Here $\Psi$
  1174	counts smooth numbers. With $T=\lceil N^{1/3}\rceil$ and $B_0=\lceil n^4\rceil$, the last three
  1175	terms are $N^{1/6}n^{O(1)}$.
  1176	\end{enumerate}
  1177	\end{theorem}
  1178	
  1179	\begin{lemma}[one-sided order dichotomy; after {\cite{hh2026}}]\label{lem:O}
  1180	For $b$ coprime to $N$, write $o_p=\ord_p(b)$ and $o_q=\ord_q(b)$.
  1181	\begin{enumerate}[label=(\alph*)]
  1182	\item If $\min(o_p,o_q)\le T_{\mathrm{scan}}$, the scan returns $r_b=\min(o_p,o_q)$, and the gcd
  1183	  there is proper iff $o_p\ne o_q$.
  1184	\item If every $b\le B_0$ is recorded, the $\Lambda$-enumeration finds $p$ at cost at most
  1185	  $\sqrt N/\Psi(p-1,B_0)$.
  1186	\end{enumerate}
  1187	\end{lemma}
  1188	\begin{proof}
  1189	\begin{enumerate}[label=(\alph*)]
  1190	\item The first $r$ with $\gcd(b^r-1,N)>1$ is $\min(o_p,o_q)$, and at $r=o_q<o_p$ the gcd is $q$.
  1191	\item If $o_p=o_q=r_b$ for all $b\le B_0$, the subgroup $\langle2,\dots,B_0\rangle\le\mathbb
  1192	  F_p^\times$ is cyclic of order $\Lambda$ dividing $p-1$. It contains every $B_0$-smooth integer
  1193	  below $p$, so $\Lambda\ge\Psi(p-1,B_0)$. Then $p=1+j\Lambda$ with $j\le\sqrt N/\Lambda$.
  1194	  For $B_0\ge(\ln p)^4$, the elementary bound $\Psi(x,(\log x)^4)\ge x^{3/4}/(\log x)^3$ gives
  1195	  $\sqrt N/\Lambda\le P^{1/4}n^3$.
  1196	\end{enumerate}
  1197	\end{proof}
  1198	
  1199	\begin{lemma}[$\gamma$ pre-step]\label{lem:G}
  1200	Exactly one of the following holds:
  1201	\begin{itemize}
  1202	\item a proper divisor is output;
  1203	\item $\ord_p(\gamma)=\ord_q(\gamma)<m$, and the equal-order split outputs a divisor, either
  1204	  directly or through the $D$-enumeration at cost at most $\sqrt N/T$;
  1205	\item $\ord_p(\gamma)\ge m$ and $\ord_q(\gamma)\ge m$.
  1206	\end{itemize}
  1207	\end{lemma}
  1208	\begin{proof}
  1209	Suppose $\gamma^o\equiv1\pmod N$. Then $o_p,o_q\mid E=Lo$. For each prime $\varrho\mid E$,
  1210	$y=b^{E/\varrho^e}$ has order $\varrho^{v_\varrho(o_p)}$ modulo $p$ and $\varrho^{v_\varrho(o_q)}$
  1211	modulo $q$. If these valuations differ for some $\varrho$, the corresponding gcd is $p$ or $q$.
  1212	Otherwise $o_p=o_q=D$, and $D>T$ because $b$ was selected; since $D\mid p-1$, the enumeration
  1213	finds $p$.
  1214	\end{proof}
  1215	
  1216	\begin{lemma}[exploration]\label{lem:X}
  1217	Assume $\ord_p(\gamma),\ord_q(\gamma)\ge m$.
  1218	\begin{enumerate}[label=(\alph*)]
  1219	\item Each giant has at most one $i<m$ with $G\equiv\gamma^i\pmod p$. So at most one node per
  1220	  tree level has gcd $N$, and the exploration of a giant costs $O(\log m)$ node evaluations.
  1221	\item If the true giant $G^*$ has $\gcd(f(G^*),N)=N$, its exploration outputs a proper divisor.
  1222	\end{enumerate}
  1223	\end{lemma}
  1224	\begin{proof}
  1225	(a) The $\gamma^i$, $i<m$, are distinct modulo $p$.
  1226	
  1227	(b) Every node on the path to leaf $i^*$ has value divisible by $p$, so its gcd is $p$ (which is
  1228	output) or $N$. If leaf $i^*$ is reached with $G^*\equiv\gamma^{i^*}\pmod N$, then
  1229	$S=c+\ell^2g=Bp+Aq$. Hence $S^2-4ABN=(Bp-Aq)^2$ and $\{(S\pm D_0)/2\}=\{Bp,Aq\}$. Finally
  1230	$\gcd(Bp,N)=p$ because $1\le B<q$.
  1231	\end{proof}
  1232	
  1233	\begin{proof}[Proof of Theorem~\ref{thm:Rprecise}]
  1234	(i) holds because all outputs are validated.
  1235	
  1236	(ii) Steps 0--1 output a divisor or select $b$ (Lemma~\ref{lem:O}). In a covering block,
  1237	Lemma~\ref{lem:G} either outputs a divisor or gives orders $\ge m$. The true target exists and its
  1238	true giant satisfies $G^*\equiv\gamma^{i^*}\pmod p$, by Lemmas~\ref{lem:coverage}--\ref{lem:modp}
  1239	(the sign of $A$ plays no role). Then either $\gcd(f(G^*),N)=p$, or Lemma~\ref{lem:X}(b) applies.
  1240	The fallback enumerations in earlier blocks are complete, so they cannot abort.
  1241	
  1242	(iii) The exploration is batched level by level, at total cost $\tilde O(m+T')$ by
  1243	Lemma~\ref{lem:X}(a). The remaining terms are as in \S\ref{sec:cost}. The term $|V||\mathcal P_k|$
  1244	charges the rejected (weight, prime) tests.
  1245	\end{proof}
  1246	
  1247	The reference implementation (\texttt{src/dchworst/wcalg.py}) is a correctness prototype. Two
  1248	steps there are unbatched (the $\gamma$ pre-step scan and the exploration), so it does not meet
  1249	the cost bound (iii). Its outputs are unaffected.
  1250	
  1251	\subsection{Consequences}
  1252	
  1253	\begin{hypothesis}[$\mathrm{DCH}_{\mathrm{pair}}(\kappa)$]\label{hyp:DCHpair}
  1254	For all large $n$ and every $(p,q)\in\Sn$, some block $\Pk$ ($k=0,\dots,3$) of the design of
  1255	$\DCL_{n,H}$ with $H=\lceil n^\kappa\rceil$ contains a prime $\ell$ with $\ell\mid Bp-Aq$, for some
  1256	primitive $(A,B)$ with $1\le|A|,B\le H$. The diagonal $(1,1)$ is allowed.
  1257	\end{hypothesis}
  1258	
  1259	\begin{proof}[Proof of Corollary~\ref{cor:conditional}]
  1260	\begin{itemize}
  1261	\item \emph{(a).} Apply Theorem~\ref{thm:Rprecise} with the design of $\DCL_{n,H}$ and signed
  1262	  weights. The list cost is $n^{O(1)}H^{5/3}2^{n/6}=N^{1/6+o(1)}$.
  1263	\item \emph{(b).} Take $J=Y^{j}$ moduli, $j\le1$, and height $H=Y^{1/2}J^{-c}$. The list cost is
  1264	  $HP/Y^2+JH^2$. Balancing over $Y$ gives the exponent
  1265	  $E(j,c)=(1+j(1-2c))/(5+2j(1-c))$. Its $j$-derivative has the sign of $3-8c$, so for $c>3/8$ the
  1266	  optimum is $j=1$, giving $(1-c)/(7/2-c)$. The extraction cost of Theorem~\ref{thm:Rprecise} is
  1267	  $N^{1/6+o(1)}$.
  1268	\end{itemize}
  1269	\end{proof}
  1270	
  1271	\begin{remark}
  1272	\begin{enumerate}[label=(\alph*)]
  1273	\item \emph{Minkowski.} With one prime $\ell\asymp P^{2/5}$, signed weights of height
  1274	  $\sqrt{2\ell}$ and $(1,1)$, pigeonhole covers every pair. So $\DCLwc$ recovers Harvey's
  1275	  unconditional worst-case exponent $1/5$. This is the case $c=0$, and it is not new.
  1276	\item \emph{Theorem~D$'$ sharpened.} With the design of $\DCL_{n,H}$, $\DCLwc$ fails only on
  1277	  pairs uncovered by every block. That set has fraction $O(n/H^2)$ by Lemma~\ref{lem:sieve}
  1278	  applied to block $0$. The sets $E_a$ and $E_c$ disappear.
  1279	\item \emph{Squares.} An earlier draft stated a divisor-cover conjecture for every integer
  1280	  candidate $p\in[\sqrt{N/2},\sqrt N]$ of every $N$ coprime to $6$, with $A\ne B$. That form is
  1281	  false. For $N=t^2$ with $t$ prime and $p=t$, the quantity $Bp^2-AN=(B-A)t^2$ has no band
  1282	  divisor, since $0<|B-A|<H<\ell<t$. Hypothesis~\ref{hyp:DCHpair} quantifies over prime pairs
  1283	  only, and that is all Theorem~\ref{thm:Rprecise} needs.
  1284	\end{enumerate}
  1285	\end{remark}
  1286	
  1287	\begin{proposition}[$\mathrm{DCH}_{\mathrm{pair}}$ needs $\kappa\ge1/2$; proved]\label{prop:N}
  1288	Let $\mathcal L$ be any set of primes in $(Y,16Y]$ with $16Y\le P^\theta$, $\theta<1/2$, and let
  1289	$V$ be any weight set with $|V||\mathcal L|=o(P)$. Put $\lambda=|V|\sum_{\ell\in\mathcal
  1290	L}1/(\ell-1)$. Then at most $(2/(1-\theta)+o(1))\lambda|\Sn|+o(|\Sn|)$ pairs are covered. For
  1291	the four blocks of $\DCL_{n,H}$, a positive proportion of $\Sn$ is uncovered by every block when
  1292	$H\le0.2\sqrt n$ (positive weights) or $H\le0.14\sqrt n$ (signed weights).
  1293	\end{proposition}
  1294	\begin{proof}[Sketch]
  1295	Fix $(A,B,\ell)$ and a prime $p$. The partners $q$ with $\ell\mid Bp-Aq$ form one class modulo
  1296	$\ell$. The Brun--Titchmarsh inequality in the Montgomery--Vaughan form \cite{mv1973} bounds them
  1297	by $2|I_p|/(\varphi(\ell)\log(|I_p|/\ell))$. The $p$ near the endpoints of the range, where $|I_p|<P/n^2$,
  1298	are counted trivially. Summing over all $p$ and comparing with $|\Sn|$ gives the bound.
  1299	\end{proof}
  1300	
  1301	\begin{remark}[barriers to proving coverage]
  1302	\begin{itemize}
  1303	\item We have no design that provably covers every pair with any $c>0$.
  1304	\item Counting arguments with error budget $\gtrsim\sqrt J$ give only $c\le1/4$; this is a
  1305	  calculation, and it is heuristic as a barrier.
  1306	\item Single-modulus pigeonhole gives $c=0$.
  1307	\item A proof that also covers coprime non-prime pairs would cover, for $x\asymp Y^{25/8}$, a
  1308	  structured set of about $Y^{1/4}$ integers $bx-a$ by band primes. We know of no method for sets
  1309	  this sparse.
  1310	\item Exhaustive worst cases over all of $\mathcal S_{32}$ and $\mathcal S_{36}$ follow the
  1311	  Poisson extreme (Section~\ref{sec:experiments}).
  1312	\end{itemize}
  1313	\end{remark}
