   698	\begin{lemma}[FULL is rare]\label{lem:crt}
   699	Fix $q$ with $d=\ord_q(2)>T$ and a block $k$ clean for $q$. Let $F_k(q)$ be the set of integers
   700	$p\in[P/2,P]$ for which some $(v,\ell)\in V\times\Pk$ has $\ell\mid Bp-Aq$ and
   701	$d\mid(A-B)(p-1)-\ell^2\delta$ for some $|\delta|<\mbar$. Then
   702	\[
   703	  |F_k(q)|\le2|V||\Pk|\,\mbar\Bigl(\frac{PH}{2^{k+1}YT}+1\Bigr).
   704	\]
   705	\end{lemma}
   706	\begin{proof}
   707	Fix $(v,\ell,\delta)$ and let $g'=\gcd(A-B,d)\le H$. The congruence on $p$ is unsolvable or holds
   708	on one class modulo $d/g'$. Cleanliness gives $\ell\nmid d$. With $p\equiv AqB^{-1}\pmod\ell$, the
   709	CRT gives one class modulo $\ell d/g'\ge\ell T/H$. There are at most $|V||\Pk|(2\mbar-1)$ triples.
   710	\end{proof}
