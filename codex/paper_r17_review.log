  1070	\subsection{Proof of Theorem~\ref{thm:AV}}
  1071	\begin{itemize}
  1072	\item \emph{(i) Completeness.} Every step outputs only validated divisors, and otherwise
  1073	  Harvey--Hittmeir factors $N$ completely.
  1074	\item \emph{(ii) Worst case.} Each rung costs at most $Cn^cH_i^{5/3}2^{n/6}\le
  1075	  Cn^{c+10/3}2^{7n/36}$, and there are $O(\log n)$ rungs. The detector costs
  1076	  $\tilde O(2^{3n/20})$, AKS is polylogarithmic, and Harvey--Hittmeir runs at most once.
  1077	\item \emph{(iii) Average: reach sets.} Let $R_i$ be the pairs of $\Sn$ that reach rung $i$, and
  1078	  $R_{\HH}$ those that reach the fallback.
  1079	  \begin{itemize}
  1080	  \item By Lemma~\ref{lem:detector}, a pair passes the detector only if $d_q>T$ or it lies in
  1081	    $C(T)$.
  1082	  \item By Proposition~\ref{prop:onerun}(iii), a pair with $d_q>T$ that fails rung $i-1$ lies in
  1083	    $E_b(H_{i-1})\cup E_c(H_{i-1},T)$.
  1084	  \item Hence $R_i\subseteq C(T)\cup E_c(H_{i-1},T)\cup E_b(H_{i-1})$ for $i\ge2$, and similarly
  1085	    for $R_{\HH}$ with $H_k$. Let $W\le Cn^{16/5}2^{n/5}$ be the worst-case total cost.
  1086	  \end{itemize}
  1087	\item \emph{(iii) Average: the five contributions.}
  1088	  \begin{enumerate}[label=(\alph*)]
  1089	  \item The detector and rung~1, paid by every pair, cost $O(n^{c+5/6}2^{n/6})$.
  1090	  \item Rung $i\ge2$ on $E_b(H_{i-1})$ contributes
  1091	    $Cn^cH_i^{5/3}2^{n/6}\cdot\min(1,Cn/H_{i-1}^2)\le C'n^{c+1}2^{n/6}$. Over the $O(\log n)$
  1092	    rungs this totals $O(n^{c+1}\log n\,2^{n/6})$.
  1093	  \item Harvey--Hittmeir on $E_b(H_k)$ contributes $Cn^{16/5}2^{n/5}\cdot n/H_{\max}^2=O(n^{1/5}2^{n/6})$.
  1094	  \item Pairs in $C(T)\cup\bigcup_iE_c(H_i,T)$ pay at most $W$. By Lemma~\ref{lem:coinc},
  1095	    $|C(T)|/|\Sn|=O(2^{-n/10})$. By Proposition~\ref{prop:onerun}(iii) with $H\le H_{\max}$,
  1096	    the $E_c$ terms have exponents $7/90+1/6-3/10=-1/18$ and $1/18-1/6=-1/9$. So these pairs
  1097	    contribute at most $Wn^{O(1)}2^{-n/18}=n^{O(1)}2^{13n/90}=o(2^{n/6})$.
  1098	  \item The primality tests are polylogarithmic.
  1099	  \end{enumerate}
  1100	\item \emph{(iv)} is immediate, since the cost is a nonnegative function of $N$.
  1101	\end{itemize}
  1102	\qed
