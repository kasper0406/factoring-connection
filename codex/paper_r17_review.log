   198	\begin{theorem}[worst case from coverage; proved]\label{thm:R}
   199	There is a deterministic algorithm $\DCLwc$ (Section~\ref{sec:worst}) that takes as public
   200	parameters a weight set and blocks of primes. Suppose $N=pq\in\Sn$ and some block contains a
   201	prime $\ell$ with $\ell\mid Bp-Aq$ for some weight $(A,B)$. Then $\DCLwc$ outputs a proper divisor
   202	of $N$. Its cost is $N^{1/6+o(1)}$ plus the cost of the shared collision search over the blocks.
   203	No hypothesis on any multiplicative order is needed.
   204	\end{theorem}
   205	
   206	\begin{corollary}[proved]\label{cor:conditional}
   207	\begin{enumerate}[label=(\alph*)]
   208	\item If Hypothesis~\ref{hyp:DCHpair} ($\mathrm{DCH}_{\mathrm{pair}}(\kappa)$) holds for some
   209	  $\kappa$, then every $N\in\Sn$ is factored deterministically in $N^{1/6+o(1)}$ bit operations.
   210	\item Fix $c\in(3/8,1/2]$. Suppose that for all large $n$ there is an $n$-only band scale
   211	  $Y=N^{1/(7-2c)+o(1)}$ such that every pair of $\Sn$ has a prime $\ell\equiv3\pmod4$ in
   212	  $(Y,2Y]$ dividing some $Bp-Aq$, with a primitive weight of height $H\le Y^{1/2}J^{-c}$, where
   213	  $J\asymp Y/\log Y$ is the number of such primes. Then every $N\in\Sn$ is factored
   214	  deterministically in $N^{(1-c)/(7/2-c)+o(1)}$ bit operations, and $(1-c)/(7/2-c)<1/5$.
   215	\end{enumerate}
   216	\end{corollary}
   217	
   218	\begin{theorem}[true-factor floor for local designs; proved in the model]\label{thm:T1}
   219	Consider a sumset collision search in which labels are charged, at most $X$ targets are issued
   220	and the windows have total size at most $X^2$. Suppose its targets are residue-local and of
   221	degree one (Section~\ref{sec:lower}). Then it reaches the true factor of at most
   222	$Cn^2X^{3/2}N^{-1/4}|\Sn|$ pairs. Success on a constant fraction $\sigma$ of $\Sn$ therefore needs
   223	$X\ge c\,\sigma^{2/3}N^{1/6}(\log N)^{-4/3}$.
   224	\end{theorem}
   225	
   226	Theorem~\ref{thm:D}(b) attains the bound of Theorem~\ref{thm:T1} up to polylogarithmic factors:
   227	the algorithm $\DCL_{n,H}$ is dominated, at constant-factor cost, by a design of this kind
   228	(Proposition~\ref{prop:Dinmodel}). This replaces a claim made in an earlier draft that the
   229	algorithm is ``optimal in its model''. That claim was based on a lower bound for covering
   230	\emph{every} integer candidate (Appendix~\ref{app:full}), which does not bound an algorithm that
   231	only needs to reach the true factor.
