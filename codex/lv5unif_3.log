  1739	\item If $r\nmid b$, the only prime $\fp\mid r$ with $\ord_\fp(a-b\alpha)\ne0$ is the degree-one prime corresponding to the root $s\equiv ab^{-1}$ of
  1740	  $f\bmod r$; it occurs only if $r\mid F_A(a,b)$, and then $\ord_\fp(a-b\alpha)=v_r(F_A(a,b))$.
  1741	\end{enumerate}
