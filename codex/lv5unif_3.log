  1725	\item for each prime $p\le B$: $\sum_\ell e_{i\ell}v_p(n_{P_\ell})$;
  1726	\item one parity column $E_i$;
  1727	\item for each prime $r\le B$ with $r\nmid D$ and each root $s$ of $f\bmod r$: $\sum_\ell e_{i\ell}\,[a_{P_\ell}\equiv b_{P_\ell}s\ (r)]\,v_r(F_A(P_\ell))$;
  1728	\item $t_\chi$ character columns (Section~\ref{sec:chars}).
