  1644	\section{Post-processing at fixed degree}\label{sec:lv6}
  1645	%======================================================================
  1646	
  1647	This section adapts the number field sieve post-processing of Buhler--Lenstra--Pomerance \cite{blp1993} and
  1648	Lee--Venkatesan \cite[\S6]{lv2018} to our rows. Because $d$ is fixed, every field-dependent quantity is
  1649	$N^{O(1)}$. This simplifies matters considerably: there are $O(\log N)$ character columns, at most one
  1650	exceptional square class, and the square root needs no lattice reduction.
  1651	
  1652	\subsection{Field-level events}\label{sec:fieldevents}
  1653	
  1654	\begin{lemma}[irreducibility certificate]\label{lem:IR}
  1655	Let $g\in\cG$ with $\gcd(g_1,N)=1$, let $w$ be a prime in $(W,2W]$, and let $N$ have no prime factor $\le B$. Let $\cP_{\rm IR}$ be
  1656	the set of primes in $(r_0(d),\frac12\log H]$, where $r_0(d)\ge16$ is a constant. For $c$ uniform on $C_H$, the probability that no
  1657	$r\in\cP_{\rm IR}$ has $f\bmod r$ of degree $d$ and irreducible over $\F_r$ is at most
  1658	\[
  1659	e\,(1-1/(4d))^{|\cP_{\rm IR}|}\ \le\ \exp\bigl(-\log H/(13d\log\log H)\bigr)\qquad(N\ge N_0).
  1660	\]
  1661	If some $r$ certifies, then $f$ is irreducible over $\Q$.
  1662	\end{lemma}
  1663	
  1664	\begin{proof}
  1665	Let $Q_{\rm IR}=\prod_{r\in\cP_{\rm IR}}r=H^{1/2+o(1)}\le(2H+1)/d$. Every residue class of $C_H$ modulo $Q_{\rm IR}$ has between
  1666	$\lfloor(2H+1)/Q_{\rm IR}\rfloor^d$ and $\lceil(2H+1)/Q_{\rm IR}\rceil^d$ elements, so the law of $c\bmod Q_{\rm IR}$ is at most $(1+1/d)^d\le e$ times
  1667	uniform. Under the uniform law the reductions modulo distinct $r$ are independent (CRT). Fix $r\in\cP_{\rm IR}$; note $r<B$, so
  1668	$r\nmid Nw$. If $r\nmid g_1$, then $c\mapsto f\bmod r$ is an affine bijection from $\F_r^d$ onto the polynomials of degree at most $d$ with
  1669	$\phi(m_r)=Nwg_1^{-d}\ne0$, where $m_r=g_0g_1^{-1}\bmod r$: multiplication by $g_1x-g_0$ maps polynomials of degree at most $d-1$ bijectively onto
  1670	those vanishing at $m_r$. If $r\mid g_1$, then $g_1x-g_0\equiv-g_0$ is a unit, and $f\bmod r$ ranges over all polynomials with leading
  1671	coefficient $a_d\not\equiv0$ (as $a_dg_0^d\equiv Nw$). Monic irreducible polynomials of degree $d$ over $\F_r$ with prescribed constant term
  1672	$v\ne0$ correspond to the elements of degree $d$ of $\F_{r^d}$ with norm $(-1)^dv$. There are at least
  1673	$((r^d-1)/(r-1)-2r^{d/2})/d\ge r^{d-1}/(2d)$ of them. After the translation $x\mapsto x+m_r$ and summing over the $r-1$ leading coefficients, the
  1674	irreducible fraction is at least $(r-1)/(2dr)\ge1/(4d)$ in the first case, and at least $1/(2d)$ in the second. Hence the bound,
  1675	with $|\cP_{\rm IR}|\ge\log H/(3\log\log H)$. A factorisation of the primitive part of $f$ over $\Z$ would reduce modulo $r$ to a
  1676	factorisation with positive degrees, since $r\nmid f_d$.
  1677	\end{proof}
  1678	
  1679	\begin{lemma}[rejection events]\label{lem:reject}
  1680	Under the raw law $\cA$, let $\cR$ be the event that $\gcd(g_1,N)=1$ and one of the following holds: (i) no irreducibility certificate; (ii) $N\mid f'(m)$; (iii) the
  1681	content of $f$ equals $w$. Then $\Prob(\cR)\le\exp(-\log H/(13d\log\log H))+2/(2H+1)+1/W=L^{-\omega(1)}$. In particular $\Prob(\cR)\le\gamma/2$
  1682	for large $N$, by Theorem~\ref{thm:Dk}.
  1683	\end{lemma}
  1684	
  1685	\begin{proof}
  1686	(i) is Lemma~\ref{lem:IR}. (ii) Modulo $N$, $f'(m)\equiv\hat f'(m)+g_1R_c(m,1)$, because the derivative of $(g_1x-g_0)R_c(x,1)$ is
  1687	$g_1R_c(x,1)+(g_1x-g_0)\partial_xR_c(x,1)$ and $g_1m-g_0\equiv0$. Here $R_c(m,1)=\sum_ic_im^{d-1-i}$ has coefficient $1$ at $c_{d-1}$ and $g_1$ is a
  1688	unit. So for fixed $c_0,\dots,c_{d-2}$ at most one $c_{d-1}\in[-H,H]$ gives $N\mid f'(m)$, since $2H+1<N$. (iii) If the content is $w$, then
  1689	$w\mid f_d=a_d+g_1c_0$, and $g_1$ is invertible modulo the prime $w>M$. For fixed $(g,w,c_1,\dots,c_{d-1})$ this fixes $c_0$ modulo $w$, so
  1690	the probability is at most $\lceil(2H+1)/w\rceil/(2H+1)$. Finally $\log H\asymp\log N$, so the bound in (i) is $\exp(-\Omega(\log N/\log\log N))=L^{-\omega(1)}$.
  1691	\end{proof}
  1692	
  1693	\begin{remark}
  1694	Rejecting a field with content $w$ loses nothing: then every nonzero value $F_A(P)$ is divisible by the prime $w>B$, so
  1695	$N_\ell(A)=0$ for all $\ell$. Also, the leading coefficient never causes a degree drop ($f_d\not\equiv0\bmod g_1$), and a non-unit
