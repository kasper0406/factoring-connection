   588	\end{proof}
   589	
   590	\noindent At $d=9$, $k=13$ the exponents are $\nu=1/52$, $\mu=17/156$, $h=1/26+\eta_0$; the rational
   591	cofactor has exponent $\mu-\nu=14/156$ and the algebraic value $\mu+h+d\nu=50/156+\eta_0$, which add up to $\theta=16/39+\eta_0$.
   592	
   593	\begin{lemma}[optimal $\mu$]\label{lem:optmu}
   594	At $\eta_0\downarrow0$, the minimum of $\theta$ over $\mu\in[\nu,1)$ is attained at $\mu=(1-\nu)/d$ with
   595	$\theta=2/d+(d^2+d-2)\nu/d$ if $k<(d^2+1)/4$, and at $\mu=(1+(d-1)\nu)/(d+1)$ with $\theta=3/(d+1)+(4d-2)\nu/(d+1)$
   596	if $k\ge(d^2+1)/4$.
   597	\end{lemma}
   598	
   599	\begin{proof}
   600	At zero slack $\theta(\mu)=\max\bigl(2\mu+(d+1)\nu,\ 3\mu+\nu,\ 1+(2-d)\mu+d\nu\bigr)$. The first two
   601	are increasing and the third decreasing, so the minimum is at the intersection of the third with the
   602	larger of the first two. The third meets the first at $\mu=(1-\nu)/d$ and the second at
   603	$\mu=(1+(d-1)\nu)/(d+1)$. Comparing the first two there, the first is the larger iff $\mu\le d\nu$, which
   604	at $\mu=(1-\nu)/d$ means $k<(d^2+1)/4$.
   605	\end{proof}
