   607	\subsection{The field law}\label{sec:field}
   608	
   609	\begin{lemma}[generalised base expansion; cf.\ {\cite[\S3]{blp1993}}]\label{lem:GB}
   610	Let $g_1\ge2$, $\gcd(g_0,g_1)=1$, $\gcd(g_1,N)=1$, and let $w$ be a prime with $w>g_1$. Put $T_d:=Nw$
   611	and, for $i=d,d-1,\dots,1$: let $a_i$ be the integer with $-g_1/2<a_i\le g_1/2$ and $a_i\equiv T_ig_0^{-i}\pmod{g_1}$,
   612	and $T_{i-1}:=(T_i-a_ig_0^i)/g_1$. Put $a_0:=T_0$. Then the form $\hat F(x,y):=\sum_{i=0}^da_ix^iy^{d-i}$ satisfies
   613	$\hat F(g_0,g_1)=Nw$. If $g_0,g_1\in[M/2,M]$, then $|a_0|\le2^dNw/M^d+d2^{d-1}M$, and $a_d\not\equiv0\pmod{g_1}$.
   614	\end{lemma}
   615	
   616	\begin{proof}
   617	$T_i\equiv a_ig_0^i\pmod{g_1}$, so $T_{i-1}\in\Z$, and by induction $T_i=\sum_{j\le i}a_jg_0^jg_1^{i-j}$.
   618	At $i=d$ this is $\hat F(g_0,g_1)=Nw$. Next, $a_0=(Nw-\sum_{i\ge1}a_ig_0^ig_1^{d-i})/g_1^d$, with $Nw/g_1^d\le2^dNw/M^d$
   619	and $|a_i|(g_0/g_1)^i\le(M/2)2^i$. Finally $a_dg_0^d\equiv Nw\pmod{g_1}$, and $Nw$ is a unit modulo $g_1$
   620	because $\gcd(g_1,N)=1$ and $w$ is a prime larger than $g_1$.
   621	\end{proof}
   622	
   623	\begin{definition}[field law $\cA$]\label{def:field}
   624	Let $\cG:=\{(g_0,g_1)\in\Z^2\cap[M/2,M]^2:\gcd(g_0,g_1)=1\}$ and $C_H:=[-H,H]^d\cap\Z^d$. A \emph{field}
   625	is $A=(g,w,c)$ with three independent components: $g=(g_0,g_1)$ uniform on $\cG$; $w$ uniform among the primes
   626	in $(W,2W]$; $c$ uniform on $C_H$. Put
   627	\[
   628	G(x,y)=G_g(x,y):=g_1x-g_0y,\quad R_c(x,y):=\sum_{i=0}^{d-1}c_ix^{d-1-i}y^i,\quad F_A:=\hat F_{g,w}+G\cdot R_c,
   629	\]
   630	where $\hat F_{g,w}$ is Lemma~\ref{lem:GB} applied to $Nw$, and $f=f_A(x):=F_A(x,1)=\sum_if_ix^i$. For $P=(a,b)$ put
   631	$v(P):=(a^{d-1-i}b^i)_{0\le i<d}$, so that $F_A(P)=\hat F(P)+G(P)\langle c,v(P)\rangle$.
   632	\end{definition}
   633	
   634	So $F_A(g_0,g_1)=Nw$, $f_d=a_d+g_1c_0\equiv a_d\not\equiv0\pmod{g_1}$, and if $\gcd(g_1,N)=1$ the map
   635	$x\mapsto m:=g_0g_1^{-1}\bmod N$ kills $f$, because $f(m)\equiv g_1^{-d}F_A(g_0,g_1)=g_1^{-d}Nw\equiv0$. Thus
   636	$(f,g_1x-g_0)$ is a number field sieve pair for $N$, with resultant $\pm Nw$.
   637	
   638	\begin{lemma}[sizes]\label{lem:valuesizes}
   639	Let $N\ge N_0$, $A$ a field, $\ell\in J$, $P=(a,b)$ with $|a|,|b|\le V_\ell$, and $|z|\le T_\ell$. Then
   640	$|G(P)|\le2MV_\ell$, $|\hat F(P)|\le C_dMHV_\ell^dN^{-\eta_0/2}$ with $C_d=2^{2d+5}$, and
