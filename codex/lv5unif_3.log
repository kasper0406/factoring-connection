  1953	\section{Batch smoothness}\label{sec:batch}
  1954	%======================================================================
  1955	
  1956	\begin{lemma}[smooth parts; Bernstein {\cite{bernstein2004,bernstein2008}}]\label{lem:BS}
  1957	Let $\mathcal P_B:=\prod_{p\le B}p$, and let $x\ge2$ and $2^e\ge\log_2x$. The $B$-smooth part of $x$ is
  1958	$\gcd\bigl(x,\ (\mathcal P_B\bmod x)^{2^e}\bmod x\bigr)$. For given $x_1,\dots,x_n$, all their smooth parts can be computed in
  1959	$O(\mathsf M(b)\log b)$ bit operations, where $b=\log_2\mathcal P_B+\sum_i\log_2x_i$.
  1960	\end{lemma}
  1961	
  1962	\begin{proof}
  1963	Write $x=s\,u$ with $s$ smooth and $\gcd(u,\mathcal P_B)=1$. Every $p^j\,\|\,s$ has $j\le\log_2x\le2^e$, so $s\mid\mathcal P_B^{2^e}$, while
  1964	$\gcd(u,\mathcal P_B^{2^e})=1$. For the cost, form a product tree of the $x_i$, reduce $\mathcal P_B$ modulo the product, and descend a
  1965	remainder tree; each level costs $O(\mathsf M(b))$ \cite[\S\S10.1--10.3]{gathengerhard}. Then perform $e=O(\log\log x)$ modular squarings and a gcd for each $x_i$.
  1966	\end{proof}
  1967	
  1968	\begin{proposition}[the special-$q$ search recognises $N_\ell(A)$ exactly]\label{prop:BS}
  1969	$\mathrm{SQ\_SEARCH}(A,\ell)$ is a deterministic function of $(A,\ell)$ and runs in time $\tilde O(B+S^2\log N)$. If $\ell\nmid N$, then either it makes a
  1970	factor exit, or it returns an atom if and only if $N_\ell(A)\ge1$, and every atom it returns is a counted point.

