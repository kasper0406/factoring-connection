   695	\begin{lemma}[coprimality and the forced residue]\label{lem:coprime}
   696	Let $N\ge N_0$ have no prime factor $\le B$, let $\ell\in J$ with $\ell\nmid N$, and let $P=(a,b)\in\cP_\ell\cap\Lambda_\ell(g)$ with
   697	$n:=G(P)/\ell\in\cS_B$. Put $t:=|G(P)|$. Then $\gcd(t,\,bg_1Nw)=1$ and
   698	\begin{equation}\label{eq:forced}
   699	\hat F_{g,w}(P)\equiv c_P\,w\pmod t,\qquad c_P:=Nb^dg_1^{-d}\in(\Z/t)^\times,
   700	\end{equation}
   701	where $c_P$ depends on $(\ell,P,g)$ but not on $w$.
   702	\end{lemma}
   703	
   704	\begin{proof}
   705	$b$ is a prime with $B<V_\ell/2<b\le V_\ell<\ell$ (Lemma~\ref{lem:sizes}(a)), so $b\nmid\ell|n|=t$. A prime dividing $g_1$ and $t=|g_1a-g_0b|$ divides
   706	$g_0b$, hence $b$ (as $\gcd(g_0,g_1)=1$), which is impossible. $N$ has no prime factor $\le B$, $n$ is smooth and $\ell\nmid N$, so
   707	$\gcd(t,N)=1$. Finally $w>W>2MV_\ell\ge t$ is prime. Now apply Lemma~\ref{lem:homog}.
   708	\end{proof}
   709	
   710	\begin{remark}
   711	Without the hypothesis that $G(P)/\ell$ is smooth, \eqref{eq:forced} can fail (for example
   712	$\gcd(g_1,t)=b$ is possible). Such candidates never enter the moment sums.
   713	\end{remark}
