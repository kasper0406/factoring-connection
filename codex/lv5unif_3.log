  1735	\begin{lemma}[good primes]\label{lem:C}
  1736	Let $r$ be a prime with $r\nmid D$, and let $(a,b)$ be coprime with $F_A(a,b)\ne0$.
  1737	\begin{enumerate}[label=(\roman*)]
