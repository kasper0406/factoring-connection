+"""Independent exact coverage audit; repo used only to supply greedy designs."""
+from math import gcd, isqrt, exp
+from fractions import Fraction
+import json, sys
+sys.path.insert(0, '/home/knielsen/code/factoring-connection')
+from src.multimod.dcl import best_design
+
+def primes(n):
+    return [x for x in range(2,n+1) if all(x%d for d in range(2,isqrt(x)+1))]
+
+def audit_design(n, lam):
+    N=2**n+2**(n//2)+1
+    d=best_design(N,lam)
+    lo=isqrt((N+1)//2)
+    while 2*lo*lo<N: lo+=1
+    hi=isqrt(N)
+    pairs=sorted({(t['A'],t['B'],t['M']) for t in d['targets']})
+    weights={}
+    roots={}
+    for A,B,M in pairs: weights.setdefault(M,[]).append((A,B))
+    # Independent residue construction: test the quadratic, no modular sqrt.
+    for M,vs in weights.items():
+        roots[M]={r for r in range(M) if any((B*r*r-A*N)%M==0 for A,B in vs)}
+    missing=[]
+    for p in range(lo,hi+1):
+        covered=any(p%M in rs for M,rs in roots.items())
+        supplied=any(p%t['M']==t['r'] for t in d['targets'])
+        assert covered==supplied
+        if not covered: missing.append(p)
+    # All genuine divisors, if any, also satisfy the linear criterion and lock.
+    checks=0
+    for p in range(lo,hi+1):
+        if N%p: continue
+        q=N//p
+        for t in d['targets']:
+            A,B,M=t['A'],t['B'],t['M']
+            assert ((B*p-A*q)%M==0)==((B*p*p-A*N)%M==0)
+            if p%M==t['r']:
+                assert (B*p+A*q-t['c'])%(M*M)==0
+                g=(B*p+A*q-t['c'])//(M*M)
+                assert t['g_lo']<=g<t['g_lo']+t['W']
+                checks+=1
+    return dict(n=n,lam_target=lam,lam=d['lam'],candidates=hi-lo+1,
+                uncovered=len(missing),fraction=len(missing)/(hi-lo+1),
+                poisson=exp(-d['lam']),targets=len(d['targets']),cost=d['cost'],
+                first_missing=missing[:3],divisor_locks=checks)
+
+def pair_audit(n,H,Y):
+    # A fixed rectangular weight pool and prime band: exhaustive prime pairs.
+    V=[(A,B) for A in range(1,H+1) for B in range(1,H+1) if gcd(A,B)==1]
+    band=[l for l in primes(2*Y) if l>Y]
+    assert all(l>2*H*H for l in band)
+    ps=primes(isqrt(2**(n+1)))
+    total=fail=locks=0
+    examples=[]
+    for q in ps:
+        classes={l:{A*q*pow(B,-1,l)%l for A,B in V} for l in band if q!=l}
+        if q>2*Y: assert all(len(s)==len(V) for s in classes.values())
+        for p in ps:
+            if p>=q: break
+            N=p*q
+            if q>2*p or N.bit_length()!=n: continue
+            total+=1
+            hits=[(A,B,l) for A,B in V for l in band
+                  if (2*A*B*N)%l and (B*p-A*q)%l==0]
+            linear=bool(hits)
+            quadratic=any((2*A*B*N)%l and (B*p*p-A*N)%l==0
+                          for A,B in V for l in band)
+            assert linear==quadratic
+            if not hits:
+                fail+=1
+                if len(examples)<3: examples.append([p,q])
+            for A,B,l in hits:
+                r=p%l
+                c=(B*r+A*N*pow(r,-1,l*l))%(l*l)
+                assert (B*p+A*q-c)%(l*l)==0
+                locks+=1
+    return dict(n=n,H=H,Y=Y,band=band,weights=len(V),pairs=total,
+                uncovered=fail,fraction=fail/total,locks=locks,examples=examples)
+
+out={'greedy':[audit_design(n,lam) for n in (24,28,32)
+               for lam in (3.0, (n/2)*0.6931471805599453+2)],
+     'pairs':[pair_audit(n,H,Y) for n in (18,22,26)
+              for H,Y in ((1,7),(2,11),(3,23))]}
+print(json.dumps(out,indent=2))
+with open('/tmp/claude-r12/exact_results.json','w') as f: json.dump(out,f,indent=2)

