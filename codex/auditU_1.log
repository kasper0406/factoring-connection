+++ b/codex/scratch/auditU_1/check_kernel.py
@@ -0,0 +1,32 @@
+"""Independent small-cube search for violations of Kern-U (no repository imports)."""
+from collections import Counter
+from itertools import combinations, product
+from math import e, gcd
+
+points = [(1, 2), (-1, 2), (1, 3), (2, 3), (-2, 3), (3, 4)]
+checks = 0
+worst = (0.0, None)
+for degree in (3, 4, 5):
+    for height in (1, 2, 3, 7):
+        cube = list(product(range(-height, height + 1), repeat=degree))
+        evaluations = {}
+        for a, b in points:
+            assert gcd(a, b) == 1
+            v = [a ** (degree - 1 - i) * b ** i for i in range(degree)]
+            evaluations[a, b] = [sum(x * y for x, y in zip(c, v)) for c in cube]
+        for p, q in combinations(points, 2):
+            if p[0] * q[1] == q[0] * p[1]:
+                continue
+            counts = Counter(zip(evaluations[p], evaluations[q]))
+            actual = max(counts.values())
+            bb = p[1] * q[1]
+            upper = (2 * height // bb + 1) ** (degree - 2)
+            assert actual <= upper, (degree, height, p, q, actual, upper)
+            if degree * bb <= 2 * height + 1:
+                normalized = actual * bb ** (degree - 2) / (2 * height + 1) ** (degree - 2)
+                assert normalized <= e, (degree, height, p, q, normalized)
+                if normalized > worst[0]:
+                    worst = (normalized, (degree, height, p, q))
+            checks += 1
+print(f"{checks} complete pair/cube checks; no violation")
+print(f"Largest normalized probability where the e-bound applies: {worst}")

