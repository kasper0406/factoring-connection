#"'!/usr/bin/env python3
"""Exact finite checks; no third-party dependencies. Not asymptotic evidence."""
from fractions import Fraction
from math import gcd, isqrt, log, exp, pi
import json


def sieve(n):
    a = bytearray(b'"'\\1') * (n + 1)
    a[:2] = b'\\0\\0'
    for p in range(2, isqrt(n) + 1):
        if a[p]:
            a[p*p:n+1:p] = b'\\0' * ((n-p*p)//p + 1)
    return a


def weights(h):
    return [(a,b) for b in range(1,h+1) for a in range(-h,h+1)
            if a and gcd(a,b)==1]


def primitive_minimum(m, r):
    for h in range(1,m+1):
        sol=[(a,b) for a,b in weights(h) if (a-r*b)%m==0]
        if sol:
            return {'m':m,'r':r,'minimum':h,'examples':sol[:2]}


out = {}
out['composite_minima']=[primitive_minimum(m,m//2-1) for m in (8,12,16,20,24,28,32,40,100)]
out['exponents']=[{'c':str(c),'j=1_exponent':str((1-c)/(Fraction(7,2)-c)),
                   'best_with_j=0_or_1':str(min(Fraction(1,5),(1-c)/(Fraction(7,2)-c)))}
                  for c in [Fraction(0),Fraction(1,4),Fraction(3,8),Fraction(2,5),Fraction(1,2)]]
out['poisson_constant_natural_log']=36*log(16)/(pi*pi)

sp=sieve(1_500_100)
q=next(n for n in range(1_500_000,len(sp)) if sp[n])
lo=(q+1)//2
candidates=[p for p in range(lo,q) if sp[p]]
Y=100
band=[ell for ell in range(Y+1,16*Y+1) if sp[ell] and ell%4==3]
uncovered=bytearray(b'\\1')*(q+1)
seen=set()
rows=[]
for h in range(1,9):
    ws=weights(h)
    for ell in band:
        residues={(a*q*pow(b,-1,ell))%ell for a,b in ws}
        for r in residues:
            if (ell,r) in seen:
                continue
            seen.add((ell,r))
            uncovered[r:q+1:ell]=b'\\0'*((q-r)//ell+1)
    surv=[p for p in candidates if uncovered[p]]
    lam=sum(len({(a*pow(b,-1,ell))%ell for a,b in ws})/(ell-1) for ell in band)
    # Exact counts of excluded local residues; log-density is floating-point only.
    log_delta=sum(log(1-len({(a*pow(b,-1,ell))%ell for a,b in ws})/(ell-1))
                  for ell in band)
    rows.append({'H':h,'weights':len(ws),'surviving_prime_p':len(surv),
                 'first_survivor':surv[0] if surv else None,
                 'lambda':lam,'complete_period_density':exp(log_delta)})
out['fixed_q_scan']={'q':q,'p_interval':[lo,q-1],'prime_candidates':len(candidates),
                      'band':[Y,16*Y],'band_prime_count':len(band),'rows':rows}
# Verify every claimed survivor directly, independently of the mask.
for row in rows:
    p=row['first_survivor']
    if p is not None:
        assert all((b*p-a*q)%ell for a,b in weights(row['H']) for ell in band)
assert len(weights(10)) == 4*sum(sum(gcd(a,b)==1 for a in range(1,b+1)) for b in range(1,11))-2
with open('exact_checks.json','w') as f:
    json.dump(out,f,indent=2)
print(json.dumps(out,indent=2))
PY
