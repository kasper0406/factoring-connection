from math import isqrt,gcd

def forms(D):
 for a in range(1,isqrt(-D//3)+1):
  for b in range(-a,a+1):
   if (b*b-D)%(4*a):continue
   c=(b*b-D)//(4*a)
   if a>c or gcd(gcd(a,b),c)>1:continue
   if (abs(b)==a or a==c) and b<0:continue
   yield (a,b,c)
def prime(p):return p>1 and all(p%d for d in range(2,isqrt(p)+1))
def leg(a,p):return 1 if pow(a%p,(p-1)//2,p)==1 else -1
# r4 is the dimension of C[2] intersect C"'^2. Evaluate genus characters on the four ambiguous classes.
for p in [x for x in range(3,90) if prime(x)]:
 for q in [x for x in range(p+1,120) if prime(x)]:
  N=p*q
  if N%8!=1:continue
  e=leg(-1,p); b=leg(2,p); D=(-8 if e==1 else -4)*N
  fs=list(forms(D)); amb=[f for f in fs if f[1]==0 or f[1]==f[0] or f[0]==f[2]]
  squares=[]
  for a,B,c in amb:
   vals=[a*x*x+B*x*y+c*y*y for x in range(0,10) for y in range(0,10)]
   v=next(v for v in vals if v>0 and gcd(v,2*N)==1)
   # odd prime-discriminant characters reduce to (v/p), (v/q); these two form a basis
   if leg(v,p)==leg(v,q)==1:squares.append((a,B,c))
  r4=(len(squares)).bit_length()-1
  assert (r4>0)==(b==1),(p,q,D,r4,b,amb,squares)
print('"'rank criterion verified for all tested prime pairs p<90, q<120 with N=1 mod8')
for D in [-260,-520,-4*697,-8*697]:
 print(D,'h=',len(list(forms(D))))
