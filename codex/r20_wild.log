  m := g0 g1^{-1} mod N;  gcd check f'(m) (with the factor t^{d−2}); if N | f'(m): return REJECT
  return A = (g0, g1, w, c, f)

DESCEND_ONCE(A, N):
  draw r uniform in [1, N − 1]; gcd check r            # a non-unit r is a factor (gcd = N impossible)
  R := r^2 mod N
