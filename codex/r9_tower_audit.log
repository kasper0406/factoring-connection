diff --git a//tmp/claude-r9/audit_exact.py b//tmp/claude-r9/audit_exact.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f680925158d9f96c0518e126d41338a1e662aad
--- /dev/null
+++ b//tmp/claude-r9/audit_exact.py
@@ -0,0 +1,161 @@
+"""Independent audit: Python integers, no imports from the audited repository.
+
+Compose by replacing the second form by a properly equivalent form whose
+leading coefficient is coprime to the first, then using the elementary CRT
+composition rule. Enumerate entire power images, without random generation.
+"""
+from math import gcd, isqrt
+from collections import defaultdict, Counter
+from functools import lru_cache
+import json, time
+
+def primes(B):
+    return [n for n in range(3,B,2) if all(n%d for d in range(3,isqrt(n)+1,2))]
+
+def reduce(f):
+    a,b,c=f
+    while True:
+        q=(a+b)//(2*a)
+        a,b,c=a,b-2*q*a,c-q*b+q*q*a
+        if a>c:
+            a,b,c=c,-b,a
+            continue
+        if b==-a or (a==c and b<0): b=-b
+        return (a,b,c)
+
+def forms(D):
+    ans=[]
+    for a in range(1,isqrt((-D)//3)+1):
+        for b in range(-a,a+1):
+            if (b*b-D)%(4*a): continue
+            c=(b*b-D)//(4*a)
+            if c<a or ((abs(b)==a or a==c) and b<0): continue
+            if gcd(gcd(a,b),c)==1: ans.append((a,b,c))
+    return ans
+
+def mul(f,g):
+    a,b,c=f
+    A,B,C=g
+    D=b*b-4*a*c
+    # A+B*t+C*t*t cannot vanish at all residues modulo an odd prime.
+    # At 2 this obstruction occurs precisely when A is even and B,C odd.
+    if a%2==0 and A%2==0 and B%2 and C%2:
+        A,B,C=C,-B,A
+    t=0
+    while gcd(a,A+B*t+C*t*t)!=1: t+=1
+    A,B,C=A+B*t+C*t*t,B+2*C*t,C
+    assert B*B-4*A*C==D
+    z=(((B-b)//2)*pow(a,-1,A))%A if A>1 else 0
+    bb=b+2*a*z
+    aa=a*A
+    assert (bb*bb-D)%(4*aa)==0
+    return reduce((aa,bb,(bb*bb-D)//(4*aa)))
+
+@lru_cache(None)
+def group(D):
+    G=set(forms(D))
+    one=next(f for f in G if f[0]==1)
+    assert all(mul(f,one)==f and mul(f,(f[0],-f[1],f[2]))==one for f in G)
+    layers=[G]
+    while len(layers[-1])%2==0:
+        nxt={mul(f,f) for f in layers[-1]}
+        assert nxt<=G and len(layers[-1])%len(nxt)==0
+        layers.append(nxt)
+    ranks=[(len(x)//len(y)).bit_length()-1 for x,y in zip(layers,layers[1:])]
+    assert all(2**r==len(x)//len(y) for r,x,y in zip(ranks,layers,layers[1:]))
+    typ=[]
+    for j,r in enumerate(ranks): typ += [2**(j+1)]*(r-(ranks[j+1] if j+1<len(ranks) else 0))
+    return {'h':len(G),'ranks':ranks,'type':sorted(typ,reverse=True),'fourths':layers[2] if len(layers)>2 else layers[-1]}
+
+def rank(g,j): return g['ranks'][j-1] if len(g['ranks'])>=j else 0
+def leg(a,p): return 1 if pow(a%p,(p-1)//2,p)==1 else -1
+def clean(g): return {k:v for k,v in g.items() if k!='fourths'}
+
+def formula_checks():
+    groups=defaultdict(set); pub=defaultdict(set); n5psi=defaultdict(set); n5omega=defaultdict(set)
+    t2={k:defaultdict(set) for k in range(6,12)}
+    logs={pow(5,j,32):j for j in range(8)}
+    count=Counter(); examples={}
+    P=primes(2000)
+    for i,p in enumerate(P):
+        for q in P[i+1:]:
+            if p%4!=q%4: continue
+            e=1 if p%4==1 else -1
+            a,b,c=logs[(e*p)%32],logs[(e*q)%32],logs[(p*q)%32]
+            N=p*q; s=p+q; uv=((p-e)//4)*((q-e)//4)
+            assert ((p-e)//4-e*a*(2*a-1))%8==0
+            assert (uv-(5-2*c)*a*(c-a))%8==0
+            assert s==e*(N+1)-16*e*uv
+            count['p_eq_q_mod4']+=1
+            if N%8==1:
+                count['N1']+=1
+                groups[(N%128,e,a%4)].add(s%128)
+                pub[(N%128,e,leg(2,p))].add(s%128)
+                h=(uv%8)//4; two=leg(2,p)==1
+                pred=(int(a%4==2) if two else int(N%32==17)) if N%16==1 else ((int(a%4==1)^int(N%32==25)) if not two else 0)
+                assert h==pred
+                if p%16==q%16: count['undetermined']+=1
+                for k,g in t2.items():
+                    for x in (p,q): g[(N%(1<<k),x%(1<<(k-3)))].add(s%(1<<k))
+            else:
+                key=(N%128,e,a%4)
+                n5psi[key].add(s%128); n5omega[(N%128,e,a)].add(s%128)
+                if key in examples and examples[key][2]!=s%128 and 'omega_counterexample' not in count:
+                    examples['counterexample']=[examples[key],(p,q,s%128)]
+                    count['omega_counterexample']=1
+                examples[key]=(p,q,s%128)
+    def info(g):return {'keys':len(g),'ambiguous':sum(len(x)>1 for x in g.values())}
+    return {'counts':dict(count),'psi':info(groups),'K0':info(pub),'N5_psi':info(n5psi),'N5_omega':info(n5omega),
+            'N5_counterexample':examples['counterexample'],'T2':{k:info(g) for k,g in t2.items()}}
+
+def main():
+    t=time.time(); out={'formula':formula_checks()}
+    for D in (-3,-4,-7,-8,-15,-20,-23,-164,-820): group(D)
+    # Associativity of a complete small multiplication table.
+    for D in range(-200,-2):
+        if D%4 not in (0,1): continue
+        G=forms(D)
+        for f in G:
+            for g in G:
+                for h in G: assert mul(mul(f,g),h)==mul(f,mul(g,h))
+    counts=Counter(); examples={}; P=primes(300)
+    for i,p in enumerate(P):
+        if p<11: continue
+        for q in P[i+1:]:
+            N=p*q
+            if N%8!=1: continue
+            counts['all_pairs']+=1
+            G4,G8=group(-4*N),group(-8*N)
+            z4=reduce((2,2,(N+1)//2)) in G4['fourths']
+            z8=reduce((2,0,N)) in G8['fourths']
+            if p%8==7:
+                counts['T3']+=1
+                r=p if leg(q,p)==1 else q
+                assert rank(G4,2)==rank(G8,2)==1
+                assert rank(G4,3)==z4 and rank(G8,3)==z8
+                assert z4^z8==(r%16==7)
+                assert (-(N+1)+64*int(N%16==1)*(z4^z8))%128==(p+q)%128
+                examples.setdefault('T3_'+str((rank(G4,3),rank(G8,3))),{'p':p,'q':q,'r':r,'-4N':clean(G4),'-8N':clean(G8)})
+            elif p%8==1:
+                if leg(p,q)==1:
+                    assert rank(G4,2)==rank(G8,2)==2
+                    if p%16==q%16:
+                        counts['T4']+=1
+                        h=int(p%16==9)
+                        if z4 or z8:
+                            counts['T4_decided']+=1
+                            assert h==int(z4!=z8)
+                        examples.setdefault('T4_'+str((int(z4),int(z8),h)),{'p':p,'q':q,'-4N':clean(G4),'-8N':clean(G8)})
+                else:
+                    counts['T4prime']+=1
+                    assert z4^z8==(N%16==9)
+            for k,K in ((3,12),(7,28)):
+                a,b=group(-k*N),group(-K*N)
+                assert a['type']==b['type'] and b['h']==a['h']*(3 if k==3 else 1)
+                counts['conductor_pairs']+=1
+    out['classgroups']={'counts':dict(counts),'examples':examples,'cached_discriminants':group.cache_info().currsize,'failures':0}
+    out['seconds']=round(time.time()-t,2)
+    with open('/tmp/claude-r9/exact_results.json','w') as f:json.dump(out,f,indent=2)
+    print(json.dumps(out,indent=2),flush=True)
+
+if __name__=='__main__': main()
