"""Agent `tower128`: what determines s = p + q mod 128 when N = pq = 1 (mod 8)?  (NEXT_STEPS item 2.)

Everything in this package is DIAGNOSTIC / HARNESS code: it knows p and q and checks mathematical claims by
exhaustive enumeration.  Nothing here is operational (rule 2 of notes/AGENT_RULES.md).

Modules
  formula     exact formula for uv mod 8 via 2-adic Dirichlet characters; exhaustive check
  classgroup  exact brute-force 2-Sylow structure of Cl(D) (primitive forms), validated against src/repair
  run_tower   computes the extended key (2-power ranks for 8 public discriminants) for all pairs, JSONL output
  analyze     ambiguity tables and conditional mutual information with the hidden bit
  symbols     quartic / octic residue symbols and Redei-symbol identities used in notes/tower_results.md section 3
"""
    from math import log2

    def cmi(tab: Counter) -> float:
        tot = sum(tab.values())
        c_, cx, ch = Counter(), Counter(), Counter()
        for (c, x, h), k in tab.items():
            c_[c] += k
            cx[(c, x)] += k
            ch[(c, h)] += k
        return sum(k * log2(k * c_[c] / (cx[(c, x)] * ch[(c, h)])) for (c, x, h), k in tab.items()) / tot

    def deterministic(tab: Counter) -> bool:
        seen = defaultdict(set)
        for (c, x, h) in tab:
            seen[(c, x)].add(h)
        return all(len(v) == 1 for v in seen.values())

    import random

    def cmi_null(tab: Counter, nperm: int = 200) -> float:
        rows = [(c, x, h) for (c, x, h), k in tab.items() for _ in range(k)]
        rng = random.Random("tower128-S3")
        by = defaultdict(list)
        for c, x, h in rows:
            by[c].append((x, h))
        vals = []
        for _ in range(nperm):
            t = Counter()
            for c, lst in by.items():
                xs = [x for x, _ in lst]
                rng.shuffle(xs)
                for x, (_, h) in zip(xs, lst):
                    t[(c, x, h)] += 1
            vals.append(cmi(t))
        vals.sort()
        return {"mean": round(sum(vals) / len(vals), 5), "p95": round(vals[int(0.95 * (len(vals) - 1))], 5)}

    res["S3_pairs"] = n
    res["S3"] = {k: {"cmi_bits_given_N_mod_128": round(cmi(t), 5), "h_function_of_it": deterministic(t),
                     "null": cmi_null(t),
                     "table_(x,h)": {f"{x},{h}": sum(v for (c, xx, hh), v in t.items() if xx == x and hh == h)
                                     for x in (1, -1) for h in (0, 1)}}
                 for k, t in tabs.items()}
    res["seconds"] = round(time.time() - t0, 1)
    return res


def main() -> None:
