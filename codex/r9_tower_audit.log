from __future__ import annotations

import argparse
import json
import time
from collections import defaultdict
from typing import Dict, List, Tuple

from src.repair.verify_r4 import legendre, odd_primes_below

# discrete log base 5 modulo 32 on the subgroup {1 mod 4}
_POW5 = [pow(5, j, 32) for j in range(8)]
_DLOG5 = {x: j for j, x in enumerate(_POW5)}


def index32(x: int) -> Tuple[int, int]:
    """Return (sign, a) with x = sign * 5^a (mod 32), sign = (-1/x) in {+1, -1}, a in Z/8.  x odd."""
    r = x % 32
    if r % 4 == 1:
        return 1, _DLOG5[r]
    return -1, _DLOG5[(-r) % 32]


def omega_exp(x: int) -> int:
    """omega(x) = zeta_8^omega_exp(x): the even order-8 Dirichlet character mod 32 with omega(5) = zeta_8."""
    return index32(x)[1]


def psi_exp(x: int) -> int:
    """psi(x) = i^psi_exp(x): the even order-4 character mod 16 with psi(5) = i (psi = omega^2)."""
    return index32(x)[1] % 4


def hidden_bit(p: int, q: int) -> int:
    """h = bit 2 of (uv mod 8).  With uv mod 4 public (REPORT 1.1), s mod 128 <=> h given (N mod 128, eps, QR_2)."""
    eps = 1 if p % 4 == 1 else -1
    u, v = (p - eps) // 4, (q - eps) // 4
    return ((u * v) % 8) >> 2


def uv_mod8_formula(p: int, q: int) -> int:
    """T1(ii): uv = (5 - 2c) a (c - a) mod 8, using only the 2-adic indices a (of p) and c (of N)."""
    a = omega_exp(p)
    c = omega_exp(p * q)
    return ((5 - 2 * c) * a * (c - a)) % 8


def h_from_psi(N: int, eps: int, psi_p: int) -> int:
    """T1(iv) as a function of public (N mod 32, eps) and the hidden psi(p) exponent (N = 1 mod 8).  eps unused:
    the rule does not depend on eps (kept in the signature to make the key explicit)."""
    two_sq = psi_p % 2 == 0  # psi(p)^2 = (2/p)
    if N % 16 == 1:
        return int(psi_p == 2) if two_sq else int(N % 32 == 17)
    assert N % 16 == 9
    return int(psi_p == 1) ^ int(N % 32 == 25) if not two_sq else 0


def run(bound: int = 2000) -> Dict[str, object]:
    t0 = time.time()
    P = odd_primes_below(bound)
    fails: Dict[str, List[Tuple[int, int]]] = defaultdict(list)
    counts: Dict[str, int] = defaultdict(int)
    groups_T2: Dict[int, Dict[tuple, set]] = {k: defaultdict(set) for k in range(6, 12)}
    groups_pub: Dict[tuple, set] = defaultdict(set)
    groups_pub_psi: Dict[tuple, set] = defaultdict(set)
    groups_pub_psi_amb: Dict[tuple, set] = defaultdict(set)
    amb_cells = defaultdict(int)
    groups_n5_psi: Dict[tuple, set] = defaultdict(set)
    groups_n5_omega: Dict[tuple, set] = defaultdict(set)
    for i, p in enumerate(P):
        for q in P[i + 1:]:
            if p % 4 != q % 4:
                continue
            N, s = p * q, p + q
            eps = 1 if p % 4 == 1 else -1
            u, v = (p - eps) // 4, (q - eps) // 4
            counts["p_eq_q_mod4"] += 1
            # T1(i), T1(ii): all pairs p = q (mod 4)
            a, b, c = omega_exp(p), omega_exp(q), omega_exp(N)
            if index32(p)[0] != eps or index32(q)[0] != eps or index32(N)[0] != 1 or (a + b - c) % 8:
                fails["index_bookkeeping"].append((p, q))
            if u % 8 != (eps * a * (2 * a - 1)) % 8 or v % 8 != (eps * b * (2 * b - 1)) % 8:
                fails["T1_i"].append((p, q))
            if (u * v) % 8 != uv_mod8_formula(p, q):
                fails["T1_ii"].append((p, q))
            if s % 128 != (eps * (N + 1) - 16 * eps * uv_mod8_formula(p, q)) % 128:
                fails["s128_from_formula"].append((p, q))
            if N % 8 != 1:
                counts["N_5_mod_8"] += 1
                groups_n5_psi[(N % 128, eps, psi_exp(p))].add(s % 128)
                groups_n5_omega[(N % 128, eps, omega_exp(p))].add(s % 128)
                continue
            counts["N_1_mod_8"] += 1
            two_sq = legendre(2, p) == 1
            if legendre(2, q) != legendre(2, p):
                fails["2p_eq_2q"].append((p, q))
            h = hidden_bit(p, q)
            # T1(iv): rule for h
            if h != h_from_psi(N, eps, psi_exp(p)) or h != h_from_psi(N, eps, psi_exp(q)):
                fails["T1_iv_rule"].append((p, q))
            # public key and the determination tests
            key = (N % 128, eps, int(two_sq))
            groups_pub[key].add(s % 128)
            groups_pub_psi[key + (psi_exp(p),)].add(s % 128)  # T1(iii): (N mod 128, eps, psi(p)) determines s mod 128
            same_psi = psi_exp(p) == psi_exp(q)
            if same_psi != (p % 16 == q % 16):
                fails["psi_equal_iff_p_eq_q_mod16"].append((p, q))
            amb_cells[(N % 16, int(two_sq), same_psi)] += 1
            # T2: s mod 2^k function of (N mod 2^k, p mod 2^(k-3))
            for k in groups_T2:
                groups_T2[k][(N % (1 << k), p % (1 << (k - 3)))].add(s % (1 << k))
                groups_T2[k][(N % (1 << k), q % (1 << (k - 3)))].add(s % (1 << k))
    def amb(groups):
        return sum(1 for vals in groups.values() if len(vals) > 1)
    # predicted ambiguity: undetermined iff psi(p) = psi(q).  Check against the actual table of keys.
    pub_amb_keys = {k for k, vals in groups_pub.items() if len(vals) > 1}
    return {
        "bound": bound,
        "counts": dict(counts),
        "failures": {k: {"n": len(v), "first": v[:5]} for k, v in fails.items()},
        "checks": ["index_bookkeeping", "T1_i", "T1_ii", "s128_from_formula", "2p_eq_2q", "T1_iv_rule",
                   "psi_equal_iff_p_eq_q_mod16"],
        "T1_iii_keys": len(groups_pub_psi), "T1_iii_ambiguous_keys": amb(groups_pub_psi),
        "pub_keys": len(groups_pub), "pub_ambiguous_keys": len(pub_amb_keys),
        "T1_v_N5mod8_by_psi": {"keys": len(groups_n5_psi), "ambiguous_keys": amb(groups_n5_psi)},
        "T1_v_N5mod8_by_omega": {"keys": len(groups_n5_omega), "ambiguous_keys": amb(groups_n5_omega)},
        "T2": {k: {"keys": len(g), "ambiguous_keys": amb(g)} for k, g in groups_T2.items()},
        "cells_N16_twoSq_samePsi": {f"N%16={k[0]},QR2={k[1]},psi_p==psi_q={k[2]}": n
                                    for k, n in sorted(amb_cells.items())},
        "seconds": round(time.time() - t0, 2),
    }


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--bound", type=int, default=2000)
    ap.add_argument("--out", default=None)
    args = ap.parse_args()
    res = run(args.bound)
    if args.out:
        with open(args.out, "w") as fh:
            json.dump(res, fh, sort_keys=True, indent=1)
            fh.write("\n")
    print(json.dumps(res, indent=1, sort_keys=True))


if __name__ == "__main__":
    main()
"""Exact 2-Sylow structure of Cl(D), D < 0, D = 0, 1 (mod 4), primitive positive definite forms.  DIAGNOSTIC.

Method (no GRH, no analytic shortcuts):
  1. enumerate ALL reduced primitive forms (a, b, c) of discriminant D (numpy-vectorized over b for each a);
     h = their number (= |Cl(D)| for the form class group of the order of discriminant D);
  2. write h = 2^e m with m odd.  The map x -> x^m sends Cl(D) onto its 2-Sylow subgroup S (|S| = 2^e);
  3. draw uniformly random reduced forms f (seeded), adjoin f^m to a subgroup T <= S built by closure, until
     |T| = 2^e (then T = S; the stopping test is exact, so the result is exact whatever the random draws);
  4. count |S[2^j]| for all j and return the 2^j-ranks r_{2^j} = log2|S[2^j]| - log2|S[2^(j-1)]|.
Composition and reduction are copied from src/repair/verify_r4.py (imported, not edited); this module is validated
against that brute-force code in tests/test_tower.py.
"""
from __future__ import annotations

import random
from math import isqrt
from typing import Dict, List, Tuple

import numpy as np

from src.repair.verify_r4 import compose, identity_form, reduce_form

Form = Tuple[int, int, int]


def reduced_forms_np(D: int) -> np.ndarray:
    """All reduced primitive forms of discriminant D < 0 as an (h, 3) int64 array.

    Reduced: |b| <= a <= c, and b >= 0 if |b| = a or a = c.  Same set as verify_r4.reduced_forms."""
    assert D < 0 and D % 4 in (0, 1)
    assert -D < 2 ** 40
    out = []
    amax = isqrt(-D // 3)
    par = D % 2
    for a in range(1, amax + 1):
        # b in (-a, a], b = D (mod 2)
        lo = -a + 1
        if (lo - par) % 2:
            lo += 1
        b = np.arange(lo, a + 1, 2, dtype=np.int64)
        t = b * b - D
        m = t % (4 * a) == 0
        if not m.any():
            continue
        b = b[m]
        c = t[m] // (4 * a)
        keep = c >= a
        keep &= ~((c == a) & (b < 0))
        b, c = b[keep], c[keep]
        if b.size == 0:
            continue
        g = np.gcd(np.gcd(np.int64(a), np.abs(b)), c)
        keep = g == 1
        b, c = b[keep], c[keep]
        if b.size:
            out.append(np.stack([np.full(b.size, a, dtype=np.int64), b, c], axis=1))
    return np.concatenate(out) if out else np.zeros((0, 3), dtype=np.int64)


def form_pow(f: Form, n: int, one: Form) -> Form:
    r, x = one, f
    while n:
        if n & 1:
            r = compose(r, x)
        n >>= 1
        if n:
            x = compose(x, x)
    return r


def two_sylow(D: int, seed: int = 0, max_draws: int = 10000, return_elems: bool = False) -> Dict[str, object]:
    """Exact 2-Sylow data of Cl(D): h, e = v2(h), counts |S[2^j]|, ranks r_{2^j} (j = 1..), abelian type.
    With return_elems, also the 2-Sylow subgroup itself as a set of reduced forms (key "elems")."""
    forms = reduced_forms_np(D)
    h = int(forms.shape[0])
    e = (h & -h).bit_length() - 1
    m = h >> e
    one = identity_form(D)
    T = {one}
    rng = random.Random(f"tower128|{D}|{seed}")
    draws = 0
    while len(T) < (1 << e):
        draws += 1
        if draws > max_draws:
            raise RuntimeError(f"2-Sylow closure did not finish for D={D}")
        a, b, c = (int(x) for x in forms[rng.randrange(h)])
        g = form_pow((a, b, c), m, one)
        if g in T:
            continue
        # closure: T <- T * <g>, with g^k the first power landing in T
        powers = [one]
        x = g
        while x not in T:
            powers.append(x)
            x = compose(x, g)
        T = {compose(t, y) for t in T for y in powers}
    # orders in S
    counts = []  # counts[j] = |S[2^j]|, j = 0..e
    elems = list(T)
    order_exp = {}
    for x in elems:
        k, y = 0, x
        while y != one:
            y = compose(y, y)
            k += 1
        order_exp[x] = k
    for j in range(0, e + 1):
        counts.append(sum(1 for x in elems if order_exp[x] <= j))
    logs = [c.bit_length() - 1 for c in counts]
    assert all(c == 1 << l for c, l in zip(counts, logs))
    ranks = [logs[j] - logs[j - 1] for j in range(1, e + 1)]  # ranks[0] = r2, ranks[1] = r4, ...
    # abelian type: number of cyclic factors of order exactly 2^j is r_{2^j} - r_{2^(j+1)}
    typ = []
    for j in range(len(ranks)):
        nxt = ranks[j + 1] if j + 1 < len(ranks) else 0
        typ += [1 << (j + 1)] * (ranks[j] - nxt)
    res = {"D": D, "h": h, "e": e, "counts": counts, "ranks": ranks, "type": sorted(typ, reverse=True),
           "draws": draws}
    if return_elems:
        res["elems"] = T
    return res


def rank(info: Dict[str, object], j: int) -> int:
    """r_{2^j} (j = 1: 2-rank, 2: 4-rank, 3: 8-rank, 4: 16-rank)."""
    rk = info["ranks"]
    return rk[j - 1] if j - 1 < len(rk) else 0
"""Part 3 checks: residue symbols, Redei-symbol identities, and the quartic-reciprocity question.  DIAGNOSTIC.

S1  classical identity, p = 1 (mod 8):  (-4/p)_8 = (2/p)_4 * psi(p),  psi(p) = (-1)^((p-1)/8).
    (Frobenius of sqrt(1+i) = 2^(1/4) zeta_16 over Q(zeta_8); this is [-1,2,p] = [-1,2,p] in Stevenhagen's notation.)
S2  single-prime prototypes of the Redei computation in notes/tower_results.md section 3 (Stevenhagen Thm 4.1 +
    linearity Thm 7.9 + Def 7.1), checked against the brute-force class groups of src.tower.classgroup:
      p = 1 (mod 8):  r8 Cl(-4p) = [(-4/p)_8 = 1]           (Stevenhagen eq. (28), Barrucand-Cohn)
                      r8 Cl(-8p) = [(2/p)_4 = 1]            (R8 = [p,-8,2] = [p,-1,2] + [p,2,2] = (2/p)_4)
      p = 7 (mod 8):  r8 Cl(-8p) = [p = 15 (mod 16)]       (R8 = [-p,8,2] = [-p,2,2] = psi_2(-p))
    and, for p = 1 (mod 8), [T in Cl(-4p)^4] XOR [T' in Cl(-8p)^4] = [p = 9 (mod 16)] (the prototype of T3/T4).
S3  quartic reciprocity question: for pairs with p = q = 1 (mod 8), (p/q) = 1, p = q (mod 16), is the hidden bit
    h = [psi(p) = -1] related to (p/q)_4 (q/p)_4, (2/p)_4 (2/q)_4, (-4/p)_8 (-4/q)_8 ?  Contingency tables.

Run:  .venv/bin/python -m src.tower.symbols --bound 2000 --out experiments/raw/tower128_symbols.json
"""
from __future__ import annotations

import argparse
import json
import time
from collections import Counter, defaultdict
from typing import Dict

from src.repair.verify_r4 import legendre, odd_primes_below
from src.tower.classgroup import two_sylow, rank
from src.tower.run_tower import ambiguous_prime_form, depth_info


def power_symbol(a: int, p: int, k: int) -> int:
    """(a/p)_k = a^((p-1)/k) mod p in {+1, -1}, for k | p - 1 and a a (k/2)-th power residue mod p.  Asserts +-1."""
    assert (p - 1) % k == 0
    t = pow(a % p, (p - 1) // k, p)
    assert t in (1, p - 1), (a, p, k, t)
    return 1 if t == 1 else -1


def psi_pm(p: int) -> int:
    """psi(p) for p = +-1 (mod 8), as +-1: +1 iff p = +-1 (mod 16)."""
    return 1 if p % 16 in (1, 15) else -1


def s2_single(p: int) -> Dict[str, object]:
    out: Dict[str, object] = {"p": p}
    if p % 8 == 1:
        S4 = two_sylow(-4 * p, return_elems=True)
        S8 = two_sylow(-8 * p, return_elems=True)
        out["r8_-4p"], out["r8_-8p"] = rank(S4, 3), rank(S8, 3)
        out["ok_-4p"] = (rank(S4, 3) == 1) == (power_symbol(-4, p, 8) == 1)
        out["ok_-8p"] = (rank(S8, 3) == 1) == (power_symbol(2, p, 4) == 1)
        z4 = depth_info(-4 * p, ambiguous_prime_form(-4 * p, 2), S4)["depth"] >= 2
        z8 = depth_info(-8 * p, ambiguous_prime_form(-8 * p, 2), S8)["depth"] >= 2
        out["ok_depth_xor"] = (z4 ^ z8) == (p % 16 == 9)
    elif p % 8 == 7:
        S8 = two_sylow(-8 * p)
        out["r8_-8p"] = rank(S8, 3)
        out["ok_-8p_7mod8"] = (rank(S8, 3) == 1) == (p % 16 == 15)
    return out


def run(bound: int = 2000, single_bound: int = 20000) -> Dict[str, object]:
    t0 = time.time()
    res: Dict[str, object] = {"bound": bound, "single_bound": single_bound}
    P1 = [p for p in odd_primes_below(single_bound) if p % 8 == 1]
    res["S1_checked"] = len(P1)
    res["S1_fail"] = [p for p in P1 if power_symbol(-4, p, 8) != power_symbol(2, p, 4) * psi_pm(p)]
    singles = [s2_single(p) for p in odd_primes_below(single_bound) if p % 8 in (1, 7)]
    s2 = {}
    for key in ("ok_-4p", "ok_-8p", "ok_depth_xor", "ok_-8p_7mod8"):
        vals = [r[key] for r in singles if key in r]
        s2[key] = {"checked": len(vals), "fail": sum(not v for v in vals),
                   "first_fail": [r["p"] for r in singles if key in r and not r[key]][:5]}
    res["S2"] = s2
    # S3
    tabs: Dict[str, Counter] = defaultdict(Counter)
    P = odd_primes_below(bound)
    n = 0
    for i, p in enumerate(P):
        if p % 8 != 1:
            continue
        for q in P[i + 1:]:
            if q % 8 != 1 or p % 16 != q % 16 or legendre(p, q) != 1:
                continue
            n += 1
            h = int(p % 16 == 9)
            cell = (p * q) % 128
            tabs["(p/q)_4(q/p)_4"][(cell, power_symbol(p, q, 4) * power_symbol(q, p, 4), h)] += 1
            tabs["(2/p)_4(2/q)_4"][(cell, power_symbol(2, p, 4) * power_symbol(2, q, 4), h)] += 1
            tabs["(-4/p)_8(-4/q)_8"][(cell, power_symbol(-4, p, 8) * power_symbol(-4, q, 8), h)] += 1
            tabs["(p/q)_4"][(cell, power_symbol(p, q, 4), h)] += 1
    from math import log2

    def cmi(tab: Counter) -> float:
        tot = sum(tab.values())
        c_, cx, ch = Counter(), Counter(), Counter()
        for (c, x, h), k in tab.items():
            c_[c] += k
            cx[(c, x)] += k
            ch[(c, h)] += k
        return sum(k * log2(k * c_[c] / (cx[(c, x)] * ch[(c, h)])) for (c, x, h), k in tab.items()) / tot

    def deterministic(tab: Counter) -> bool:
        seen = defaultdict(set)
        for (c, x, h) in tab:
            seen[(c, x)].add(h)
        return all(len(v) == 1 for v in seen.values())

    import random

    def cmi_null(tab: Counter, nperm: int = 200) -> float:
        rows = [(c, x, h) for (c, x, h), k in tab.items() for _ in range(k)]
        rng = random.Random("tower128-S3")
        by = defaultdict(list)
        for c, x, h in rows:
            by[c].append((x, h))
        vals = []
        for _ in range(nperm):
            t = Counter()
            for c, lst in by.items():
                xs = [x for x, _ in lst]
                rng.shuffle(xs)
                for x, (_, h) in zip(xs, lst):
                    t[(c, x, h)] += 1
            vals.append(cmi(t))
        vals.sort()
        return {"mean": round(sum(vals) / len(vals), 5), "p95": round(vals[int(0.95 * (len(vals) - 1))], 5)}

    res["S3_pairs"] = n
    res["S3"] = {k: {"cmi_bits_given_N_mod_128": round(cmi(t), 5), "h_function_of_it": deterministic(t),
                     "null": cmi_null(t),
                     "table_(x,h)": {f"{x},{h}": sum(v for (c, xx, hh), v in t.items() if xx == x and hh == h)
                                     for x in (1, -1) for h in (0, 1)}}
                 for k, t in tabs.items()}
    res["seconds"] = round(time.time() - t0, 1)
    return res


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--bound", type=int, default=2000)
    ap.add_argument("--single_bound", type=int, default=20000)
    ap.add_argument("--out", default=None)
    args = ap.parse_args()
    res = run(args.bound, args.single_bound)
    if args.out:
        with open(args.out, "w") as fh:
            json.dump(res, fh, sort_keys=True, indent=1)
            fh.write("\n")
    print(json.dumps(res, indent=1, sort_keys=True))


if __name__ == "__main__":
    main()

