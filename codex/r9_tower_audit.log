"""Part 2: extended class-group key for every pair p < q < bound with N = pq = 1 (mod 8).  DIAGNOSTIC.

For each pair and each public discriminant D in DISCS (all negative, all = 0,1 mod 4, primitive forms):
  * the exact 2-Sylow type of Cl(D) (hence r2, r4, r8, r16, ...), via src.tower.classgroup.two_sylow;
  * for each public prime l | D/N (l in {2, 3, 5, 7}) whose ambiguous form (l, b, c) is primitive: its 2-depth,
    the largest j with [form] in Cl(D)^(2^j) (capped at e = v2(h)), and its order (1 or 2).
Pairs with p <= 7 are excluded so that gcd(k, N) = 1 for every multiplier k.  Discriminants -N, -2N, -5N, -6N are
not = 0,1 (mod 4) when N = 1 (mod 8) and are skipped (as are their -4kN counterparts' duplicates).

Run:  .venv/bin/python -m src.tower.run_tower --bound 2000 --workers 20 --out experiments/raw/tower128_invariants.jsonl
      gzip -9 experiments/raw/tower128_invariants.jsonl
Config: experiments/configs/tower128.json
"""
from __future__ import annotations

import argparse
import json
import time
from math import gcd
from multiprocessing import Pool
from typing import Dict, List, Optional, Tuple

from src.repair.verify_r4 import compose, identity_form, odd_primes_below, reduce_form
from src.tower.classgroup import two_sylow
from src.tower.formula import hidden_bit, omega_exp, psi_exp

DISCS: Dict[str, Tuple[int, Tuple[int, ...]]] = {
    # name: (multiplier k with D = -k N, public primes dividing k)
    "-4N": (4, (2,)), "-8N": (8, (2,)), "-12N": (12, (2, 3)), "-20N": (20, (2, 5)),
    "-24N": (24, (2, 3)), "-28N": (28, (2, 7)), "-3N": (3, (3,)), "-7N": (7, (7,)),
}


def ambiguous_prime_form(D: int, l: int) -> Optional[Tuple[int, int, int]]:
    """The form (l, b, c) of discriminant D with l | b (ramified prime l | D), if primitive; else None."""
    for b in range(0, 2 * l):
        if (b - D) % 2 == 0 and (b * b - D) % (4 * l) == 0 and b % l == 0:
            c = (b * b - D) // (4 * l)
            if gcd(gcd(l, b), c) == 1:
                return reduce_form((l, b, c))
    return None


def depth_info(D: int, x: Tuple[int, int, int], syl: Dict[str, object]) -> Dict[str, int]:
    """2-depth of a class x of order <= 2: max j <= e with x in Cl^(2^j).  Uses the 2-Sylow S (x lies in S)."""
    one = identity_form(D)
    if x == one:
        return {"order": 1, "depth": syl["e"]}
    S = syl["elems"]
    j, layer = 0, S
    while True:
        nxt = {compose(y, y) for y in layer}
        if x not in nxt:
            return {"order": 2, "depth": j}
        j += 1
        layer = nxt


def invariants(pq: Tuple[int, int]) -> Dict[str, object]:
    p, q = pq
    N = p * q
    eps = 1 if p % 4 == 1 else -1
    rec: Dict[str, object] = {
        "p": p, "q": q, "N": N, "eps": eps, "QR2": int(pow(2, (p - 1) // 2, p) == 1),  # (2/p) = (2/q) = +1
        "N_mod_128": N % 128, "h_bit": hidden_bit(p, q), "s_mod_128": (p + q) % 128,
        "psi_p": psi_exp(p), "psi_q": psi_exp(q), "omega_p": omega_exp(p), "omega_q": omega_exp(q),
    }
    cg = {}
    for name, (k, ls) in DISCS.items():
        D = -k * N
        syl = two_sylow(D, seed=0, return_elems=True)
        d = {"h": syl["h"], "ranks": syl["ranks"], "type": syl["type"]}
        for l in ls:
            x = ambiguous_prime_form(D, l)
            if x is not None:
                di = depth_info(D, x, syl)
                d[f"amb{l}"] = di
        cg[name] = d
    rec["cg"] = cg
    return rec


def pairs(bound: int, pmin: int = 11) -> List[Tuple[int, int]]:
    P = [p for p in odd_primes_below(bound) if p >= pmin]
    return [(p, q) for i, p in enumerate(P) for q in P[i + 1:] if (p * q) % 8 == 1]


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--bound", type=int, default=2000)
    ap.add_argument("--workers", type=int, default=20)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()
    t0 = time.time()
    todo = pairs(args.bound)
    todo.sort(key=lambda t: -t[0] * t[1])  # big first for load balance
    with Pool(args.workers) as pool, open(args.out, "w") as fh:
        for i, rec in enumerate(pool.imap_unordered(invariants, todo, chunksize=8)):
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
            if (i + 1) % 1000 == 0:
                print(f"{i + 1}/{len(todo)}  {time.time() - t0:.0f}s", flush=True)
    print(json.dumps({"bound": args.bound, "pairs": len(todo), "seconds": round(time.time() - t0, 1)}))


if __name__ == "__main__":
    main()
"""Part 2 analysis: ambiguity tables and conditional mutual information with the hidden bit.  DIAGNOSTIC.

Input: JSONL from src.tower.run_tower.  Public key K0 = (N mod 128, eps, QR_2).  Hidden bit h (s mod 128 <=> h | K0).

* ambiguity(key): number of distinct key values, how many are ambiguous (two pairs, same key, different s mod 128),
  and how many pairs lie in ambiguous keys -- same convention as src/repair/verify_r5.py.
* cmi(X): plug-in I(h; X | K0) in bits, over all pairs.  Null: permute X within each K0 cell (seeded), 200 times;
  report the null mean and 99th percentile.  "excess" = observed - null mean.  Also the fraction of pairs in
  K0-ambiguous cells whose extended key (K0, X) is h-pure ("decided").

Run:  .venv/bin/python -m src.tower.analyze --inp experiments/raw/tower128_invariants.jsonl.gz \
          --out experiments/analysis/tower128_tables.json
"""
from __future__ import annotations

import argparse
import gzip
import json
import random
from collections import Counter, defaultdict
from math import log2
from typing import Callable, Dict, List

DISC_NAMES = ["-4N", "-8N", "-12N", "-20N", "-24N", "-28N", "-3N", "-7N"]


def load(path: str) -> List[dict]:
    """Read the JSONL written by run_tower (plain or gzip-compressed, by extension)."""
    opener = gzip.open if path.endswith(".gz") else open
    with opener(path, "rt") as fh:
        return [json.loads(line) for line in fh]


def K0(r: dict) -> tuple:
    return (r["N_mod_128"], r["eps"], r["QR2"])


def rk(r: dict, D: str, j: int) -> int:
    ranks = r["cg"][D]["ranks"]
    return ranks[j - 1] if j - 1 < len(ranks) else 0


def invariant_extractors() -> Dict[str, Callable[[dict], object]]:
    ex: Dict[str, Callable[[dict], object]] = {}
    for D in DISC_NAMES:
        for j, nm in ((2, "r4"), (3, "r8"), (4, "r16"), (5, "r32")):
            ex[f"{D}:{nm}"] = (lambda D, j: lambda r: rk(r, D, j))(D, j)
        ex[f"{D}:(r4,r8,r16)"] = (lambda D: lambda r: (rk(r, D, 2), rk(r, D, 3), rk(r, D, 4)))(D)
        ex[f"{D}:type"] = (lambda D: lambda r: tuple(r["cg"][D]["type"]))(D)
        ex[f"{D}:v2(h)"] = (lambda D: lambda r: len(r["cg"][D]["ranks"]) and sum(r["cg"][D]["ranks"]))(D)
        for l in (2, 3, 5, 7):
            ex[f"{D}:depth(amb{l})"] = (lambda D, l: lambda r: (r["cg"][D].get(f"amb{l}") or {}).get("depth"))(D, l)
    return ex


def ambiguity(recs: List[dict], keyf: Callable[[dict], tuple]) -> Dict[str, int]:
    groups = defaultdict(set)
    for r in recs:
        groups[keyf(r)].add(r["s_mod_128"])
    amb = {k for k, v in groups.items() if len(v) > 1}
    return {"keys": len(groups), "ambiguous_keys": len(amb),
            "pairs_in_ambiguous_keys": sum(1 for r in recs if keyf(r) in amb), "pairs": len(recs)}


def _cmi(hs: List[int], xs: list, cells: List[tuple]) -> float:
    n = len(hs)
    cnt_cxh = Counter(zip(cells, xs, hs))
    cnt_cx = Counter(zip(cells, xs))
    cnt_ch = Counter(zip(cells, hs))
    cnt_c = Counter(cells)
    tot = 0.0
    for (c, x, h), k in cnt_cxh.items():
        tot += k * log2(k * cnt_c[c] / (cnt_cx[(c, x)] * cnt_ch[(c, h)]))
    return tot / n


def cmi_with_null(recs: List[dict], f: Callable[[dict], object], nperm: int = 200, seed: str = "tower128-perm"):
    hs = [r["h_bit"] for r in recs]
    cells = [K0(r) for r in recs]
    xs = [f(r) for r in recs]
    obs = _cmi(hs, xs, cells)
    rng = random.Random(seed)
    idx_by_cell = defaultdict(list)
    for i, c in enumerate(cells):
        idx_by_cell[c].append(i)
    null = []
    for _ in range(nperm):
        xp = list(xs)
        for idx in idx_by_cell.values():
            vals = [xs[i] for i in idx]
            rng.shuffle(vals)
            for i, v in zip(idx, vals):
                xp[i] = v
        null.append(_cmi(hs, xp, cells))
    null.sort()
    # fraction of K0-ambiguous pairs decided by (K0, X)
    hk = defaultdict(set)
    for c, x, h in zip(cells, xs, hs):
        hk[(c, x)].add(h)
    amb_cells = {c for c in set(cells) if len({h for cc, h in zip(cells, hs) if cc == c}) > 1}
    in_amb = [i for i, c in enumerate(cells) if c in amb_cells]
    decided = sum(1 for i in in_amb if len(hk[(cells[i], xs[i])]) == 1)
    return {"cmi_bits": round(obs, 6), "null_mean": round(sum(null) / len(null), 6),
            "null_p99": round(null[int(0.99 * (len(null) - 1))], 6), "excess": round(obs - sum(null) / len(null), 6),
            "n_values": len(set(xs)), "decided_frac_of_ambiguous": round(decided / max(1, len(in_amb)), 4)}


def cond_entropy_h(recs: List[dict]) -> float:
    cells = Counter(K0(r) for r in recs)
    ch = Counter((K0(r), r["h_bit"]) for r in recs)
    n = len(recs)
    return -sum(k / n * log2(k / cells[c]) for (c, h), k in ch.items())


def depth2(r: dict, D: str) -> int:
    """2-depth of the ramified prime above 2 (T_4 = (2,2,(N+1)/2) for -4N, T_8 = (2,0,N) for -8N), capped at 2."""
    return min(r["cg"][D]["amb2"]["depth"], 2)


def r_prime(r: dict) -> int:
    """For p = q = 3 (mod 4): the prime r in {p, q} with (other / r) = +1 (exactly one exists)."""
    p, q = r["p"], r["q"]
    return p if pow(q, (p - 1) // 2, p) == 1 else q


def depth_rule(recs: List[dict]) -> Dict[str, object]:
    """Theorems T3/T4 of notes/tower_results.md, checked on every pair with QR_2 true (p = q = +-1 mod 8).

    T3 (eps = -1):  [T_4 in C^4] XOR [T_8 in C^4] = [r = 7 (mod 16)]  (r as in r_prime), hence = h when p = q (16).
    T4 (eps = +1, (p/q) = 1):  with z4 = [T_4 in C^4], z8 = [T_8 in C^4] and p = q (mod 16):
        (z4, z8) = (1, 1) -> h = 0;  (1, 0) or (0, 1) -> h = 1;  (0, 0) -> undetermined.
    T4' (eps = +1, (p/q) = -1):  z4 = z8 XOR [psi(N) = -1]  (public), so the depths carry nothing about h."""
    out = {"T3_checked": 0, "T3_fail": 0, "T3_ambiguous_pairs": 0, "T3_ambiguous_fail": 0,
           "T4_checked": 0, "T4_fail": 0, "T4_decided": 0, "T4_undecided_h": Counter(),
           "T4p_checked": 0, "T4p_fail": 0, "T3_rank_form_fail": 0, "C3_s128_fail": 0,
           "T4_r4_is_2_fail": 0, "C4_s128_fail": 0}
    for r in recs:
        if r["QR2"] != 1:
            continue
        z4, z8 = int(depth2(r, "-4N") >= 2), int(depth2(r, "-8N") >= 2)
        if r["eps"] == -1:
            out["T3_checked"] += 1
            # rank form: r4 = 1 for both, r8 = [T in C^4], and Corollary C3 for s mod 128
            r8a, r8b = rk(r, "-4N", 3), rk(r, "-8N", 3)
            if rk(r, "-4N", 2) != 1 or rk(r, "-8N", 2) != 1 or r8a != z4 or r8b != z8:
                out["T3_rank_form_fail"] += 1
            pred = (-(r["N"] + 1) + 64 * int(r["N"] % 16 == 1) * (r8a ^ r8b)) % 128
            out["C3_s128_fail"] += int(pred != r["s_mod_128"])
            if z4 ^ z8 != int(r_prime(r) % 16 == 7):
                out["T3_fail"] += 1
            if r["psi_p"] == r["psi_q"]:
                out["T3_ambiguous_pairs"] += 1
                out["T3_ambiguous_fail"] += int(z4 ^ z8 != r["h_bit"])
            continue
        p, q = r["p"], r["q"]
        lam = pow(q, (p - 1) // 2, p) == 1
        if not lam:
            out["T4p_checked"] += 1
            out["T4p_fail"] += int(z4 != z8 ^ int(r["N"] % 16 == 9))
            continue
        if r["psi_p"] != r["psi_q"]:
            continue
        out["T4_checked"] += 1
        out["T4_r4_is_2_fail"] += int(rk(r, "-4N", 2) != 2 or rk(r, "-8N", 2) != 2)
        if (z4, z8) == (0, 0):
            out["T4_undecided_h"][r["h_bit"]] += 1
            continue
        out["T4_decided"] += 1
        pred = 0 if (z4, z8) == (1, 1) else 1
        out["T4_fail"] += int(pred != r["h_bit"])
        # Corollary C4: s = (N + 1) + 64 h (mod 128) in this cell (N = 1 mod 16, eps = +1, 2 a square)
        out["C4_s128_fail"] += int((r["N"] + 1 + 64 * pred) % 128 != r["s_mod_128"])
    out["T4_undecided_h"] = dict(out["T4_undecided_h"])
    return out


def ambiguity_by_cell(recs: List[dict], keyf: Callable[[dict], tuple], nperm: int = 20,
                      seed: str = "tower128-ambnull") -> Dict[str, object]:
    """Pairs in K0-ambiguous cells that the extended key leaves ambiguous, per (eps, QR2) cell, with a null:
    the extension part of the key is permuted within K0 cells (destroys any link to h, keeps cardinalities)."""
    ext = [keyf(r) for r in recs]
    cells = [K0(r) for r in recs]
    hs = [r["h_bit"] for r in recs]

    def count(ext_list):
        g = defaultdict(set)
        for c, x, h in zip(cells, ext_list, hs):
            g[(c, x)].add(h)
        res = Counter()
        for r, c, x in zip(recs, cells, ext_list):
            if len(g[(c, x)]) > 1:
                res[(r["eps"], r["QR2"])] += 1
        return res

    obs = count(ext)
    rng = random.Random(seed)
    idx_by_cell = defaultdict(list)
    for i, c in enumerate(cells):
        idx_by_cell[c].append(i)
    nulls = []
    for _ in range(nperm):
        xp = list(ext)
        for idx in idx_by_cell.values():
            vals = [ext[i] for i in idx]
            rng.shuffle(vals)
            for i, v in zip(idx, vals):
                xp[i] = v
        nulls.append(count(xp))
    amb0 = count([()] * len(recs))
    out = {}
    for cell in sorted(set(amb0) | set(obs)):
        nv = sorted(n[cell] for n in nulls)
        out[f"eps={cell[0]},QR2={cell[1]}"] = {
            "K0_ambiguous_pairs": amb0[cell], "still_ambiguous": obs[cell],
            "null_still_ambiguous_mean": round(sum(nv) / len(nv), 1), "null_min": nv[0]}
    return out


def analyze(recs: List[dict], nperm: int = 200) -> Dict[str, object]:
    ex = invariant_extractors()
    out: Dict[str, object] = {"pairs": len(recs), "H(h|K0)_bits": round(cond_entropy_h(recs), 4)}
    amb = {}
    amb["K0"] = ambiguity(recs, K0)
    amb["K0+r4r8(-4N,-8N)"] = ambiguity(recs, lambda r: K0(r) + tuple(rk(r, D, j) for D in ("-4N", "-8N") for j in (2, 3)))
    for D in DISC_NAMES:
        amb[f"K0+{D}:(r4,r8,r16)"] = ambiguity(recs, lambda r, D=D: K0(r) + (rk(r, D, 2), rk(r, D, 3), rk(r, D, 4)))
    amb["K0+all:(r4,r8,r16)"] = ambiguity(recs, lambda r: K0(r) + tuple(rk(r, D, j) for D in DISC_NAMES for j in (2, 3, 4)))
    amb["K0+all:type"] = ambiguity(recs, lambda r: K0(r) + tuple(tuple(r["cg"][D]["type"]) for D in DISC_NAMES))
    amb["K0+all:type+depths"] = ambiguity(recs, lambda r: K0(r) + tuple(
        (tuple(r["cg"][D]["type"]),) + tuple((r["cg"][D].get(f"amb{l}") or {}).get("depth", -1) for l in (2, 3, 5, 7))
        for D in DISC_NAMES))
    out["ambiguity"] = amb
    out["cmi"] = {name: cmi_with_null(recs, f, nperm) for name, f in ex.items()
                  if len({f(r) for r in recs}) > 1}
    # breakdown of the ambiguous population by (eps, QR2)
    by = {}
    for e in (1, -1):
        for b in (0, 1):
            sub = [r for r in recs if r["eps"] == e and r["QR2"] == b]
            by[f"eps={e},QR2={b}"] = {"pairs": len(sub), "H(h|K0)": round(cond_entropy_h(sub), 4) if sub else None}
    out["cells"] = by
    out["depth_rule"] = depth_rule(recs)
    keysets = {
        "-4N:type": lambda r: (tuple(r["cg"]["-4N"]["type"]),),
        "-8N:type": lambda r: (tuple(r["cg"]["-8N"]["type"]),),
        "(-4N,-8N):(r4,r8)": lambda r: tuple(rk(r, D, j) for D in ("-4N", "-8N") for j in (2, 3)),
        "(-4N,-8N):(r4,r8,r16)": lambda r: tuple(rk(r, D, j) for D in ("-4N", "-8N") for j in (2, 3, 4)),
        "(-4N,-8N):depth(T)": lambda r: (depth2(r, "-4N"), depth2(r, "-8N")),
        "(-4N,-8N):(r4,depth(T))": lambda r: (rk(r, "-4N", 2), rk(r, "-8N", 2), depth2(r, "-4N"), depth2(r, "-8N")),
        "(-4N,-8N):type+depth(T)": lambda r: tuple((tuple(r["cg"][D]["type"]), r["cg"][D]["amb2"]["depth"])
                                                   for D in ("-4N", "-8N")),
        "all:(r4,r8,r16)": lambda r: tuple(rk(r, D, j) for D in DISC_NAMES for j in (2, 3, 4)),
        "all:type+depths": lambda r: tuple((tuple(r["cg"][D]["type"]),) + tuple(
            (r["cg"][D].get(f"amb{l}") or {}).get("depth", -1) for l in (2, 3, 5, 7)) for D in DISC_NAMES),
        "all-but-(-4N,-8N):type+depths": lambda r: tuple((tuple(r["cg"][D]["type"]),) + tuple(
            (r["cg"][D].get(f"amb{l}") or {}).get("depth", -1) for l in (2, 3, 5, 7)) for D in DISC_NAMES[2:]),
    }
    out["ambiguity_by_cell"] = {nm: ambiguity_by_cell(recs, f) for nm, f in keysets.items()}
    out["same_2sylow"] = {
        "-12N_vs_-3N": sum(r["cg"]["-12N"]["type"] != r["cg"]["-3N"]["type"] for r in recs),
        "-28N_vs_-7N": sum(r["cg"]["-28N"]["type"] != r["cg"]["-7N"]["type"] for r in recs)}
    return out


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--inp", required=True)
    ap.add_argument("--out", default=None)
    ap.add_argument("--nperm", type=int, default=200)
    ap.add_argument("--bound", type=int, default=None, help="restrict to q < bound")
    args = ap.parse_args()
    recs = load(args.inp)
    if args.bound:
        recs = [r for r in recs if r["q"] < args.bound]
    recs.sort(key=lambda r: (r["p"], r["q"]))
    res = analyze(recs, args.nperm)
    if args.out:
        with open(args.out, "w") as fh:
            json.dump(res, fh, sort_keys=True, indent=1)
            fh.write("\n")
    print(json.dumps({k: v for k, v in res.items() if k not in ("cmi", "ambiguity")}, indent=1, sort_keys=True))
    top = sorted(res["cmi"].items(), key=lambda kv: -kv[1]["excess"])[:25]
    for k, v in top:
        print(f"{k:28s} {v}")


if __name__ == "__main__":
    main()
"""Agent `tower128`: what determines s = p + q mod 128 when N = pq = 1 (mod 8)?  (NEXT_STEPS item 2.)

Everything in this package is DIAGNOSTIC / HARNESS code: it knows p and q and checks mathematical claims by
exhaustive enumeration.  Nothing here is operational (rule 2 of notes/AGENT_RULES.md).

Modules
  formula     exact formula for uv mod 8 via 2-adic Dirichlet characters; exhaustive check
  classgroup  exact brute-force 2-Sylow structure of Cl(D) (primitive forms), validated against src/repair
  run_tower   computes the extended key (2-power ranks for 8 public discriminants) for all pairs, JSONL output
  analyze     ambiguity tables and conditional mutual information with the hidden bit
  symbols     quartic / octic residue symbols and Redei-symbol identities used in notes/tower_results.md section 3
"""
"""Exhaustive check of the GPT-6.1-sol round-4 claims (notes/codex_r4_sos_classgroup.md §2–§3).  DIAGNOSTIC.

Everything here knows p and q.  Exact integer arithmetic only (Python ints).

Claims checked, for every pair of distinct odd primes p < q < BOUND:

  R4-1  exact identity      s = eps(N+1) - 16*eps*u*v,  p = eps + 4u, q = eps + 4v   (needs p = q mod 4)
  R4-2  mod-16 table        s mod 16 = eps(N+1) mod 16, i.e. the printed 4x2 table
  R4-3  mod-32 formula      s = eps(N+1) - 16*eps*[(2/p) = -1]*[(2/q) = -1]  (mod 32)
        and, for N = 1 mod 8: (2/p) = (2/q), and s mod 32 is eps(N+1) - 16*eps*[2 is a non-square mod N]
  R4-4  4-rank criterion    for N = 1 mod 8:  2 is a square mod N  <=>  r4 Cl(-8N) > 0 (eps = +1),
                                                                         r4 Cl(-4N) > 0 (eps = -1)

The class groups are computed by brute force: enumerate the reduced primitive positive definite forms of
discriminant D, compose by Dirichlet/Shanks composition, and count elements with x^2 = 1 and x^4 = 1.
For a finite abelian group G, |G[2]| = 2^{r2} and |G[4]| = 2^{r2 + r4}.

Extras (also printed in the r4 note, checked here because they are cheap):
  X1  mod-64 formula for N = 5 mod 8
  X2  the public class T = [(2, 2, (N+1)/2)] is a square in Cl(-4N)  <=>  (2/p) = (2/q) = +1   (p = q mod 4)
  X3  r4 = 2 - rank_F2(M) for the printed genus matrices M_{-4N}, M_{-8N}            (N = 1 mod 8)
  X4  Milovic Prop. 1 as quoted: eps = +1:  r4 Cl(-4N) = 2  <=>  p = q = 1 mod 8 and (p/q) = 1   (N = 1 mod 8)
  X5  r2 Cl(D) = 2 for D in {-4N, -8N} (genus theory sanity check)
  X6  the "wrong" discriminant (Cl(-4N) when eps = +1, Cl(-8N) when eps = -1): how often it agrees

Run:  .venv/bin/python -m src.repair.verify_r4 --bound 300 --out experiments/raw/verify_r4.json
"""
from __future__ import annotations

import argparse
import json
import time
from math import gcd, isqrt
from typing import Dict, List, Tuple

Form = Tuple[int, int, int]


# ---------------------------------------------------------------------------
# elementary number theory
# ---------------------------------------------------------------------------
def odd_primes_below(bound: int) -> List[int]:
    sieve = bytearray([1]) * bound
    sieve[0:2] = b"\x00\x00"
    for i in range(2, isqrt(bound - 1) + 1):
        if sieve[i]:
            sieve[i * i::i] = bytearray(len(sieve[i * i::i]))
    return [i for i in range(3, bound) if sieve[i]]


def legendre(a: int, p: int) -> int:
    """Legendre symbol (a/p) for an odd prime p, by Euler's criterion."""
    t = pow(a % p, (p - 1) // 2, p)
    return -1 if t == p - 1 else t


def kronecker(D: int, n: int) -> int:
    """Kronecker symbol (D/n) for n >= 1 (used only for the analytic class number check)."""
    if n == 1:
        return 1
    res = 1
    while n % 2 == 0:
        n //= 2
        if D % 2 == 0:
            return 0
        res *= 1 if D % 8 in (1, 7) else -1
    # Jacobi symbol (D/n), n odd
    a, m = D % n, n
    while a:
        while a % 2 == 0:
            a //= 2
            if m % 8 in (3, 5):
                res = -res
        a, m = m, a
        if a % 4 == 3 and m % 4 == 3:
            res = -res
        a %= m
    return res if m == 1 else 0


def class_number_analytic(D: int) -> int:
    """h(D) = -(1/|D|) sum_{a=1}^{|D|} (D/a) a, valid for fundamental D < -4.  Independent of the form code."""
    n = -D
    s = sum(kronecker(D, a) * a for a in range(1, n + 1))
    assert s % n == 0
    return -s // n


# ---------------------------------------------------------------------------
# binary quadratic forms (positive definite, discriminant D < 0)
# ---------------------------------------------------------------------------
def _egcd(a: int, b: int) -> Tuple[int, int, int]:
    x0, y0, x1, y1 = 1, 0, 0, 1
    while b:
        k = a // b
        a, b = b, a - k * b
        x0, x1 = x1, x0 - k * x1
        y0, y1 = y1, y0 - k * y1
    return a, x0, y0


def reduce_form(f: Form) -> Form:
    a, b, c = f
    D = b * b - 4 * a * c
    while True:
        # normalize: -a < b <= a
        if not (-a < b <= a):
            k = (a - b) // (2 * a)
            b += 2 * a * k
            c = (b * b - D) // (4 * a)
        if a > c:
            a, b, c = c, -b, a
            continue
        if a == c and b < 0:
            b = -b
        return a, b, c


def compose(f: Form, g: Form) -> Form:
    """Dirichlet composition (Shanks' formula), then reduction."""
    a1, b1, c1 = f
    a2, b2, c2 = g
    D = b1 * b1 - 4 * a1 * c1
    assert b2 * b2 - 4 * a2 * c2 == D
    s = (b1 + b2) // 2
    g1, x1, y1 = _egcd(a1, a2)
    e, x2, w = _egcd(g1, s)
    u, v = x2 * x1, x2 * y1
    a3 = a1 * a2 // (e * e)
    num = u * a1 * b2 + v * a2 * b1 + w * (b1 * b2 + D) // 2
    assert num % e == 0
    b3 = (num // e) % (2 * a3)
    assert (b3 * b3 - D) % (4 * a3) == 0
    c3 = (b3 * b3 - D) // (4 * a3)
    return reduce_form((a3, b3, c3))


def identity_form(D: int) -> Form:
    return (1, 0, -D // 4) if D % 4 == 0 else (1, 1, (1 - D) // 4)


def reduced_forms(D: int) -> List[Form]:
    """All reduced primitive forms (a, b, c): |b| <= a <= c, b >= 0 if |b| = a or a = c."""
    assert D < 0 and D % 4 in (0, 1)
    out = []
    amax = isqrt(-D // 3)
    for a in range(1, amax + 1):
        for b in range(D % 2, a + 1, 2):  # b = D (mod 2)
            t = b * b - D
            if t % (4 * a):
                continue
            c = t // (4 * a)
            if c < a:
                continue
            for bb in ((b,) if (b == 0 or b == a or a == c) else (b, -b)):
                if gcd(gcd(a, abs(bb)), c) == 1:
                    out.append((a, bb, c))
    return out


def two_four_torsion(D: int) -> Dict[str, object]:
    """Brute force: h, |G[2]|, |G[4]|, r2, r4, and the set of squares G^2."""
    forms = reduced_forms(D)
    one = identity_form(D)
    n2 = n4 = 0
    squares = set()
    for f in forms:
        f2 = compose(f, f)
        squares.add(f2)
        if f2 == one:
            n2 += 1
            n4 += 1
        elif compose(f2, f2) == one:
            n4 += 1
    r2 = n2.bit_length() - 1
    r24 = n4.bit_length() - 1
    assert n2 == 1 << r2 and n4 == 1 << r24, (D, n2, n4)
    return {"h": len(forms), "G2": n2, "G4": n4, "r2": r2, "r4": r24 - r2, "squares": squares}


def rank_f2(M: List[List[int]]) -> int:
    rows = [r[:] for r in M]
    rank, ncol = 0, len(rows[0])
    for col in range(ncol):
        piv = next((i for i in range(rank, len(rows)) if rows[i][col] % 2), None)
        if piv is None:
            continue
        rows[rank], rows[piv] = rows[piv], rows[rank]
        for i in range(len(rows)):
            if i != rank and rows[i][col] % 2:
                rows[i] = [(x + y) % 2 for x, y in zip(rows[i], rows[rank])]
        rank += 1
    return rank


# ---------------------------------------------------------------------------
# the checks
# ---------------------------------------------------------------------------
TABLE16 = {1: (2, 14), 5: (6, 10), 9: (10, 6), 13: (14, 2)}  # N mod 16 -> (eps=+1, eps=-1), as printed


def check_pair(p: int, q: int, class_groups: bool = True) -> Dict[str, object]:
    """All checks for one pair p < q with p = q (mod 4).  Returns booleans (True = claim holds)."""
    N, s = p * q, p + q
    assert p % 4 == q % 4
    eps = 1 if p % 4 == 1 else -1
    u, v = (p - eps) // 4, (q - eps) // 4
    bp, bq = legendre(2, p), legendre(2, q)
    two_sq = bp == 1 and bq == 1  # 2 is a square mod N  <=>  square mod p and mod q (CRT)
    rec: Dict[str, object] = {"p": p, "q": q, "N": N, "eps": eps, "N_mod_8": N % 8}

    rec["R4_1_identity"] = s == eps * (N + 1) - 16 * eps * u * v
    rec["R4_2_table16"] = s % 16 == TABLE16[N % 16][0 if eps == 1 else 1] and s % 16 == eps * (N + 1) % 16
    ind = ((1 - bp) // 2) * ((1 - bq) // 2)
    rec["R4_3_mod32_formula"] = s % 32 == (eps * (N + 1) - 16 * eps * ind) % 32
    if N % 8 == 1:
        rec["R4_3_bp_eq_bq"] = bp == bq
        rec["R4_3_bit_is_2_square"] = s % 32 == (eps * (N + 1) - 16 * eps * (0 if two_sq else 1)) % 32
    if N % 8 == 5:
        rec["X1_bp_ne_bq"] = bp != bq
        rec["X1_mod32_no_new_bit"] = s % 32 == eps * (N + 1) % 32
        r = p if bp == 1 else q
        rec["X1_mod64_formula"] = s % 64 == (eps * (N + 1) - 32 * eps * (((r - eps) // 8) % 2)) % 64

    if not class_groups:
        return rec
    # Cl(-4N): always computed (needed for X2); Cl(-8N): computed for N = 1 mod 8.
    G4N = two_four_torsion(-4 * N)
    T = reduce_form((2, 2, (N + 1) // 2))
    rec["X2_T_square_iff_2_square"] = (T in G4N["squares"]) == two_sq
    rec["X5_r2_minus4N"] = G4N["r2"] == 2
    rec["h_minus4N"], rec["r4_minus4N"] = G4N["h"], G4N["r4"]
    if N % 8 == 1:
        G8N = two_four_torsion(-8 * N)
        rec["X5_r2_minus8N"] = G8N["r2"] == 2
        rec["h_minus8N"], rec["r4_minus8N"] = G8N["h"], G8N["r4"]
        sel, other = (G8N, G4N) if eps == 1 else (G4N, G8N)
        rec["R4_4_criterion"] = (sel["r4"] > 0) == two_sq
        rec["X6_wrong_disc_agrees"] = (other["r4"] > 0) == two_sq
        beta = (1 - bp) // 2
        eta = (1 - eps) // 2
        lam = (1 - legendre(p, q)) // 2
        M4 = [[beta, lam + eta], [beta, lam]]
        M8 = [[beta, beta + lam + eta], [beta, lam]]
        rec["X3_matrix_minus4N"] = G4N["r4"] == 2 - rank_f2(M4)
        rec["X3_matrix_minus8N"] = G8N["r4"] == 2 - rank_f2(M8)
        if eps == 1:
            rec["X4_milovic"] = (G4N["r4"] == 2) == (p % 8 == 1 and q % 8 == 1 and legendre(p, q) == 1)
    return rec


def run(bound: int = 300, class_groups: bool = True) -> Dict[str, object]:
    t0 = time.time()
    P = odd_primes_below(bound)
    pairs = [(p, q) for i, p in enumerate(P) for q in P[i + 1:]]
    in_scope = [(p, q) for p, q in pairs if p % 4 == q % 4]
    records = [check_pair(p, q, class_groups) for p, q in in_scope]
    keys = sorted({k for r in records for k, v in r.items() if isinstance(v, bool)})
    summary = {}
    for k in keys:
        vals = [r[k] for r in records if k in r]
        fails = [(r["p"], r["q"]) for r in records if k in r and not r[k]]
        summary[k] = {"checked": len(vals), "hold": sum(vals), "fail": len(vals) - sum(vals), "first_failures": fails[:10]}
    return {
        "bound": bound,
        "odd_primes": len(P),
        "pairs_total": len(pairs),
        "pairs_p_eq_q_mod4": len(in_scope),
        "pairs_N_1_mod_8": sum(1 for r in records if r["N_mod_8"] == 1),
        "pairs_N_5_mod_8": sum(1 for r in records if r["N_mod_8"] == 5),
        "summary": summary,
        "max_h_minus8N": max((r.get("h_minus8N", 0) for r in records), default=0),
        "seconds": round(time.time() - t0, 2),
        "records": records,
    }


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--bound", type=int, default=300)
    ap.add_argument("--out", default=None, help="write the full result (with per-pair records) as JSON")
    args = ap.parse_args()
    res = run(args.bound)
    if args.out:
        with open(args.out, "w") as fh:
            json.dump(res, fh, sort_keys=True)
            fh.write("\n")
    print(json.dumps({k: v for k, v in res.items() if k != "records"}, indent=1, sort_keys=True))


if __name__ == "__main__":
    main()

