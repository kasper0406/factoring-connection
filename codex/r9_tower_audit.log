    71	def two_sylow(D: int, seed: int = 0, max_draws: int = 10000, return_elems: bool = False) -> Dict[str, object]:
    72	    """Exact 2-Sylow data of Cl(D): h, e = v2(h), counts |S[2^j]|, ranks r_{2^j} (j = 1..), abelian type.
    73	    With return_elems, also the 2-Sylow subgroup itself as a set of reduced forms (key "elems")."""
