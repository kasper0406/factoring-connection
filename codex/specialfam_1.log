"""Algorithms B and D: residues from the smooth part of N^2 - 1, then Coppersmith.

OPERATIONAL. Inputs: N and public parameters (smoothness bound B, lower size bound
on the target modulus, a size band for p). Never uses the factors; no primality test.

Algorithm B (Theorem S). Promise: an integer g >= Dmin with P+(g) <= B divides
p^2 - 1 and N^2 - 1 (e.g. g | gcd(p^2-1, q^2-1) for N = pq).
  1. Pollard–Strassen (block products over Z/M) finds every prime <= B dividing
     M = N - 1 and M = N + 1, with multiplicity: H = B-smooth part of N^2 - 1.
  2. For every divisor d | H with d >= Dmin (largest first) and every r mod d with
     r^2 == 1 (mod d): Coppersmith with known residue p == r (mod d), subdividing
     the band into rigorous chunks.
Algorithm D (Corollary W). g = gcd(p-1, q-1) arbitrary (not smooth): dovetail
B = 2^t, budget 2^{t/2} chunks per divisor, residue r = 1 (or all r^2 == 1).
"""
from __future__ import annotations

from itertools import product as iproduct
from math import gcd, isqrt
from typing import Dict, Iterable, List, Optional, Sequence, Tuple

from src.common.metrics import Metrics, NullMetrics
from src.specialfam.copper import best_params, n_chunks, subdivide_search
from src.specialfam.normbox import small_trial
from src.specialfam.polyprod import block_products


def smooth_part_ps(M: int, B: int, mt: Optional[Metrics] = None) -> Dict[int, int]:
    """{ell: v_ell(M)} for every prime ell <= B dividing M, by Pollard–Strassen.

    Block products prod_{j<m}(2 + m v + j) mod M by one remainder tree (polyprod),
    then in-order block gcds; the first x with gcd(x, M_cur) > 1 is the least prime
    factor of M_cur in range, so no primality test is needed. Cost O~(sqrt B).
    """
    mt = mt if mt is not None else NullMetrics()
    M = abs(M)
    out: Dict[int, int] = {}
    if M <= 1 or B < 2:
        return out
    # powers of 2 directly (cheap, and keeps M odd)
    while M % 2 == 0:
        out[2] = out.get(2, 0) + 1
        M //= 2
    if B < 3 or M == 1:
        return out
    lo = 3
    span = B - lo + 1
    m = isqrt(span) + 1
    V = -(-span // m)
    mt.inc("ps_units", m + V)
    if M == 1:
        return out
    vals = block_products(M, list(range(m)), [[lo + m * v, 1] for v in range(V)], mt)
    Mcur = M
    for v, val in enumerate(vals):
        if Mcur == 1:
            break
        mt.inc("gcd")
        if gcd(val % Mcur, Mcur) == 1:
            continue
        for j in range(m):
            x = lo + m * v + j
            if x > B or Mcur == 1:
                break
            mt.inc("gcd")
            if gcd(x, Mcur) > 1:  # x is the least prime factor of Mcur in [lo, B]
                e = 0
                while Mcur % x == 0:
                    Mcur //= x
                    e += 1
                out[x] = out.get(x, 0) + e
                mt.inc("ps_scan", m)
    return out


def merge(a: Dict[int, int], b: Dict[int, int]) -> Dict[int, int]:
    c = dict(a)
    for k, v in b.items():
        c[k] = c.get(k, 0) + v
    return c


def divisors(fac: Dict[int, int]) -> List[Tuple[int, Dict[int, int]]]:
    items = sorted(fac.items())
    out = [(1, {})]
    for ell, e in items:
        nxt = []
        for d, f in out:
            pe = 1
            for k in range(e + 1):
                g = dict(f)
                if k:
                    g[ell] = k
                nxt.append((d * pe, g))
                pe *= ell
        out = nxt
    return out


def unit_roots(fac: Dict[int, int]) -> List[int]:
    """All r mod d (d = prod ell^e) with r^2 == 1 (mod d), by CRT."""
    mods, opts = [], []
    for ell, e in sorted(fac.items()):
        q = ell ** e
        if ell == 2:
            if e == 1:
                o = [1]
            elif e == 2:
                o = [1, 3]
            else:
                o = [1, q - 1, q // 2 - 1, q // 2 + 1]
        else:
            o = [1, q - 1]
        mods.append(q)
        opts.append(o)
    d = 1
    for q in mods:
        d *= q
    res = []
    for combo in iproduct(*opts):
        r = 0
        for q, a in zip(mods, combo):
            Q = d // q
            r = (r + a * Q * pow(Q, -1, q)) % d
        res.append(r)
    return sorted(set(res)) if d > 1 else [0]


def balanced_band(N: int) -> Tuple[int, int]:
    """Smaller factor of a balanced semiprime (q <= 2p): p in [isqrt(N//2), isqrt(N)]."""
    return isqrt(N // 2), isqrt(N)


def smoothcopp_factor(N: int, B: int, Dmin: int, band: Tuple[int, int],
                      Dmax_lat: int = 9, residues: str = "pm",
                      metrics: Optional[Metrics] = None, max_total_chunks: Optional[int] = None) -> Dict:
    """Algorithm B. residues: 'pm' (r^2 == 1, from N^2-1) or 'one' (r = 1, from N-1)."""
    mt = metrics if metrics is not None else NullMetrics()
    t = small_trial(N, mt)
    if t:
        return {"factor": t, "how": "trial"}
    fac = smooth_part_ps(N - 1, B, mt)
    if residues == "pm":
        fac = merge(fac, smooth_part_ps(N + 1, B, mt))
    P_lo, P_hi = band
    params = best_params(N, max(P_lo, 2), Dmax_lat)
    mt.set("lattice", list(params[:2]))
    Y = params[2]
    # Lemma W: g >= Dmin with P+(g) <= B has a divisor in [Dmin, B*Dmin); only those are tried
    divs = [(d, f) for d, f in divisors(fac) if Dmin <= d < Dmin * max(B, 2)]
    divs.sort(key=lambda t: -t[0])
    total = 0
    pairs = 0
    for d, f in divs:
        roots = [1] if residues == "one" else unit_roots(f)
        for r in roots:
            pairs += 1
            left = None if max_total_chunks is None else max_total_chunks - total
            if left is not None and left <= 0:
                return {"factor": None, "chunks": total, "pairs": pairs, "H": fac, "how": "budget"}
            fct, used = subdivide_search(N, d, r, P_lo, P_hi, P_lo, params, mt, max_chunks=left)
            total += used
            if fct:
                mt.inc("chunks", total)
                return {"factor": fct, "d": d, "r": r, "chunks": total, "pairs": pairs,
                        "n_divisors": len(divs), "H": fac, "how": "coppersmith", "Y": Y}
    mt.inc("chunks", total)
    return {"factor": None, "chunks": total, "pairs": pairs, "n_divisors": len(divs), "H": fac}


def common_factor_factor(N: int, band: Tuple[int, int], residues: str = "one",
                         Dmax_lat: int = 9, tmax: Optional[int] = None,
                         metrics: Optional[Metrics] = None) -> Dict:
    """Algorithm D: dovetail over B = 2^t with chunk budget 2^{ceil(t/2)} per divisor.

    Finds p when g = gcd(p-1, q-1) (residues='one') or g | gcd(p^2-1, q^2-1)
    (residues='pm') is large, with cost N^{max(gamma/2, beta(1-beta)-gamma)+o(1)}.
    """
    mt = metrics if metrics is not None else NullMetrics()
    t0 = small_trial(N, mt)
    if t0:
        return {"factor": t0, "how": "trial"}
    P_lo, P_hi = band
    params = best_params(N, max(P_lo, 2), Dmax_lat)
    Y = params[2]
    tried = set()
    total_chunks = 0
    ps_units = 0
    t = 2
    tmax = tmax if tmax is not None else (N.bit_length() // 2 + 2)
    while t <= tmax:
        B = 1 << t
        budget = 1 << ((t + 1) // 2)
        sub = Metrics()
        fac = smooth_part_ps(N - 1, B, sub)
        if residues == "pm":
            fac = merge(fac, smooth_part_ps(N + 1, B, sub))
        ps_units += sub.get("ps_units")
        mt.merge(sub)
        for d, f in sorted(divisors(fac), key=lambda x: -x[0]):
            if d in tried or d < 2:
                continue
            if n_chunks(d, P_lo, P_hi, Y) > budget:
                continue
            tried.add(d)
            roots = [1] if residues == "one" else unit_roots(f)
            for r in roots:
                fct, used = subdivide_search(N, d, r, P_lo, P_hi, P_lo, params, mt)
                total_chunks += used
                if fct:
                    return {"factor": fct, "d": d, "t": t, "chunks": total_chunks,
                            "ps_units": ps_units, "how": "coppersmith"}
        t += 1
    return {"factor": None, "chunks": total_chunks, "ps_units": ps_units}
"""Known-residue Coppersmith / Howgrave-Graham decoder with interval subdivision.

OPERATIONAL. Adapted (copied, rule 7) from src/trackE/coppersmith.py: same lattice
[May 2010, proof of Thm 3, delta = 1], same rigorous sufficient condition, flint LLL
(fpylll is not installed). Integer roots of the reduced polynomial use flint's
fmpz_poly.roots() over Z (standard last step; never touches N).

Task: find a divisor b of N with b = r + d*x, x in [x_lo, x_hi], b >= L (L public).
Write x = xc + y, |y| <= Y. With c = r*d^{-1} + xc (mod N), f(y) = y + c is monic and
f(y0) = d^{-1} b == 0 (mod b). Rigorous condition (Howgrave-Graham + LLL bound):
    2^{D(D-1)} det^4 D^{2D} < L^{4 m D},  det = N^{m(m+1)/2} Y^{D(D-1)/2}.
Subdividing [x_lo, x_hi] into chunks of width 2Y+1 costs ceil(len/(2Y+1)) LLL calls.
"""
from __future__ import annotations

import math
from math import comb, gcd
from typing import List, Optional, Tuple

import flint

from src.common.metrics import Metrics, NullMetrics
from src.common.ring import NonUnit


def rigorous_ok(N: int, L: int, Y: int, D: int, m: int) -> bool:
    det = N ** (m * (m + 1) // 2) * Y ** (D * (D - 1) // 2)
    return (1 << (D * (D - 1))) * det ** 4 * D ** (2 * D) < L ** (4 * m * D)


def max_rigorous_Y(N: int, L: int, D: int, m: int) -> int:
    """Largest Y >= 0 satisfying rigorous_ok (0 if none)."""
    lnN, lnL = math.log2(N), math.log2(L)
    est = (4 * m * D * lnL - D * (D - 1) - 2 * D * math.log2(D) - 2 * m * (m + 1) * lnN) / (2 * D * (D - 1))
    if est < 0:
        return 0 if not rigorous_ok(N, L, 1, D, m) else 1
    Y = max(1, int(2 ** est))
    while Y > 1 and not rigorous_ok(N, L, Y, D, m):
        Y = Y * 15 // 16
    while rigorous_ok(N, L, Y * 17 // 16 + 1, D, m):
        Y = Y * 17 // 16 + 1
    while not rigorous_ok(N, L, Y, D, m) and Y > 0:
        Y -= 1
    return Y


def best_params(N: int, L: int, Dmax: int = 13) -> Tuple[int, int, int]:
    """(D, m, Y) maximising the rigorous Y over D <= Dmax (deterministic choice)."""
    best = (1, 0, 0)
    for D in range(3, Dmax + 1, 2):
        for m in range(max(1, (D - 1) // 2 - 1), min(D, (D - 1) // 2 + 2)):
            Y = max_rigorous_Y(N, L, D, m)
            if Y > best[2]:
                best = (D, m, Y)
    return best


def _basis(N: int, c: int, Y: int, D: int, m: int) -> List[List[int]]:
    fp = [[comb(k, i) * c ** (k - i) for i in range(k + 1)] for k in range(m + 1)]
    Yp = [Y ** j for j in range(D)]
    rows = []
    for i in range(m):
        Ni = N ** (m - i)
        row = [0] * D
        for j, a in enumerate(fp[i]):
            row[j] = Ni * a * Yp[j]
        rows.append(row)
    for j in range(D - m):
        row = [0] * D
        for i2, a in enumerate(fp[m]):
            row[i2 + j] = a * Yp[i2 + j]
        rows.append(row)
    return rows


def decode_chunk(N: int, d: int, r: int, xc: int, Y: int, D: int, m: int,
                 mt: Metrics, n_vectors: int = 2) -> Optional[int]:
    """One lattice call: proper divisor b = r + d*(xc+y), |y| <= Y, or None."""
    g = gcd(d, N)
    if 1 < g < N:
        return g
    dinv = pow(d, -1, N) if d % N != 1 else 1
    c = (r * dinv + xc) % N
    B = _basis(N, c, max(Y, 1), D, m)
    mt.inc("lll_calls")
    red = flint.fmpz_mat(B).lll().tolist()
    Yp = [max(Y, 1) ** j for j in range(D)]
    red.sort(key=lambda v: sum(int(a) * int(a) for a in v))
    for row in red[:n_vectors]:
        coeffs = []
        for j, a in enumerate(row):
            a = int(a)
            coeffs.append(a // Yp[j])
        poly = flint.fmpz_poly(coeffs)
        if poly.degree() < 1:
            continue
        mt.inc("root_calls")
        for y0, _ in poly.roots():
            y0 = int(y0)
            if abs(y0) > Y:
                continue
            b = r + d * (xc + y0)
            mt.inc("gcd")
            h = gcd(b, N)
            if 1 < h < N:
                return h
    return None


def subdivide_search(N: int, d: int, r: int, P_lo: int, P_hi: int, L: int,
                     params: Tuple[int, int, int], mt: Metrics,
                     max_chunks: Optional[int] = None) -> Tuple[Optional[int], int]:
    """Find a divisor b = r + d x of N in [P_lo, P_hi] by chunked Coppersmith calls.

    params = (D, m, Y) rigorous for lower bound L <= every target b. Returns
    (factor or None, chunks used).
    """
    D, m, Y = params
    x_lo = -(-(P_lo - r) // d)
    x_hi = (P_hi - r) // d
    if x_hi < x_lo:
        return None, 0
    width = 2 * Y + 1
    if Y <= 2:  # tiny lattice range: direct enumeration is cheaper
        chunks = 0
        for x in range(x_lo, x_hi + 1):
            chunks += 1
            h = gcd(r + d * x, N)
            mt.inc("gcd")
            if 1 < h < N:
                return h, chunks
        return None, chunks
    nchunks = -(-(x_hi - x_lo + 1) // width)
    used = 0
    for t in range(nchunks):
        if max_chunks is not None and used >= max_chunks:
            break
        xc = x_lo + t * width + Y
        used += 1
        f = decode_chunk(N, d, r, xc, Y, D, m, mt)
        if f:
            return f, used
    return None, used


def n_chunks(d: int, P_lo: int, P_hi: int, Y: int) -> int:
    span = (P_hi - P_lo) // d + 1
    return -(-span // (2 * Y + 1)) if Y > 2 else span
"""HARNESS (knows the factors). Instance generators and hit classification.

Never imported by operational modules (polyprod, normbox, copper, smoothcopp).
Primality testing (gmpy2) is used here only to build instances.
"""
from __future__ import annotations

import random
from fractions import Fraction
from math import gcd, isqrt
from typing import Dict, List, Optional, Tuple

import gmpy2


def _rng(tag: str, seed: int) -> random.Random:
    return random.Random(f"specialfam|{tag}|{seed}")


def is_prime(x: int) -> bool:
    return x > 1 and bool(gmpy2.is_prime(x, 50))


def rand_prime_in(rng: random.Random, lo: int, hi: int) -> int:
    while True:
        x = rng.randrange(lo, hi + 1) | 1
        if lo <= x <= hi and is_prime(x):
            return x


def hl_prime(rng: random.Random, kp: int, eta: Fraction) -> Tuple[int, int, int]:
    """Prime p in (2^{kp-1}, 2^kp] with p = a^2 + b^2, 1 <= b <= p^eta (b uniform)."""
    lo, hi = (1 << (kp - 1)) + 1, 1 << kp
    while True:
        bmax = int(gmpy2.iroot(gmpy2.mpz(lo) ** eta.numerator, eta.denominator)[0])
        b = rng.randint(1, max(1, bmax))
        alo = isqrt(max(lo - b * b, 0))
        ahi = isqrt(hi - b * b)
        a = rng.randint(alo, ahi)
        p = a * a + b * b
        if lo <= p <= hi and is_prime(p) and b ** eta.denominator <= p ** eta.numerator:
            return p, a, b


def normbox_instance(n: int, beta: Fraction, eta: Fraction, seed: int) -> Dict:
    """N = p q, p as in hl_prime with kp = round(beta n), q a random prime with q > p."""
    rng = _rng(f"normbox|{n}|{beta}|{eta}", seed)
    kp = max(8, round(beta * n))
    while True:
        p, a, b = hl_prime(rng, kp, eta)
        kq = n - kp
        if kq < kp:
            continue
        if beta == Fraction(1, 2):
            q = rand_prime_in(rng, p + 1, 2 * p - 1)
        else:
            q = rand_prime_in(rng, 1 << (kq - 1), (1 << kq) - 1)
        N = p * q
        if q != p:
            return {"N": N, "p": p, "q": q, "a": a, "b": b, "kp": kp, "n": N.bit_length()}


def control_instance(n: int, seed: int) -> Dict:
    """Balanced semiprime with no imposed structure (control)."""
    rng = _rng(f"control|{n}", seed)
    kp = n // 2
    p = rand_prime_in(rng, (1 << (kp - 1)) + 1, 1 << kp)
    q = rand_prime_in(rng, p + 1, 2 * p - 1)
    return {"N": p * q, "p": p, "q": q, "n": (p * q).bit_length()}


def sumsq_rep(p: int) -> Optional[Tuple[int, int]]:
    """Harness: (a, b) with a >= b >= 1 and a^2 + b^2 = p (Cornacchia via sympy-free search)."""
    if p % 4 != 1:
        return None
    # find sqrt(-1) mod p by trying bases
    for c in range(2, 200):
        t = pow(c, (p - 1) // 4, p)
        if t * t % p == p - 1:
            break
    else:
        return None
    r0, r1 = p, t
    lim = isqrt(p)
    while r1 > lim:
        r0, r1 = r1, r0 % r1
    a = r1
    b = isqrt(p - a * a)
    if a * a + b * b != p:
        return None
    return (max(a, b), min(a, b))


def smooth_gcd_instance(n: int, g_fac: Dict[int, int], signs_p: str, signs_q: str,
                        seed: int) -> Dict:
    """Balanced N = p q with g | p^2 - 1 and g | q^2 - 1.

    g_fac: {ell: e}. signs_*: string over {'+','-'} per prime (sorted), choosing
    p == +-1 mod ell^e independently (mixed CRT sign patterns).
    """
    rng = _rng(f"smooth|{n}|{sorted(g_fac.items())}|{signs_p}|{signs_q}", seed)
    items = sorted(g_fac.items())
    g = 1
    for ell, e in items:
        g *= ell ** e

    def residue(signs: str) -> int:
        r = 0
        for (ell, e), s in zip(items, signs):
            q = ell ** e
            a = 1 if s == "+" else q - 1
            Q = g // q
            r = (r + a * Q * pow(Q, -1, q)) % g
        return r

    rp, rq = residue(signs_p), residue(signs_q)
    kp = n // 2
    lo, hi = (1 << (kp - 1)) + 1, 1 << kp
    if g > hi // 64:
        raise ValueError("g too large for the size")
    while True:
        p = rng.randrange(lo // g, hi // g + 1) * g + rp
        if lo <= p <= hi and is_prime(p):
            break
    while True:
        q = rng.randrange((p + 1) // g, (2 * p - 1) // g + 1) * g + rq
        if p < q < 2 * p and is_prime(q):
            break
    return {"N": p * q, "p": p, "q": q, "g": g, "n": (p * q).bit_length()}


def common_gcd_instance(n: int, gbits: int, seed: int, pm: str = "++") -> Dict:
    """Balanced N = p q with a prime-ish (not smooth) common factor g of p -+ 1, q -+ 1.

    g = 2 * (random prime of gbits-1 bits). pm: signs for p, q ('+' means == 1 mod g).
    """
    rng = _rng(f"common|{n}|{gbits}|{pm}", seed)
    kp = n // 2
    lo, hi = (1 << (kp - 1)) + 1, 1 << kp
    while True:
        g = 2 * rand_prime_in(rng, 1 << (gbits - 2), (1 << (gbits - 1)) - 1)
        if g < hi // 64:
            break
    rp = 1 if pm[0] == "+" else g - 1
    rq = 1 if pm[1] == "+" else g - 1
    while True:
        p = rng.randrange(lo // g, hi // g + 1) * g + rp
        if lo <= p <= hi and is_prime(p):
            break
    for _ in range(100000):
        q = rng.randrange((p + 1) // g, (2 * p - 1) // g + 1) * g + rq
        if p < q < 2 * p and is_prime(q):
            return {"N": p * q, "p": p, "q": q, "g": g, "n": (p * q).bit_length(),
                    "gcd_pm1": gcd(p - 1, q - 1)}
    raise RuntimeError("no q")


def classify_normbox(inst: Dict, res: Dict, eta: Fraction) -> str:
    """STRUCTURAL-PROMISED if the hit is in the band/block containing the promised (a, b);
    STRUCTURAL-OTHER if another leaf of the box is divisible by the found prime;
    TRIAL for a small-prime trial hit."""
    if res.get("how") == "trial":
        return "TRIAL"
    f = res.get("factor")
    if not f:
        return "FAIL"
    k = res.get("band")
    blk = res.get("block")
    m = res.get("m")
    a, b, p = inst["a"], inst["b"], inst["p"]
    if f in (inst["p"], inst["q"]) and blk is not None and m:
        v, bb = blk
        if f == p and bb == b and v * m <= a < (v + 1) * m:
            return "STRUCTURAL-PROMISED"
    return "STRUCTURAL-OTHER"
