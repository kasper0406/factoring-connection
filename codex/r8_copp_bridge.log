+from fractions import Fraction as Q
+from math import comb, isqrt, log
+import json
+from pathlib import Path
+from fpylll import IntegerMatrix, LLL
+from sympy import Matrix, nextprime
+
+OUT = Path('/tmp/claude-r8')
+
+def coeff_f(j, p0, scale=1, shift=0, d=None):
+    v = [0] * d
+    for t in range(j + 1):
+        v[t + shift] = scale * comb(j, t) * p0 ** (j-t)
+    return v
+
+def gs_check(rows):
+    stars, lengths = [], []
+    for i, row in enumerate(rows):
+        v = list(map(Q, row))
+        mus = []
+        for j, star in enumerate(stars):
+            mu = sum(Q(a)*b for a,b in zip(row, star)) / lengths[j]
+            mus.append(mu)
+            assert abs(mu) <= Q(1,2)
+            v = [a-mu*b for a,b in zip(v,star)]
+        length = sum(a*a for a in v)
+        if i:
+            assert length >= (Q(3,4)-mus[-1]**2)*lengths[-1]
+        stars.append(v)
+        lengths.append(length)
+
+def evaluate(h, x):
+    return sum(c*x**i for i,c in enumerate(h))
+
+results = []
+for seed in (10**6, 10**9):
+    p, q = int(nextprime(seed)), int(nextprime(13*seed//10))
+    N = p*q
+    for beta in (Q(1,5), Q(3,10), Q(2,5)):
+        # Exact floor N**beta, with rational beta.
+        from sympy import integer_nthroot
+        X = int(integer_nthroot(N**beta.numerator, beta.denominator)[0])
+        p0 = p-X//3
+        x0 = p-p0
+        for m in range(1,5):
+            for d in sorted(set((m+1, 2*m, 2*m+1))):
+                raw = [coeff_f(j,p0,N**(m-j),d=d) for j in range(m)]
+                raw += [coeff_f(m,p0,shift=i,d=d) for i in range(d-m)]
+                weighted = [[c*X**t for t,c in enumerate(v)] for v in raw]
+                determinant = N**(m*(m+1)//2)*X**(d*(d-1)//2)
+                assert abs(int(Matrix(weighted).det())) == determinant
+                B = IntegerMatrix.from_matrix(weighted)
+                U = IntegerMatrix.identity(d)
+                LLL.reduction(B,U,delta=0.75,eta=0.501,method='proved')
+                reduced = [[int(B[i,j]) for j in range(d)] for i in range(d)]
+                transform = Matrix([[int(U[i,j]) for j in range(d)] for i in range(d)])
+                assert abs(int(transform.det())) == 1
+                assert transform*Matrix(weighted) == Matrix(reduced)
+                gs_check(reduced)
+                normsquared = sum(v*v for v in reduced[0])
+                assert normsquared**(2*d) <= 2**(d*(d-1))*determinant**4
+                ks, trivial = [], []
+                for row in reduced:
+                    assert all(c % X**t == 0 for t,c in enumerate(row))
+                    h = [c//X**t for t,c in enumerate(row)]
+                    hx = evaluate(h,x0)
+                    assert hx % p**m == 0
+                    k = hx//p**m
+                    exponent = evaluate(h,1-p0)
+                    assert (exponent-k)%(p-1) == 0
+                    assert pow(2,exponent,p) == pow(2,k,p)
+                    ks.append(k)
+                    # Candidate equation identically zero means no factor information.
+                    trivial.append(h == coeff_f(m,p0,scale=k,d=d))
+                results.append(dict(N=N,p=p,q=q,beta=str(beta),X=X,m=m,d=d,
+                    quotient_first=ks[0], first_trivial=trivial[0],
+                    first_norm_logN=log(normsquared)/(2*log(N)),
+                    quotient_bound_exponent=float(beta*(d-1)/2+Q(m*(m+1),2*d)-Q(m,2)),
+                    quotients=ks, trivial=trivial))
+
+(OUT/'results.json').write_text(json.dumps(results,indent=2)+'\n')
+print('Cases:',len(results),' All determinants, unimodular transforms, rational LLL conditions, quotient integrality, and exponent identities passed.')
