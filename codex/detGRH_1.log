+"""Finite sanity checks for elementary claims in independent_report.md.
+
+These checks are illustrations, not substitutes for the report's proofs.
+Only the Python standard library is used.
+"""
+
+from math import gcd, isqrt, lcm, log
+
+
+def factor(n):
+    out = []
+    p = 2
+    while p * p <= n:
+        if n % p == 0:
+            e = 0
+            while n % p == 0:
+                n //= p
+                e += 1
+            out.append((p, e))
+        p += 1
+    if n > 1:
+        out.append((n, 1))
+    return out
+
+
+counts = {"selector_moduli": 0, "selector_pairs": 0,
+          "order_four_obstructions": 0, "gauss_instances": 0,
+          "exponent_splits": 0}
+
+for n in range(3, 251, 2):
+    fac = factor(n)
+    units = [a for a in range(1, n) if gcd(a, n) == 1]
+    squares = sorted({a * a % n for a in units})
+    exponent = lcm(*(p ** (e - 1) * (p - 1) for p, e in fac))
+    if all(p % 4 == 3 for p, _ in fac):
+        odd_exponent = exponent // 2
+        assert odd_exponent % 2 == 1
+        root = {q: pow(q, (odd_exponent + 1) // 2, n) for q in squares}
+        assert all(y * y % n == q for q, y in root.items())
+        for a in units:
+            ratio = root[a * a % n] * pow(a, -1, n) % n
+            for p, e in fac:
+                sign = 1 if pow(a, (p - 1) // 2, p) == 1 else -1
+                assert ratio % (p ** e) == sign % (p ** e)
+        for q in squares:
+            for r in squares:
+                assert root[q * r % n] == root[q] * root[r] % n
+                counts["selector_pairs"] += 1
+        counts["selector_moduli"] += 1
+    else:
+        a = next(a for a in units if pow(a, 4, n) == 1 and a * a % n != 1)
+        q = a * a % n
+        assert q in squares and q * q % n == 1 and q != 1
+        assert all(y * y % n != 1 for y in units if y * y % n == q)
+        counts["order_four_obstructions"] += 1
+
+for n in range(3, 1001, 2):
+    r = 2
+    while r ** 4 + 1 < n:
+        R = r * r
+        norm2 = R * R + 1
+        radius = isqrt(norm2)
+        shortest = []
+        for u in range(-radius, radius + 1):
+            for v in range(-radius, radius + 1):
+                if (u or v) and u * u + v * v <= norm2 and (u - R * v) % n == 0:
+                    shortest.append((u, v))
+        assert sorted(shortest) == [(-R, -1), (R, 1)], (n, r, shortest)
+        counts["gauss_instances"] += 1
+        r += 1
+
+for n in range(3, 2001, 2):
+    fac = factor(n)
+    if len(fac) < 2:
+        continue
+    exponent = lcm(*(p ** (e - 1) * (p - 1) for p, e in fac))
+    for multiplier in (1, 8, 15):
+        M = exponent * multiplier
+        t = M
+        s = 0
+        while t % 2 == 0:
+            s += 1
+            t //= 2
+        found = False
+        for a in range(2, int(2 * log(n) ** 2) + 1):
+            d = gcd(a, n)
+            if 1 < d < n:
+                found = True
+                break
+            if d != 1:
+                continue
+            x = pow(a, t, n)
+            for _ in range(s + 1):
+                d = gcd(x - 1, n)
+                if 1 < d < n:
+                    found = True
+                    break
+                x = x * x % n
+            if found:
+                break
+        assert found, (n, M)
+        counts["exponent_splits"] += 1
+
+assert pow(4, 8, 77) == 9
+assert gcd(9 - 2, 77) == 7
+assert pow(8, 2, 65) == 64
+assert gcd(7 - 4, 33) == 3
+print("All finite sanity checks passed:")
+for name, count in counts.items():
+    print(f"  {name}: {count}")

