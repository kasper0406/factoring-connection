     1	"""Cost formulas for agent `siconstruct` (exact sympy where possible; mpmath only to evaluate closed forms).
     2	
     3	Notation: x = ln N, F_a = x^a (ln x)^{1-a}, L[a, c] = exp((c + o(1)) F_a).  Factor base y = L[1/3, kappa],
     4	window h = L[2/3, nu], per-output constructor cost L[1/3, tau].
     5	
     6	* `si_cost(tau)`          : min_kappa max(kappa + tau + 2/(9 kappa^2), 2 kappa)   (Prop SI with an L[1/3, tau] oracle)
     7	* `si_cost_slack(t)`      : min_kappa max(kappa + 2/(9 kappa^2) + t/(3 kappa), 2 kappa)
     8	                            (residue inflated to h * L[2/3, t]: a CVP oracle with slack t, Prop CV(d))
     9	* `mitm_per_output(...)`  : amortised MITM per-output cost 2 sqrt(N / (R (h+1))) (Lemma MA)
    10	* `cvp_bounds(...)`       : the exact inequalities of Prop CV, evaluated at high precision for tests
    11	"""
    12	from __future__ import annotations
    13	
    14	from math import isqrt
    15	from typing import Dict, Sequence
    16	
    17	import mpmath as mp
    18	import sympy as sp
    19	
    20	K = sp.Symbol("kappa", positive=True)
    21	
    22	
    23	def _min_max(trial: sp.Expr) -> Dict[str, sp.Expr]:
    24	    """min over kappa > 0 of max(trial(kappa), 2 kappa), trial convex decreasing-then-increasing."""
    25	    crit = [r for r in sp.solve(sp.Eq(sp.diff(trial, K), 0), K) if r.is_real and r > 0]
    26	    kmin = crit[0]
    27	    inter = [r for r in sp.solve(sp.Eq(trial, 2 * K), K) if r.is_real and r > 0]
    28	    # the max is minimised at the intersection if it lies left of the trial minimiser, else at the minimiser
    29	    left = [r for r in inter if sp.N(r - kmin) <= 0]
    30	    if left:
    31	        k0 = max(left, key=lambda r: sp.N(r))
    32	        return {"kappa": k0, "c": 2 * k0, "regime": "intersection"}
    33	    return {"kappa": kmin, "c": trial.subs(K, kmin), "regime": "trial-minimum"}
    34	
    35	
    36	def si_cost(tau) -> Dict[str, sp.Expr]:
    37	    tau = sp.nsimplify(tau)
    38	    return _min_max(K + tau + sp.Rational(2, 9) / K ** 2)
    39	
    40	
    41	def si_cost_slack(t) -> Dict[str, sp.Expr]:
    42	    t = sp.nsimplify(t)
    43	    return _min_max(K + sp.Rational(2, 9) / K ** 2 + t / (3 * K))
    44	
    45	
    46	def tau_threshold(target) -> sp.Expr:
    47	    """Largest per-output tau with si_cost(tau) < target (trial-minimum regime): (3/2)(4/9)^{1/3} + tau = target."""
    48	    return sp.nsimplify(target) - sp.Rational(3, 2) * sp.Rational(4, 9) ** sp.Rational(1, 3)
    49	
    50	
    51	def linear_oracle_cost() -> sp.Expr:
    52	    """tau = kappa (per-output cost linear in the factor-base size): min_kappa 2 kappa + 2/(9 kappa^2)."""
    53	    tr = 2 * K + sp.Rational(2, 9) / K ** 2
    54	    k0 = [r for r in sp.solve(sp.diff(tr, K), K) if r.is_real and r > 0][0]
    55	    return sp.simplify(tr.subs(K, k0))
    56	
    57	
    58	# ------------------------------------------------------------------------------------------- Lemma MA (amortised MITM)
    59	def mitm_expected_hits(nA: int, nB: int, h: int, N: int) -> sp.Rational:
    60	    """Heuristic H_eq: a*b mod N uniform for N-oblivious lists, for every product range [N, KN]."""
    61	    return sp.Rational(nA * nB * (h + 1), N)
    62	
    63	
    64	def mitm_per_output(N: int, h: int, R: int) -> float:
    65	    """Optimal amortised MITM per-output cost (|A| = |B| = sqrt(R N/(h+1))): 2 sqrt(N/(R (h+1)))."""
    66	    return float(2 * mp.sqrt(mp.mpf(N) / (R * (h + 1))))
    67	
    68	
    69	def mitm_list_size(N: int, h: int, R: int) -> int:
    70	    return isqrt(R * N // (h + 1)) + 1
    71	
    72	
    73	# ------------------------------------------------------------------------------------------- Prop CV (one-sided CVP)
    74	def cvp_bounds(e: Sequence[int], P: Sequence[int], N: int, k: int, h: int, dps: int = 80) -> Dict[str, mp.mpf]:
    75	    """For the Adleman-weight lattice b(e) = (sqrt(l_i) e_i, C <e, l>), target t_k = (0, C ln kN), C = kN/h:
    76	    returns Q, Delta, dist2 = Q + C^2 Delta^2, the lower bound ln kN - 1/(4C^2) (Prop CV(a)) and the witness
    77	    bound ln kN + h/kN + 1 (Prop CV(b), valid for squarefree u in I_k)."""
    78	    with mp.workdps(dps):
    79	        l = [mp.log(p) for p in P]
    80	        C = mp.mpf(k * N) / h
    81	        dot = mp.fsum(ei * li for ei, li in zip(e, l))
    82	        Delta = dot - mp.log(k * N)
    83	        Q = mp.fsum(ei * ei * li for ei, li in zip(e, l))
    84	        return {"Q": Q, "Delta": Delta, "dist2": Q + C * C * Delta * Delta,
    85	                "lower": mp.log(k * N) - 1 / (4 * C * C),
    86	                "witness_upper": mp.log(k * N) + mp.mpf(h) / (k * N) + 1}
