    26	def mitm_construct(N: int, h: int, A: Sequence[int], B: Sequence[int]) -> Dict:
    27	    """All pairs (a, b) in A x B with a*b in [kN, kN + h] for some k >= 1.
    28	
    29	    For each a and each k whose b-interval [ceil(kN/a), floor((kN + h)/a)] meets [min B, max B], bisect the
    30	    sorted B.  Counters:
    31	      gen      = |A| + |B|                 (list generation + sorting, L^{o(1)} each)
    32	      queries  = number of (a, k) pairs bisected (the K-dependent part of this implementation)
    33	      points   = number of integers b in those intervals (cost of an ideal Bohr-set enumerator + hash lookup)
    34	      hits     = pairs found;  outputs = distinct u.
    35	    """
    36	    Bs = sorted(B)
    37	    bmin, bmax = Bs[0], Bs[-1]
    38	    queries = 0
    39	    points = 0
    40	    hits = []
    41	    for a in A:
    42	        k_lo = max(1, (a * bmin - h) // N)
    43	        k_hi = (a * bmax) // N
    44	        for k in range(k_lo, k_hi + 1):
    45	            kN = k * N
    46	            lo = -(-kN // a)
    47	            hi = (kN + h) // a
    48	            if hi < bmin or lo > bmax or hi < lo:
    49	                continue
    50	            queries += 1
    51	            points += min(hi, bmax) - max(lo, bmin) + 1
    52	            i = bisect_left(Bs, lo)
    53	            j = bisect_right(Bs, hi)
    54	            for b in Bs[i:j]:
    55	                w = a * b - kN
    56	                assert 0 <= w <= h
    57	                hits.append((a * b, k, w))
    58	    outs = {u: (k, w) for (u, k, w) in hits}
    59	    return {"gen": len(A) + len(B), "queries": queries, "points": points, "hits": len(hits),
    60	            "outputs": sorted(outs.items())}
