    63	def aim2d_construct(N: int, h: int, K: int, S: Sequence[int], P: Sequence[int],
    64	                    max_per_sk: Optional[int] = None) -> Dict:
    65	    """For each constructed smooth s and k <= K, every w in [0, h] with s | kN + w (w = (-kN mod s) + j s), at most
    66	    `max_per_sk` of them per (s, k); test the cofactor m = (kN + w)/s for P-smoothness.
    67	    Returns outputs and a histogram of the tested cofactor bit lengths."""
    68	    tested = 0
    69	    outs = {}
    70	    cof_bits: Counter = Counter()
    71	    for s in S:
    72	        for k in range(1, K + 1):
    73	            kN = k * N
    74	            w = (-kN) % s
    75	            j = 0
    76	            while w <= h and (max_per_sk is None or j < max_per_sk):
    77	                m = (kN + w) // s
    78	                tested += 1
    79	                j += 1
    80	                cof_bits[m.bit_length()] += 1
