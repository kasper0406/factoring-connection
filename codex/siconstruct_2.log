+import os, sys, math, json, itertools
+os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
+sys.path.insert(0, '/Volumes/git/factoring-connection')
+import sympy as sp
+from src.siconstruct.theory import si_cost, si_cost_slack, linear_oracle_cost
+
+# Certify the old-target exact CVP counterexample using the nonnegative
+# squarefree candidate bound (< log(N)+2 log(2)).
+N,h = 143,67
+C=N/h
+P=[2,3,5,7]
+rows=[]
+for bits in itertools.product([0,1], repeat=4):
+    u=math.prod(p for p,b in zip(P,bits) if b)
+    val=math.log(u)+C*C*math.log(u/N)**2
+    rows.append((val,u))
+best=sorted(rows)[:3]
+print('CVP', best, 'cutoff',math.log(N)+2*math.log(2)-1/(4*C*C))
+print('RC', {'N':143,'h':1,'K':1,'s':16,'w':1,'m':9,'claimed_m_min':143/2})
+
+# Smooth balanced products immediately above a balanced semiprime, to show
+# that Kh << a gives collinearity rather than at most one lattice point.
+for r in range(8,15):
+    a=2**r
+    found=False
+    for b in range(a//2, 2*a):
+        z=b
+        for p in P:
+            while z%p==0: z//=p
+        if z!=1: continue
+        n=a*b-1
+        fs=sp.factorint(n)
+        if sum(fs.values())==2 and min(fs)>7 and max(fs)/min(fs)<10:
+            K,h0=8,8
+            print('MERGE',dict(N=n,factors=fs,a=a,b0=b,K=K,h=h0,
+                  candidates=[(k,k*b,k) for k in range(1,K+1)],Kh_over_a=K*h0/a))
+            found=True
+            break
+    if found: break
+for tau in [0,sp.Rational(1,10),sp.Rational(1,4),sp.Rational(1,2),sp.Rational(757,1000)]:
+    v=si_cost(tau)
+    print('COST',str(tau),float(v['kappa']),float(v['c']),v['regime'])
+for t in [0,sp.Rational(1,10),sp.Rational(1,2),1,2]:
+    v=si_cost_slack(t)
+    print('SLACK',str(t),float(v['kappa']),float(v['c']),v['regime'])
+print('LINEAR',float(linear_oracle_cost()))
+print('THRESHOLD',1.9019-1.5*(4/9)**(1/3),'FIXED',1.9019-(16/9)**(1/3))
+
+raw='/Volumes/git/factoring-connection/experiments/raw'
+E1=[json.loads(x) for x in open(raw+'/siconstruct_E1.jsonl')]
+print('E1',sum(r['hits'] for r in E1),sum(r['pred_hits'] for r in E1),sum(r['outputs'] for r in E1))
+print('E1_K',[(K, sum(r['hits'] for r in E1 if r['K']==K)/sum(r['pred_hits'] for r in E1 if r['K']==K)) for K in [1,4,16,64,256]])
+E2=[json.loads(x) for x in open(raw+'/siconstruct_E2.jsonl')]
+mm=[r for r in E2 if r['method']=='mitm']
+print('E2',sum(r['hits'] for r in mm),sum(r['pred_hits'] for r in mm),sum(r['outputs'] for r in mm))
+print('E2_GEN_SECS',[(r['bits'],round(r['secs_gen'],2),round(r['secs'],2)) for r in mm])
+E3=[json.loads(x) for x in open(raw+'/siconstruct_E3diag.jsonl')]
+print('E3',sum(r['successful_tests'] for r in E3),sum(r['pred_tests'] for r in E3),min(r['ratio_tests'] for r in E3),max(r['ratio_tests'] for r in E3))
+print('GROWING_K',[(x, math.log(sp.binomial(int(x/math.log(2))+x-1,x-1))/x) for x in [100,1000]])

