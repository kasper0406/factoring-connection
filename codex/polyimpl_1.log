+from pathlib import Path
+from fractions import Fraction
+from math import comb, gcd, lcm, prod
+import re
+import sympy as sp
+
+ROOT = Path(__file__).resolve().parent
+REPORT = ROOT / "polyimpl_1_report.md"
+
+def checks():
+    # Exact exponents, including the coefficient of delta.
+    rows = [
+        (Fraction(21, 40), Fraction(1), [Fraction(21,40), Fraction(83,120), Fraction(29,40)]),
+        (Fraction(1,2), Fraction(18,19), [Fraction(19,36), Fraction(19,27), Fraction(133,180)]),
+        (Fraction(1,2), Fraction(24,25), [Fraction(25,48), Fraction(25,36), Fraction(35,48)]),
+        (Fraction(1,2), Fraction(25,26), [Fraction(13,25), Fraction(52,75), Fraction(91,125)]),
+    ]
+    for beta, theta, expected in rows:
+        assert [(beta+a)/theta for a in [0,Fraction(1,6),Fraction(1,5)]] == expected
+        assert theta/2-beta <= 0
+    assert Fraction(1,5)-Fraction(1,6)==Fraction(1,30)
+    for k in range(2,120):
+        modulus=lcm(*range(1,k+1))
+        assert all(modulus % comb(k-1,j)==0 for j in range(k))
+        assert modulus*k >= 2**(k-1)
+    for N in range(2,2001):
+        m=N
+        layers=[]
+        while m>1:
+            g=gcd(m,int(sp.totient(m)))
+            r=m//g
+            assert all(e==1 for e in sp.factorint(r).values())
+            layers.append(r)
+            m=g
+        assert prod(layers)==N
+        assert lcm(*layers)==prod(sp.factorint(N))
+        q=int(sp.nextprime(1+N.bit_length()))
+        D=int(sp.divisor_count(N**(q-1)))
+        r=0
+        while D%q==0:
+            D//=q
+            r+=1
+        mu=0 if D!=1 else (-1)**r
+        assert mu==sp.mobius(N)
+    primes=list(sp.primerange(3,80))
+    for p in primes:
+        for q in primes:
+            if p>=q:
+                continue
+            N=p*q
+            s=N+1-int(sp.totient(N))
+            assert s==p+q==int(sp.divisor_sigma(N))-N-1
+            if N%4==1:
+                assert int(sp.totient(N))%8 == (0 if p%4==1 else 4)
+            v=int(sp.factorint(q-p).get(2,0))
+            for k in range(1,9):
+                for x in range(2**k):
+                    actual=(x*x-s*x+N)%2**k==0
+                    if k>2*v:
+                        d=2**(k-v)
+                        predicted=(x-p)%d==0 or (x-q)%d==0
+                    else:
+                        predicted=(x-p)%2**((k+1)//2)==0
+                    assert actual==predicted, (p,q,k,x)
+    print("PASS: exact interval exponents; lcm/binomial bound; totient-to-radical and divisor-count-to-mu identities for N<=2000; semiprime and 2-adic formulas.")
+
+def format_math():
+    s=REPORT.read_text()
+    # Recover missing TeX command prefixes in the initial draft.
+    for command in ["operatorname","mathfrak","lfloor","sqrt","lambda","kappa","alpha","beta","theta","pi","Phi","sum"]:
+        s=re.sub(r"(?<![A-Za-z\\])"+command+r"(?=[_={(\s\\]|$)", lambda m: "\\"+m.group(), s)
+    s=s.replace("(ge2)",r"(\ge2)").replace("(le h)",r"(\le h)").replace("(ge c",r"(\ge c").replace("(ge\\sqrt",r"(\ge\sqrt").replace("(min(",r"(\min(")
+    s=s.replace(r"AC\(^0[p])",r"$\mathrm{AC}^{0}[p]$").replace(r"AC\(^0[2])",r"$\mathrm{AC}^{0}[2]$")
+    s=s.replace(r"AC\(^0\)",r"$\mathrm{AC}^{0}$").replace(r"AC\(^0)",r"$\mathrm{AC}^{0}$")
+    s=s.replace("Given the high or low (roughly (", "Given roughly (").replace(r"\frac14\log_2N)) bits of a factor",r"\frac14\log_2N) high or low bits of a factor")
+
+    def eligible(t):
+        if "\n" in t or "http" in t or "/Volumes/" in t:
+            return False
+        # Keep explanatory prose parentheses, recursively formatting inner math.
+        words=re.findall(r"(?<!\\)\b[a-z]{3,}\b",re.sub(r"\\[A-Za-z]+(?:\{[^{}]*\})?","",t))
+        prose={"and","the","for","with","from","not","case","time","bound","input","prime","proof","bits","below","above","fixed","mean","roughly","positive","distinct","general","theorem","modulo","length"}
+        if any(w in prose for w in words):
+            return False
+        if "\\" in t or any(c in t for c in "=^_<>{}"):
+            return True
+        return bool(re.fullmatch(r"[A-Za-zΑ-ω0-9+\-*/.,: ]{1,30}",t)) and (
+            len(t.strip())==1 or bool(re.search(r"\d",t)) or t.strip() in {"N,p","p,q","A,B,M,K,D","R","PK"}
+        )
+
+    def segment(line):
+        out=[]
+        i=0
+        while i<len(line):
+            # Preserve existing inline math and link destinations.
+            if line[i]=="$":
+                j=line.find("$",i+1)
+                if j!=-1:
+                    out.append(line[i:j+1]);i=j+1;continue
+            if line[i]=="(":
+                depth=1;j=i+1
+                while j<len(line) and depth:
+                    if line[j]=="(":depth+=1
+                    elif line[j]==")":depth-=1
+                    j+=1
+                if depth:
+                    out.append(line[i:]);break
+                inner=line[i+1:j-1]
+                if i and line[i-1]=="]":
+                    out.append(line[i:j])
+                elif (i==0 or not line[i-1].isalnum()) and eligible(inner):
+                    out.append("$"+inner+"$")
+                else:
+                    out.append("("+segment(inner)+")")
+                i=j;continue
+            out.append(line[i]);i+=1
+        return "".join(out)
+
+    lines=[];display=False
+    for line in s.splitlines():
+        if line.strip()==r"\[":
+            display=True;lines.append("$$");continue
+        if line.strip()==r"\]":
+            display=False;lines.append("$$");continue
+        lines.append(line if display else segment(line))
+    s="\n".join(lines).rstrip()+"\n"
+    REPORT.write_text(s)
+    assert s.count("\n$$\n")%2==0
+    assert not re.search(r"turn\d+(?:view|search)",s)
+    # All local citations exist.
+    local=re.findall(r"\]\((/Volumes/[^)]+)\)",s)
+    assert all(Path(p).exists() for p in local),[p for p in local if not Path(p).exists()]
+    print(f"Formatted report: {len(s.splitlines())} lines, {len(s.split())} words; {len(local)} local citations checked.")
+
+if __name__=="__main__":
+    import sys
+    if "--format" in sys.argv:
+        format_math()
+    checks()
