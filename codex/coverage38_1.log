from fractions import Fraction
from math import gcd, log, sqrt, pi
import cmath
import random

# Check the moving-center identity exactly (rational arithmetic).
p, q, H = 101, 139, 3
primes = [m for m in range(17,35) if all(m%d for d in range(2,int(sqrt(m))+1))]
checked=0
for ell in primes:
    for B in range(1,H+1):
        residue = (B*p*pow(ell,-1,q)) % q
        shifted = Fraction(residue,q)-Fraction(B*p,ell*q)
        circular = min(abs(shifted-z) for z in range(-2,3))
        left = any((B*p-A*q)%ell==0 for A in range(-H,H+1) if A)
        right = circular <= Fraction(H,ell)
        assert left == right, (ell,B,left,right)
        checked += 1
print('exact moving-center reciprocity checks:',checked)

# A Fourier-small configuration that completely avoids a fixed Farey target.
q, Y, H, J = 10007, 400, 2, 400
forbidden=[]
allowed=[]
for x in range(q):
    hit=any(min((B*x)%q, q-(B*x)%q)*Y <= H*q for B in range(1,H+1))
    (forbidden if hit else allowed).append(x)
rng=random.Random(38)
points=rng.sample(allowed,J)
maximum=0.0
argmax=0
for h in range(1,q):
    value=abs(sum(cmath.exp(2j*pi*((h*x)%q)/q) for x in points))
    if value>maximum:
