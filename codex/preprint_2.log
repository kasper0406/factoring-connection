   507	%======================================================================
   508	\section{Parameters, field law and the algorithm}\label{sec:algorithm}
   509	%======================================================================
   510	
   511	\subsection{Parameters}\label{sec:params}
   512	\emph{Fixed parameters.} An odd integer $d\ge3$; an integer $k>(d+1)/4$; $\nu:=1/(4k)$; a rational $\mu$ with
   513	$\nu+\eta_0\le\mu<1$; a rational $\eta_0>0$. Put
   514	\[
   515	h:=h_*(\mu)+\eta_0,\qquad h_*(\mu)=\max\bigl(\underbrace{2\nu}_{\text{kernel}},\ \underbrace{\mu-(d-2)\nu}_{\text{level }1/2},\
   516	\underbrace{1-d\mu+\nu}_{\text{window}}\bigr),\qquad \theta:=2\mu+h+(d-1)\nu,
   517	\]
   518	and assume $\theta<1$. Put $a:=\theta/\sqrt2$.
   519	
   520	\emph{Quantities depending on $N$} (the integer handed to the splitting routine, see
   521	Section~\ref{sec:uniform}):
   522	\begin{itemize}
   523	\item $B:=\lfloor L^{a}\rfloor$, the smoothness bound;
   524	\item $X:=\lfloor\sqrt{N/2}\rfloor$; $j$ maximal with $2^{kj}\le X$; $Y:=2^{j-1}$; $J:=\{\ell\text{ prime}:Y<\ell\le2Y\}$;
   525	  $\pi_J:=\#J$;
   526	\item $S:=\lceil L^{1/(2\sqrt2)}\rceil$, so that $S^2=L^{\theta/(2a)+o(1)}$;
   527	\item for $\ell\in J$: $V_\ell:=\lfloor\sqrt\ell\,S\rfloor$, with envelopes $\Vm:=\lfloor\sqrt Y\,S\rfloor\le
   528	  V_\ell\le\VM:=\lfloor\sqrt{2Y}\,S\rfloor$; and $T_\ell:=dHV_\ell^{d-1}$;
   529	\item $M:=\lfloor N^\mu\rfloor$, $H:=\lfloor N^h\rfloor$, $W:=\lceil N^{\mu+\nu+\eta_0/2}\rceil$;
   530	\item $\XF:=C'_dMH\VM^d$ and $\Xr:=2M\VM/Y$, where $C'_d:=2^{2d+5}+2d$; and
   531	  $\rr:=\varrho(\Xr)$, $\rF:=\varrho(\XF)$.
   532	\end{itemize}
   533	Since $2^{k(j+1)}>X$, we have $X^{1/k}/4<Y\le X^{1/k}/2$, so $Y=N^{2\nu+o(1)}$ and every product of $k$ primes of $J$ is at most $X$.
   534	$V_\ell=N^\nu L^{1/(2\sqrt2)+o(1)}$, $\Xr=N^{\mu-\nu}L^{O(1)}$ and $\XF=N^{\mu+h+d\nu}L^{O(1)}$. By Lemma~\ref{lem:local}(iv),
   535	\begin{equation}\label{eq:rhosizes}
   536	\rr\rF=L^{-(\mu-\nu+\mu+h+d\nu)/(2a)+o(1)}=L^{-\theta/(2a)+o(1)}=L^{-1/\sqrt2+o(1)},\qquad\text{so}\qquad S^2\rr\rF=L^{o(1)}.
   537	\end{equation}
   538	
   539	\begin{lemma}[size relations]\label{lem:sizes}
   540	For $N\ge N_0(d,k,\mu,\eta_0)$:

