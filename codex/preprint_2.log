  1909	%======================================================================
  1910	\section{Batch smoothness}\label{sec:batch}
  1911	%======================================================================
  1912	
  1913	\begin{lemma}[smooth parts; Bernstein {\cite{bernstein2004,bernstein2008}}]\label{lem:BS}
  1914	Let $\mathcal P_B:=\prod_{p\le B}p$, and let $x\ge2$ and $2^e\ge\log_2x$. The $B$-smooth part of $x$ is
  1915	$\gcd\bigl(x,\ (\mathcal P_B\bmod x)^{2^e}\bmod x\bigr)$. For given $x_1,\dots,x_n$, all their smooth parts can be computed in
  1916	$O(\mathsf M(b)\log b)$ bit operations, where $b=\log_2\mathcal P_B+\sum_i\log_2x_i$.
  1917	\end{lemma}
  1918	
  1919	\begin{proof}
  1920	Write $x=s\,u$ with $s$ smooth and $\gcd(u,\mathcal P_B)=1$. Every $p^j\,\|\,s$ has $j\le\log_2x\le2^e$, so $s\mid\mathcal P_B^{2^e}$, while
  1921	$\gcd(u,\mathcal P_B^{2^e})=1$. For the cost, form a product tree of the $x_i$, reduce $\mathcal P_B$ modulo the product, and descend a
  1922	remainder tree; each level costs $O(\mathsf M(b))$ \cite[\S\S10.1--10.3]{gathengerhard}. Then perform $e=O(\log\log x)$ modular squarings and a gcd for each $x_i$.
  1923	\end{proof}
  1924	
  1925	\begin{proposition}[the special-$q$ search recognises $N_\ell(A)$ exactly]\label{prop:BS}
  1926	$\mathrm{SQ\_SEARCH}(A,\ell)$ is a deterministic function of $(A,\ell)$ and runs in time $\tilde O(B+S^2\log N)$. If $\ell\nmid N$, then either it makes a
  1927	factor exit, or it returns an atom if and only if $N_\ell(A)\ge1$, and every atom it returns is a counted point.
  1928	\end{proposition}
  1929	
  1930	\begin{proof}
  1931	If $N_\ell(A)\ge1$, the lattice is regular (Lemma~\ref{lem:reg}), so step~1 does not fail. Step~2 enumerates at most $200S^2$ points from the reduced
  1932	basis. It keeps exactly the points of $\cP_\ell\cap\Lambda_\ell(g)\cap[-V,V]^2$ with $G(P)\ne0$, $F_A(P)\ne0$ and $|G(P)|\ge MV/32$. Every counted point is
  1933	kept, and its gcd checks pass (its values are coprime to $N$). Step~3 computes all smooth parts exactly (Lemma~\ref{lem:BS}). So step~4 returns
  1934	a counted point whenever one exists, and only counted points. Lemma~\ref{lem:BS} applies with $b=O(B+S^2\log N)$, since every value has
  1935	$O(\log N)$ bits (Lemma~\ref{lem:valuesizes}). Trial division of the two chosen values costs $\tilde O(B)$.
  1936	\end{proof}
  1937	
  1938	\begin{remark}
  1939	Since $B\le S^2$ when $\theta\le1$, the batch costs $\tilde O(S^2)$ per box, the same as the enumeration. No smoothness test is
  1940	probabilistic, and in particular no hyperelliptic curve method is used. (The published proof of the hyperelliptic
  1941	curve method's running time \cite{lpp1993} refers to an unpublished third part; Lee--Venkatesan's congruence theorem relies on it.)
  1942	The Lenstra--Pomerance algorithm used in the shape test does not use the hyperelliptic method either; it uses the elliptic
  1943	curve method on ``recognisable'' smooth numbers \cite[\S7]{lp1992}.
  1944	\end{remark}
