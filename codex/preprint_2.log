   678	\begin{remark}
   679	Without the hypothesis that $G(P)/\ell$ is smooth, \eqref{eq:forced} can fail (for example
   680	$\gcd(g_1,t)=b$ is possible). Such candidates never enter the moment sums.
   681	\end{remark}
   682	
   683	\subsection{The algorithm}\label{sec:alg}
   684	
   685	\begin{algorithm}[$\mathrm{FACTOR}(N)$]\label{alg:factor}
   686	\begin{enumerate}[label=\arabic*.]
   687	\item If $N=1$ return the empty list. If $N$ is prime (AKS), return $[N]$. If $N=m^e$ with $e\ge2$ (integer roots,
   688	  $e\le\log_2N$), return $\mathrm{FACTOR}(m)$ with all exponents multiplied by $e$.
   689	\item Trial-divide $N$ by all primes $\le B(N)$. Record the primes found, and let $N'$ be the cofactor. If $N'=1$,
   690	  stop. If $N'$ is prime or a perfect power, handle it as in step 1.
   691	\item Run $\mathrm{SPLIT}(N')$ and trial division of $N'$ in parallel, alternating steps, until one returns a
   692	  proper factor $g$ of $N'$. (This alternation removes the need for any branch ``$N'<N_0$'': the algorithm then uses no analytic
   693	  constant at all, and pays at most a factor $2$ in expected time; see Remark~\ref{rem:noN0}.)
   694	\item Return $\mathrm{FACTOR}(g)$ merged with $\mathrm{FACTOR}(N'/g)$, together with the primes from step 2.
   695	\end{enumerate}
   696	\end{algorithm}
   697	
   698	\begin{algorithm}[$\mathrm{SPLIT}(N)$; $N$ odd, all prime factors $>B$, not a prime power]\label{alg:split}
   699	\begin{enumerate}[label=\arabic*.]
   700	\item \emph{Field selection.} Repeat: $A\leftarrow\mathrm{SAMPLE\_FIELD}$; if $A$ is rejected, continue;
   701	  $\mathrm{row}\leftarrow\mathrm{DESCEND\_ONCE}(A)$; if a row is returned, keep $A$ and go to step~2.
   702	  (Any factor exit returns the factor.)
   703	\item \emph{Rows.} Call $\mathrm{DESCEND\_ONCE}(A)$ until $M_{\rm rows}$ rows are held, where $M_{\rm rows}$ is
   704	  defined in \eqref{eq:Mrows}.
   705	\item \emph{Post-processing.} Run $\mathrm{POSTPROCESS}(A,\text{rows})$ (Algorithm~\ref{alg:lv6}). It returns a nonempty set
  1960	\begin{itemize}
  1961	\item \emph{Rows.} $M_{\rm rows}\le(d+1)\pi(B)+O_d(\log N)=L^{a+o(1)}$.
  1962	\item \emph{One trial.} SAMPLE\_FIELD costs $(\log N)^{O(1)}$ in expectation. DESCEND\_ONCE costs one Gauss reduction, two runs of the
  1963	  Lenstra--Pomerance algorithm on integers $\le\sqrt{2N}$, and at most $2k$ special-$q$ searches. The first has expected cost
  1964	  $L_{\sqrt{2N}}[1/2,1+o(1)]=L^{1/\sqrt2+o(1)}$ (Fact~\ref{fact:LP}), uniformly over the inputs. Each search costs $\tilde O(B+S^2\log N)=L^{1/\sqrt2+o(1)}$
  1965	  (Proposition~\ref{prop:BS}; recall $S^2=L^{\theta/(2a)+o(1)}$ and $\theta/(2a)=1/\sqrt2$). AKS certification of the output primes is
  1966	  polynomial. So $C_{\rm trial}=L^{\max(1/\sqrt2,\theta/(2a))+o(1)}$.
  1967	\item \emph{Post-processing.} $\mathrm T_{\rm post}=M_{\rm rows}^2(\log N)^{O(1)}+B^{1+o(1)}=L^{2a+o(1)}$ (Proposition~\ref{prop:lv6}).
  1968	\end{itemize}
  1969	Hence the expected time is at most $L^{o(1)}(L^{a+o(1)}L^{\max(1/\sqrt2,\theta/(2a))}+L^{2a})$. With $a=\theta/\sqrt2$ the first two exponents
  1970	both equal $(1+\theta)/\sqrt2$, and $2a=\sqrt2\theta<(1+\theta)/\sqrt2$ because $\theta<1$.
  1971	\end{proof}
  1972	
  1973	\begin{remark}[the choice of $a$]
  1974	For a general smoothness exponent $a$ (with $S^2=L^{\theta/(2a)}$) the same proof gives $L^{c(a)+o(1)}$ with
  1975	$c(a)=\max(2a,a+1/\sqrt2,a+\theta/(2a))$. For $a>\theta/\sqrt2$ the term $a+1/\sqrt2$ exceeds $(1+\theta)/\sqrt2$. On $(0,\theta/\sqrt2)$ the function
  1976	$a+\theta/(2a)$ is decreasing, because $\theta/\sqrt2<\sqrt{\theta/2}$ for $\theta<1$. So $a=\theta/\sqrt2$ is optimal, and the minimum is $(1+\theta)/\sqrt2$.
  1977	\end{remark}
  1978	
  1979	%======================================================================
  1980	\section{Uniformity, small factors and prime powers; proof of the main theorem}\label{sec:uniform}
  1981	%======================================================================
  1982	
  1983	\begin{proof}[Proof of Theorem~\ref{thm:main}]
  1984	\emph{Correctness.} Every prime in the output is certified by AKS. Every proper factor returned by SPLIT, or by a factor exit,
  1985	divides the current integer. FACTOR recurses on both cofactors and stops at certified primes. So the output is the complete
  1986	factorisation, and the algorithm is Las Vegas: it never errs, only its running time is random.
  1987	
  1988	\emph{Preprocessing.} Step~1 of FACTOR (primality, perfect powers) costs $(\log N)^{O(1)}$. Trial division to $B(N)$ costs $L^{a+o(1)}$. The cofactor
  1989	$N'$ handed to SPLIT is odd, has no prime factor $\le B(N)$, and is neither a prime nor a perfect power, so $\omega(N')\ge2$. Since
  1990	$B(N')\le B(N)$, $N'$ has no prime factor $\le B(N')$, and all statements of Sections~\ref{sec:split}--\ref{sec:cost} apply to $N'$ with its own
  1991	parameters. A non-squarefree $N'$ (for example $p^2q$) needs no special treatment: Theorem~\ref{thm:DD} uses $|\bmu|=2^{\omega}$, and the other
  1992	sections use only $\gcd(N',t)=1$ and $N'\mid F_A(g_0,g_1)$.
  1993	
  1994	\emph{Small $N'$.} Step~3 of FACTOR runs SPLIT and trial division in parallel, so its cost is at most twice the smaller of their costs. For
  1995	$N'<N_0$, trial division bounds it by $O(\sqrt{N_0})=O(1)$. For $N'\ge N_0$, Proposition~\ref{prop:cost} bounds it by
  1996	$L_{N'}^{(1+\theta)/\sqrt2+o(1)}\le L_N^{(1+\theta)/\sqrt2+o(1)}$. Here $N_0=N_0(d,k,\mu,\eta_0)$ is effective (it involves the effective constants of
  1997	Facts~\ref{fact:Stark}--\ref{fact:LO} and of the smooth-number facts), but it need not be known to the algorithm.
  1998	
  1999	\emph{Recursion.} Every call of SPLIT produces a proper factor, and the factorisation tree has fewer than $\log_2N$ internal nodes. So
  2000	there are at most $\log_2N$ calls of SPLIT and of trial division, each on an integer $\le N$, plus polynomial bookkeeping. The bound of
  2001	Proposition~\ref{prop:cost} is uniform in the input. To apply it to all smaller inputs at once, replace the $o(1)$ by a non-increasing
  2002	envelope; this costs only a polylogarithmic factor. Hence the expected total time is $L_N^{(1+\theta)/\sqrt2+o(1)}$.
  2003	
  2004	\emph{Uniformity.} All $L^{o(1)}$ factors are uniform in $N$: $(\log N)^{O(k)}$, $\binom{2k}k$, $2^{O(\omega(N))}$ (Lemma~\ref{lem:omega}),
  2005	$\gamma^{-O(k)}$ (Theorem~\ref{thm:Dk}), and the Wiedemann and Hensel polylogarithms. No exceptional set of $N$ arises. The analytic inputs need
  2006	only $\gcd(N,t)=1$, the absence of prime factors $\le B$, and the coprimality statements of Lemma~\ref{lem:coprime}. They need no squarefreeness
  2007	and no condition on the residue classes of the prime factors of $N$.
  2008	\end{proof}
