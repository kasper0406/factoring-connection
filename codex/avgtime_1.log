   209	# 3. One DCL stage as LP constraints: cost <= C, failure fraction <= N^{-e}.
   210	# ---------------------------------------------------------------------------
   211	def _stage(lp: LP, s: str, C: Dict[str, F], e: str, j: F, detector: bool,
   212	           t_shared: Optional[str] = None) -> None:
   213	    """Add stage s with variables h,y,mu,(t) ; constraints cost <= C (a linear form
   214	    given as dict, e.g. {'z':1,'e0':1}) and e <= each failure exponent."""
   215	    h, y, mu = lp.var(f"h{s}"), lp.var(f"y{s}"), lp.var(f"mu{s}")
   216	    t = t_shared or lp.var(f"t{s}")
   217	    neg = {k: -v for k, v in C.items()}
   218	    lp.le({mu: 1, **neg}, 0)
   219	    lp.le({h: 2, y: 1, **neg}, 0)
   220	    lp.le({h: 3, y: -1, mu: -1, **neg}, F(-1, 2))
   221	    # side constraints
   222	    lp.le({y: -1}, F(-1, 8))                 # Y^4 > sqrt2 P   (infimum)
   223	    lp.le({h: 2, y: -1}, 0)                  # Y > H^2         (infimum)
   224	    lp.le({y: 1}, F(1, 4))                   # large-sieve level
   225	    lp.le({t: 1}, F(1, 2))
   226	    # failure exponent e <= each term's saving
   227	    lp.le({e: 1, h: -2 * j}, 0)                          # E_b
   228	    lp.le({e: 1, t: -1, h: 3, mu: 1}, 0)                 # E_c1
   229	    lp.le({e: 1, h: 2, y: 1, mu: 1}, F(1, 2))            # E_c2
   230	    if detector:
   231	        lp.le({e: 1, t: 3}, 1)                           # C(T) coincidences
   232	    else:
   233	        lp.le({e: 1, t: 2}, F(1, 2))                     # E_a
