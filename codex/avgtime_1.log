   204	def choose_m(targets: List[Dict], mbar: int) -> int:
   205	    """Public choice of the baby length: minimise m + sum ceil(W/m) over a
   206	    geometric grid in [1, max W] (never above max W; max W <= mbar)."""
   207	    if not targets:
   208	        return 1
   209	    Wmax = max(t["W"] for t in targets)
   210	    best, m = None, 1
   211	    while True:
