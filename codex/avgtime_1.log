     1	"""Exact (Fraction) exponent bookkeeping for notes/avgtime_results.md.
     2	
     3	All exponents are in units of n = log2 N, so "x" means 2^{x n} = N^x, up to
     4	(log N)^{O(1)} factors.  P = N^{1/2}.  Free parameters of one DCL-det stage:
     5	
     6	  h   H = N^h            weight height
     7	  y   Y = N^y            band scale
     8	  mu  m = N^mu           baby-list length (m <= mbar is all the success proof needs)
     9	  t   T = N^t            order threshold (analysis only for DCL; detector length if used)
    10	
    11	Bounds proved in notes/dcltheorem_results.md (Theorem D', section 4), with Lemma 10
    12	evaluated at the true baby length m (the delta-range of Lemma 7 is (-m, m)):
    13	
    14	  cost   = max(mu, 2h + y, 3h + 1/2 - y - mu)        [m + T_k (1 + mbar/m)]
    15	  E_a    = 2t - 1/2                                  [n T^2 / P]
    16	  E_b    = -2 j h                                    [(n/H^2)^j; proved j = 1]
    17	  E_c1   = 3h + mu - t                               [n H^3 m / T]
    18	  E_c2   = 2h + y + mu - 1/2                         [n H^2 Y m / P]
    19	  C(T)   = 3t - 1   (detector failure: ord_p 2 = ord_q 2 <= T)  [T^3 / P^2]
    20	  detector cost = t/2
    21	
    22	Side constraints: Y > H^2 (y > 2h, Lemma 9), Y^4 > sqrt2 P (y > 1/8, Lemma 6),
    23	large-sieve level 256 Y^2 <= P (y < 1/4), 0 <= t < 1/2.
    24	
    25	Nothing here is an experiment: it is exact linear algebra on these exponents.
    26	"""
    27	from __future__ import annotations
    28	
    29	from fractions import Fraction as F
    30	from itertools import combinations
    31	from typing import Dict, List, Optional, Sequence, Tuple
    32	
    33	ONE_FIFTH = F(1, 5)      # Harvey--Hittmeir fallback exponent
    34	ONE_SIXTH = F(1, 6)
    35	
    36	
    37	# ---------------------------------------------------------------------------
    38	# 1. Audit of Theorem D' as written: H = n 2^{eps n/2}, Y = 2^{n/6} H^{-1/3},
    39	#    T = 2^{(1/4 - eps) n}, m = mbar.  Each requirement is a + b*eps < 0.
    40	# ---------------------------------------------------------------------------
    41	def dprime_exponents(eps: F) -> Dict[str, F]:
    42	    h = eps / 2
    43	    y = ONE_SIXTH - h / 3
    44	    t = F(1, 4) - eps
    45	    mu = h + F(1, 2) - 2 * y          # mbar = H P / Y^2
    46	    return {"h": h, "y": y, "t": t, "mu": mu,
    47	            "cost": max(mu, 2 * h + y, 3 * h + F(1, 2) - y - mu),
    48	            "E_a": 2 * t - F(1, 2), "E_b": -2 * h,
    49	            "E_c1": 3 * h + mu - t, "E_c2": 2 * h + y + mu - F(1, 2)}
    50	
    51	
    52	def dprime_requirements() -> Dict[str, Tuple[F, F]]:
    53	    """name -> (a, b): requirement a + b*eps < 0 (strict: polylog factors).
    54	
    55	    Separations: Y > H^2 (Lemma 9 distinct classes), Y^4 > sqrt2 P (Lemma 6).
    56	    Exceptional terms must be o(N^{-eps}) * polylog^{-1}: E_x + eps < 0.
    57	    E_b is N^{-eps} exactly by the choice H = n 2^{eps n/2} (no requirement).
    58	    'useful' = D' cheaper than HH (not needed for validity)."""
    59	    def lin(f):
    60	        a = f(F(0))
    61	        b = f(F(1)) - a
    62	        return a, b
    63	    req = {
    64	        "Y>H^2 (Lemma 9)": lin(lambda e: 2 * dprime_exponents(e)["h"] - dprime_exponents(e)["y"]),
    65	        "Y^4>sqrt2 P (Lemma 6)": lin(lambda e: F(1, 2) - 4 * dprime_exponents(e)["y"]),
    66	        "E_a < N^-eps": lin(lambda e: dprime_exponents(e)["E_a"] + e),
    67	        "E_c1 < N^-eps": lin(lambda e: dprime_exponents(e)["E_c1"] + e),
    68	        "E_c2 < N^-eps": lin(lambda e: dprime_exponents(e)["E_c2"] + e),
    69	        "useful: cost < 1/5": lin(lambda e: dprime_exponents(e)["cost"] - ONE_FIFTH),
    70	    }
    71	    return req
    72	
    73	
    74	def sup_eps(a: F, b: F) -> Optional[F]:
    75	    """sup of eps > 0 with a + b eps < 0 (None = no upper limit; requires a < 0 or b < 0)."""
    76	    if b <= 0:
    77	        return None if a < 0 or b < 0 else F(0)
    78	    return -a / b
    79	
    80	
    81	def dprime_admissible() -> Tuple[F, str]:
    82	    """Binding validity constraint of D' as written (excluding 'useful')."""
    83	    best, name = None, None
    84	    for k, (a, b) in dprime_requirements().items():
    85	        if k.startswith("useful"):
    86	            continue
    87	        s = sup_eps(a, b)
    88	        if s is not None and (best is None or s < best):
    89	            best, name = s, k
    90	    return best, name
    91	
