    94	# 2. A small exact LP solver (two-phase tableau simplex, Bland's rule).
    95	#    maximise c.x  s.t.  A x <= b,  x >= 0.   Fractions throughout.
    96	# ---------------------------------------------------------------------------
    97	def lp_max(c: Sequence[F], A: Sequence[Sequence[F]], b: Sequence[F]
    98	           ) -> Tuple[Optional[F], Optional[List[F]]]:
    99	    m, nv = len(A), len(c)
   100	    # columns: x (nv) | slack/surplus (m) | artificial (m)
   101	    rows, basis, art = [], [], []
   102	    for i in range(m):
   103	        Ai, bi = [F(v) for v in A[i]], F(b[i])
   104	        s = [F(0)] * m
   105	        a = [F(0)] * m
   106	        if bi >= 0:
   107	            s[i] = F(1)
   108	            rows.append(Ai + s + a + [bi])
   109	            basis.append(nv + i)
   110	        else:
   111	            s[i] = F(-1)
   112	            a[i] = F(1)
   113	            rows.append([-v for v in Ai] + s + a + [-bi])
   114	            basis.append(nv + m + i)
   115	            art.append(nv + m + i)
   116	    ncol = nv + 2 * m
   117	
   118	    def pivot(r, col):
   119	        pv = rows[r][col]
   120	        rows[r] = [v / pv for v in rows[r]]
   121	        for i in range(m):
   122	            if i != r and rows[i][col] != 0:
   123	                f = rows[i][col]
   124	                rows[i] = [vi - f * vr for vi, vr in zip(rows[i], rows[r])]
   125	        basis[r] = col
   126	
   127	    def simplex(obj, allowed):
   128	        # obj: maximise obj.x over columns; reduced costs computed each step
   129	        while True:
   130	            cb = [obj[basis[i]] for i in range(m)]
   131	            enter = None
   132	            for j in allowed:
   133	                if j in basis:
   134	                    continue
   135	                red = obj[j] - sum(cb[i] * rows[i][j] for i in range(m))
   136	                if red > 0:
   137	                    enter = j
   138	                    break
   139	            if enter is None:
   140	                return "opt"
   141	            best, r = None, None
   142	            for i in range(m):
   143	                if rows[i][enter] > 0:
   144	                    ratio = rows[i][-1] / rows[i][enter]
   145	                    if best is None or ratio < best or (ratio == best and basis[i] < basis[r]):
   146	                        best, r = ratio, i
   147	            if r is None:
   148	                return "unbounded"
   149	            pivot(r, enter)
   150	
   151	    allcols = list(range(ncol))
   152	    if art:
   153	        obj1 = [F(0)] * ncol
   154	        for j in art:
   155	            obj1[j] = F(-1)
   156	        simplex(obj1, allcols)
   157	        if sum(rows[i][-1] for i in range(m) if basis[i] in art) != 0:
   158	            return None, None                       # infeasible
   159	        # drive remaining artificials out of the basis
   160	        for i in range(m):
   161	            if basis[i] in art:
   162	                for j in range(nv + m):
   163	                    if rows[i][j] != 0:
   164	                        pivot(i, j)
   165	                        break
   166	    obj2 = [F(v) for v in c] + [F(0)] * (2 * m)
   167	    st = simplex(obj2, list(range(nv + m)))
   168	    if st == "unbounded":
   169	        return None, None
   170	    x = [F(0)] * nv
   171	    for i in range(m):
   172	        if basis[i] < nv:
   173	            x[basis[i]] = rows[i][-1]
   174	    return sum(F(ci) * xi for ci, xi in zip(c, x)), x
