    34	def _iroot(x: int, k: int) -> int:
    35	    lo, hi = 0, 1 << (x.bit_length() // k + 1)
    36	    while lo < hi:
    37	        mid = (lo + hi + 1) // 2
    38	        if mid ** k <= x:
    39	            lo = mid
    40	        else:
    41	            hi = mid - 1
