   279	# ---------------------------------------------------------------------------
   280	# 5. The ladder schedule of Theorem AV (integers, n-only)
   281	# ---------------------------------------------------------------------------
   282	def icbrt_like_root(x: int, num: int, den: int) -> int:
   283	    """ceil(x^(num/den)) exactly for integers x >= 1."""
   284	    target = x ** num
   285	    lo, hi = 1, 1
   286	    while hi ** den < target:
   287	        hi *= 2
   288	    while lo < hi:
   289	        mid = (lo + hi) // 2
   290	        if mid ** den >= target:
   291	            hi = mid
   292	        else:
   293	            lo = mid + 1
   294	    return lo
   295	
   296	
   297	def ladder_schedule(n: int) -> List[int]:
   298	    """H_1 = ceil(sqrt n), H_{i+1} = ceil(H_i^{6/5}), stop at H_max = n^2 * 2^{ceil(n/60)}
   299	    (last step truncated).  All stages satisfy H_{i+1}^5 <= 2^5 H_i^6 (i.e.
   300	    H_{i+1}^{5/3} <= 2^{5/3} H_i^2), which is all the expectation bound uses."""
   301	    Hmax = (n * n) << (-(-n // 60))
   302	    from math import isqrt
   303	    Hs = [isqrt(n - 1) + 1]
   304	    while Hs[-1] < Hmax:
   305	        Hs.append(min(Hmax, icbrt_like_root(Hs[-1], 6, 5)))
   306	    return Hs
   307	
   308	
   309	def ladder_bound_terms(n: int, c: int = 0) -> List[F]:
   310	    """Per-stage expectation terms / (n^c 2^{n/6}) of the proof's bound (constants 1):
   311	    stage 1: H_1^{5/3};  stage i >= 2: H_i^{5/3} * min(1, n / H_{i-1}^2).
   312	    Returned as exact Fractions of the 5th powers (term^3 to avoid roots)."""
   313	    Hs = ladder_schedule(n)
   314	    out = [F(Hs[0] ** 5)]                       # (H^{5/3})^3
   315	    for a, b in zip(Hs, Hs[1:]):
   316	        out.append(F(b ** 5) * min(F(1), F(n, a * a)) ** 3)
   317	    return out
     1	"""OPERATIONAL: small-order detector (notes/avgtime_results.md, Lemma S).
     2	
     3	Sees only N and the public bound T.  Finds a proper divisor of N whenever the
     4	smallest order d_min = min_{r | N prime} ord_r(2) satisfies d_min <= T and the
     5	primes r with ord_r(2) = d_min do not exhaust N (for N = pq: ord_p 2 != ord_q 2).
     6	
     7	Baby-step giant-step on the exponent:
     8	  m = ceil(sqrt T), babies 2^i (0 <= i < m), f(X) = prod (X - 2^i),
     9	  giants 2^{jm} (1 <= j <= ceil(T/m));  G_j = gcd(f(2^{jm}), N).
    10	  j* = first j with G_j > 1;  then gcd(2^k - 1, N) for k in ((j*-1)m, j*m].
    11	Block j has G_j > 1 iff ((j-1)m, jm] contains a positive multiple of some
    12	ord_r(2), so j* = ceil(d_min/m) and k = d_min is scanned; gcd(2^{d_min}-1, N)
    13	is the product of the r with ord_r(2) | d_min, i.e. with ord_r(2) = d_min.
    14	Cost: O(sqrt T) ring operations plus the product/remainder trees.
    15	Not new: elementary BSGS order search (cf. Pollard 1974, Pollard--Strassen).
    16	"""
    17	from __future__ import annotations
    18	
    19	from math import gcd, isqrt
    20	from typing import Optional
    21	
    22	from src.common.metrics import Metrics
    23	from src.dcltheorem.stage3 import eval_baby_poly_at_giants
    24	
    25	
    26	def _proper(d: int, N: int) -> bool:
    27	    return 1 < d < N and N % d == 0
    28	
    29	
    30	def small_order_detector(N: int, T: int, met: Optional[Metrics] = None) -> Optional[int]:
    31	    met = met or Metrics()
    32	    if N < 4 or T < 1:
    33	        return None
    34	    if N % 2 == 0:
    35	        return 2
    36	    m = isqrt(T - 1) + 1 if T > 1 else 1          # ceil(sqrt T)
    37	    J = -(-T // m)                                  # ceil(T/m); J*m >= T
    38	    g = pow(2, m, N)
    39	    giants, x = [], 1
    40	    for _ in range(J):
    41	        x = x * g % N
    42	        met.inc("mulN")
    43	        giants.append(x)
    44	    vals = eval_baby_poly_at_giants(N, 2, m, giants, met)
    45	    for j, v in enumerate(vals, start=1):
    46	        met.inc("gcdN")
    47	        G = gcd(v, N)
    48	        if G == 1:
    49	            continue
    50	        # first block with a hit: scan k in ((j-1)m, jm]
    51	        k0 = (j - 1) * m + 1
    52	        y = pow(2, k0, N)
    53	        for k in range(k0, j * m + 1):
    54	            met.inc("gcdN")
    55	            d = gcd(y - 1, N)
    56	            if _proper(d, N):
