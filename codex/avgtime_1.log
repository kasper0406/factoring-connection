   236	def single_fallback(j=1, detector: bool = False) -> Tuple[F, Dict[str, F]]:
   237	    """min over all stage parameters of max(cost, 1/5 - e) [D' then HH]."""
   238	    j = F(j)
   239	    lp = LP()
   240	    z, e = lp.var("z"), lp.var("e")
   241	    _stage(lp, "", {z: F(1)}, e, j, detector, t_shared=None)
   242	    lp.le({e: -1, z: -1}, -ONE_FIFTH)                    # 1/5 - e <= z
   243	    if detector:
   244	        lp.le({"t": F(1, 2), z: -1}, 0)                  # detector cost t/2 <= z
   245	    return lp.minimise(z)
