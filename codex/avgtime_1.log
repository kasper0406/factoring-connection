   248	def ladder(k: int, j=1, detector: bool = False) -> Tuple[F, Dict[str, F]]:
   249	    """k DCL stages then HH.  E[T] exponent z with stage i cost <= z + e_{i-1}
   250	    (it is reached on at most N^{-e_{i-1}} of S_n), HH: 1/5 - e_k <= z.
   251	    With the detector, one T is shared (it is run once, cost t/2 <= z)."""
   252	    j = F(j)
   253	    lp = LP()
   254	    z = lp.var("z")
   255	    tsh = lp.var("t") if detector else None
   256	    prev = None
   257	    for i in range(1, k + 1):
   258	        e = lp.var(f"e{i}")
   259	        C = {z: F(1)} if prev is None else {z: F(1), prev: F(1)}
   260	        _stage(lp, str(i), C, e, j, detector, t_shared=tsh)
   261	        prev = e
   262	    lp.le({prev: -1, z: -1}, -ONE_FIFTH)
   263	    if detector:
   264	        lp.le({tsh: F(1, 2), z: -1}, 0)
   265	    return lp.minimise(z)
