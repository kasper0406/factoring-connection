    71	# ---------------------------------------------------------------------------
    72	# balanced all-but-one exponent tree
    73	# ---------------------------------------------------------------------------
    74	def int_product_tree(xs: Sequence[int], met) -> List[List[int]]:
    75	    # gmpy2/GMP multiplication (FFT for large operands), so the tree costs
    76	    # O(M(log L) log #leaves) bit operations; CPython ints would be Karatsuba.
    77	    levels = [[gmpy2.mpz(x) for x in xs]]
    78	    while len(levels[-1]) > 1:
    79	        cur, nxt = levels[-1], []
    80	        for i in range(0, len(cur) - 1, 2):
    81	            met.inc("bigmul_bits", cur[i].bit_length() + cur[i + 1].bit_length())
    82	            nxt.append(cur[i] * cur[i + 1])
    83	        if len(cur) % 2:
    84	            nxt.append(cur[-1])
    85	        levels.append(nxt)
    86	    return levels
