    41	def dprime_exponents(eps: F) -> Dict[str, F]:
    42	    h = eps / 2
    43	    y = ONE_SIXTH - h / 3
    44	    t = F(1, 4) - eps
    45	    mu = h + F(1, 2) - 2 * y          # mbar = H P / Y^2
    46	    return {"h": h, "y": y, "t": t, "mu": mu,
    47	            "cost": max(mu, 2 * h + y, 3 * h + F(1, 2) - y - mu),
    48	            "E_a": 2 * t - F(1, 2), "E_b": -2 * h,
    49	            "E_c1": 3 * h + mu - t, "E_c2": 2 * h + y + mu - F(1, 2)}
    50	
