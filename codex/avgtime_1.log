    89	def all_but_one(base: int, exps: Sequence[int], N: int, met) -> Tuple[List[int], int]:
    90	    """([base^{E/e_j} for j], E) with E = prod exps, via the balanced product
    91	    tree: a node holding base^{E/prod(node)} passes base^{E/prod(node)*prod(sib)}
    92	    to each child.  Per level the exponent bit lengths sum to <= log2 E + #nodes."""
    93	    levels = int_product_tree(exps, met)
    94	    E = int(levels[-1][0])
    95	    vals = [base % N]
    96	    for lev in range(len(levels) - 2, -1, -1):
    97	        cur = levels[lev]
    98	        parent_count = len(levels[lev + 1])
    99	        new = [None] * len(cur)
   100	        for pi in range(parent_count):
   101	            li, ri = 2 * pi, 2 * pi + 1
   102	            if ri < len(cur):
   103	                new[li] = powN(vals[pi], int(cur[ri]), N, met)
   104	                new[ri] = powN(vals[pi], int(cur[li]), N, met)
   105	            else:
   106	                new[li] = vals[pi]          # odd node carried up unchanged
   107	        vals = new
   108	    return vals, E
