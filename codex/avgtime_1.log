   177	class LP:
   178	    """Tiny builder: named nonnegative variables, constraints sum coef*var <= rhs."""
   179	
   180	    def __init__(self):
   181	        self.names: List[str] = []
   182	        self.cons: List[Tuple[Dict[str, F], F]] = []
   183	
   184	    def var(self, name: str) -> str:
   185	        self.names.append(name)
   186	        return name
   187	
   188	    def le(self, coefs: Dict[str, F], rhs) -> None:
   189	        self.cons.append(({k: F(v) for k, v in coefs.items()}, F(rhs)))
   190	
   191	    def minimise(self, name: str) -> Tuple[F, Dict[str, F]]:
   192	        idx = {v: i for i, v in enumerate(self.names)}
   193	        c = [F(0)] * len(self.names)
   194	        c[idx[name]] = F(-1)
   195	        A, b = [], []
   196	        for coefs, rhs in self.cons:
   197	            row = [F(0)] * len(self.names)
   198	            for k, v in coefs.items():
   199	                row[idx[k]] += v
   200	            A.append(row)
   201	            b.append(rhs)
   202	        val, x = lp_max(c, A, b)
   203	        if val is None:
   204	            raise ValueError("LP infeasible or unbounded")
   205	        return -val, dict(zip(self.names, x))
