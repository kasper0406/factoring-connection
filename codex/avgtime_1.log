   114	def balanced_range(N: int) -> Tuple[int, int]:
   115	    """Integers p with p^2 < N <= 2 p^2 lie in [a0, b0]."""
   116	    a0 = isqrt(N // 2)
   117	    while 2 * a0 * a0 < N:
   118	        a0 += 1
   119	    b0 = isqrt(N)
   120	    return a0, b0
