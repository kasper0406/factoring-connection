   124	    """Lo <= B x + A N / x <= Hi for all real x in [a0, b0]:  Lo = floor(2 sqrt(ABN))
   125	    (AM-GM), Hi = max over the endpoints of ceil(F) (convexity)."""
   126	    met.inc("isqrt_ops")
   127	    lo = isqrt(4 * A * B * N)
   128	    hi = max(B * x + -(-(A * N) // x) for x in (a0, b0))
