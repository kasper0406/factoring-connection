   280	# 5. The ladder schedule of Theorem AV (integers, n-only)
   281	# ---------------------------------------------------------------------------
   282	def icbrt_like_root(x: int, num: int, den: int) -> int:
   283	    """ceil(x^(num/den)) exactly for integers x >= 1."""
   284	    target = x ** num
   285	    lo, hi = 1, 1
   286	    while hi ** den < target:
   287	        hi *= 2
   288	    while lo < hi:
   289	        mid = (lo + hi) // 2
   290	        if mid ** den >= target:
   291	            hi = mid
   292	        else:
   293	            lo = mid + 1
   294	    return lo
   295	
