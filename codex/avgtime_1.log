    29	
    30	def is_prime(x: int) -> bool:
    31	    return x >= 2 and bool(gmpy2.is_prime(x, 50))
    32	
    33	
    34	def _iroot(x: int, k: int) -> int:
    35	    lo, hi = 0, 1 << (x.bit_length() // k + 1)
    36	    while lo < hi:
    37	        mid = (lo + hi + 1) // 2
    38	        if mid ** k <= x:
    39	            lo = mid
    40	        else:
    41	            hi = mid - 1
    42	    return lo
    43	
    44	
    45	def lehman_split(N: int) -> Optional[int]:
    46	    """Lehman 1974: a proper divisor of N, or None iff N is 1 or prime. Deterministic."""
    47	    if N < 4:
    48	        return None
    49	    c = _iroot(N, 3)
    50	    for a in range(2, c + 2):
    51	        if a < N and N % a == 0:
    52	            return a
    53	    for k in range(1, c + 2):
    54	        four_kN = 4 * k * N
    55	        r = isqrt(four_kN)
    56	        xmax = _iroot(N // (4096 * k ** 3), 6) if N >= 4096 * k ** 3 else 0
    57	        for a in range(r, r + xmax + 2):
    58	            b2 = a * a - four_kN
    59	            if b2 < 0:
    60	                continue
    61	            b = isqrt(b2)
    62	            if b * b == b2:
    63	                d = gcd(a + b, N)
    64	                if 1 < d < N:
    65	                    return d
    66	    return None
    67	
    68	
    69	def complete_factorisation(N: int, split: Callable[[int], Optional[int]] = lehman_split) -> List[int]:
    70	    if N < 2:
    71	        return []
    72	    if is_prime(N):
    73	        return [N]
    74	    d = split(N)
    75	    if d is None:            # cannot happen for composite N with a correct split
    76	        raise RuntimeError("fallback failed on composite N")
    77	    return sorted(complete_factorisation(d, split) + complete_factorisation(N // d, split))
    78	
    79	
    80	def stage_design(n: int, H: int) -> Design:
    81	    """DCL-det_{n,H}: Y = ceil(2^{n/6} / floor(H^{1/3})) (D' convention), K = 4, l = 3 mod 4.
    82	    (At toy sizes Y > H^2 is enforced by max; the theorem has it for n >= n_0.)"""
    83	    Y = -(-pow2_frac(n, 1, 6) // max(1, icbrt(H)))
    84	    return Design(n=n, H=H, Y=max(3, H * H + 1, Y), K=4, mod4=True, label=f"ladder H={H}")
    85	
    86	
    87	def ladder_factor(N: int, n: int, Hs: Sequence[int], T: Optional[int] = None,
    88	                  split: Callable[[int], Optional[int]] = lehman_split,
    89	                  met: Optional[Metrics] = None) -> Dict:
    90	    """Run LAD on N.  Returns {'factors': sorted prime list, 'stage': name}."""
    91	    met = met or Metrics()
    92	    if N < 2:
    93	        return {"factors": [], "stage": "trivial"}
    94	    T = (1 << (3 * n // 10)) if T is None else T
    95	
    96	    def finish(d: int, stage: str) -> Dict:
    97	        e = N // d
    98	        if is_prime(d) and is_prime(e):
    99	            return {"factors": sorted([d, e]), "stage": stage}
   100	        return {"factors": complete_factorisation(N, split), "stage": stage + "+fallback"}
   101	
   102	    d = small_order_detector(N, T, met)
   103	    if d is not None:
   104	        return finish(d, "detector")
   105	    for i, H in enumerate(Hs, start=1):
   106	        r = dcl_det(N, stage_design(n, H), met)
   107	        if r["factor"] is not None:
   108	            return finish(r["factor"], f"dcl{i}")
   109	    return {"factors": complete_factorisation(N, split), "stage": "fallback"}
