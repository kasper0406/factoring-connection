"""Exponent bookkeeping for design (a'''_k) (notes/ldbound_results.md §1, §5).

Design (a'''_k) = pcest's (a''_k) plus one extra field parameter: a uniform random prime
w in (W, 2W], W = N^(s + 1/(4k) + eta0/2), and F(g0, g1) = N w (Lemma GB applied to N w).
All sizes are exponents of N (eta0 -> 0 slack omitted unless stated):
  s = 1/(d+1);  l = N^(1/(2k));  V = N^(1/(4k));  rational modulus t = |G| = N^(s + 1/(4k));
  |a_0| = O(M w) = N^(2s + 1/(4k));  H = N^h.
Constraints on h:
  (W)   H >= w N^(eta0/2)  (FM window, |F^| << t Y_omega; X_F unchanged): h >= s + 1/(4k)
  (lvl) level 1/2 for FM (Lemma 8.5'):   h >= s - (d-2)/(4k)      [implied by (W)]
  (ker) Lemma Kern H >= V^2:            h >= 1/(2k)              [implied by (W) iff k >= (d+1)/4]
theta''' = (s - 1/(4k)) + (s + h + d/(4k)) = 2s + h + (d-1)/(4k) = 3s + d/(4k)  at h = s + 1/(4k).
Constant (Lenstra-Pomerance shape test): c = (1 + theta)/sqrt 2; infimum over k: (1 + 3/(d+1))/sqrt 2,
the same as for (a''_k) (pcest).
"""
from __future__ import annotations

from fractions import Fraction
from math import sqrt
from typing import Dict

from src.pcest.params import theta as theta_pp  # design (a''_k), for comparison


def h_floor(d: int, k: int) -> Fraction:
    s = Fraction(1, d + 1)
    return max(s + Fraction(1, 4 * k), s - Fraction(d - 2, 4 * k), Fraction(1, 2 * k))


def theta3(d: int, k: int) -> Fraction:
    s = Fraction(1, d + 1)
    return 2 * s + h_floor(d, k) + Fraction(d - 1, 4 * k)


def c_const(th) -> float:
    return (1 + float(th)) / sqrt(2)


def c_ps(th) -> float:
    """Theorem A' (Pollard-Strassen smoothness tests), closed form valid for theta <= 1/2."""
    th = float(th)
    assert th <= 0.5
    return 1 / sqrt(2) + (sqrt(2) - sqrt(2 - 4 * th)) / 2


def min_k(d: int, target: float = 1.0, design: str = "a3", kmax: int = 10 ** 5) -> int:
    for k in range(1, kmax):
        if 4 * k <= d + 1:          # FM needs k > (d+1)/4
            continue
        th = theta3(d, k) if design == "a3" else theta_pp(d, k, "pair")
        if th < 1 and c_const(th) < target:
            return k
    raise ValueError("no k found")


def margins(d: int, k: int) -> Dict[str, Fraction]:
    """Exponent (of N) of every polynomial margin used in the LD* proof; all must be > 0
    (each is then at least the fixed slack and absorbs any L^{O(1)} factor)."""
    s = Fraction(1, d + 1)
    h = h_floor(d, k)
    nu = Fraction(1, 4 * k)
    return {
        # FM needs q = s + nu > 1/(2k): k > (d+1)/4
        "FM_k": s + nu - 2 * nu,
        # Lemma 8.5' level: q < xi/2 with xi = s + h + d nu
        "FM_level": (s + h + d * nu) / 2 - (s + nu),
        # Lemma Kern: H >= V^2
        "Kern": h - 2 * nu,
        # diagonal / window: T = H V^(d-1) >> l q (moduli t Delta << X)
        "diag": h + (d - 1) * nu - 2 * nu,
        # step (C) of (***): Y^2 q^2 << T rho rho, i.e. h + (d-1) nu > 4 nu
        "C_R2": h + (d - 1) * nu - 4 * nu,
        # step (C): pi_J = N^(1/(2k)) beats 1/rho_F = L^{O(1)}
        "C_X": 2 * nu,
        # step (B): X'_+ q^2 << X rho rho: X / X' = l T
        "B_R2": 2 * nu + h + (d - 1) * nu,
        # Brun-Titchmarsh: W / t_max = N^(eta0/2) -- by construction (slack only)
    }


def table(ds=(7, 9, 11, 13, 19), ks=(10, 12, 20, 30, 50, 100, 1000)) -> Dict:
    out = {}
    for d in ds:
        rows = {}
        for k in ks:
            if 4 * k <= d + 1:
                continue
            t3, t2 = theta3(d, k), theta_pp(d, k, "pair")
            rows[k] = dict(theta_a3=float(t3), c_a3=c_const(t3),
                           theta_a2=float(t2), c_a2=c_const(t2))
        out[d] = dict(rows=rows, c_limit=c_const(Fraction(3, d + 1)),
                      min_k_a3=min_k(d) if c_const(Fraction(3, d + 1)) < 1 else None,
                      min_k_a2=min_k(d, design="a2") if c_const(Fraction(3, d + 1)) < 1 else None)
    return out


if __name__ == "__main__":
    import json
    print(json.dumps(table(), indent=1))
"""Exact checks of the identities and inequalities behind notes/ldbound_results.md.

OPERATIONAL (N, public parameters, seed only):
- field_w(N, w, d, g0, g1, R): f = gbe(N w) + (g1 x - g0) R.  F(g0, g1) = N w.
DIAGNOSTIC (pure arithmetic; no factorization of N is ever used):
- lemma12_w: g1^d F(P) == N w b^d (mod G(P)).
- pair_count_direct / pair_count_ramanujan: #{(F,F'): F == F' (mod m)} computed directly and via
  (1/m) sum_{m'|m} sum_{F,F'} c_{m'}(F - F')  (Ramanujan sums; = the additive Parseval identity
  Q(m) = (1/m) sum_{m'|m} sum_{(a,m')=1} |S(a/m')|^2, in exact integer form).
- bt_ratio(t, W): max_a #{w prime in (W,2W], w == a (t)} * phi(t) / #{w}  versus the
  Montgomery-Vaughan Brun-Titchmarsh bound 4 W log W' ... (see bt_bound).
- lift_chain(...): for one toy pair (P, P', g, w): Z <= (Q + Q')/2, Q <= Q0(t, Delta, r0),
  and sum over all reduced r0 of Q0 <= Q_full(t Delta).
"""
from __future__ import annotations

from math import gcd, log
from typing import Dict, List, Sequence

import sympy

from src.pcest.geometry import gbe, hom_eval


def field_w(N: int, w: int, d: int, g0: int, g1: int, R: Sequence[int]) -> List[int]:
    f = gbe(N * w, d, g0, g1)
    assert len(R) == d
    for j, r in enumerate(R):
        f[j + 1] += g1 * r
        f[j] -= g0 * r
    return f


def lemma12_w(f: Sequence[int], N: int, w: int, g0: int, g1: int, a: int, b: int) -> bool:
    d = len(f) - 1
    G = g1 * a - g0 * b
    if G == 0:
        return True
    return (pow(g1, d) * hom_eval(f, a, b) - N * w * b ** d) % abs(G) == 0


def ramanujan(m: int, n: int) -> int:
    """c_m(n) = sum_{e | gcd(m, n)} e mu(m/e)."""
    g = gcd(m, n)
    return sum(e * sympy.mobius(m // e) for e in sympy.divisors(g))


def pair_count_direct(vals: Sequence[int], m: int) -> int:
    cnt: Dict[int, int] = {}
    for v in vals:
        cnt[v % m] = cnt.get(v % m, 0) + 1
    return sum(c * c for c in cnt.values())


def pair_count_ramanujan(vals: Sequence[int], m: int) -> int:
    tot = 0
    for mp in sympy.divisors(m):
        for v in vals:
            for v2 in vals:
                tot += ramanujan(mp, v - v2)
    assert tot % m == 0
    return tot // m


def bt_ratio(t: int, W: int) -> Dict[str, float]:
    ws = list(sympy.primerange(W + 1, 2 * W + 1))
    cnt: Dict[int, int] = {}
    for w in ws:
        cnt[w % t] = cnt.get(w % t, 0) + 1
    phi = int(sympy.totient(t))
    mx = max(cnt.values())
    bound = 4 * W / (phi * log(2 * W / t))       # Montgomery-Vaughan: pi(2W; t, a) <= this
    return dict(max_class=mx, bt_bound=bound, ratio_to_uniform=mx * phi / len(ws),
                n_primes=len(ws), ok=mx <= bound)


def smooth(n: int, B: int) -> bool:
    n = abs(n)
    if n == 0:
        return False
    for p in sympy.primerange(2, B + 1):
        while n % p == 0:
            n //= p
        if n == 1:
            return True
    return n == 1


def smooth_sieve(X: int, B: int):
    """Set of B-smooth integers in [1, X] (exact; numpy sieve)."""
    import numpy as np
    v = np.arange(X + 1, dtype=np.int64)
    for p in sympy.primerange(2, B + 1):
        pk = p
        while pk <= X:
            v[::pk] //= p
            pk *= p
    return set(int(i) for i in np.nonzero(v == 1)[0] if i >= 1)


def lift_chain(N: int, w: int, d: int, g: Sequence[int], P, P2, T: int, B: int,
               Xstar: int = None, smooth_set=None) -> Dict[str, int]:
    """Exact check of steps 2-4 of the LD* proof on one pair.

    A_j(P) = #{z in [-T,T], z == j (|Delta|), Fhat(P) + G z B-smooth}; Z = sum_j A_j(P) A_{kappa^(d-1) j}(P');
    Q(P) = sum_j A_j(P)^2.  Q0 = #{(F,F') smooth in [-X*,X*]: F == F' == r0 (t), F == F' (t |Delta|)}.
    """
    g0, g1 = g
    a, b = P
    a2, b2 = P2
    Delta = a * b2 - a2 * b
    D = abs(Delta)
    fhat = gbe(N * w, d, g0, g1)
    G, G2 = g1 * a - g0 * b, g1 * a2 - g0 * b2
    F0, F02 = hom_eval(fhat, a, b), hom_eval(fhat, a2, b2)
    if Xstar is None:
        Xstar = max(abs(F0), abs(F02)) + max(abs(G), abs(G2)) * T
    if smooth_set is None:
        smooth_set = smooth_sieve(Xstar, B)
    isS = lambda x: abs(x) in smooth_set
    A = [0] * D
    A2 = [0] * D
    for z in range(-T, T + 1):
        if F0 + G * z != 0 and isS(F0 + G * z):
            A[z % D] += 1
        if F02 + G2 * z != 0 and isS(F02 + G2 * z):
            A2[z % D] += 1
    # kappa: P' == kappa P (mod Delta)
    kappa = None
    for k0 in range(D):
        if (a2 - k0 * a) % D == 0 and (b2 - k0 * b) % D == 0:
            kappa = k0
            break
    assert kappa is not None
    Z = sum(A[j] * A2[(pow(kappa, d - 1, D) * j) % D] for j in range(D))
    Q, Q2 = sum(x * x for x in A), sum(x * x for x in A2)
    t = abs(G)
    r0 = F0 % t
    vals = [F for F in range(-Xstar, Xstar + 1) if F != 0 and isS(F)]
    cls: Dict[int, int] = {}
    for F in vals:
        if F % t == r0:
            cls[F % (t * D)] = cls.get(F % (t * D), 0) + 1
    Q0 = sum(c * c for c in cls.values())
    # all reduced r0' mod t
    byres: Dict[int, int] = {}
    for F in vals:
        if gcd(F, t) == 1:
            byres[F % (t * D)] = byres.get(F % (t * D), 0) + 1
    Q0_all = sum(c * c for c in byres.values())
    Qfull = pair_count_direct(vals, t * D)
    return dict(Delta=Delta, Xstar=Xstar, Z=Z, Q=Q, Q2=Q2, Q0=Q0, Q0_all=Q0_all, Qfull=Qfull,
                r0_ok=int((pow(g1, d, t) * F0 - N * w * pow(b, d, t)) % t == 0),
                chain_ok=int(2 * Z <= Q + Q2 and Q <= Q0 and Q0 <= Q0_all <= Qfull))
"""Tests for src/ldbound (notes/ldbound_results.md)."""
from fractions import Fraction
from math import gcd
import random

import sympy

from src.ldbound import params
from src.ldbound.checks import (bt_ratio, field_w, lemma12_w, lift_chain, pair_count_direct,
                                pair_count_ramanujan)
from src.pcest.geometry import hom_eval


def test_theta3_formula_and_limits():
    for d in (3, 5, 7, 9, 11, 19):
        s = Fraction(1, d + 1)
        for k in (d, 2 * d, 50, 1000):
            if 4 * k <= d + 1:
                continue
            assert params.theta3(d, k) == 3 * s + Fraction(d, 4 * k)
            assert all(v > 0 for v in params.margins(d, k).values()), (d, k)
    assert abs(params.c_const(Fraction(3, 10)) - 0.91924) < 1e-4
    assert params.min_k(9) == 20 and params.min_k(9, design="a2") == 12
    assert params.min_k(11) < params.min_k(9) < params.min_k(7)


def test_field_w_resultant_and_lemma12():
    rng = random.Random(1)
    for _ in range(40):
        d = rng.choice([3, 5, 7])
        N = rng.randrange(10 ** 20, 10 ** 21) | 1
        M = int(round(N ** (1 / (d + 1))))
        while True:
            g0, g1 = rng.randrange(M // 2, M), rng.randrange(M // 2, M)
            if gcd(g0, g1) == 1 and g1 >= 2:
                break
        w = sympy.nextprime(rng.randrange(10 ** 6, 2 * 10 ** 6))
        R = [rng.randrange(-50, 51) for _ in range(d)]
        f = field_w(N, w, d, g0, g1, R)
        assert hom_eval(f, g0, g1) == N * w
        # |a_i| <= g1/2 (i>=1) for the GB part, |a_0| = O(M w)
        for _ in range(20):
            a, b = rng.randrange(-30, 31), rng.randrange(1, 31)
            if gcd(a, b) == 1:
                assert lemma12_w(f, N, w, g0, g1, a, b)


def test_ramanujan_parseval_identity():
    rng = random.Random(2)
    for _ in range(15):
        vals = [rng.randrange(-200, 200) for _ in range(rng.randrange(5, 25))]
        m = rng.randrange(1, 40)
        assert pair_count_direct(vals, m) == pair_count_ramanujan(vals, m)


def test_brun_titchmarsh_ratio():
    for t, W in ((97, 20000), (210, 30000), (1001, 60000)):
        r = bt_ratio(t, W)
        assert r["ok"]
        assert r["ratio_to_uniform"] < 3.0


def test_lift_chain_toy():
