+from math import isqrt
+from random import Random
+
+
+def mul(a, b, g):
+    d = len(g) - 1
+    c = [0] * (2 * d - 1)
+    for i, x in enumerate(a):
+        for j, y in enumerate(b):
+            c[i + j] += x * y
+    for i in range(2 * d - 2, d - 1, -1):
+        for j in range(d):
+            c[i - d + j] -= c[i] * g[j]
+    return c[:d]
+
+
+rng = Random(20261019)
+count = 0
+for d in (3, 5, 9):
+    for _ in range(300):
+        t = rng.choice([x for x in range(-20, 21) if x])
+        f = [rng.randint(-100, 100) for _ in range(d)] + [t]
+        g = [f[i] * t ** (d - 1 - i) for i in range(d)] + [1]
+        gp = [(i + 1) * g[i + 1] for i in range(d)]
+        eta = gp
+        mh = isqrt(sum(x * x for x in g)) + 1
+        gd = d * sum(map(abs, g)) * mh ** (d - 1)
+        u = gd * gd
+        for _ in range(rng.randint(0, 12)):
+            a, b = rng.randint(-1000, 1000), rng.randint(1, 1000)
+            z = [t * a, -b] + [0] * (d - 2)
+            eta = mul(eta, z, g)
+            u *= (sum(map(abs, z)) * mh ** (d - 1)) ** 2
+        ceil_sqrt_u = isqrt(u) + (isqrt(u) ** 2 != u)
+        bound = d * ceil_sqrt_u * 2 ** (d - 1) * mh * gd ** (d - 1)
+        assert max(map(abs, eta)) <= bound
+        count += 1
+print(f"SQ coefficient bound: {count} exact paired-product cases passed (d = 3, 5, 9).")
+
+# A cubic over a field is irreducible exactly when it has no root.
+for p in (17, 19, 23):
+    per_constant = []
+    for c in range(1, p):
+        n = sum(
+            all((x**3 + a * x*x + b * x + c) % p for x in range(p))
+            for a in range(p) for b in range(p)
+        )
+        assert 6 * n >= p**2
+        per_constant.append(n)
+    print(f"IR prescribed nonzero constant, d = 3, r = {p}: min count {min(per_constant)} >= r^2/6.")
+
+# The raw Legendre symbols do not encode quadratic characters in F_2.
+assert 1 % 2 == (-1) % 2
+assert (1 - 1) // 2 == 0 and (1 - (-1)) // 2 == 1
+print("Character encoding: raw +/-1 collapse modulo 2; (1 - Legendre)/2 is necessary.")

