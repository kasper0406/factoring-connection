+++ b/codex/scratch/systeq_1/systeq_blind_binomial_test.py
@@ -0,0 +1,126 @@
+"""Exact blind-round experiment; uses no repository data or third-party modules."""
+
+import gc
+import json
+import math
+import random
+import time
+from itertools import groupby
+
+B = 4096
+P, Q = 1_000_003, 1_000_033
+N = P * Q
+MIN_BITS = 80
+INDEX_BITS = 24
+INDEX_MASK = (1 << INDEX_BITS) - 1
+
+
+def is_prime(n):
+    return n >= 2 and all(n % d for d in range(2, math.isqrt(n) + 1))
+
+
+def candidates():
+    for n in range(4, B + 1):
+        value = n
+        for k in range(2, n // 2 + 1):
+            value = value * (n - k + 1) // k
+            if value.bit_length() >= MIN_BITS:
+                yield n, k, value
+
+
+def valuations(n, k, primes):
+    def factorial_valuation(t, p):
+        answer = 0
+        while t:
+            t //= p
+            answer += t
+        return answer
+
+    return [factorial_valuation(n, p) - factorial_valuation(k, p)
+            - factorial_valuation(n - k, p) for p in primes]
+
+
+def main():
+    start = time.monotonic()
+    assert is_prime(P) and is_prime(Q) and N.bit_length() == 40 and P > B
+    primes = [p for p in range(2, B + 1) if is_prime(p)]
+    records = [((v % N) << INDEX_BITS) | (n << 12) | k
+               for n, k, v in candidates()]
+    records.sort()
+    candidate_count = len(records)
+    duplicate_count = 0
+    pairs = []
+    for residue, group in groupby(records, key=lambda z: z >> INDEX_BITS):
+        bucket = list(group)
+        if len(bucket) < 2:
+            continue
+        distinct = {}
+        for packed in bucket:
+            index = packed & INDEX_MASK
+            n, k = index >> 12, index & 4095
+            value = math.comb(n, k)
+            if value in distinct:
+                duplicate_count += 1
+                continue
+            for other_value, other_index in distinct.items():
+                assert value != other_value and (value - other_value) % N == 0
+                pairs.append((other_index, (n, k)))
+            distinct[value] = (n, k)
+    del records
+    gc.collect()
+
+    basis = {}
+    zero_parity_rows = 0
+    exponent_rows = set()
+    for (n, k), (m, j) in pairs:
+        left, right = valuations(n, k, primes), valuations(m, j, primes)
+        row = tuple(a - b for a, b in zip(left, right))
+        divisor = math.gcd(*row)
+        normalized = tuple(a // divisor for a in row)
+        if next(a for a in normalized if a) < 0:
+            normalized = tuple(-a for a in normalized)
+        exponent_rows.add(normalized)
+        bits = sum((a & 1) << i for i, a in enumerate(row))
+        if not bits:
+            zero_parity_rows += 1
+        while bits:
+            pivot = bits.bit_length() - 1
+            if pivot in basis:
+                bits ^= basis[pivot]
+            else:
+                basis[pivot] = bits
+                break
+
+    # An exact control: independently sampled integers of each candidate's
+    # bit length, conditioned on being units. The seed is fixed in advance.
+    rng = random.Random(20261020)
+    control = []
+    for n, k, value in candidates():
+        bits = value.bit_length()
+        while True:
+            draw = (1 << (bits - 1)) | rng.getrandbits(bits - 1)
+            if math.gcd(draw, N) == 1:
+                control.append(draw % N)
+                break
+    control.sort()
+    control_pairs = sum(len(bucket) * (len(bucket) - 1) // 2
+                        for _, group in groupby(control)
+                        for bucket in [list(group)])
+    unique_count = candidate_count - duplicate_count
+    phi = (P - 1) * (Q - 1)
+    print(json.dumps({
+        "B": B, "N": N, "N_bits": N.bit_length(),
+        "factor_base_size": len(primes), "min_value_bits": MIN_BITS,
+        "candidate_count": candidate_count, "exact_duplicates_removed": duplicate_count,
+        "distinct_candidate_count": unique_count,
+        "uniform_unit_null_mean": unique_count * (unique_count - 1) / (2 * phi),
+        "nontrivial_collision_pairs": len(pairs),
+        "distinct_primitive_exponent_rows": len(exponent_rows),
+        "parity_rank": len(basis), "zero_parity_rows": zero_parity_rows,
+        "same_bit_length_control_collision_pairs": control_pairs,
+        "collisions": pairs, "seconds": round(time.monotonic() - start, 3),
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()

