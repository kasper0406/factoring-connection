\begin{fact}[Lee--Venkatesan {\cite[Lemma~8.5 and its proof, eq.~(8.2)]{lv2018}}]\label{fact:LV85}
Fix $\varepsilon>0$. There are effective constants $K,c>0$ such that for $(\log x)^K<y<x^{1/\log\log x}$, $u=\log x/\log y$,
$x^\varepsilon\le Q\le\sqrt{\Psi(x,y)}$, and $\omega_0\to\infty$ with $\omega_0=y^{O(1)}$,
\begin{multline*}
\mathcal W(Q):=\sum_{\substack{r\in[Q/\omega_0,Q]\\ \Pp(r)\le y}}\frac1{\varphi(r)}\sum_{\chi\bmod r,\ \chi\ne\chi_0}|\Psi(x,y;\chi)|\\
\ll\ \Psi(x,y)\varrho(Q,y)\bigl(e^{-cu/\log^2u}+y^{-c}\bigr)+Q\sqrt{\Psi(x,y)}\log^{7/2}x .
\end{multline*}
\end{fact}

\noindent Lee--Venkatesan state this bound for $\sum_r\max_{(a,r)=1}|\Psi(x,y;r,a)-\Psi_r(x,y)/\varphi(r)|$, which $\mathcal W(Q)$ majorises \cite[(8.2)]{lv2018}.
Their proof bounds $\mathcal W(Q)$ itself, splitting it into characters of small, medium and large conductor and treating exceptional
characters separately. This is the imported step.

\begin{fact}[Harper {\cite[Prop.~2]{harper2012}}; {\cite[Fact~8.11]{lv2018}}]\label{fact:Harper}
For $0<\eta<1/80$, $y\le x^{9/10}$ and $x^\eta\le Q\le\sqrt x$, with $M_0:=x^\eta$,
\begin{multline*}
\sum_{M_0\le r\le Q}\ \sum_{\chi^*\bmod r\text{ primitive}}\ \sum_{t\in[M_0,Q]}\frac1{\varphi(t)}\sum_{\chi\bmod t\text{ induced by }\chi^*}|\Psi(x,y;\chi)|\\
\ll\ \log^{7/2}x\,\sqrt{\Psi(x,y)}\,\bigl(Q+x^{1/2-\eta}\log^2x\bigr).
\end{multline*}
\end{fact}

\begin{proof}[Proof of Lemma~\ref{lem:85}]
Write $\Psi=\Psi(x)$ and $\delta:=\#\cT_Q/Q$.

\emph{Setup.} Since $\ell>B\ge\Pp(s)$, each $t\in\cT_Q$ determines $(\ell,s)$, and $\ell\nmid s$. So $\#\cT_Q=\sum_{\ell\in J}(\Psi(Q/\ell)-\Psi(Q/2\ell))\asymp\pi_J(Q/Y)\varrho(Q/Y)$
by Lemma~\ref{lem:local}, and $\delta\asymp\varrho(Q/Y)/\log Y=N^{-o(1)}$. By orthogonality,
$\Psi(x;t,r)-\Psi_t(x)/\varphi(t)=\varphi(t)^{-1}\sum_{\chi\ne\chi_0}\bar\chi(r)\Psi(x;\chi)$. So the left side of the lemma is at most
$\sum_{t\in\cT_Q}\varphi(t)^{-1}\sum_{\chi\ne\chi_0\bmod t}|\Psi(x;\chi)|$. Every character modulo $t=\ell s$ is $\chi=\chi^{(\ell)}\chi^{(s)}$, and
$\varphi(t)=(\ell-1)\varphi(s)$.

\emph{Part 1: $\chi^{(\ell)}$ principal, $\chi^{(s)}$ non-principal.} Every $B$-smooth $n$ is coprime to $\ell$, so $\Psi(x;\chi)=\Psi(x;\chi^{(s)})$. This part
equals
\[
\sum_{\ell\in J}\frac1{\ell-1}\sum_{\substack{s\in(Q/2\ell,Q/\ell]\\ \Pp(s)\le B}}\frac1{\varphi(s)}\sum_{\chi^{(s)}\ne\chi_0}|\Psi(x;\chi^{(s)})|\ \le\ \sum_{\ell\in J}\frac{\mathcal W(Q/\ell)}{\ell-1},
\]
by positivity, with $\omega_0:=\log x$. Fact~\ref{fact:LV85} applies with $y=B$: we have $Q/\ell=N^{q_0-2\nu+o(1)}\ge x^\varepsilon$ for
$\varepsilon:=(q_0-2\nu)/(2\xi)$, and $Q/\ell\le\sqrt\Psi$ because $q_0<\xi/2$. Hence Part~1 is
\[
\ll\Psi\bigl(e^{-cu/\log^2u}+B^{-c}\bigr)\sum_{\ell\in J}\frac{\varrho(Q/\ell)}{\ell}+\sqrt\Psi\log^{7/2}x\sum_{\ell\in J}\frac Q{\ell^2}.
\]
The first sum is at most $2\varrho(Q/2Y)\sum_{\ell\in J}1/\ell\ll\varrho(Q/Y)/\log Y\asymp\delta$, by Lemma~\ref{lem:local} and Mertens. The second
term is $\ll(Q/Y)\sqrt\Psi\log^{7/2}x/\log Y$. Relative to $\Psi\delta$ this is $N^{q_0-2\nu-\xi/2+o(1)}$, which is polynomially small.

\emph{Part 2: $\chi^{(\ell)}$ non-principal.} The conductor of $\chi$ is divisible by $\ell>Y$. Put $\eta:=\min(1/100,\nu/\xi)$ and $M_0:=x^\eta$. Then
$M_0\le Y$, every conductor lies in $[M_0,Q]$, every modulus $t\in(Q/2,Q]$ lies in $[M_0,Q]$, $Q\le\sqrt x$, and $B\le x^{9/10}$. By positivity, Part~2
is at most the left side of Fact~\ref{fact:Harper}, which is $\ll\log^{7/2}x\sqrt\Psi(Q+x^{1/2-\eta}\log^2x)$. Relative to $\Psi\delta$ this is
$N^{q_0-\xi/2+o(1)}+N^{-\eta\xi+o(1)}$.

The principal character of $t$ contributes exactly the subtracted main term. Adding the two parts gives the lemma with
$\varepsilon_N=O(e^{-cu/\log^2u}+B^{-c}+N^{-c})$. Finally, $e^{-cu/\log^2u}=\exp(-c'(\log N)^{1/2}(\log\log N)^{-5/2+o(1)})$ beats every power of $\log N$.
\end{proof}

\begin{remark}
In the regime used here no conductor in $[Y,M_0)$ occurs for $\chi^{(\ell)}\ne\chi_0$, so neither Harper's Proposition~1 nor the zero-density
estimate is needed in Part~2. All Siegel/Page considerations are inside Fact~\ref{fact:LV85}, and they concern only characters
of $B$-smooth moduli. The absorption of $(\log x)^{O(1)}$ into $e^{-cu/\log^2u}$ there requires $u/\log^2u\gg\log\log x$, which holds for
$u\asymp(\log N/\log\log N)^{1/2}$ but not at the edge of Lee--Venkatesan's stated range of $y$.
\end{remark}

